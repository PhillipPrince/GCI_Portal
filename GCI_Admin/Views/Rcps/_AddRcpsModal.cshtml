@model GCI_Admin.Models.DTOs.RcpsDto

<div class="modal fade" id="addRCPSModal" tabindex="-1" aria-labelledby="addRCPSModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-gradient-primary text-white">
                <h5 class="modal-title" id="addRCPSModalLabel">
                    <i class="fa fa-plus-circle me-2"></i>Add New RCP Rcps
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <div class="modal-body" style="max-height: 70vh; overflow-y: auto;">
                <form id="addRcpsForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" id="RcpsId" />
                    
                    <!-- Basic Information Section -->
                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-header bg-light">
                            <h6 class="mb-0">
                                <i class="fa fa-info-circle me-2 text-primary"></i>
                                Basic Information
                            </h6>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-12 mb-3">
                                    <label asp-for="Name" class="form-label fw-bold">
                                        <i class="fa fa-tag me-1 text-danger"></i>Rcps Name *
                                    </label>
                                    <input asp-for="Name" class="form-control form-control-lg" 
                                           id="RcpsName"
                                           placeholder="Enter Rcps name" 
                                           autocomplete="off" />
                                    <span asp-validation-for="Name" class="text-danger small"></span>
                                    <small class="text-muted d-block mt-1">Example: "Harvest Rcps 2024" or "City Outreach Program"</small>
                                </div>
                                
                                <div class="col-md-12 mb-3">
                                    <label asp-for="CountyCode" class="form-label fw-bold">
                                        <i class="fa fa-map-marker-alt me-1 text-primary"></i>County *
                                    </label>
                                    <select asp-for="CountyCode" class="form-select form-select-lg" 
                                            id="CountyCode"
                                            asp-items="@(ViewBag.Counties as List<SelectListItem> ?? new List<SelectListItem>())">
                                        <option value="">-- Select a County --</option>
                                    </select>
                                    <span asp-validation-for="CountyCode" class="text-danger small"></span>
                                    <small class="text-muted d-block mt-1">Select the county for this RCPS</small>
                                </div>
                                
                                <div class="col-md-12 mb-3">
                                    <label asp-for="Description" class="form-label fw-bold">
                                        <i class="fa fa-align-left me-1 text-primary"></i>Description
                                    </label>
                                    <textarea asp-for="Description" class="form-control" rows="4" 
                                              id="RcpsDescription"
                                              placeholder="Provide a detailed description of the Rcps..."></textarea>
                                    <span asp-validation-for="Description" class="text-danger small"></span>
                                    <small class="text-muted">Describe the goals, target areas, and vision for this Rcps</small>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Financial Information Section -->
                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-header bg-light">
                            <h6 class="mb-0">
                                <i class="fa fa-money-bill-wave me-2 text-success"></i>
                                Financial Information
                            </h6>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="TargetAmount" class="form-label fw-bold">
                                        <i class="fa fa-bullseye me-1 text-warning"></i>Target Amount (KES) *
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text">KES</span>
                                        <input asp-for="TargetAmount" class="form-control form-control-lg" 
                                               id="TargetAmount"
                                               type="number" step="1000" min="1000" 
                                               placeholder="Enter target amount" />
                                    </div>
                                    <span asp-validation-for="TargetAmount" class="text-danger small"></span>
                                    <small class="text-muted">Minimum: KES 1,000</small>
                                </div>
                                
                                <div class="col-md-6 mb-3">
                                    <label asp-for="AmountRaised" class="form-label fw-bold">
                                        <i class="fa fa-chart-line me-1 text-info"></i>Initial Amount Raised (KES)
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text">KES</span>
                                        <input asp-for="AmountRaised" class="form-control" 
                                               id="AmountRaised"
                                               type="number" step="1000" min="0" 
                                               placeholder="Enter amount raised so far" />
                                    </div>
                                    <span asp-validation-for="AmountRaised" class="text-danger small"></span>
                                    <small class="text-muted">Initial funds already raised (optional)</small>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Timeline Section -->
                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-header bg-light">
                            <h6 class="mb-0">
                                <i class="fa fa-calendar-alt me-2 text-info"></i>
                                Rcps Timeline
                            </h6>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="StartDate" class="form-label fw-bold">
                                        <i class="fa fa-calendar-check me-1 text-success"></i>Start Date *
                                    </label>
                                    <input asp-for="StartDate" class="form-control form-control-lg" 
                                           id="StartDate"
                                           value="@Model.StartDate.ToString("yyyy-MM-dd")"
                                           type="date" />
                                    <span asp-validation-for="StartDate" class="text-danger small"></span>
                                    <small class="text-muted">Rcps launch date</small>
                                </div>
                                
                                <div class="col-md-6 mb-3">
                                    <label asp-for="EndDate" class="form-label fw-bold">
                                        <i class="fa fa-calendar-times me-1 text-danger"></i>End Date *
                                    </label>
                                    <input asp-for="EndDate" class="form-control form-control-lg" 
                                           id="EndDate"
                                           value="@Model.EndDate.ToString("yyyy-MM-dd")"
                                           type="date" />
                                    <span asp-validation-for="EndDate" class="text-danger small"></span>
                                    <small class="text-muted">Rcps closing date</small>
                                </div>
                            </div>
                            
                            <div class="alert alert-info mt-2" id="dateValidationMessage" style="display: none;">
                                <i class="fa fa-exclamation-triangle me-2"></i>
                                <span id="dateValidationText"></span>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Status Section -->
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-light">
                            <h6 class="mb-0">
                                <i class="fa fa-toggle-on me-2 text-primary"></i>
                                Rcps Status
                            </h6>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Status" class="form-label fw-bold">
                                        <i class="fa fa-flag me-1"></i>Status *
                                    </label>
                                    <select asp-for="Status" class="form-select form-select-lg" id="RcpsStatus">
                                        <option value="">-- Select Rcps Status --</option>
                                        <option value="Planning">📋 Planning</option>
                                        <option value="Ongoing">🚀 Ongoing / Active</option>
                                        <option value="OnHold">⏸️ On Hold</option>
                                        <option value="Suspended">⛔ Suspended</option>
                                        <option value="Completed">✅ Completed</option>
                                        <option value="Upcoming">📅 Upcoming</option>
                                    </select>
                                    <span asp-validation-for="Status" class="text-danger small"></span>
                                </div>
                                
                                <div class="col-md-6 mb-3">
                                    <div class="card bg-light h-100">
                                        <div class="card-body py-3">
                                            <div class="form-check form-switch">
                                                <input class="form-check-input" type="checkbox" id="IsActive" name="IsActive" value="true" checked>
                                                <label class="form-check-label fw-bold ms-2" for="IsActive">
                                                    <i class="fa fa-check-circle text-success me-1"></i>
                                                    Mark as Active Rcps
                                                </label>
                                            </div>
                                            <small class="text-muted ms-4">Active Rcpss will appear in the main view</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Status Tips -->
                            <div class="alert alert-secondary mt-2">
                                <i class="fa fa-lightbulb-o me-2"></i>
                                <strong>Status Guide:</strong>
                                <ul class="mb-0 mt-2 small">
                                    <li><span class="badge bg-secondary">Planning</span> - Rcps is in planning phase, not yet launched</li>
                                    <li><span class="badge bg-success">Ongoing</span> - Currently active and receiving pledges</li>
                                    <li><span class="badge bg-warning">On Hold</span> - Temporarily paused</li>
                                    <li><span class="badge bg-danger">Suspended</span> - Permanently stopped</li>
                                    <li><span class="badge bg-info">Completed</span> - Successfully finished</li>
                                    <li><span class="badge bg-primary">Upcoming</span> - Scheduled for future launch</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fa fa-times me-1"></i>Cancel
                </button>
                <button type="button" class="btn btn-primary" onclick="submitAddRcpsForm()">
                    <i class="fa fa-save me-1"></i>Create Rcps
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    function initializeModalDateValidation() {
        // Set minimum date to today for start date
        var today = new Date().toISOString().split('T')[0];
        var startDateInput = document.getElementById('StartDate');
        if (startDateInput) {
            startDateInput.min = today;
        }
        
        // Set default values if empty
        if (startDateInput && !startDateInput.value) {
            startDateInput.value = today;
        }
        
        var endDateInput = document.getElementById('EndDate');
        if (endDateInput && !endDateInput.value) {
            var defaultEndDate = new Date();
            defaultEndDate.setMonth(defaultEndDate.getMonth() + 3);
            endDateInput.value = defaultEndDate.toISOString().split('T')[0];
        }
        
        // Add event listeners for date validation
        $('#StartDate, #EndDate').off('change').on('change', validateModalDates);
        
        // Format number inputs
        $('#TargetAmount, #AmountRaised').off('input').on('input', function() {
            if ($(this).val() < 0) $(this).val(0);
        });
        
        // Update status based on dates
        updateStatusBasedOnDates();
    }
    
    function validateModalDates() {
        var startDate = $('#StartDate').val();
        var endDate = $('#EndDate').val();
        
        if (startDate && endDate) {
            if (new Date(startDate) > new Date(endDate)) {
                $('#dateValidationMessage').show();
                $('#dateValidationText').text('End date cannot be earlier than start date!');
                return false;
            } else {
                $('#dateValidationMessage').hide();
                updateStatusBasedOnDates();
                return true;
            }
        }
        return true;
    }
    
    function updateStatusBasedOnDates() {
        var startDate = $('#StartDate').val();
        var endDate = $('#EndDate').val();
        var today = new Date().toISOString().split('T')[0];
        var currentStatus = $('#RcpsStatus').val();
        
        if (startDate && endDate && (!currentStatus || currentStatus === '')) {
            if (new Date(startDate) > new Date(today)) {
                $('#RcpsStatus').val('Upcoming');
            } else if (new Date(endDate) < new Date(today)) {
                $('#RcpsStatus').val('Completed');
            } else if (new Date(startDate) <= new Date(today) && new Date(endDate) >= new Date(today)) {
                $('#RcpsStatus').val('Ongoing');
            }
        }
    }
    
    function submitAddRcpsForm() {
        // Validate required fields
        var name = $('#RcpsName').val();
        var targetAmount = $('#TargetAmount').val();
        var startDate = $('#StartDate').val();
        var endDate = $('#EndDate').val();
        var status = $('#RcpsStatus').val();
        var countyCode = $('#CountyCode').val();
        
        // Basic validation
        if (!name || name.trim() === '') {
            Swal.fire('Validation Error', 'Please enter a name for the Rcps', 'error');
            $('#RcpsName').focus();
            return false;
        }
        
        if (!countyCode) {
            Swal.fire('Validation Error', 'Please select a County', 'error');
            $('#CountyCode').focus();
            return false;
        }
        
        if (!targetAmount || targetAmount <= 0) {
            Swal.fire('Validation Error', 'Please enter a valid target amount (minimum KES 1,000)', 'error');
            $('#TargetAmount').focus();
            return false;
        }
        
        if (!startDate) {
            Swal.fire('Validation Error', 'Please select the start date', 'error');
            $('#StartDate').focus();
            return false;
        }
        
        if (!endDate) {
            Swal.fire('Validation Error', 'Please select the end date', 'error');
            $('#EndDate').focus();
            return false;
        }
        
        if (!validateModalDates()) {
            Swal.fire('Validation Error', 'Please check the Rcps dates', 'error');
            return false;
        }
        
        if (!status) {
            Swal.fire('Validation Error', 'Please select a Rcps status', 'error');
            $('#RcpsStatus').focus();
            return false;
        }
        
        var isEdit = $('#RcpsId').val() && $('#RcpsId').val() !== "0";
        var title = isEdit ? 'Update Rcps?' : 'Create New Rcps?';
        var confirmBtn = isEdit ? 'Yes, update Rcps!' : 'Yes, create Rcps!';

        // Show confirmation dialog
        Swal.fire({
            title: title,
            html: `
                <div class="text-start">
                    <p><strong>Rcps Name:</strong> ${escapeHtml(name)}</p>
                    <p><strong>Target Amount:</strong> KES ${parseInt(targetAmount).toLocaleString()}</p>
                    <p><strong>Start Date:</strong> ${new Date(startDate).toLocaleDateString()}</p>
                    <p><strong>End Date:</strong> ${new Date(endDate).toLocaleDateString()}</p>
                    <p><strong>Status:</strong> ${status}</p>
                </div>
            `,
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#28a745',
            cancelButtonColor: '#dc3545',
            confirmButtonText: confirmBtn,
            cancelButtonText: 'Cancel'
        }).then((result) => {
            if (result.isConfirmed) {
                submitFormData();
            }
        });
        
        return false;
    }
    
    function submitFormData() {
        var isEdit = $('#RcpsId').val() && $('#RcpsId').val() !== "0";
        var loadingText = isEdit ? 'Updating Rcps...' : 'Creating Rcps...';
        
        // Show loading state
        Swal.fire({
            title: loadingText,
            text: 'Please wait...',
            allowOutsideClick: false,
            didOpen: () => {
                Swal.showLoading();
            }
        });
        
        var formData = {
            Id: parseInt($('#RcpsId').val()) || 0,
            Name: $('#RcpsName').val(),
            Description: $('#RcpsDescription').val(),
            TargetAmount: parseFloat($('#TargetAmount').val()),
            AmountRaised: parseFloat($('#AmountRaised').val()) || 0,
            StartDate: $('#StartDate').val(),
            EndDate: $('#EndDate').val(),
            Status: $('#RcpsStatus').val(),
            CountyCode: $('#CountyCode').val(),
            IsActive: $('#IsActive').is(':checked')
        };
        
        var url = isEdit ? '/Rcps/UpdateRcps' : '/Rcps/CreateRcps';
        
        $.ajax({
            url: url,
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(formData),
            headers: {
                'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(response) {
                if (response.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Success!',
                        text: response.message,
                        confirmButtonColor: '#28a745'
                    }).then(() => {
                        $('#addRCPSModal').modal('hide');
                        // Refresh the page or reload the table
                        if (typeof applyFilters === 'function') {
                            applyFilters();
                        }
                        if (typeof updateStats === 'function') {
                            updateStats();
                        }
                        showSuccessToast(response.message);
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error!',
                        text: response.message || 'Failed to create Rcps',
                        confirmButtonColor: '#d33'
                    });
                }
            },
            error: function(xhr, status, error) {
                let errorMessage = 'An error occurred while creating the Rcps';
                if (xhr.responseJSON && xhr.responseJSON.message) {
                    errorMessage = xhr.responseJSON.message;
                } else if (xhr.responseText) {
                    try {
                        var response = JSON.parse(xhr.responseText);
                        errorMessage = response.message || errorMessage;
                    } catch(e) {}
                }
                
                Swal.fire({
                    icon: 'error',
                    title: 'Error!',
                    text: errorMessage,
                    confirmButtonColor: '#d33'
                });
            }
        });
    }
    
    function escapeHtml(text) {
        if (!text) return '';
        var map = {
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;',
            "'": '&#39;'
        };
        return text.replace(/[&<>"']/g, function(m) { return map[m]; });
    }
    
    function showSuccessToast(message) {
        if (typeof showToast === 'function') {
            showToast(message, 'success');
        } else {
            alert(message);
        }
    }
    
    // Initialize when modal is shown
    $('#addRCPSModal').on('shown.bs.modal', function() {
        initializeModalDateValidation();
    });
    
    // Reset form when modal is hidden
    $('#addRCPSModal').on('hidden.bs.modal', function() {
        $('#addRcpsForm')[0].reset();
        $('#dateValidationMessage').hide();
        $('#AmountRaised').val(0);
        $('.is-invalid').removeClass('is-invalid');
    });
    
    // Update end date min based on start date
    $(document).on('change', '#StartDate', function() {
        var startDate = $(this).val();
        $('#EndDate').attr('min', startDate);
        validateModalDates();
    });
</script>

<style>
    .bg-gradient-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }
    
    .modal-content {
        border: none;
        border-radius: 15px;
        overflow: hidden;
    }
    
    .modal-header {
        border-bottom: none;
        padding: 1.5rem;
    }
    
    .form-control:focus, .form-select:focus {
        border-color: #667eea;
        box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
    }
    
    .card-header {
        border-bottom: 2px solid #e9ecef;
        background-color: #f8f9fa;
    }
    
    .form-label {
        margin-bottom: 0.5rem;
    }
    
    input, select, textarea {
        transition: all 0.3s ease;
    }
    
    input:hover, select:hover, textarea:hover {
        transform: translateY(-1px);
    }
    
    .modal.fade .modal-dialog {
        transform: scale(0.8);
        transition: transform 0.3s ease-in-out;
    }
    
    .modal.show .modal-dialog {
        transform: scale(1);
    }
    
   
    
    .modal-content {
        animation: slideIn 0.3s ease-out;
    }
</style>