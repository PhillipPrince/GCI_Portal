@model GCI_Admin.Models.RcpsViewModel

@{
    ViewData["Title"] = "Rapid Church Planting Strategy (RCPS)";
}

<div class="row mb-4">
    <div class="col-md-8">
        <h2 class="fw-bold mb-1">
            <i class="fa fa-seedling text-success me-2"></i>Rapid Church Planting Strategy (RCPS)
        </h2>
        <p class="text-muted mb-0">Manage church planting Rcpss and track fundraising progress</p>
    </div>
    <div class="col-md-4 text-end">
        <button type="button" class="btn btn-primary btn-lg" onclick="openAddRCPSModal()">
            <i class="fa fa-plus-circle me-2"></i>New Rcps
        </button>
    </div>
</div>

<!-- Stats Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm stat-card">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="bg-primary bg-opacity-10 p-3 rounded-circle">
                            <i class="fa fa-church text-primary fa-2x"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1">Total RCPs</h6>
                        <h3 class="fw-bold mb-0" id="totalRCPs">@Model.TotalRcps</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm stat-card">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="bg-success bg-opacity-10 p-3 rounded-circle">
                            <i class="fa fa-rocket text-success fa-2x"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1">Active RCPs</h6>
                        <h3 class="fw-bold mb-0" id="activeRCPs">@Model.ActiveRcps</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm stat-card">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="bg-info bg-opacity-10 p-3 rounded-circle">
                            <i class="fa fa-check-circle text-info fa-2x"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1">Completed RCPs</h6>
                        <h3 class="fw-bold mb-0" id="completedRCPs">@Model.CompletedRcps</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm stat-card">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="bg-warning bg-opacity-10 p-3 rounded-circle">
                            <i class="fa fa-money text-warning fa-2x"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1">Total Raised</h6>
                        <h3 class="fw-bold mb-0">KES @Model.TotalRaised.ToString("N0")</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Current Active RCP Highlight -->
<div class="card border-0 shadow-sm mb-4" id="activeRCPCard">
    <div class="card-header bg-transparent">
        <h5 class="mb-0">
            <i class="fa fa-fire text-danger me-2"></i>Currently Active RCP
        </h5>
    </div>
    <div class="card-body">
        @if (Model.CurrentActiveRcps != null)
        {
            <div class="row align-items-center">
                <div class="col-md-8">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-success bg-opacity-10 p-3 rounded-circle me-3">
                            <i class="fa fa-flag-checkered text-success fa-2x"></i>
                        </div>
                        <div>
                            <h3 class="fw-bold mb-0">@Model.CurrentActiveRcps.Name</h3>
                            <p class="text-muted mb-0">
                                <i class="fa fa-calendar me-1"></i>@Model.CurrentActiveRcps.StartDate?.ToString("MMM dd, yyyy") - @Model.CurrentActiveRcps.EndDate?.ToString("MMM dd, yyyy")
                            </p>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="text-muted small">Description</label>
                                <p class="mb-0">@Model.CurrentActiveRcps.Description</p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="text-muted small">Target Amount</label>
                                <h5 class="fw-bold text-success mb-0">KES @Model.CurrentActiveRcps.TargetAmount.ToString("N0")</h5>
                            </div>
                            <div class="mb-3">
                                <label class="text-muted small">Amount Raised</label>
                                <h5 class="fw-bold text-primary mb-0">KES @Model.CurrentActiveRcps.AmountRaised.ToString("N0")</h5>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card bg-light">
                        <div class="card-body text-center">
                            <h6 class="text-muted">Fundraising Progress</h6>
                            <h2 class="fw-bold text-primary">@(((decimal)Model.CurrentActiveRcps.AmountRaised / Model.CurrentActiveRcps.TargetAmount * 100).ToString("F1"))%</h2>
                            <div class="progress mb-2" style="height: 10px;">
                                <div class="progress-bar bg-success" role="progressbar" style="width: @((decimal)Model.CurrentActiveRcps.AmountRaised / Model.CurrentActiveRcps.TargetAmount * 100)%"></div>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="small">Raised: KES @Model.CurrentActiveRcps.AmountRaised.ToString("N0")</span>
                                <span class="small">Remaining: KES @((Model.CurrentActiveRcps.TargetAmount - Model.CurrentActiveRcps.AmountRaised).ToString("N0"))</span>
                            </div>
                            <button class="btn btn-primary btn-sm mt-3" onclick="viewRCPDetails(@Model.CurrentActiveRcps.Id)">
                                <i class="fa fa-eye me-1"></i>View Full Details
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="text-center py-4">
                <i class="fa fa-inbox fa-3x text-muted mb-3"></i>
                <p class="mb-0">No active RCP Rcps at the moment</p>
                <button class="btn btn-primary mt-3" onclick="openAddRCPSModal()">
                    <i class="fa fa-plus-circle me-1"></i>Launch New RCP
                </button>
            </div>
        }
    </div>
</div>

<!-- Tabs Navigation -->
<ul class="nav nav-tabs mb-4" id="rcpsTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="rcps-tab" data-bs-toggle="tab" data-bs-target="#rcps-list" type="button" role="tab" aria-controls="rcps-list" aria-selected="true">
            <i class="fa fa-church me-2"></i>RCPs
            <span class="badge bg-primary ms-2" id="rcpsCount">@Model.Rcps?.Count</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="county-coordinators-tab" data-bs-toggle="tab" data-bs-target="#county-coordinators" type="button" role="tab" aria-controls="county-coordinators" aria-selected="false">
            <i class="fa fa-users me-2"></i>County Coordinators
            <span class="badge bg-primary ms-2" id="countyCoordinatorsCount">@Model.CountyCoordinators?.Count</span>
        </button>
    </li>
</ul>

<!-- Tab Content -->
<div class="tab-content" id="rcpsTabsContent">
    <!-- RCPs Tab -->
    <div class="tab-pane fade show active" id="rcps-list" role="tabpanel" aria-labelledby="rcps-tab">
        <!-- Search and Filter -->
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="input-group">
                            <span class="input-group-text bg-transparent border-end-0">
                                <i class="fa fa-search text-muted"></i>
                            </span>
                            <input type="text" class="form-control border-start-0" id="rcpSearch" placeholder="Search by name, description...">
                        </div>
                    </div>
                    <div class="col-md-3">
                        <select class="form-select" id="statusFilter">
                            <option value="">All Status</option>
                            <option value="Active">Active</option>
                            <option value="Completed">Completed</option>
                            <option value="Planning">Planning</option>
                            <option value="On Hold">On Hold</option>
                            <option value="Upcoming">Upcoming</option>
                            <option value="Suspended">Suspended</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <button class="btn btn-outline-secondary" onclick="clearFilters()">
                            <i class="fa fa-times me-1"></i>Clear Filters
                        </button>
                        <button class="btn btn-primary ms-2" onclick="applyFilters()">
                            <i class="fa fa-filter me-1"></i>Apply
                        </button>
                    </div>
                    <div class="col-md-2 text-end">
                        <button class="btn btn-outline-success" onclick="exportRCPs()">
                            <i class="fa fa-file-excel me-1"></i>Export
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div id="rcpsTableContainer">
            @await Html.PartialAsync("_RcpsTable", Model.Rcps)
        </div>
    </div>

    <!-- County Coordinators Tab -->
    <div class="tab-pane fade" id="county-coordinators" role="tabpanel" aria-labelledby="county-coordinators-tab">
        <div class="d-flex justify-content-end mb-3">
            <button type="button" class="btn btn-primary" onclick="openAddCountyCoordinatorModal()">
                <i class="fa fa-user-plus me-2"></i>Assign County Coordinator
            </button>
        </div>
        <div id="countyCoordinatorsTableContainer">
            @await Html.PartialAsync("_CountyCoordinatorsTable", Model.CountyCoordinators)
        </div>
    </div>
</div>

<!-- Add RCP Modal Container -->
<div id="addRCPSModalContainer"></div>

<!-- County Coordinator Modal -->
<div class="modal fade" id="countyCoordinatorModal" tabindex="-1" aria-labelledby="countyCoordinatorModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="countyCoordinatorModalLabel">
                    <i class="fa fa-user-plus me-2"></i>
                    <span id="modalTitleCountyCoordinator">Assign County Coordinator</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <div id="countyCoordinatorModalContent">
                <div class="text-center p-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2">Loading form...</p>
                </div>
            </div>
            
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="confirmAndSubmitCoordinator()" id="saveCoordinatorBtn">
                    <i class="fa fa-save me-1"></i><span id="saveCoordinatorBtnText">Save Coordinator</span>
                    <span id="coordinatorLoading" class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Toast Container -->
<div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div id="successToast" class="toast align-items-center text-white bg-success border-0">
        <div class="d-flex">
            <div class="toast-body"></div>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.sheetjs.com/xlsx-0.20.1/package/dist/xlsx.full.min.js"></script>
    
    <style>
        .stat-card {
            transition: transform 0.2s, box-shadow 0.2s;
            cursor: pointer;
        }
        .stat-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 0.5rem 1.5rem rgba(0,0,0,0.1) !important;
        }
        #activeRCPCard {
            background: linear-gradient(135deg, #fff 0%, #f8f9fa 100%);
            border-left: 4px solid #28a745 !important;
        }
    </style>

    <script>
        function viewRCPDetails(id) {
            window.location.href = '/Rcps/RcpsDetails/' + id;
        }

        function openAddRCPSModal() {
            $.ajax({
                url: '/Rcps/GetAddRcpsPartial',
                type: 'GET',
                success: function(data) {
                    $('#addRCPSModalContainer').html(data);
                    $('#addRCPSModalLabel').html('<i class="fa fa-plus-circle me-2"></i>Add New RCP Rcps');
                    $('#addRCPSModal').modal('show');
                    
                    if (typeof initializeModalDateValidation === 'function') {
                        initializeModalDateValidation();
                    }
                },
                error: function(xhr, status, error) {
                    Swal.fire('Error', 'Failed to load the form: ' + error, 'error');
                }
            });
        }

        function editRcps(id) {
            $.ajax({
                url: '/Rcps/GetEditRcpsPartial/' + id,
                type: 'GET',
                success: function(data) {
                    $('#addRCPSModalContainer').html(data);
                    $('#addRCPSModalLabel').html('<i class="fa fa-edit me-2"></i>Edit RCP Rcps');
                    $('#addRCPSModal').modal('show');
                    
                    if (typeof initializeModalDateValidation === 'function') {
                        initializeModalDateValidation();
                    }
                },
                error: function(xhr, status, error) {
                    Swal.fire('Error', 'Failed to load the form: ' + error, 'error');
                }
            });
        }

        function applyFilters() {
            var search = $('#rcpSearch').val().toLowerCase();
            var status = $('#statusFilter').val();
            
            $.ajax({
                url: '/Rcps/FilterRCPs',
                type: 'POST',
                data: { search: search, status: status },
                success: function(response) {
                    $('#rcpsTableContainer').html(response);
                },
                error: function() {
                    Swal.fire('Error', 'Failed to filter RCPs', 'error');
                }
            });
        }

        function clearFilters() {
            $('#rcpSearch').val('');
            $('#statusFilter').val('');
            $.ajax({
                url: '/Rcps/GetAllRCPs',
                type: 'GET',
                success: function(response) {
                    $('#rcpsTableContainer').html(response);
                }
            });
        }

        function exportRCPs() {
            var search = $('#rcpSearch').val();
            var status = $('#statusFilter').val();
            window.location.href = '/Rcps/ExportRCPs?search=' + encodeURIComponent(search) + '&status=' + encodeURIComponent(status);
        }

        function deleteRCP(id) {
            Swal.fire({
                title: 'Delete RCP Rcps',
                text: 'Are you sure you want to delete this Rcps?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                confirmButtonText: 'Yes, delete it',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/Rcps/DeleteRcp/' + id,
                        type: 'POST',
                        data: {
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function(response) {
                            if (response.success) {
                                Swal.fire('Deleted!', response.message || 'RCP Rcps deleted successfully.', 'success');
                                applyFilters();
                                updateStats();
                            } else {
                                Swal.fire('Error', response.message || 'Failed to delete Rcps', 'error');
                            }
                        },
                        error: function() {
                            Swal.fire('Error', 'Failed to delete Rcps', 'error');
                        }
                    });
                }
            });
        }

        function updateStats() {
            $.ajax({
                url: '/Rcps/GetStats',
                type: 'GET',
                success: function(response) {
                    $('#totalRCPs').text(response.totalRCPs);
                    $('#activeRCPs').text(response.activeRCPs);
                    $('#completedRCPs').text(response.completedRCPs);
                },
                error: function() {
                    console.log('Failed to update stats');
                }
            });
        }

        function showToast(message, type = 'success') {
            const toast = $('#successToast');
            toast.removeClass('bg-success bg-danger bg-warning');
            
            if (type === 'success') toast.addClass('bg-success');
            else if (type === 'error') toast.addClass('bg-danger');
            else toast.addClass('bg-warning');
            
            toast.find('.toast-body').text(message);
            const bsToast = new bootstrap.Toast(toast[0], { autohide: true, delay: 3000 });
            bsToast.show();
        }

        function deleteRcps(rcpsId) {
    // Get the campaign name for better user experience
    var campaignName = $(`button[onclick="deleteRcps(${rcpsId})"]`)
        .closest('tr')
        .find('td:eq(1) strong')
        .text();
    
    // If name not found through DOM, try alternative method
    if (!campaignName) {
        campaignName = $(`button[onclick="deleteRcps(${rcpsId})"]`)
            .parents('tr')
            .find('td:nth-child(2)')
            .text()
            .trim();
    }
    
    // Use SweetAlert2 for beautiful confirmation dialog
    Swal.fire({
        title: 'Delete RCP Campaign?',
        html: `
            <div class="text-start">
                <p class="mb-2">Are you sure you want to delete this campaign?</p>
                <div class="alert alert-danger">
                    <strong>Campaign:</strong> ${escapeHtml(campaignName) || 'Unknown'}<br>
                    <strong>ID:</strong> ${rcpsId}
                </div>
                <p class="text-danger mb-0">
                    <i class="fa fa-exclamation-triangle me-1"></i>
                    <small>This action cannot be undone. All pledges associated with this campaign will also be permanently deleted.</small>
                </p>
            </div>
        `,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#d33',
        cancelButtonColor: '#6c757d',
        confirmButtonText: '<i class="fa fa-trash me-1"></i> Yes, delete campaign!',
        cancelButtonText: '<i class="fa fa-times me-1"></i> Cancel',
        reverseButtons: true,
        showLoaderOnConfirm: true,
        preConfirm: async () => {
            try {
                const response = await $.ajax({
                    url: `/Rcps/DeleteRcp/${rcpsId}`,
                    type: 'POST',
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() || getCsrfToken()
                    }
                });
                
                if (response.success) {
                    return response;
                } else {
                    throw new Error(response.message || 'Failed to delete campaign');
                }
            } catch (error) {
                throw error;
            }
        },
        allowOutsideClick: () => !Swal.isLoading()
    }).then((result) => {
        if (result.isConfirmed) {
            // Show success message
            Swal.fire({
                title: 'Deleted!',
                text: result.value?.message || 'RCP campaign has been deleted successfully.',
                icon: 'success',
                confirmButtonColor: '#28a745',
                timer: 2000,
                timerProgressBar: true
            }).then(() => {
                // Refresh the page or update the UI
                location.reload(); // Or call a refresh function
                // If you have a refresh function, use that instead:
                // if (typeof refreshRcpsList === 'function') refreshRcpsList();
            });
        }
    });
}

// Helper function to escape HTML
function escapeHtml(text) {
    if (!text) return '';
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
}

// Helper function to get CSRF token if not in form
function getCsrfToken() {
    const token = $('input[name="__RequestVerificationToken"]').val();
    if (token) return token;
    
    // Alternative: get from meta tag
    const metaToken = $('meta[name="csrf-token"]').attr('content');
    return metaToken || '';
}
// =========================================================
// COUNTY COORDINATOR FUNCTIONS
// =========================================================

function openAddCountyCoordinatorModal() {
    $('#modalTitleCountyCoordinator').text('Assign County Coordinator');
    $('#saveCoordinatorBtnText').text('Save Coordinator');
    $('#countyCoordinatorModalContent').html('<div class="text-center p-4"><div class="spinner-border text-primary" role="status"></div><p class="mt-2">Loading form...</p></div>');
    
    var modal = new bootstrap.Modal(document.getElementById('countyCoordinatorModal'));
    modal.show();

    $.ajax({
        url: '/Rcps/LoadCoordinatorCreateForm',
        type: 'GET',
        success: function (result) {
            $('#countyCoordinatorModalContent').html(result);
            // Re-initialize Select2 or any plugins if needed inside the partial
        },
        error: function () {
            $('#countyCoordinatorModalContent').html('<div class="alert alert-danger">Failed to load form.</div>');
        }
    });
}

function editCountyCoordinator(id) {
    $('#modalTitleCountyCoordinator').text('Edit County Coordinator');
    $('#saveCoordinatorBtnText').text('Update Coordinator');
    $('#countyCoordinatorModalContent').html('<div class="text-center p-4"><div class="spinner-border text-primary" role="status"></div><p class="mt-2">Loading form...</p></div>');
    
    var modal = new bootstrap.Modal(document.getElementById('countyCoordinatorModal'));
    modal.show();

    $.ajax({
        url: '/Rcps/LoadCoordinatorEditForm/' + id,
        type: 'GET',
        success: function (result) {
            if (result.success === false) {
                modal.hide();
                showToast(result.message, 'error');
                return;
            }
            $('#countyCoordinatorModalContent').html(result);
        },
        error: function () {
            $('#countyCoordinatorModalContent').html('<div class="alert alert-danger">Failed to load form.</div>');
        }
    });
}

function confirmAndSubmitCoordinator() {
    if (typeof getCoordinatorFormData !== 'function') {
        console.error('getCoordinatorFormData function not found');
        return;
    }

    const data = getCoordinatorFormData();
    if (!data) return; // Validation failed

    const isEdit = data.id > 0;
    const url = isEdit ? '/Rcps/UpdateCountyCoordinator' : '/Rcps/CreateCountyCoordinator';

    $('#saveCoordinatorBtn').prop('disabled', true);
    $('#coordinatorLoading').removeClass('d-none');

    $.ajax({
        url: url,
        type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify(data),
        headers: {
            'RequestVerificationToken': getCsrfToken()
        },
        success: function (response) {
            if (response.success) {
                bootstrap.Modal.getInstance(document.getElementById('countyCoordinatorModal')).hide();
                showToast(response.message, 'success');
                setTimeout(() => location.reload(), 1000);
            } else {
                showToast(response.message || 'Operation failed', 'error');
            }
        },
        error: function (xhr) {
            showToast('An error occurred while saving the coordinator', 'error');
        },
        complete: function () {
            $('#saveCoordinatorBtn').prop('disabled', false);
            $('#coordinatorLoading').addClass('d-none');
        }
    });
}

function toggleCountyCoordinatorStatus(id, newStatus) {
    Swal.fire({
        title: newStatus ? 'Activate Coordinator?' : 'Deactivate Coordinator?',
        text: `Are you sure you want to ${newStatus ? 'activate' : 'deactivate'} this coordinator?`,
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: newStatus ? '#28a745' : '#ffc107',
        confirmButtonText: 'Yes, proceed'
    }).then((result) => {
        if (result.isConfirmed) {
            $.ajax({
                url: '/Rcps/ToggleCoordinatorStatus',
                type: 'POST',
                data: { 
                    id: id, 
                    isActive: newStatus,
                    __RequestVerificationToken: getCsrfToken() 
                },
                success: function(response) {
                    if (response.success) {
                        showToast(response.message, 'success');
                        setTimeout(() => location.reload(), 1000);
                    } else {
                        showToast(response.message, 'error');
                    }
                },
                error: function() {
                    showToast('Failed to update status', 'error');
                }
            });
        }
    });
}

function deleteCountyCoordinator(id) {
    Swal.fire({
        title: 'Delete Coordinator?',
        text: 'Are you sure you want to remove this coordinator? This action cannot be undone.',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#dc3545',
        confirmButtonText: 'Yes, delete it'
    }).then((result) => {
        if (result.isConfirmed) {
            $.ajax({
                url: '/Rcps/DeleteCountyCoordinator',
                type: 'POST',
                data: { 
                    id: id,
                    __RequestVerificationToken: getCsrfToken()
                },
                success: function(response) {
                    if (response.success) {
                        showToast('Coordinator removed successfully', 'success');
                        setTimeout(() => location.reload(), 1000);
                    } else {
                        showToast(response.message, 'error');
                    }
                },
                error: function() {
                    showToast('Failed to delete coordinator', 'error');
                }
            });
        }
    });
}
    </script>
}