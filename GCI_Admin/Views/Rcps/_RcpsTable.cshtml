@model List<GCI_Admin.Models.Rcps>

<div class="card shadow-sm">
    <div class="table-responsive p-3">
        <table id="rcpsTable" class="table table-striped table-hover align-middle datatable">

            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Target Amount</th>
                    <th>Amount Raised</th>
                    <th>Progress</th>
                    <th>Start Date</th>
                    <th>End Date</th>
                    <th>Status</th>
                    <th>Created At</th>
                    <th class="text-end">Actions</th>
                </tr>

                <!-- Search Row -->
                <tr>
                    <th>
                        <input type="text" placeholder="Search Name" class="form-control form-control-sm" />
                    </th>
                    <th>
                        <input type="text" placeholder="Search Description" class="form-control form-control-sm" />
                    </th>
                    <th>
                        <input type="text" placeholder="Search Target" class="form-control form-control-sm" />
                    </th>
                    <th>
                        <input type="text" placeholder="Search Raised" class="form-control form-control-sm" />
                    </th>
                    <th>
                        <input type="text" placeholder="Search Progress" class="form-control form-control-sm" />
                    </th>
                    <th>
                        <input type="date" class="form-control form-control-sm" />
                    </th>
                    <th>
                        <input type="date" class="form-control form-control-sm" />
                    </th>
                    <th>
                        <select class="form-control form-control-sm">
                            <option value="">All</option>
                            <option value="Planning">Planning</option>
                            <option value="Active">Active</option>
                            <option value="On Hold">On Hold</option>
                            <option value="Completed">Completed</option>
                            <option value="Cancelled">Cancelled</option>
                        </select>
                    </th>
                    <th>
                        <input type="date" class="form-control form-control-sm" />
                    </th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                @foreach (var rcps in Model)
                {
                    <tr>
                        <td>@rcps.Name</td>
                        <td>@rcps.Description</td>
                        <td>KES @rcps.TargetAmount.ToString("N2")</td>
                        <td>KES @rcps.AmountRaised.ToString("N2")</td>
                        <td>
                            @{
                                decimal percentage = rcps.TargetAmount > 0 ? ((decimal)rcps.AmountRaised / rcps.TargetAmount * 100) : 0;
                            }
                            <div class="d-flex align-items-center">
                                <span class="me-2">@(percentage.ToString("F0"))%</span>
                                <div class="progress flex-grow-1" style="height: 6px;">
                                    <div class="progress-bar bg-success" role="progressbar" style="width: @(percentage)%"></div>
                                </div>
                            </div>
                        </td>
                        <td>@rcps.StartDate?.ToString("dd MMM yyyy")</td>
                        <td>@rcps.EndDate?.ToString("dd MMM yyyy")</td>
                        <td>
                            @if (rcps.Status == "Ongoing")
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else if (rcps.Status == "Completed")
                            {
                                <span class="badge bg-info">Completed</span>
                            }
                            else if (rcps.Status == "Planning")
                            {
                                <span class="badge bg-secondary">Planning</span>
                            }
                            else if (rcps.Status == "On Hold")
                            {
                                <span class="badge bg-warning">On Hold</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Cancelled</span>
                            }
                        </td>
                        <td>@rcps.CreatedAt.ToString("dd MMM yyyy")</td>
                        <td class="text-end">
                            <!-- View -->
                            <button class="btn btn-sm btn-outline-info"
                                    onclick="viewRCPDetails(@rcps.Id)">
                                <i class="fa fa-eye"></i>
                            </button>

                            <!-- Edit -->
                            <button class="btn btn-sm btn-outline-primary"
                                    onclick="editRcps(@rcps.Id)">
                                <i class="fa fa-edit"></i>
                            </button>

                            <!-- Delete -->
                            <button class="btn btn-sm btn-outline-danger"
                                    onclick="deleteRcps(@rcps.Id)">
                                <i class="fa fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    </div>
</div>