@model List<GCI_Admin.Models.GECMember>

<div class="card shadow-sm">
    <div class="table-responsive p-3">
        <table id="gecMembersTable" class="table table-striped table-hover align-middle datatable">

            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Name</th>
                    <th>Phone</th>
                    <th>Email</th>
                    <th>Gender</th>
                    <th>Position</th>
                    <th>Start Date</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>

                <!-- Filter Row -->
                <tr>
                    <th></th>
                    <th>
                        <input type="text" placeholder="Search Name" class="form-control form-control-sm" />
                    </th>
                    <th>
                        <input type="text" placeholder="Search Phone" class="form-control form-control-sm" />
                    </th>
                    <th>
                        <input type="text" placeholder="Search Email" class="form-control form-control-sm" />
                    </th>
                    <th>
                        <select class="form-select form-select-sm">
                            <option value="">All</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                        </select>
                    </th>
                    <th>
                        <input type="text" placeholder="Search Position" class="form-control form-control-sm" />
                    </th>
                    <th></th>
                    <th>
                        <select class="form-select form-select-sm">
                            <option value="">All</option>
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                        </select>
                    </th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Any())
                {
                    int count = 1;

                    foreach (var m in Model)
                    {
                        <tr>
                            <td>@count</td>
                            <td>
                                @($"{m.Member?.FirstName} {m.Member?.OtherNames}")
                            </td>
                            <td>@m.Member?.Phone</td>
                            <td>@m.Member?.Email</td>

                            <!-- Gender Badge -->
                            <td>
                                @if (m.Member?.Gender == "Male")
                                {
                                    <span class="badge bg-primary">Male</span>
                                }
                                else if (m.Member?.Gender == "Female")
                                {
                                    <span class="badge bg-info text-dark">Female</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">-</span>
                                }
                            </td>

                            <td>@m.PositionTitle</td>
                            <td>@m.StartDate.ToString("dd MMM yyyy")</td>

                            <!-- Status Badge -->
                            <td>
                                @if (m.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>

                            <!-- Actions -->
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <!-- View Details -->
                                    <a href="@Url.Action("Details", "GECMember", new { id = m.GECId })"
                                       class="btn btn-outline-info"
                                       title="View Details">
                                        <i class="fa fa-eye"></i>
                                    </a>

                                    <!-- Edit -->
                                    <button class="btn btn-outline-primary"
                                            title="Edit"
                                            onclick="editGECMember(@m.GECId)">
                                        <i class="fa fa-edit"></i>
                                    </button>

                                    <!-- Toggle Status -->
                                    @if (m.IsActive)
                                    {
                                        <button class="btn btn-outline-warning"
                                                title="Deactivate"
                                                onclick="toggleGECMemberStatus(@m.GECId, false)">
                                            <i class="fa fa-ban"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-outline-success"
                                                title="Activate"
                                                onclick="toggleGECMemberStatus(@m.GECId, true)">
                                            <i class="fa fa-check-circle"></i>
                                        </button>
                                    }

                                    <!-- Delete -->
                                    <button class="btn btn-outline-danger"
                                            title="Delete"
                                            onclick="deleteGECMember(@m.GECId)">
                                        <i class="fa fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>

                        count++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center text-muted py-4">No GEC Members Found</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
