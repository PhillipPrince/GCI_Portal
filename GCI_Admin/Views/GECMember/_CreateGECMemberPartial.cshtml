@model GCI_Admin.Models.DTOs.CreateGECMemberDto

@{
    var isEdit = ViewBag.IsEdit ?? false;
    var formId = isEdit ? "editMemberForm" : "createMemberForm";
    var action = isEdit ? "UpdateGECMember" : "CreateGECMember";
    var modalId = "memberModal";
}

<!-- Modal Body -->
<div class="modal-body">
    <form asp-action="@action" asp-controller="GECMember" method="post" id="@formId">
        @Html.AntiForgeryToken()

        @if (isEdit)
        {
            <input type="hidden" asp-for="GECMember.GECId" id="GECId" />
        }

        <!-- Member Selector Partial -->
        @await Html.PartialAsync("_MemberSelector", new GCI_Admin.Models.ViewModels.MemberSelectorViewModel
        {
            ControlId = "gecMemberSelector",
            LabelText = "Select GEC Member",
            MemberIdFieldName = "MemberId",
            SelectedMemberId = Model?.GECMember?.MemberId,
            Members = Model?.Members,
            IsRequired = true,
            IsEdit = isEdit,
            ShowPhoneAndGender = true
        })

        <hr />

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label fw-bold">Position *</label>
                <select asp-for="GECMember.PositionTitle" class="form-select" required>
                    <option value="">-- Select Position --</option>
                    <option value="Chairperson">Chairperson</option>
                    <option value="Vice Chairperson">Vice Chairperson</option>
                    <option value="Secretary">Secretary</option>
                    <option value="Treasurer">Treasurer</option>
                    <option value="Member" selected>Member</option>
                    <option value="Observer">Observer</option>
                </select>
                <span asp-validation-for="GECMember.PositionTitle" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label fw-bold">Bio</label>
                <textarea asp-for="GECMember.Bio" class="form-control" rows="3" maxlength="500" 
                          placeholder="Brief biography or qualifications"></textarea>
                <span asp-validation-for="GECMember.Bio" class="text-danger"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label fw-bold">Start Date <span class="text-danger">*</span></label>
                <input asp-for="GECMember.StartDate" type="date" class="form-control" required 
                       value="@(Model?.GECMember?.StartDate.ToString("yyyy-MM-dd") ?? DateTime.Today.ToString("yyyy-MM-dd"))">
                <span asp-validation-for="GECMember.StartDate" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label fw-bold">End Date</label>
                <input asp-for="GECMember.EndDate" type="date" class="form-control" 
                       value="@(Model?.GECMember?.EndDate?.ToString("yyyy-MM-dd"))">
                <span asp-validation-for="GECMember.EndDate" class="text-danger"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <div class="form-check form-switch mt-4">
                    <input asp-for="GECMember.IsActive" class="form-check-input" type="checkbox" 
                           checked="@(Model?.GECMember?.IsActive ?? true)">
                    <label class="form-check-label fw-bold" asp-for="GECMember.IsActive">Active Member</label>
                </div>
            </div>
        </div>
    </form>
</div>




<script>
    // Initialize modal and form handling
    $(document).ready(function() {
        // Ensure form validation
        $('#@formId').on('submit', function(e) {
            e.preventDefault();
            return false;
        });
    });

    // Function to show confirmation dialog before submission
    function confirmAndSubmit() {
        const isEdit = '@isEdit'.toLowerCase() === 'true';
        
        // Get all field values for the confirmation message
        const memberDisplayName = $('#gecMemberSelector_display').val();
        const positionTitle = $('select[name="GECMember.PositionTitle"] option:selected').text();
        const startDate = $('#GECMember_StartDate').val();
        const isActive = $('#GECMember_IsActive').is(':checked');
        
        // Format dates for display
        const formattedStartDate = startDate ? new Date(startDate).toLocaleDateString() : 'Not specified';
        
        // Build confirmation message
        let confirmationMessage = '';
        let confirmationTitle = '';
        
        if (isEdit) {
            confirmationTitle = 'Confirm Update';
            confirmationMessage = `
                <div style="text-align: left;">
                    <p>Are you sure you want to update this GEC member?</p>
                    <hr>
                    <p><strong>Member:</strong> ${memberDisplayName || 'Not selected'}</p>
                    <p><strong>Position:</strong> ${positionTitle}</p>
                    <p><strong>Start Date:</strong> ${formattedStartDate}</p>
                    <p><strong>Status:</strong> ${isActive ? 'Active' : 'Inactive'}</p>
                    <hr>
                    <p class="text-warning">This action will update the member's information in the system.</p>
                </div>
            `;
        } else {
            confirmationTitle = 'Confirm Creation';
            confirmationMessage = `
                <div style="text-align: left;">
                    <p>Are you sure you want to create a new GEC member?</p>
                    <hr>
                    <p><strong>Member:</strong> ${memberDisplayName || 'Not selected'}</p>
                    <p><strong>Position:</strong> ${positionTitle}</p>
                    <p><strong>Start Date:</strong> ${formattedStartDate}</p>
                    <p><strong>Status:</strong> ${isActive ? 'Active' : 'Inactive'}</p>
                    <hr>
                    <p class="text-info">Please review the information before confirming.</p>
                </div>
            `;
        }
        
        // Show SweetAlert confirmation
        Swal.fire({
            title: confirmationTitle,
            html: confirmationMessage,
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: isEdit ? 'Yes, update it!' : 'Yes, create it!',
            cancelButtonText: 'Cancel',
            showLoaderOnConfirm: true,
            preConfirm: async () => {
                try {
                    // Call the submit function
                    return await submitMemberForm();
                } catch (error) {
                    Swal.showValidationMessage(`Request failed: ${error}`);
                }
            },
            allowOutsideClick: () => !Swal.isLoading()
        }).then((result) => {
            if (result.isConfirmed) {
                // Success is handled in the submit function
                console.log('User confirmed the action');
            } else if (result.dismiss === Swal.DismissReason.cancel) {
                Swal.fire(
                    'Cancelled',
                    isEdit ? 'Member update was cancelled' : 'Member creation was cancelled',
                    'info'
                );
            }
        });
    }

    // Main submit function
    function submitMemberForm() {
        return new Promise((resolve, reject) => {
            // Get the correct form based on edit mode
            const isEdit = '@isEdit'.toLowerCase() === 'true';
            const formId = isEdit ? 'editMemberForm' : 'createMemberForm';
            const form = $('#' + formId);
            
            if (!form.length) {
                console.error('Form not found:', formId);
                reject('Form not found');
                Swal.fire('Error', 'Form not found', 'error');
                return;
            }

            // Get all field values
            const gecId = $('#GECId').val() || '0';
            const memberId = $('#gecMemberSelector_selectedId').val();
            const positionTitle = $('select[name="GECMember.PositionTitle"]').val();
            const bio = $('#GECMember_Bio').val();
            const startDate = $('#GECMember_StartDate').val();
            const endDate = $('#GECMember_EndDate').val();
            const isActive = $('#GECMember_IsActive').is(':checked');

            // Validate form
            if (!form[0].checkValidity()) {
                form[0].reportValidity();
                reject('Validation failed');
                Swal.fire('Validation Error', 'Please fill all required fields correctly', 'warning');
                return;
            }

            // Validate member is selected
            if (!memberId || memberId === '') {
                Swal.fire('Validation Error', 'Please select a member', 'warning');
                reject('Member not selected');
                return;
            }

            // Validate position is selected
            if (!positionTitle || positionTitle === '') {
                Swal.fire('Validation Error', 'Please select a position', 'warning');
                reject('Position not selected');
                return;
            }

            // Validate start date
            if (!startDate) {
                Swal.fire('Validation Error', 'Please select a start date', 'warning');
                reject('Start date not selected');
                return;
            }

            // Disable button and show loading
            const $saveBtn = $('#saveMemberBtn');
            const $loadingSpinner = $('#memberLoading');
            const $btnText = $('#saveBtnText');
            
            $saveBtn.prop('disabled', true);
            $loadingSpinner.removeClass('d-none');
            const originalText = $btnText.text();
            $btnText.text('Saving...');

            // Get anti-forgery token
            const token = $('input[name="__RequestVerificationToken"]', form).val();

            // Prepare form data
            const formData = new FormData();
            formData.append('__RequestVerificationToken', token);
            formData.append('GECId', gecId);
            formData.append('MemberId', memberId);
            formData.append('PositionTitle', positionTitle);
            formData.append('Bio', bio || '');
            formData.append('StartDate', startDate);
            formData.append('EndDate', endDate || '');
            formData.append('IsActive', isActive);

            // Log form data to console
            console.log("Submitting form data:");
            for (let pair of formData.entries()) {
                console.log(pair[0] + ': ' + pair[1]);
            }

            // Make AJAX request
            $.ajax({
                url: form.attr('action'),
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function(response) {
                    console.log("Response:", response);
                    
                    // Reset button state
                    $saveBtn.prop('disabled', false);
                    $loadingSpinner.addClass('d-none');
                    $btnText.text(originalText);

                    if (response.success) {
                        // Show success message
                        Swal.fire({
                            icon: 'success',
                            title: 'Success!',
                            text: response.message || `GEC member ${isEdit ? 'updated' : 'created'} successfully`,
                            showConfirmButton: false,
                            timer: 1500
                        }).then(() => {
                            // Close modal and reload
                            $('#memberModal').modal('hide');
                            location.reload();
                        });
                        resolve(response);
                    } else {
                        // Show error message
                        let errorMessage = response.message || 'Failed to save member.';
                        
                        // Handle validation errors
                        if (response.errors && response.errors.length > 0) {
                            errorMessage = response.errors.join('<br>');
                        }
                        
                        Swal.fire('Error', errorMessage, 'error');
                        reject(errorMessage);
                    }
                },
                error: function(xhr, status, error) {
                    // Reset button state
                    $saveBtn.prop('disabled', false);
                    $loadingSpinner.addClass('d-none');
                    $btnText.text(originalText);
                    
                    // Handle different error scenarios
                    let errorMessage = 'An unexpected error occurred.';
                    
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMessage = xhr.responseJSON.message;
                    } else if (xhr.status === 0) {
                        errorMessage = 'Network error. Please check your connection.';
                    } else if (xhr.status === 404) {
                        errorMessage = 'Service not found. Please contact support.';
                    } else if (xhr.status === 500) {
                        errorMessage = 'Server error. Please try again later.';
                    }
                    
                    console.error('Form submission error:', xhr, status, error);
                    Swal.fire('Error', errorMessage, 'error');
                    reject(errorMessage);
                }
            });
        });
    }

    // Optional: Handle Enter key in form inputs
    $(document).on('keypress', '#@formId input, #@formId select, #@formId textarea', function(e) {
        if (e.which === 13 && !$(this).is('textarea')) {
            e.preventDefault();
            confirmAndSubmit();
        }
    });

    // Listen for member selection to validate
    $(document).on('memberSelected', function(e, data) {
        console.log('Member selected:', data);
        // Clear any previous member validation errors
        $('#gecMemberSelector_validation').text('');
    });
</script>