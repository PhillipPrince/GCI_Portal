@model GCI_Admin.Models.DTOs.CreateGECMemberDto

@{
    var isEdit = ViewBag.IsEdit ?? false;
    var formId = isEdit ? "editMemberForm" : "createMemberForm";
    var action = isEdit ? "UpdateGECMember" : "CreateGECMember";
    var modalId = "memberModal";
}

<!-- Modal Body -->
<div class="modal-body">
    <form asp-action="@action" asp-controller="GECMember" method="post" id="@formId">
        @Html.AntiForgeryToken()

        @if (isEdit)
        {
            <input type="hidden" asp-for="GECMember.GECId" id="GECId" />
        }

        <!-- Member Selector Partial -->
        @await Html.PartialAsync("_MemberSelector", new GCI_Admin.Models.ViewModels.MemberSelectorViewModel
        {
            ControlId = "gecMemberSelector",
            LabelText = "Select GEC Member",
            MemberIdFieldName = "MemberId",
            SelectedMemberId = Model?.GECMember?.MemberId,
            Members = Model?.Members,
            IsRequired = true,
            IsEdit = isEdit,
            ShowPhoneAndGender = true,
            DataUrl = "/Finance/GetActiveMembers"
        })

        <!-- Profile Image Picker -->
        <div class="row mt-3">
            <div class="col-12">
                @await Html.PartialAsync("_ImagePicker", new GCI_Admin.Models.ImagePickerViewModel
                {
                    ControlId = "gecProfileImage",
                    LabelText = "Profile Image",
                    IconClass = "fa fa-user-circle-o",
                    HelpText = "Upload a profile image for the growth center leader. Recommended size: 400x400 pixels. Max size: 5MB",
                    UploadButtonText = "Choose Image",
                    CurrentImageUrl = ViewBag.CurrentImageUrl,
                    PreviewWidth = 150,
                    PreviewHeight = 150,
                    MaxFileSizeMB = 5,
                    IsRequired = false,
                    Rounded = true,
                    FileInputName = "ProfileImage",
                    ImageUrlFieldName = "ProfileImageUrl",
                    Base64FieldName = "ProfileImageBase64"
                })
            </div>
        </div>

        <hr />

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label fw-bold">Title Prefix <span class="text-danger">*</span></label>
                <select asp-for="GECMember.TitlePrefixId" class="form-select" required>
                    <option value="">-- Select Title Prefix --</option>
                    @if (Model?.TitlePrefixes != null)
                    {
                        foreach (var prefix in Model.TitlePrefixes)
                        {
                            <option value="@prefix.Id">@prefix.Title</option>
                        }
                    }
                </select>
                <span asp-validation-for="GECMember.TitlePrefixId" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label fw-bold">Position *</label>
                <select asp-for="GECMember.GECPositionId" class="form-select" required>
                    <option value="">-- Select Position --</option>
                    @if (Model?.Positions != null)
                    {
                        foreach (var position in Model.Positions)
                        {
                            <option value="@position.Id">@position.Title</option>
                        }
                    }
                </select>
                <span asp-validation-for="GECMember.GECPositionId" class="text-danger"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label fw-bold">Start Date <span class="text-danger">*</span></label>
                <input asp-for="GECMember.StartDate" type="date" class="form-control" required 
                       value="@(Model?.GECMember?.StartDate.ToString("yyyy-MM-dd") ?? DateTime.Today.ToString("yyyy-MM-dd"))">
                <span asp-validation-for="GECMember.StartDate" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label fw-bold">End Date</label>
                <input asp-for="GECMember.EndDate" type="date" class="form-control" 
                       value="@(Model?.GECMember?.EndDate?.ToString("yyyy-MM-dd"))">
                <span asp-validation-for="GECMember.EndDate" class="text-danger"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <div class="form-check form-switch mt-4">
                    <input asp-for="GECMember.IsActive" class="form-check-input" type="checkbox" 
                           checked="@(Model?.GECMember?.IsActive ?? true)">
                    <label class="form-check-label fw-bold" asp-for="GECMember.IsActive">Active Member</label>
                </div>
            </div>
        </div>
    </form>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    // Initialize modal and form handling
    $(document).ready(function() {
        // Ensure form validation
        $('#@formId').on('submit', function(e) {
            e.preventDefault();
            return false;
        });

        // Initialize member selector if needed
        if (typeof initializeCustomDropdown === 'function') {
            initializeCustomDropdown('gecMemberSelector');
        }
    });

    // Function to show confirmation dialog before submission
    function confirmAndSubmit() {
        const isEdit = '@isEdit'.toLowerCase() === 'true';
        
        // Get all field values for the confirmation message
        const memberDisplayName = $('#gecMemberSelector_display').val();
        const titlePrefixText = $('select[name="GECMember.TitlePrefixId"] option:selected').text();
        const positionTitle = $('select[name="GECMember.GECPositionId"] option:selected').text();
        const startDate = $('#GECMember_StartDate').val();
        const isActive = $('#GECMember_IsActive').is(':checked');
        const hasImage = $('#gecProfileImage_fileData').val() ? 'Yes' : 'No';
        
        // Format dates for display
        const formattedStartDate = startDate ? new Date(startDate).toLocaleDateString() : 'Not specified';
        
        // Build confirmation message
        let confirmationMessage = '';
        let confirmationTitle = '';
        
        if (isEdit) {
            confirmationTitle = 'Confirm Update';
            confirmationMessage = `
                <div style="text-align: left;">
                    <p>Are you sure you want to update this GEC member?</p>
                    <hr>
                    <p><strong>Member:</strong> ${memberDisplayName || 'Not selected'}</p>
                    <p><strong>Title Prefix:</strong> ${titlePrefixText}</p>
                    <p><strong>Position:</strong> ${positionTitle}</p>
                    <p><strong>Start Date:</strong> ${formattedStartDate}</p>
                    <p><strong>Status:</strong> ${isActive ? 'Active' : 'Inactive'}</p>
                    <p><strong>Profile Image:</strong> ${hasImage}</p>
                    <hr>
                    <p class="text-warning">This action will update the member's information in the system.</p>
                </div>
            `;
        } else {
            confirmationTitle = 'Confirm Creation';
            confirmationMessage = `
                <div style="text-align: left;">
                    <p>Are you sure you want to create a new GEC member?</p>
                    <hr>
                    <p><strong>Member:</strong> ${memberDisplayName || 'Not selected'}</p>
                    <p><strong>Title Prefix:</strong> ${titlePrefixText}</p>
                    <p><strong>Position:</strong> ${positionTitle}</p>
                    <p><strong>Start Date:</strong> ${formattedStartDate}</p>
                    <p><strong>Status:</strong> ${isActive ? 'Active' : 'Inactive'}</p>
                    <p><strong>Profile Image:</strong> ${hasImage}</p>
                    <hr>
                    <p class="text-info">Please review the information before confirming.</p>
                </div>
            `;
        }
        
        // Show SweetAlert confirmation
        Swal.fire({
            title: confirmationTitle,
            html: confirmationMessage,
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: isEdit ? 'Yes, update it!' : 'Yes, create it!',
            cancelButtonText: 'Cancel',
            showLoaderOnConfirm: true,
            preConfirm: async () => {
                try {
                    // Call the submit function
                    return await submitMemberForm();
                } catch (error) {
                    Swal.showValidationMessage(`Request failed: ${error}`);
                }
            },
            allowOutsideClick: () => !Swal.isLoading()
        }).then((result) => {
            if (result.isConfirmed) {
                // Success is handled in the submit function
                console.log('User confirmed the action');
            } else if (result.dismiss === Swal.DismissReason.cancel) {
                Swal.fire(
                    'Cancelled',
                    isEdit ? 'Member update was cancelled' : 'Member creation was cancelled',
                    'info'
                );
            }
        });
    }

    // Main submit function with image Base64 support
    function submitMemberForm() {
        return new Promise((resolve, reject) => {
            // Get the correct form based on edit mode
            const isEdit = '@isEdit'.toLowerCase() === 'true';
            const formId = isEdit ? 'editMemberForm' : 'createMemberForm';
            const form = $('#' + formId);
            
            if (!form.length) {
                console.error('Form not found:', formId);
                reject('Form not found');
                Swal.fire('Error', 'Form not found', 'error');
                return;
            }

            // Get all field values
            const gecId = $('#GECId').val() || '0';
            const memberId = $('#gecMemberSelector_selectedId').val();
            const titlePrefixId = $('select[name="GECMember.TitlePrefixId"]').val();
            const gecPositionId = $('select[name="GECMember.GECPositionId"]').val();
            const bio = $('#GECMember_Bio').val();
            const startDate = $('#GECMember_StartDate').val();
            const endDate = $('#GECMember_EndDate').val();
            const isActive = $('#GECMember_IsActive').is(':checked');
            
            // Get image Base64 data from the image picker
            let profileImageBase64 = $('#gecProfileImage_fileData').val();
            
            // If no image was uploaded, set to null
            if (!profileImageBase64 || profileImageBase64 === '') {
                profileImageBase64 = null;
            }

            // Validate form
            if (!form[0].checkValidity()) {
                form[0].reportValidity();
                reject('Validation failed');
                Swal.fire('Validation Error', 'Please fill all required fields correctly', 'warning');
                return;
            }

            // Validate member is selected
            if (!memberId || memberId === '') {
                Swal.fire('Validation Error', 'Please select a member', 'warning');
                reject('Member not selected');
                return;
            }

            // Validate title prefix is selected
            if (!titlePrefixId || titlePrefixId === '') {
                Swal.fire('Validation Error', 'Please select a title prefix', 'warning');
                reject('Title prefix not selected');
                return;
            }

            // Validate position is selected
            if (!gecPositionId || gecPositionId === '') {
                Swal.fire('Validation Error', 'Please select a position', 'warning');
                reject('Position not selected');
                return;
            }

            // Validate start date
            if (!startDate) {
                Swal.fire('Validation Error', 'Please select a start date', 'warning');
                reject('Start date not selected');
                return;
            }

            // Disable button and show loading
            const $saveBtn = $('#saveMemberBtn');
            const $loadingSpinner = $('#memberLoading');
            const $btnText = $('#saveBtnText');
            
            $saveBtn.prop('disabled', true);
            $loadingSpinner.removeClass('d-none');
            const originalText = $btnText.text();
            $btnText.text('Saving...');

            // Get anti-forgery token
            const token = $('input[name="__RequestVerificationToken"]', form).val();

            // Prepare JSON data (using JSON instead of FormData for Base64 support)
            const requestData = {
                GECId: parseInt(gecId) || 0,
                MemberId: parseInt(memberId),
                TitlePrefixId: parseInt(titlePrefixId),
                GECPositionId: parseInt(gecPositionId),
                Bio: bio || '',
                StartDate: startDate,
                EndDate: endDate || null,
                IsActive: isActive,
                ProfileImageBase64: profileImageBase64
            };

            console.log("Submitting GEC member form with Base64 image:");
            console.log("URL:", form.attr('action'));
            console.log("Is Edit:", isEdit);
            console.log("Has Image:", !!profileImageBase64);
            if (profileImageBase64) {
                console.log("Image Base64 Length:", profileImageBase64.length);
                console.log("Image Base64 Preview:", profileImageBase64.substring(0, 100) + "...");
            }
            console.log("Request Data:", {
                ...requestData,
                ProfileImageBase64: profileImageBase64 ? '[Base64 String]' : null
            });

            // Make AJAX request with JSON content type
            $.ajax({
                url: form.attr('action'),
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(requestData),
                timeout: 30000, // 30 second timeout for image upload
                headers: {
                    'RequestVerificationToken': token
                },
                success: function(response) {
                    console.log("Response:", response);
                    
                    // Reset button state
                    $saveBtn.prop('disabled', false);
                    $loadingSpinner.addClass('d-none');
                    $btnText.text(originalText);

                    if (response.success) {
                        // Show success message
                        Swal.fire({
                            icon: 'success',
                            title: 'Success!',
                            text: response.message || `GEC member ${isEdit ? 'updated' : 'created'} successfully`,
                            showConfirmButton: false,
                            timer: 1500
                        }).then(() => {
                            // Close modal and reload
                            $('#memberModal').modal('hide');
                            location.reload();
                        });
                        resolve(response);
                    } else {
                        // Show error message
                        let errorMessage = response.message || 'Failed to save member.';
                        
                        // Handle validation errors
                        if (response.errors && response.errors.length > 0) {
                            errorMessage = response.errors.join('<br>');
                        }
                        
                        Swal.fire('Error', errorMessage, 'error');
                        reject(errorMessage);
                    }
                },
                error: function(xhr, status, error) {
                    // Reset button state
                    $saveBtn.prop('disabled', false);
                    $loadingSpinner.addClass('d-none');
                    $btnText.text(originalText);
                    
                    // Handle different error scenarios
                    let errorMessage = 'An unexpected error occurred.';
                    
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMessage = xhr.responseJSON.message;
                    } else if (xhr.status === 400) {
                        errorMessage = 'Invalid data sent to server. Please check the image size and format.';
                    } else if (xhr.status === 413) {
                        errorMessage = 'Image file is too large. Please use an image under 5MB.';
                    } else if (xhr.status === 0) {
                        errorMessage = 'Network error. Please check your connection.';
                    } else if (xhr.status === 404) {
                        errorMessage = 'Service not found. Please contact support.';
                    } else if (xhr.status === 500) {
                        errorMessage = 'Server error. Please try again later.';
                    }
                    
                    console.error('Form submission error:', xhr, status, error);
                    Swal.fire('Error', errorMessage, 'error');
                    reject(errorMessage);
                }
            });
        });
    }

    // Optional: Handle Enter key in form inputs
    $(document).on('keypress', '#@formId input, #@formId select, #@formId textarea', function(e) {
        if (e.which === 13 && !$(this).is('textarea')) {
            e.preventDefault();
            confirmAndSubmit();
        }
    });

    // Listen for member selection to validate
    $(document).on('memberSelected', function(e, data) {
        console.log('Member selected:', data);
        // Clear any previous member validation errors
        $('#gecMemberSelector_validation').text('');
    });

    // Listen for image selection events
    $(document).on('imageSelected', function(e, data) {
        console.log('Image selected for GEC member:', data.controlId);
        // You can add additional validation or preview logic here
    });

    $(document).on('imageCleared', function(e, data) {
        console.log('Image cleared for GEC member:', data.controlId);
    });

    // Reset form when modal is closed
    $('#memberModal').on('hidden.bs.modal', function() {
        // Clear member selector
        $('#gecMemberSelector_display').val('');
        $('#gecMemberSelector_selectedId').val('');
        
        // Clear image picker
        if (typeof clearImage === 'function') {
            const controlId = 'gecProfileImage';
            const fileInput = $('#' + controlId + '_fileInput');
            if (fileInput.length) {
                fileInput.val('');
                $('#' + controlId + '_preview').attr('src', '/images/default-avatar.png');
                $('#' + controlId + '_fileData').val('');
                $('#' + controlId + '_url').val('');
                $('#' + controlId + '_clearBtn').hide();
                if (typeof clearImageError === 'function') {
                    clearImageError(controlId);
                }
            }
        }
        
        // Reset other fields (but keep default values)
        $('select[name="GECMember.TitlePrefixId"]').val('');
        $('select[name="GECMember.GECPositionId"]').val('');
        $('#GECMember_Bio').val('');
        $('#GECMember_StartDate').val(new Date().toISOString().split('T')[0]);
        $('#GECMember_EndDate').val('');
        $('#GECMember_IsActive').prop('checked', true);
        
        // Hide dropdowns and clear validation
        $('.dropdown-list').hide();
        $('#gecMemberSelector_validation').text('');
    });
</script>
