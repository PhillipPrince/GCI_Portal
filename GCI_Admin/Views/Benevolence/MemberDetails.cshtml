@model GCI_Admin.Models.BenevolenceDetails

@{
    ViewData["Title"] = "Benevolence Member Details";
    var member = Model.Member;
}

<!-- Page Header with Back Button -->
<div class="row mb-4">
    <div class="col-md-8">
        <div class="d-flex align-items-center">
            <a href="@Url.Action("Index", "Benevolence")" class="btn btn-outline-secondary me-3">
                <i class="fa fa-arrow-left me-2"></i>Back to List
            </a>
            <div>
                <h2 class="fw-bold mb-1">Benevolence Member Details</h2>
                <p class="text-muted mb-0">View and edit member information and beneficiaries</p>
            </div>
        </div>
    </div>
    <div class="col-md-4 text-end">
        <div id="editModeButtons">
            <button class="btn btn-warning btn-lg me-2" id="enableEditMode">
                <i class="fa fa-edit me-2"></i>Edit Mode
            </button>
            <a href="@Url.Action("AddBeneficiary", "Benevolence", new { memberId = member.Id })" class="btn btn-primary btn-lg">
                <i class="fa fa-plus-circle me-2"></i>Add Beneficiary
            </a>
        </div>
        <div id="saveCancelButtons" style="display: none;">
            <button class="btn btn-success btn-lg me-2" id="saveChanges">
                <i class="fa fa-save me-2"></i>Save Changes
            </button>
            <button class="btn btn-secondary btn-lg" id="cancelEdit">
                <i class="fa fa-times me-2"></i>Cancel
            </button>
        </div>
    </div>
</div>

<!-- Member Details Card -->
<div class="row">
    <div class="col-md-12">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="fa fa-user-circle me-2 text-primary"></i>Member Information
                </h5>
                <div>
                    <span class="display-value" data-field="isActive">
                        @if (member.IsActive)
                        {
                            <span class="badge bg-success fs-6 p-2">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-danger fs-6 p-2">Inactive</span>
                        }
                    </span>
                    <select class="form-select edit-field" data-field="isActive" style="display: none; width: auto; display: inline-block;">
                        <option value="true" selected="@(member.IsActive)">Active</option>
                        <option value="false" selected="@(!member.IsActive)">Inactive</option>
                    </select>
                </div>
            </div>
            <div class="card-body">
                <div class="row">
                    <!-- Personal Information Section -->
                    <div class="col-md-6">
                        <div class="info-section mb-4">
                            <h6 class="text-primary mb-3"><i class="fa fa-user me-2"></i>Personal Details</h6>
                            <table class="table table-borderless">
                                <tr>
                                    <td class="text-muted" style="width: 40%">Full Name:</td>
                                    <td class="fw-bold">
                                        <span class="display-value" data-field="fullName">@(member.Member != null ? $"{member.Member.FirstName} {member.Member.OtherNames}" : "-")</span>
                                        <input type="text" class="form-control edit-field" data-field="fullName" style="display: none;" value="@(member.Member != null ? $"{member.Member.FirstName} {member.Member.OtherNames}" : "")">
                                    </td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Phone Number:</td>
                                    <td class="fw-bold">
                                        <span class="display-value" data-field="phone">@(member.Member?.Phone ?? "-")</span>
                                        <input type="tel" class="form-control edit-field" data-field="phone" style="display: none;" value="@(member.Member?.Phone ?? "")">
                                    </td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Email Address:</td>
                                    <td class="fw-bold">
                                        <span class="display-value" data-field="email">@(member.Member?.Email ?? "-")</span>
                                        <input type="email" class="form-control edit-field" data-field="email" style="display: none;" value="@(member.Member?.Email ?? "")">
                                    </td>
                                </tr>
                                <tr>
                                    <td class="text-muted">National ID:</td>
                                    <td class="fw-bold">
                                        <span class="display-value" data-field="nationalId">@member.NationalId</span>
                                        <input type="text" class="form-control edit-field" data-field="nationalId" style="display: none;" value="@member.NationalId">
                                    </td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Registration No:</td>
                                    <td class="fw-bold">
                                        <span class="display-value" data-field="regNo">@member.RegNo</span>
                                        <input type="text" class="form-control edit-field" data-field="regNo" style="display: none;" value="@member.RegNo">
                                    </td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Member ID:</td>
                                    <td class="fw-bold">@member.Id</td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    <!-- Financial Information Section -->
                    <div class="col-md-6">
                        <div class="info-section mb-4">
                            <h6 class="text-success mb-3"><i class="fa fa-credit-card me-2"></i>Financial Details</h6>
                            <table class="table table-borderless">
                                <tr>
                                    <td class="text-muted" style="width: 40%">Preferred Cover Amount:</td>
                                    <td class="fw-bold">
                                        <span class="display-value" data-field="preferredCoverAmount">Ksh @member.PreferredCoverAmount.ToString("N2")</span>
                                        <input type="number" step="0.01" class="form-control edit-field" data-field="preferredCoverAmount" style="display: none;" value="@member.PreferredCoverAmount">
                                    </td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Total Amount Due:</td>
                                    <td class="fw-bold">
                                        <span class="display-value" data-field="totalAmountDue">Ksh @member.TotalAmountDue.ToString("N2")</span>
                                        <input type="number" step="0.01" class="form-control edit-field" data-field="totalAmountDue" style="display: none;" value="@member.TotalAmountDue">
                                    </td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Amount Paid:</td>
                                    <td class="fw-bold">
                                        <span class="display-value" data-field="amountPaid">Ksh @member.AmountPaid.ToString("N2")</span>
                                        <input type="number" step="0.01" class="form-control edit-field" data-field="amountPaid" style="display: none;" value="@member.AmountPaid">
                                    </td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Balance Amount:</td>
                                    <td class="fw-bold">
                                        <span class="display-value" data-field="balanceAmount">
                                            <span class="@(member.BalanceAmount > 0 ? "text-danger" : "text-success")">
                                                Ksh @member.BalanceAmount.ToString("N2")
                                            </span>
                                        </span>
                                        <input type="number" step="0.01" class="form-control edit-field" data-field="balanceAmount" style="display: none;" value="@member.BalanceAmount">
                                    </td>
                                </tr>
                            </table>

                            <!-- Payment Progress Bar -->
                            @{
                                var paymentPercentage = member.TotalAmountDue > 0
                                ? (member.AmountPaid / member.TotalAmountDue) * 100
                                : 0;
                            }
                            <div class="mt-3">
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="text-muted small">Payment Progress</span>
                                    <span class="text-muted small" id="paymentPercentage">@paymentPercentage.ToString("F0")%</span>
                                </div>
                                <div class="progress" style="height: 10px;">
                                    <div class="progress-bar bg-success" role="progressbar"
                                         id="paymentProgressBar"
                                         style="width: @paymentPercentage%"
                                         aria-valuenow="@paymentPercentage"
                                         aria-valuemin="0"
                                         aria-valuemax="100">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Next of Kin Information Section -->
                    <div class="col-md-6">
                        <div class="info-section mb-4">
                            <h6 class="text-info mb-3"><i class="fa fa-users me-2"></i>Next of Kin Details</h6>
                            <table class="table table-borderless">
                                <tr>
                                    <td class="text-muted" style="width: 40%">Next of Kin Name:</td>
                                    <td class="fw-bold">
                                        <span class="display-value" data-field="nextOfKinName">@member.NextOfKinName</span>
                                        <input type="text" class="form-control edit-field" data-field="nextOfKinName" style="display: none;" value="@member.NextOfKinName">
                                    </td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Next of Kin Phone:</td>
                                    <td class="fw-bold">
                                        <span class="display-value" data-field="nextOfKinPhone">@member.NextOfKinPhone</span>
                                        <input type="tel" class="form-control edit-field" data-field="nextOfKinPhone" style="display: none;" value="@member.NextOfKinPhone">
                                    </td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Number of Dependants:</td>
                                    <td class="fw-bold">
                                        <span class="display-value" data-field="numberOfDependants">
                                            <span class="badge bg-info">@member.NumberOfDependants</span>
                                        </span>
                                        <input type="number" class="form-control edit-field" data-field="numberOfDependants" style="display: none;" value="@member.NumberOfDependants" min="0">
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    <!-- System Information Section -->
                    <div class="col-md-6">
                        <div class="info-section mb-4">
                            <h6 class="text-secondary mb-3"><i class="fa fa-clock-o me-2"></i>System Information</h6>
                            <table class="table table-borderless">
                                <tr>
                                    <td class="text-muted" style="width: 40%">Created At:</td>
                                    <td class="fw-bold">@member.CreatedAt.ToString("dd MMM yyyy HH:mm")</td>
                                </tr>
                                @if (member.UpdatedAt.HasValue)
                                {
                                    <tr>
                                        <td class="text-muted">Last Updated:</td>
                                        <td class="fw-bold">@member.UpdatedAt.Value.ToString("dd MMM yyyy HH:mm")</td>
                                    </tr>
                                }
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Beneficiaries Section -->
<div class="row">
    <div class="col-md-12">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="fa fa-users me-2 text-primary"></i>Beneficiaries
                    <span class="badge bg-primary ms-2">@Model.TotalBeneficiaries</span>
                </h5>
                <div>
                    <button class="btn btn-sm btn-outline-success me-2" onclick="downloadBeneficiariesTemplate()">
                        <i class="fa fa-download me-1"></i>Download Template
                    </button>
                    <button class="btn btn-sm btn-outline-primary" onclick="showBeneficiaryUploadModal()">
                        <i class="fa fa-upload me-1"></i>Upload Beneficiaries
                    </button>
                </div>
            </div>
            <div class="card-body">
                @if (Model.Beneficiaries != null && Model.Beneficiaries.Any())
                {
                    @await Html.PartialAsync("_BeneficiariesTable", Model.Beneficiaries)
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="fa fa-users fa-4x text-muted mb-3"></i>
                        <h5 class="text-muted">No Beneficiaries Found</h5>
                        <p class="text-muted mb-3">This member hasn't added any beneficiaries yet</p>
                        <a href="@Url.Action("AddBeneficiary", "Benevolence", new { memberId = member.Id })" class="btn btn-primary">
                            <i class="fa fa-plus-circle me-2"></i>Add First Beneficiary
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Beneficiary Upload Modal -->
<div class="modal fade" id="beneficiaryUploadModal" tabindex="-1" aria-labelledby="beneficiaryUploadModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="beneficiaryUploadModalLabel">
                    <i class="fa fa-upload me-2"></i>Upload Beneficiaries for @(member.Member != null ? $"{member.Member.FirstName} {member.Member.OtherNames}" : "Member")
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info">
                    <i class="fa fa-info-circle me-2"></i>
                    Upload Excel file with beneficiary information. The file should have the following columns:
                    FullName, DateOfBirth, NationalId, Gender, Relationship.
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Upload Options</label>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="beneficiaryUploadOption" id="appendBeneficiaries" value="append" checked>
                        <label class="form-check-label" for="appendBeneficiaries">
                            Append to existing beneficiaries
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="beneficiaryUploadOption" id="replaceBeneficiaries" value="replace">
                        <label class="form-check-label" for="replaceBeneficiaries">
                            Replace all beneficiaries
                        </label>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Choose File</label>
                    <input type="file" class="form-control" id="beneficiaryExcelFile" accept=".xlsx,.xls,.csv">
                </div>

                <div class="progress mb-3" style="display: none;" id="beneficiaryUploadProgress">
                    <div class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" style="width: 0%">0%</div>
                </div>

                <div id="beneficiaryUploadPreview" class="mb-3" style="display: none;">
                    <h6>Preview:</h6>
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered">
                            <thead id="beneficiaryPreviewHeader"></thead>
                            <tbody id="beneficiaryPreviewBody"></tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="uploadBeneficiaries(@member.Id)" id="uploadBeneficiariesBtn">
                    <i class="fa fa-upload me-1"></i>Upload
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- SheetJS for Excel handling -->
    <script src="https://cdn.sheetjs.com/xlsx-0.20.1/package/dist/xlsx.full.min.js"></script>

    <!-- SweetAlert2 for better confirmations -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        let isEditMode = false;
        let originalData = {};

        $(document).ready(function() {
            initializeBeneficiariesTable();
            storeOriginalData();

            // Enable edit mode
            $('#enableEditMode').click(function() {
                enableEditMode();
            });

            // Save changes
            $('#saveChanges').click(function() {
                saveChanges();
            });

            // Cancel edit
            $('#cancelEdit').click(function() {
                cancelEdit();
            });
        });

        function storeOriginalData() {
            $('.display-value').each(function() {
                const field = $(this).data('field');
                originalData[field] = $(this).text().trim();
            });
        }

        function enableEditMode() {
            isEditMode = true;

            // Hide display values, show edit fields
            $('.display-value').hide();
            $('.edit-field').show();

            // Toggle buttons
            $('#editModeButtons').hide();
            $('#saveCancelButtons').show();

            // Show SweetAlert notification
            Swal.fire({
                icon: 'info',
                title: 'Edit Mode Enabled',
                text: 'You can now edit benevolence member information. Click Save when done.',
                timer: 2000,
                showConfirmButton: false
            });
        }

        function saveChanges() {
            // Collect all edited data
            const benevolenceData = {
                Id: @member.Id,
                MemberId: @(member.Member?.Id ),
                NationalId: '',
                RegNo: '',
                PreferredCoverAmount: 0,
                TotalAmountDue: 0,
                AmountPaid: 0,
                BalanceAmount: 0,
                NextOfKinName: '',
                NextOfKinPhone: '',
                NumberOfDependants: 0,
                IsActive: true,
                Member: {
                    Id: @(member.Member?.Id ),
                    FirstName: '',
                    OtherNames: '',
                    Phone: '',
                    Email: ''
                }
            };

            // Get values from edit fields
            const fullName = $('[data-field="fullName"] input').val();
            if (fullName && fullName !== '-') {
                const nameParts = fullName.trim().split(' ');
                benevolenceData.Member.FirstName = nameParts[0];
                benevolenceData.Member.OtherNames = nameParts.slice(1).join(' ');
            }

            benevolenceData.Member.Phone = $('[data-field="phone"] input').val();
            benevolenceData.Member.Email = $('[data-field="email"] input').val();
            benevolenceData.NationalId = $('[data-field="nationalId"] input').val();
            benevolenceData.RegNo = $('[data-field="regNo"] input').val();
            benevolenceData.PreferredCoverAmount = parseFloat($('[data-field="preferredCoverAmount"] input').val()) || 0;
            benevolenceData.TotalAmountDue = parseFloat($('[data-field="totalAmountDue"] input').val()) || 0;
            benevolenceData.AmountPaid = parseFloat($('[data-field="amountPaid"] input').val()) || 0;
            benevolenceData.BalanceAmount = parseFloat($('[data-field="balanceAmount"] input').val()) || 0;
            benevolenceData.NextOfKinName = $('[data-field="nextOfKinName"] input').val();
            benevolenceData.NextOfKinPhone = $('[data-field="nextOfKinPhone"] input').val();
            benevolenceData.NumberOfDependants = parseInt($('[data-field="numberOfDependants"] input').val()) || 0;
            benevolenceData.IsActive = $('[data-field="isActive"] select').val() === 'true';

            // Validate required fields
            if (!benevolenceData.Member.FirstName || !benevolenceData.Member.Phone || !benevolenceData.NationalId) {
                Swal.fire('Validation Error', 'Full Name, Phone, and National ID are required fields.', 'error');
                return;
            }

            // Show loading state
            Swal.fire({
                title: 'Saving Changes...',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            // Send update request
            $.ajax({
                url: '/Benevolence/UpdateBenevolenceMember',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(benevolenceData),
                success: function(response) {
                    if (response.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Success',
                            text: 'Benevolence member information updated successfully.',
                            timer: 1500,
                            showConfirmButton: false
                        }).then(() => {
                            location.reload();
                        });
                    } else {
                        Swal.fire('Error', response.message || 'Failed to update benevolence member.', 'error');
                    }
                },
                error: function(xhr) {
                    let errorMessage = 'An error occurred while updating the benevolence member.';
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMessage = xhr.responseJSON.message;
                    }
                    Swal.fire('Error', errorMessage, 'error');
                }
            });
        }

        function cancelEdit() {
            // Restore original data
            $('.display-value').each(function() {
                const field = $(this).data('field');
                if (originalData[field]) {
                    $(this).html(originalData[field]);
                }
            });

            // Hide edit fields, show display values
            $('.edit-field').hide();
            $('.display-value').show();

            // Toggle buttons
            $('#editModeButtons').show();
            $('#saveCancelButtons').hide();

            isEditMode = false;

            Swal.fire({
                icon: 'info',
                title: 'Edit Cancelled',
                text: 'No changes were saved.',
                timer: 1500,
                showConfirmButton: false
            });
        }

        // Update payment progress when amount paid or total due changes
        function updatePaymentProgress() {
            const amountPaid = parseFloat($('[data-field="amountPaid"] input').val()) || 0;
            const totalDue = parseFloat($('[data-field="totalAmountDue"] input').val()) || 0;

            let percentage = 0;
            if (totalDue > 0) {
                percentage = (amountPaid / totalDue) * 100;
            }

            $('#paymentPercentage').text(Math.round(percentage) + '%');
            $('#paymentProgressBar').css('width', percentage + '%');
            $('#paymentProgressBar').attr('aria-valuenow', percentage);
        }

        // Listen for changes in amount paid and total due
        $(document).on('input', '[data-field="amountPaid"] input, [data-field="totalAmountDue"] input', function() {
            updatePaymentProgress();
        });

        // Initialize beneficiaries DataTable
        function initializeBeneficiariesTable() {
            if ($.fn.DataTable.isDataTable('#beneficiariesTable')) {
                $('#beneficiariesTable').DataTable().destroy();
            }

            $('#beneficiariesTable').DataTable({
                pageLength: 10,
                language: {
                    search: "Search beneficiaries:",
                    lengthMenu: "Show _MENU_ beneficiaries",
                    info: "Showing _START_ to _END_ of _TOTAL_ beneficiaries",
                    emptyTable: "No beneficiaries available",
                    zeroRecords: "No matching beneficiaries found"
                },
                columnDefs: [
                    {
                        targets: -1,
                        orderable: false,
                        searchable: false
                    }
                ]
            });
        }

        // Download beneficiaries template
        function downloadBeneficiariesTemplate() {
            const template = [
                {
                    'FullName': 'Jane Doe',
                    'DateOfBirth': '2015-03-15',
                    'NationalId': 'CHILD-123456',
                    'Gender': 'Female',
                    'Relationship': 'Child'
                },
                {
                    'FullName': 'John Smith',
                    'DateOfBirth': '1980-06-20',
                    'NationalId': 'SPOUSE-789012',
                    'Gender': 'Male',
                    'Relationship': 'Spouse'
                }
            ];

            const wb = XLSX.utils.book_new();
            const ws = XLSX.utils.json_to_sheet(template);

            // Set column widths
            ws['!cols'] = [
                { wch: 30 }, // FullName
                { wch: 15 }, // DateOfBirth
                { wch: 20 }, // NationalId
                { wch: 10 }, // Gender
                { wch: 15 }  // Relationship
            ];

            // Instructions sheet
            const instructions = [
                { 'Field': 'FullName', 'Required': 'Yes', 'Description': 'Beneficiary full name', 'Example': 'Jane Doe' },
                { 'Field': 'DateOfBirth', 'Required': 'Yes', 'Description': 'Format: YYYY-MM-DD', 'Example': '2015-03-15' },
                { 'Field': 'NationalId', 'Required': 'Yes', 'Description': 'National ID or birth certificate number', 'Example': 'CHILD-123456' },
                { 'Field': 'Gender', 'Required': 'Yes', 'Description': 'Male / Female / Other', 'Example': 'Female' },
                { 'Field': 'Relationship', 'Required': 'Yes', 'Description': 'Spouse / Child / Parent / Sibling / Other', 'Example': 'Child' }
            ];

            const wsInstructions = XLSX.utils.json_to_sheet(instructions);
            wsInstructions['!cols'] = [{ wch: 18 }, { wch: 12 }, { wch: 60 }, { wch: 25 }];

            XLSX.utils.book_append_sheet(wb, ws, 'Beneficiaries');
            XLSX.utils.book_append_sheet(wb, wsInstructions, 'Instructions');

            XLSX.writeFile(wb, 'Beneficiaries_Template.xlsx');

            Swal.fire({
                icon: 'success',
                title: 'Template Downloaded',
                text: 'Beneficiaries Excel template downloaded successfully.',
                timer: 2000,
                showConfirmButton: false
            });
        }

        // Show beneficiary upload modal
        function showBeneficiaryUploadModal() {
            $('#beneficiaryUploadModal').modal('show');

            // Reset form
            $('#beneficiaryExcelFile').val('');
            $('#beneficiaryUploadPreview').hide();
            $('#beneficiaryUploadProgress').hide();
        }

        // Handle file selection for beneficiaries
        $('#beneficiaryExcelFile').on('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                previewBeneficiaryExcelFile(file);
            }
        });

        // Preview beneficiary Excel file
        function previewBeneficiaryExcelFile(file) {
            const reader = new FileReader();

            reader.onload = function(e) {
                try {
                    const data = new Uint8Array(e.target.result);
                    const workbook = XLSX.read(data, { type: 'array' });

                    // Get first sheet
                    const firstSheetName = workbook.SheetNames[0];
                    const worksheet = workbook.Sheets[firstSheetName];

                    // Convert to JSON
                    const jsonData = XLSX.utils.sheet_to_json(worksheet, { header: 1 });

                    if (jsonData.length > 0) {
                        // Get headers (first row)
                        const headers = jsonData[0];

                        // Get next 5 rows for preview
                        const previewRows = jsonData.slice(1, 6);

                        // Build preview table
                        let headerHtml = '<tr>';
                        headers.forEach(header => {
                            headerHtml += `<th>${header}</th>`;
                        });
                        headerHtml += '</tr>';

                        let bodyHtml = '';
                        previewRows.forEach(row => {
                            bodyHtml += '<tr>';
                            row.forEach(cell => {
                                bodyHtml += `<td>${cell || ''}</td>`;
                            });
                            bodyHtml += '</tr>';
                        });

                        $('#beneficiaryPreviewHeader').html(headerHtml);
                        $('#beneficiaryPreviewBody').html(bodyHtml);
                        $('#beneficiaryUploadPreview').show();
                    }
                } catch (error) {
                    console.error('Error previewing file:', error);
                    Swal.fire('Error', 'Error previewing file. Please check the format.', 'error');
                }
            };

            reader.readAsArrayBuffer(file);
        }

        // Upload beneficiaries
        function uploadBeneficiaries(memberId) {
            const fileInput = document.getElementById('beneficiaryExcelFile');
            const uploadOption = document.querySelector('input[name="beneficiaryUploadOption"]:checked').value;
            const progressBar = document.getElementById('beneficiaryUploadProgress');
            const progressBarInner = progressBar.querySelector('.progress-bar');

            if (fileInput.files.length === 0) {
                Swal.fire('Warning', 'Please select an Excel file.', 'warning');
                return;
            }

            const formData = new FormData();
            formData.append('file', fileInput.files[0]);
            formData.append('memberId', memberId);
            formData.append('uploadOption', uploadOption);

            progressBar.style.display = 'block';
            progressBarInner.style.width = '0%';
            progressBarInner.innerText = '0%';

            $.ajax({
                url: '/Benevolence/UploadBeneficiariesExcel',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                xhr: function() {
                    const xhr = new window.XMLHttpRequest();
                    xhr.upload.addEventListener('progress', function(evt) {
                        if (evt.lengthComputable) {
                            const percentComplete = Math.round((evt.loaded / evt.total) * 100);
                            progressBarInner.style.width = percentComplete + '%';
                            progressBarInner.innerText = percentComplete + '%';
                        }
                    }, false);
                    return xhr;
                },
                success: function(response) {
                    progressBar.style.display = 'none';

                    Swal.fire({
                        icon: 'success',
                        title: 'Upload Completed',
                        html: `
                            <b>Total:</b> ${response.data.totalRecords} <br/>
                            <b>Successful:</b> ${response.data.successfulRecords} <br/>
                            <b>Failed:</b> ${response.data.failedRecords}
                        `
                    }).then(() => {
                        location.reload();
                    });
                },
                error: function(xhr) {
                    progressBar.style.display = 'none';

                    let errorMessage = 'Upload failed.';
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMessage = xhr.responseJSON.message;
                    }

                    Swal.fire('Error', errorMessage, 'error');
                }
            });
        }

        // Beneficiary action functions
        function openBeneficiaryModal(url) {
            window.location.href = url;
        }

        function toggleBeneficiaryStatus(id, activate) {
            const actionText = activate ? 'activate' : 'deactivate';

            Swal.fire({
                title: 'Are you sure?',
                text: `You are about to ${actionText} this beneficiary.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, proceed',
                confirmButtonColor: activate ? '#28a745' : '#6c757d'
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire({
                        title: 'Processing...',
                        allowOutsideClick: false,
                        didOpen: () => {
                            Swal.showLoading();
                        }
                    });

                    $.ajax({
                        url: '/Benevolence/ToggleBeneficiaryStatus',
                        type: 'POST',
                        data: {
                            id: id,
                            isActive: activate
                        },
                        success: function(response) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Success',
                                text: response.message
                            }).then(() => {
                                location.reload();
                            });
                        },
                        error: function(xhr) {
                            let message = 'Operation failed.';
                            if (xhr.responseJSON && xhr.responseJSON.message) {
                                message = xhr.responseJSON.message;
                            }
                            Swal.fire('Error', message, 'error');
                        }
                    });
                }
            });
        }

        function deleteBeneficiary(id) {
            Swal.fire({
                title: 'Delete Beneficiary',
                text: 'Are you sure you want to delete this beneficiary? This action cannot be undone.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, delete it',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire({
                        title: 'Processing...',
                        allowOutsideClick: false,
                        didOpen: () => {
                            Swal.showLoading();
                        }
                    });

                    $.ajax({
                        url: '/Benevolence/DeleteBeneficiary',
                        type: 'POST',
                        data: { id: id },
                        success: function(response) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Deleted!',
                                text: response.message
                            }).then(() => {
                                location.reload();
                            });
                        },
                        error: function(xhr) {
                            let message = 'Delete failed.';
                            if (xhr.responseJSON && xhr.responseJSON.message) {
                                message = xhr.responseJSON.message;
                            }
                            Swal.fire('Error', message, 'error');
                        }
                    });
                }
            });
        }

        // Make functions globally available
        window.openBeneficiaryModal = openBeneficiaryModal;
        window.toggleBeneficiaryStatus = toggleBeneficiaryStatus;
        window.deleteBeneficiary = deleteBeneficiary;
    </script>
}