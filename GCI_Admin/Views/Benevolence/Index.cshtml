@model GCI_Admin.Models.BenevolenceData

@{
    ViewData["Title"] = "Benevolence Members";
}

<!-- Page Header with Stats -->
<div class="row mb-4">
    <div class="col-md-8">
        <h2 class="fw-bold mb-1">Benevolence Members</h2>
        <p class="text-muted mb-0">Manage church benevolence program members and contributions</p>
    </div>
    <div class="col-md-4 text-end">
        <button class="btn btn-success btn-lg me-2" onclick="downloadTemplate()">
            <i class="fa fa-download me-2"></i>Download Template
        </button>
        <a href="@Url.Action("CreateBenevolence", "Benevolence")" class="btn btn-primary btn-lg">
            <i class="fa fa-plus-circle me-2"></i>Add New Member
        </a>
    </div>
</div>

<!-- Quick Stats Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm stat-card">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="bg-primary bg-opacity-10 p-3 rounded-circle">
                            <i class="fa fa-users text-primary fa-2x"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1">Total Members</h6>
                        <h3 class="fw-bold mb-0" id="totalMembers">@Model.TotalMembers</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm stat-card">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="bg-success bg-opacity-10 p-3 rounded-circle">
                            <i class="fa fa-check-circle text-success fa-2x"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1">Active Members</h6>
                        <h3 class="fw-bold mb-0" id="activeMembers">@Model.TotalActiveMembers</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm stat-card">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="bg-warning bg-opacity-10 p-3 rounded-circle">
                            <i class="fa fa-credit-card text-warning fa-2x"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1">Total Contributions</h6>
                        <h3 class="fw-bold mb-0" id="totalContributions">KSHs @Model.TotalAmountPaid</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm stat-card">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="bg-danger bg-opacity-10 p-3 rounded-circle">
                            <i class="fa fa-balance-scale text-danger fa-2x"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1">Outstanding Balance</h6>
                        <h3 class="fw-bold mb-0" id="totalBalance">Ksh @Model.TotalBalance</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Filter Bar -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-center">
            <div class="col-md-3">
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-end-0">
                        <i class="fa fa-search text-muted"></i>
                    </span>
                    <input type="text" class="form-control border-start-0" id="memberSearch" placeholder="Search by name, phone or email...">
                </div>
            </div>
            <div class="col-md-2">
                <select class="form-select" id="statusFilter">
                    <option value="">All Status</option>
                    <option value="true">Active</option>
                    <option value="false">Inactive</option>
                </select>
            </div>
            <div class="col-md-2">
                <select class="form-select" id="balanceFilter">
                    <option value="">All Balances</option>
                    <option value="positive">Has Balance</option>
                    <option value="zero">Fully Paid</option>
                </select>
            </div>
            <div class="col-md-2">
                <select class="form-select" id="dependantsFilter">
                    <option value="">Dependants</option>
                    <option value="0">None</option>
                    <option value="1-2">1-2</option>
                    <option value="3+">3+</option>
                </select>
            </div>
            <div class="col-md-3 text-end">
                <button class="btn btn-outline-secondary me-2" onclick="clearFilters()">
                    <i class="fa fa-times me-1"></i>Clear
                </button>
                <button class="btn btn-primary" onclick="applyFilters()">
                    <i class="fa fa-filter me-1"></i>Apply
                </button>
            </div>
        </div>
    </div>
</div>

<!-- View Toggle -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="btn-group" role="group">
        <button class="btn btn-outline-primary active" onclick="toggleView('table')">
            <i class="fa fa-table me-1"></i>Table View
        </button>
        <button class="btn btn-outline-primary" onclick="toggleView('grid')">
            <i class="fa fa-th me-1"></i>Card View
        </button>
        <button class="btn btn-outline-primary" onclick="toggleView('summary')">
            <i class="fa fa-chart-pie me-1"></i>Summary
        </button>
    </div>
    <div>
        <button class="btn btn-outline-secondary me-2" onclick="exportMembers()">
            <i class="fa fa-file-excel me-1"></i>Export to Excel
        </button> 
        <button class="btn btn-outline-secondary" onclick="showUploadModal()">
            <i class="fa fa-upload me-1"></i>Upload Members
        </button>
    </div>
</div>

<!-- Benevolence Members Container -->
<div id="membersTableContainer">
    @await Html.PartialAsync("_BenevolenceTable", Model.BenevolenceMembers)

</div>

<!-- Card View (Hidden by default) -->
<div id="cardView" style="display: none;">
    <div class="row g-4" id="memberCards">
        <!-- Members will be loaded here dynamically -->
    </div>
</div>

<!-- Summary View (Hidden by default) -->
<div id="summaryView" style="display: none;">
    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-transparent border-0">
                    <h5 class="mb-0">Members by Status</h5>
                </div>
                <div class="card-body">
                    <canvas id="statusChart" height="300"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-transparent border-0">
                    <h5 class="mb-0">Financial Overview</h5>
                </div>
                <div class="card-body">
                    <canvas id="financialChart" height="300"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-transparent border-0">
                    <h5 class="mb-0">Monthly Contributions</h5>
                </div>
                <div class="card-body">
                    <canvas id="monthlyChart" height="300"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Upload Modal -->
<div class="modal fade" id="uploadModal" tabindex="-1" aria-labelledby="uploadModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="uploadModalLabel">
                    <i class="fa fa-upload me-2"></i>Upload Benevolence Members from Excel
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info">
                    <i class="fa fa-info-circle me-2"></i>
                    Please use the downloaded template format. The Excel file should match the template structure below.
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Upload Options</label>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="uploadOption" id="appendData" value="append" checked>
                        <label class="form-check-label" for="appendData">
                            Append to existing data
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="uploadOption" id="replaceData" value="replace">
                        <label class="form-check-label" for="replaceData">
                            Replace all data (clears existing)
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="uploadOption" id="updateData" value="update">
                        <label class="form-check-label" for="updateData">
                            Update existing records (based on National ID)
                        </label>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Choose File</label>
                    <input type="file" class="form-control" id="excelFile" accept=".xlsx,.xls,.csv">
                </div>

                <div class="progress mb-3" style="display: none;" id="uploadProgress">
                    <div class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" style="width: 0%">0%</div>
                </div>

                <div id="uploadPreview" class="mb-3" style="display: none;">
                    <h6>Preview:</h6>
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered">
                            <thead id="previewHeader"></thead>
                            <tbody id="previewBody"></tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="uploadFile()" id="uploadBtn">
                    <i class="fa fa-upload me-1"></i>Upload
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Success Toast Notification -->
<div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div id="successToast" class="toast align-items-center text-white bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body">
                <i class="fa fa-check-circle me-2"></i>
                <span id="toastMessage">Operation completed successfully</span>
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Chart.js for summary charts -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

    <!-- Moment.js for date handling -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.4/moment.min.js"></script>

    <!-- SheetJS for Excel handling -->
    <script src="https://cdn.sheetjs.com/xlsx-0.20.1/package/dist/xlsx.full.min.js"></script>

    <!-- SweetAlert2 for better confirmations -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>
        .stat-card {
            transition: transform 0.2s, box-shadow 0.2s;
            cursor: pointer;
        }

            .stat-card:hover {
                transform: translateY(-3px);
                box-shadow: 0 0.5rem 1.5rem rgba(0,0,0,0.1) !important;
            }

        .member-card {
            transition: all 0.3s;
            border: 1px solid rgba(0,0,0,0.05);
        }

            .member-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 10px 25px rgba(0,0,0,0.1);
            }

        .status-badge {
            position: absolute;
            top: 10px;
            right: 10px;
        }

        .btn-group .btn.active {
            background-color: #0d6efd;
            color: white;
            border-color: #0d6efd;
        }

        /* Loading overlay */
        .loading-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(255,255,255,0.8);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 9999;
        }

        /* Action buttons */
        .action-btn {
            width: 32px;
            height: 32px;
            padding: 0;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            transition: all 0.2s;
        }

            .action-btn:hover {
                transform: translateY(-2px);
            }

            .action-btn.edit-btn:hover {
                background-color: #0d6efd;
                color: white;
            }

            .action-btn.delete-btn:hover {
                background-color: #dc3545;
                color: white;
            }

            .action-btn.view-btn:hover {
                background-color: #6c757d;
                color: white;
            }

        .financial-highlight {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 20px;
            border-radius: 10px;
            margin-bottom: 20px;
        }
    </style>

    <script>
        // Global variables
        let members = [];
        let currentView = 'table';
        let selectedFile = null;
        let statusChart, financialChart, monthlyChart;

        $(document).ready(function() {
            loadMembers();
            initializeDataTable();

            // Check for success message from TempData
        @if (TempData["SuccessMessage"] != null)
        {
            <text>
                    showToast('@TempData["SuccessMessage"]', 'success');
            </text>
        }

            // Check for error message from TempData
        @if (TempData["ErrorMessage"] != null)
        {
            <text>
                    showToast('@TempData["ErrorMessage"]', 'error');
            </text>
        }
        });

        // Load members from server
        function loadMembers() {
            $.get('@Url.Action("GetBenevolenceMembers", "Benevolence")', function(data) {
                members = data;
                updateStats();
                if (currentView === 'grid') {
                    renderCardView();
                } else if (currentView === 'summary') {
                    renderSummaryView();
                }
            }).fail(function() {
                console.error('Failed to load benevolence members');
            });
        }

        // Update statistics
        function updateStats() {
            const total = members.length;
            const active = members.filter(m => m.isActive).length;
            const totalContributions = members.reduce((sum, m) => sum + m.amountPaid, 0);
            const totalBalance = members.reduce((sum, m) => sum + m.balanceAmount, 0);

            $('#totalMembers').text(total);
            $('#activeMembers').text(active);
            $('#totalContributions').text('GHS ' + totalContributions.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ','));
            $('#totalBalance').text('GHS ' + totalBalance.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ','));
        }

        // Show toast notification
        function showToast(message, type = 'success') {
            const toast = $('#successToast');
            toast.removeClass('bg-success bg-danger bg-warning');

            if (type === 'success') {
                toast.addClass('bg-success');
                toast.find('i').removeClass().addClass('fa fa-check-circle me-2');
            } else if (type === 'error') {
                toast.addClass('bg-danger');
                toast.find('i').removeClass().addClass('fa fa-exclamation-circle me-2');
            } else if (type === 'warning') {
                toast.addClass('bg-warning');
                toast.find('i').removeClass().addClass('fa fa-exclamation-triangle me-2');
            }

            $('#toastMessage').text(message);
            const bsToast = new bootstrap.Toast(toast[0], { delay: 3000 });
            bsToast.show();
        }

        // Download Excel template
        function downloadTemplate() {
            const template = [
                {
                    'MemberId': 'M001',
                    'FirstName': 'John',
                    'OtherNames': 'Doe Smith',
                    'Phone': '0244123456',
                    'Email': 'john.doe@email.com',
                    'NationalId': 'GHA-123456789',
                    'PreferredCoverAmount': '5000.00',
                    'NextOfKinName': 'Jane Doe',
                    'NextOfKinPhone': '0244987654',
                    'NumberOfDependants': '2',
                    'IsActive': 'TRUE',
                    'RegNo': 'BEN-2024-001',
                    'TotalAmountDue': '5000.00',
                    'AmountPaid': '2000.00',
                    'BalanceAmount': '3000.00'
                }
            ];

            const wb = XLSX.utils.book_new();
            const ws = XLSX.utils.json_to_sheet(template);

            // Set column widths
            ws['!cols'] = [
                { wch: 15 }, // MemberId
                { wch: 15 }, // FirstName
                { wch: 20 }, // OtherNames
                { wch: 15 }, // Phone
                { wch: 25 }, // Email
                { wch: 20 }, // NationalId
                { wch: 20 }, // PreferredCoverAmount
                { wch: 20 }, // NextOfKinName
                { wch: 15 }, // NextOfKinPhone
                { wch: 15 }, // NumberOfDependants
                { wch: 10 }, // IsActive
                { wch: 15 }, // RegNo
                { wch: 18 }, // TotalAmountDue
                { wch: 15 }, // AmountPaid
                { wch: 15 }  // BalanceAmount
            ];

            // Instructions sheet
            const instructions = [
                { 'Field': 'MemberId', 'Required': 'Yes', 'Description': 'Unique member identifier', 'Example': 'M001' },
                { 'Field': 'FirstName', 'Required': 'Yes', 'Description': 'Member first name', 'Example': 'John' },
                { 'Field': 'OtherNames', 'Required': 'No', 'Description': 'Other names', 'Example': 'Doe Smith' },
                { 'Field': 'Phone', 'Required': 'Yes', 'Description': 'Contact phone number', 'Example': '0244123456' },
                { 'Field': 'Email', 'Required': 'No', 'Description': 'Email address', 'Example': 'john.doe@email.com' },
                { 'Field': 'NationalId', 'Required': 'Yes', 'Description': 'National ID number', 'Example': 'GHA-123456789' },
                { 'Field': 'PreferredCoverAmount', 'Required': 'Yes', 'Description': 'Preferred cover amount', 'Example': '5000.00' },
                { 'Field': 'NextOfKinName', 'Required': 'Yes', 'Description': 'Next of kin full name', 'Example': 'Jane Doe' },
                { 'Field': 'NextOfKinPhone', 'Required': 'Yes', 'Description': 'Next of kin phone', 'Example': '0244987654' },
                { 'Field': 'NumberOfDependants', 'Required': 'Yes', 'Description': 'Number of dependants', 'Example': '2' },
                { 'Field': 'IsActive', 'Required': 'Yes', 'Description': 'TRUE / FALSE', 'Example': 'TRUE' },
                { 'Field': 'RegNo', 'Required': 'Yes', 'Description': 'Registration number', 'Example': 'BEN-2024-001' },
                { 'Field': 'TotalAmountDue', 'Required': 'Yes', 'Description': 'Total amount due', 'Example': '5000.00' },
                { 'Field': 'AmountPaid', 'Required': 'Yes', 'Description': 'Amount paid so far', 'Example': '2000.00' },
                { 'Field': 'BalanceAmount', 'Required': 'Yes', 'Description': 'Remaining balance', 'Example': '3000.00' }
            ];

            const wsInstructions = XLSX.utils.json_to_sheet(instructions);
            wsInstructions['!cols'] = [{ wch: 18 }, { wch: 12 }, { wch: 60 }, { wch: 25 }];

            XLSX.utils.book_append_sheet(wb, ws, 'Members');
            XLSX.utils.book_append_sheet(wb, wsInstructions, 'Instructions');

            XLSX.writeFile(wb, 'Benevolence_Members_Template.xlsx');

            Swal.fire({
                icon: 'success',
                title: 'Template Downloaded',
                text: 'Benevolence members Excel template downloaded successfully.'
            });
        }

        // Show upload modal
        function showUploadModal() {
            $('#uploadModal').modal('show');

            // Reset form
            $('#excelFile').val('');
            $('#uploadPreview').hide();
            $('#uploadProgress').hide();
        }

        // Handle file selection
        $('#excelFile').on('change', function(e) {
            selectedFile = e.target.files[0];
            if (selectedFile) {
                previewExcelFile(selectedFile);
            }
        });

        // Preview Excel file
        function previewExcelFile(file) {
            const reader = new FileReader();

            reader.onload = function(e) {
                try {
                    const data = new Uint8Array(e.target.result);
                    const workbook = XLSX.read(data, { type: 'array' });

                    // Get first sheet
                    const firstSheetName = workbook.SheetNames[0];
                    const worksheet = workbook.Sheets[firstSheetName];

                    // Convert to JSON
                    const jsonData = XLSX.utils.sheet_to_json(worksheet, { header: 1 });

                    if (jsonData.length > 0) {
                        // Get headers (first row)
                        const headers = jsonData[0];

                        // Get next 5 rows for preview
                        const previewRows = jsonData.slice(1, 6);

                        // Build preview table
                        let headerHtml = '<tr>';
                        headers.forEach(header => {
                            headerHtml += `<th>${header}</th>`;
                        });
                        headerHtml += '</tr>';

                        let bodyHtml = '';
                        previewRows.forEach(row => {
                            bodyHtml += '<tr>';
                            row.forEach(cell => {
                                bodyHtml += `<td>${cell || ''}</td>`;
                            });
                            bodyHtml += '</tr>';
                        });

                        $('#previewHeader').html(headerHtml);
                        $('#previewBody').html(bodyHtml);
                        $('#uploadPreview').show();
                    }
                } catch (error) {
                    console.error('Error previewing file:', error);
                    showToast('Error previewing file. Please check the format.', 'error');
                }
            };

            reader.readAsArrayBuffer(file);
        }

        // Upload file
        function uploadFile() {
            var fileInput = document.getElementById("excelFile");
            var uploadOption = document.querySelector('input[name="uploadOption"]:checked').value;
            var progressBar = document.getElementById("uploadProgress");
            var progressBarInner = progressBar.querySelector(".progress-bar");

            if (fileInput.files.length === 0) {
                Swal.fire("Warning", "Please select an Excel file.", "warning");
                return;
            }

            var formData = new FormData();
            formData.append("file", fileInput.files[0]);
            formData.append("uploadOption", uploadOption);

            progressBar.style.display = "block";
            progressBarInner.style.width = "0%";
            progressBarInner.innerText = "0%";

            $.ajax({
                url: '/Benevolence/UploadMembersExcel',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                xhr: function () {
                    var xhr = new window.XMLHttpRequest();
                    xhr.upload.addEventListener("progress", function (evt) {
                        if (evt.lengthComputable) {
                            var percentComplete = Math.round((evt.loaded / evt.total) * 100);
                            progressBarInner.style.width = percentComplete + "%";
                            progressBarInner.innerText = percentComplete + "%";
                        }
                    }, false);
                    return xhr;
                },
                success: function (response) {
                    progressBar.style.display = "none";

                    Swal.fire({
                        icon: "success",
                        title: "Upload Completed",
                        html: `
                            <b>Total:</b> ${response.data.totalRecords} <br/>
                            <b>Successful:</b> ${response.data.successfulRecords} <br/>
                            <b>Failed:</b> ${response.data.failedRecords}
                        `
                    }).then(() => {
                        location.reload();
                    });
                },
                error: function (xhr) {
                    progressBar.style.display = "none";

                    let errorMessage = "Upload failed.";

                    if (xhr.responseJSON && xhr.responseJSON.message)
                        errorMessage = xhr.responseJSON.message;

                    Swal.fire("Error", errorMessage, "error");
                }
            });
        }

        // Edit member - redirect to edit page
        function editMember(id) {
            window.location.href = '@Url.Action("Edit", "Benevolence")/' + id;
        }

        // View member details - redirect to details page
        function viewMember(id) {
            window.location.href = '@Url.Action("Details", "Benevolence")/' + id;
        }

        // Delete member with SweetAlert2 confirmation
        function deleteMember(id) {
            Swal.fire({
                title: 'Delete Member',
                text: 'Are you sure you want to delete this benevolence member? This action cannot be undone.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, delete it',
                cancelButtonText: 'Cancel',
                showLoaderOnConfirm: true,
                preConfirm: () => {
                    return $.ajax({
                        url: '@Url.Action("Delete", "Benevolence")',
                        type: 'POST',
                        data: { id: id },
                        dataType: 'json'
                    }).then(response => {
                        if (!response.success) {
                            throw new Error(response.message || 'Delete failed');
                        }
                        return response;
                    }).catch(error => {
                        Swal.showValidationMessage(`Request failed: ${error.message}`);
                    });
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    showToast('Member deleted successfully');
                    reloadMembersTable();
                    loadMembers();
                }
            });
        }

        // Toggle between views
        function toggleView(view) {
            currentView = view;

            // Update button states
            $('.btn-group .btn').removeClass('active');
            $(`.btn-group .btn:eq(${view === 'table' ? 0 : view === 'grid' ? 1 : 2})`).addClass('active');

            // Hide all views
            $('#membersTableContainer').hide();
            $('#cardView').hide();
            $('#summaryView').hide();

            // Show selected view
            if (view === 'table') {
                $('#membersTableContainer').show();
                reloadMembersTable();
            } else if (view === 'grid') {
                $('#cardView').show();
                renderCardView();
            } else if (view === 'summary') {
                $('#summaryView').show();
                renderSummaryView();
            }
        }

        // Render card view
        function renderCardView() {
            const container = $('#memberCards');
            container.empty();

            if (members.length === 0) {
                container.html(`
                    <div class="col-12">
                        <div class="text-center py-5">
                            <i class="fa fa-users fa-4x text-muted mb-3"></i>
                            <h5>No Members Found</h5>
                            <p class="text-muted">Add your first benevolence member to get started</p>
                            <a href="@Url.Action("Create", "Benevolence")" class="btn btn-primary mt-3">
                                <i class="fa fa-plus-circle me-2"></i>Add New Member
                            </a>
                        </div>
                    </div>
                `);
                return;
            }

            members.forEach(member => {
                const fullName = member.member ?
                    `${member.member.firstName} ${member.member.otherNames || ''}` :
                    member.memberId || 'Unknown';

                const Collectionstatus = member.balanceAmount > 0 ?
                    '<span class="badge bg-warning">Partial Collection</span>' :
                    '<span class="badge bg-success">Fully Paid</span>';

                container.append(`
                    <div class="col-md-4">
                        <div class="card member-card border-0 shadow-sm h-100">
                            <div class="status-badge">
                                ${member.isActive ?
                                    '<span class="badge bg-success">Active</span>' :
                                    '<span class="badge bg-danger">Inactive</span>'}
                            </div>
                            <div class="card-body">
                                <div class="d-flex align-items-center mb-3">
                                    <div class="flex-shrink-0">
                                        <div class="bg-primary bg-opacity-10 p-3 rounded-circle">
                                            <i class="fa fa-user-circle text-primary fa-2x"></i>
                                        </div>
                                    </div>
                                    <div class="flex-grow-1 ms-3">
                                        <h5 class="card-title mb-1">${escapeHtml(fullName)}</h5>
                                        <p class="text-muted small mb-0">${escapeHtml(member.member?.email || 'No email')}</p>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <p class="small text-muted mb-2">
                                        <i class="fa fa-phone me-2"></i>${escapeHtml(member.member?.phone || 'No phone')}<br>
                                        <i class="fa fa-id-card me-2"></i>${escapeHtml(member.nationalId)}<br>
                                        <i class="fa fa-users me-2"></i>Dependants: ${member.numberOfDependants}<br>
                                        <i class="fa fa-user me-2"></i>Next of Kin: ${escapeHtml(member.nextOfKinName)}<br>
                                        <i class="fa fa-credit-card me-2"></i>Preferred Cover: GHS ${member.preferredCoverAmount.toFixed(2)}
                                    </p>
                                </div>

                                <div class="financial-highlight p-3 mb-3 rounded">
                                    <div class="d-flex justify-content-between mb-1">
                                        <span>Total Due:</span>
                                        <strong>GHS ${member.totalAmountDue.toFixed(2)}</strong>
                                    </div>
                                    <div class="d-flex justify-content-between mb-1">
                                        <span>Paid:</span>
                                        <strong class="text-success">GHS ${member.amountPaid.toFixed(2)}</strong>
                                    </div>
                                    <div class="d-flex justify-content-between">
                                        <span>Balance:</span>
                                        <strong class="${member.balanceAmount > 0 ? 'text-danger' : 'text-success'}">
                                            GHS ${member.balanceAmount.toFixed(2)}
                                        </strong>
                                    </div>
                                </div>

                                <div class="d-flex justify-content-between align-items-center mt-3">
                                    <span class="text-muted small">
                                        <i class="fa fa-clock-o me-1"></i>
                                        ${moment(member.createdAt).format('MMM D, YYYY')}
                                    </span>
                                    <div>
                                        <button class="action-btn view-btn btn btn-sm btn-outline-secondary me-1" onclick="viewMember(${member.id})" title="View Details">
                                            <i class="fa fa-eye"></i>
                                        </button>
                                        <button class="action-btn edit-btn btn btn-sm btn-outline-primary me-1" onclick="editMember(${member.id})" title="Edit">
                                            <i class="fa fa-edit"></i>
                                        </button>
                                        <button class="action-btn delete-btn btn btn-sm btn-outline-danger" onclick="deleteMember(${member.id})" title="Delete">
                                            <i class="fa fa-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                `);
            });
        }

        // Render summary view with charts
        function renderSummaryView() {
            // Destroy existing charts if they exist
            if (statusChart) statusChart.destroy();
            if (financialChart) financialChart.destroy();
            if (monthlyChart) monthlyChart.destroy();

            // Status Chart
            const activeCount = members.filter(m => m.isActive).length;
            const inactiveCount = members.filter(m => !m.isActive).length;

            const ctx1 = document.getElementById('statusChart').getContext('2d');
            statusChart = new Chart(ctx1, {
                type: 'pie',
                data: {
                    labels: ['Active Members', 'Inactive Members'],
                    datasets: [{
                        data: [activeCount, inactiveCount],
                        backgroundColor: ['#28a745', '#dc3545'],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: {
                            position: 'bottom'
                        }
                    }
                }
            });

            // Financial Chart
            const totalDue = members.reduce((sum, m) => sum + m.totalAmountDue, 0);
            const totalPaid = members.reduce((sum, m) => sum + m.amountPaid, 0);
            const totalBalance = members.reduce((sum, m) => sum + m.balanceAmount, 0);

            const ctx2 = document.getElementById('financialChart').getContext('2d');
            financialChart = new Chart(ctx2, {
                type: 'doughnut',
                data: {
                    labels: ['Amount Paid', 'Balance'],
                    datasets: [{
                        data: [totalPaid, totalBalance],
                        backgroundColor: ['#28a745', '#dc3545'],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: {
                            position: 'bottom'
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    let label = context.label || '';
                                    let value = context.raw || 0;
                                    return `${label}: GHS ${value.toFixed(2)}`;
                                }
                            }
                        }
                    }
                }
            });

            // Monthly Chart (last 6 months)
            const months = [];
            const monthlyData = [];

            for (let i = 5; i >= 0; i--) {
                const month = moment().subtract(i, 'months');
                months.push(month.format('MMM YYYY'));

                // Calculate Collections for this month (simplified - in real app, you'd have Collection history)
                const monthTotal = members.reduce((sum, m) => {
                    // This is a placeholder - you'd need actual Collection dates
                    return sum + (m.amountPaid / 6);
                }, 0);

                monthlyData.push(monthTotal);
            }

            const ctx3 = document.getElementById('monthlyChart').getContext('2d');
            monthlyChart = new Chart(ctx3, {
                type: 'line',
                data: {
                    labels: months,
                    datasets: [{
                        label: 'Monthly Contributions',
                        data: monthlyData,
                        borderColor: '#0d6efd',
                        backgroundColor: 'rgba(13, 110, 253, 0.1)',
                        tension: 0.4,
                        fill: true
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return `GHS ${context.raw.toFixed(2)}`;
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) {
                                    return 'GHS ' + value;
                                }
                            }
                        }
                    }
                }
            });
        }

        // Helper function to escape HTML
        function escapeHtml(text) {
            if (!text) return '';
            const div = document.createElement('div');
            div.appendChild(document.createTextNode(text));
            return div.innerHTML;
        }

        // Reload members table
        function reloadMembersTable() {
            $('#membersTableContainer').load('@Url.Action("BenevolenceTable", "Benevolence")', function() {
                initializeDataTable();
            });
        }

        // Initialize DataTable
        function initializeDataTable() {
            if ($.fn.DataTable.isDataTable('#benevolenceTable')) {
                $('#benevolenceTable').DataTable().destroy();
            }

            $('#benevolenceTable').DataTable({
                pageLength: 10,
                language: {
                    search: "Search members:",
                    lengthMenu: "Show _MENU_ members",
                    info: "Showing _START_ to _END_ of _TOTAL_ members",
                    emptyTable: "No benevolence members available",
                    zeroRecords: "No matching members found"
                },
                columnDefs: [
                    {
                        targets: -1,
                        orderable: false,
                        searchable: false
                    }
                ],
                initComplete: function() {
                    // Add action buttons styling
                    $('#benevolenceTable .btn-group .btn').addClass('action-btn');
                }
            });
        }

        // Filter functions
        function applyFilters() {
            const search = $('#memberSearch').val();
            const status = $('#statusFilter').val();
            const balance = $('#balanceFilter').val();
            const dependants = $('#dependantsFilter').val();

            if (currentView === 'table') {
                const table = $('#benevolenceTable').DataTable();
                table.search(search).draw();

                // Custom filtering would need to be implemented based on your DataTable setup
            } else if (currentView === 'grid') {
                filterCardView(search, status, balance, dependants);
            }
        }

        function filterCardView(search, status, balance, dependants) {
            const filteredMembers = members.filter(m => {
                let matches = true;

                if (search) {
                    const fullName = m.member ?
                        `${m.member.firstName} ${m.member.otherNames || ''} ${m.member.email || ''} ${m.member.phone || ''}` :
                        '';
                    matches = matches && fullName.toLowerCase().includes(search.toLowerCase());
                }

                if (status) {
                    matches = matches && m.isActive.toString() === status;
                }

                if (balance === 'positive') {
                    matches = matches && m.balanceAmount > 0;
                } else if (balance === 'zero') {
                    matches = matches && m.balanceAmount === 0;
                }

                if (dependants === '0') {
                    matches = matches && m.numberOfDependants === 0;
                } else if (dependants === '1-2') {
                    matches = matches && m.numberOfDependants >= 1 && m.numberOfDependants <= 2;
                } else if (dependants === '3+') {
                    matches = matches && m.numberOfDependants >= 3;
                }

                return matches;
            });

            // Temporarily replace members for rendering
            const tempMembers = members;
            members = filteredMembers;
            renderCardView();
            members = tempMembers;
        }

        function clearFilters() {
            $('#memberSearch').val('');
            $('#statusFilter').val('');
            $('#balanceFilter').val('');
            $('#dependantsFilter').val('');

            if (currentView === 'table') {
                const table = $('#benevolenceTable').DataTable();
                table.search('').columns().search('').draw();
            } else if (currentView === 'grid') {
                renderCardView();
            }
        }

        // Toggle member status
        function toggleMemberStatus(id, activate) {
            let actionText = activate ? "activate" : "deactivate";

            Swal.fire({
                title: "Are you sure?",
                text: `You are about to ${actionText} this benevolence member.`,
                icon: "warning",
                showCancelButton: true,
                confirmButtonText: "Yes, proceed"
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire({
                        title: "Processing...",
                        allowOutsideClick: false,
                        didOpen: () => {
                            Swal.showLoading();
                        }
                    });

                    $.ajax({
                        url: '/Benevolence/ToggleStatus',
                        type: 'POST',
                        data: {
                            id: id,
                            isActive: activate
                        },
                        success: function (response) {
                            Swal.fire("Success", response.message, "success")
                                .then(() => {
                                    location.reload();
                                });
                        },
                        error: function (xhr) {
                            let message = "Operation failed.";

                            if (xhr.responseJSON && xhr.responseJSON.message)
                                message = xhr.responseJSON.message;

                            Swal.fire("Error", message, "error");
                        }
                    });
                }
            });
        }

        // Export members to Excel
        function exportMembers() {
            const exportData = members.map(m => ({
                'ID': m.id,
                'MemberId': m.memberId,
                'Full Name': m.member ? `${m.member.firstName} ${m.member.otherNames || ''}` : '',
                'Phone': m.member?.phone || '',
                'Email': m.member?.email || '',
                'National ID': m.nationalId,
                'Preferred Cover': m.preferredCoverAmount,
                'Next of Kin': m.nextOfKinName,
                'Next of Kin Phone': m.nextOfKinPhone,
                'Dependants': m.numberOfDependants,
                'Status': m.isActive ? 'Active' : 'Inactive',
                'Reg No': m.regNo,
                'Total Due': m.totalAmountDue,
                'Amount Paid': m.amountPaid,
                'Balance': m.balanceAmount,
                'Created At': moment(m.createdAt).format('YYYY-MM-DD HH:mm:ss')
            }));

            const wb = XLSX.utils.book_new();
            const ws = XLSX.utils.json_to_sheet(exportData);

            XLSX.utils.book_append_sheet(wb, ws, 'Benevolence Members');
            XLSX.writeFile(wb, `Benevolence_Members_${moment().format('YYYY-MM-DD')}.xlsx`);

            showToast('Members exported successfully', 'success');
        }

        // Make functions globally available
        window.deleteMember = deleteMember;
        window.editMember = editMember;
        window.viewMember = viewMember;
        window.toggleMemberStatus = toggleMemberStatus;
    </script>
}