@model List<GCI_Admin.Models.Member>

<div class="card shadow-sm">
    <div class="table-responsive p-3">
        <table id='@(ViewData["TableId"] ?? "membersTable")' class="table table-striped table-hover align-middle members-ajax-table" data-status='@(ViewData["StatusId"] ?? "0")'>

            <!-- HEADER -->
            <thead class="table-light">
                <tr>
                    <th>Member Name</th>
                    <th>Phone</th>
                    <th>Email</th>
                    <th>Gender</th>
                    <th>Assembly</th>
                    <th>Marital Status</th>
                    <th>Children</th>
                    <th>Status</th>
                    <th>Joined</th>
                    <th class="text-end">Actions</th>
                </tr>
                <!-- FILTERS -->
                <tr class="filter-row">
                    <th><input type="text" placeholder="Search Name" class="form-control form-control-sm" /></th>
                    <th><input type="text" placeholder="Search Phone" class="form-control form-control-sm" /></th>
                    <th><input type="text" placeholder="Search Email" class="form-control form-control-sm" /></th>
                    <th>
                        <select class="form-select form-select-sm">
                            <option value="">All</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                        </select>
                    </th>
                    <th><input type="text" placeholder="Search Assembly" class="form-control form-control-sm" /></th>
                    <th>
                        <select class="form-select form-select-sm">
                            <option value="">All</option>
                            <option value="Single">Single</option>
                            <option value="Married">Married</option>
                            <option value="Divorced">Divorced</option>
                            <option value="Widowed">Widowed</option>
                        </select>
                    </th>
                    <th></th>
                    <th>
                        <select class="form-select form-select-sm">
                            <option value="">All</option>
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                            <option value="Pending">Pending</option>
                        </select>
                    </th>
                    <th></th>
                    <th></th>
                </tr>
            </thead>

            <!-- BODY -->
            <tbody>
                <!-- DataTables will populate this via AJAX -->
            </tbody>

        </table>
    </div>
</div>
@section Scripts {
    <!-- SweetAlert2 for better confirmations -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(document).ready(function() {
            // Global DataTable initializer handles #membersTable (has datatable class)
        });

        // Re-initialize after AJAX reload (e.g. filters from parent view)
        function initializeMembersTable() {
            GCIDataTable.init('#membersTable');
        }

        // Join Membership Class
        function joinMembershipClass(memberId) {
            Swal.fire({
                title: 'Add to Membership Class',
                text: 'Are you sure you want to add this member to the membership class?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, add to class',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire({
                        title: 'Processing...',
                        allowOutsideClick: false,
                        didOpen: () => {
                            Swal.showLoading();
                        }
                    });

                    $.ajax({
                        url: '/Members/JoinMembershipClass',
                        type: 'POST',
                        data: { id: memberId },
                        success: function(response) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Success!',
                                text: 'Member has been added to membership class.',
                                timer: 2000,
                                showConfirmButton: false
                            }).then(() => {
                                location.reload();
                            });
                        },
                        error: function(xhr) {
                            let message = 'Operation failed.';
                            if (xhr.responseJSON && xhr.responseJSON.message) {
                                message = xhr.responseJSON.message;
                            }
                            Swal.fire('Error', message, 'error');
                        }
                    });
                }
            });
        }

        // Make Full Member
        function makeFullMember(memberId) {
            Swal.fire({
                title: 'Make Full Member',
                text: 'Are you sure you want to make this member a full member?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#28a745',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, make full member',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire({
                        title: 'Processing...',
                        allowOutsideClick: false,
                        didOpen: () => {
                            Swal.showLoading();
                        }
                    });

                    $.ajax({
                        url: '/Members/MakeFullMember',
                        type: 'POST',
                        data: { id: memberId },
                        success: function(response) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Success!',
                                text: 'Member has been made a full member.',
                                timer: 2000,
                                showConfirmButton: false
                            }).then(() => {
                                location.reload();
                            });
                        },
                        error: function(xhr) {
                            let message = 'Operation failed.';
                            if (xhr.responseJSON && xhr.responseJSON.message) {
                                message = xhr.responseJSON.message;
                            }
                            Swal.fire('Error', message, 'error');
                        }
                    });
                }
            });
        }

        // Toggle Member Status (Activate/Deactivate)
        function toggleMemberStatus(memberId, activate) {
            const actionText = activate ? 'activate' : 'deactivate';

            Swal.fire({
                title: `Are you sure?`,
                text: `You are about to ${actionText} this member.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: `Yes, ${actionText}`,
                confirmButtonColor: activate ? '#28a745' : '#6c757d',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire({
                        title: 'Processing...',
                        allowOutsideClick: false,
                        didOpen: () => {
                            Swal.showLoading();
                        }
                    });

                    $.ajax({
                        url: '/Members/ToggleMemberStatus',
                        type: 'POST',
                        data: {
                            id: memberId,
                            isActive: activate
                        },
                        success: function(response) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Success',
                                text: response.message || `Member ${actionText}d successfully.`
                            }).then(() => {
                                location.reload();
                            });
                        },
                        error: function(xhr) {
                            let message = 'Operation failed.';
                            if (xhr.responseJSON && xhr.responseJSON.message) {
                                message = xhr.responseJSON.message;
                            }
                            Swal.fire('Error', message, 'error');
                        }
                    });
                }
            });
        }

        // Delete Member
        function deleteMember(memberId) {
            Swal.fire({
                title: 'Delete Member',
                text: 'Are you sure you want to delete this member? This action cannot be undone.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, delete it',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire({
                        title: 'Processing...',
                        allowOutsideClick: false,
                        didOpen: () => {
                            Swal.showLoading();
                        }
                    });

                    $.ajax({
                        url: '/Members/DeleteMember',
                        type: 'POST',
                        data: { id: memberId },
                        success: function(response) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Deleted!',
                                text: response.message || 'Member has been deleted successfully.'
                            }).then(() => {
                                location.reload();
                            });
                        },
                        error: function(xhr) {
                            let message = 'Delete failed.';
                            if (xhr.responseJSON && xhr.responseJSON.message) {
                                message = xhr.responseJSON.message;
                            }
                            Swal.fire('Error', message, 'error');
                        }
                    });
                }
            });
        }

        // Make functions globally available
        window.joinMembershipClass = joinMembershipClass;
        window.makeFullMember = makeFullMember;
        window.toggleMemberStatus = toggleMemberStatus;
        window.deleteMember = deleteMember;
    </script>
}

<style>
    .avatar-circle {
        transition: transform 0.2s ease;
    }

        .avatar-circle:hover {
            transform: scale(1.05);
        }

    .table tbody tr:hover {
        background-color: rgba(0,0,0,0.02);
        transition: background-color 0.2s ease;
    }

    .btn-sm {
        margin: 0 2px;
        transition: all 0.2s ease;
    }

        .btn-sm:hover {
            transform: translateY(-1px);
        }

    .badge {
        font-weight: 500;
        padding: 5px 10px;
    }

    .table td {
        vertical-align: middle;
    }

    .form-control-sm, .form-select-sm {
        font-size: 0.875rem;
    }
</style>