        // Render summary view with charts
        function renderSummaryView() {
            if (statusChart) statusChart.destroy();
            if (genderChart) genderChart.destroy();
            if (growthChart) growthChart.destroy();

            // Status Chart
            const activeCount = allMembers.filter(m => m.statusId === 1).length;
            const membershipCount = allMembers.filter(m => m.statusId === 2).length;
            const pendingCount = allMembers.filter(m => m.statusId === 3).length;

            const ctx1 = document.getElementById('statusChart').getContext('2d');
            statusChart = new Chart(ctx1, {
                type: 'pie',
                data: {
                    labels: ['Active Members', 'Membership Class', 'Pending'],
                    datasets: [{
                        data: [activeCount, membershipCount, pendingCount],
                        backgroundColor: ['#28a745', '#ffc107', '#6c757d'],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { position: 'bottom' }
                    }
                }
            });

            // Gender Chart
            const maleCount = allMembers.filter(m => m.gender === 'Male').length;
            const femaleCount = allMembers.filter(m => m.gender === 'Female').length;

            const ctx2 = document.getElementById('genderChart').getContext('2d');
            genderChart = new Chart(ctx2, {
                type: 'doughnut',
                data: {
                    labels: ['Male', 'Female'],
                    datasets: [{
                        data: [maleCount, femaleCount],
                        backgroundColor: ['#0d6efd', '#dc3545'],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { position: 'bottom' }
                    }
                }
            });

            // Growth Chart (last 6 months)
            const months = [];
            const monthlyData = [];

            for (let i = 5; i >= 0; i--) {
                const month = moment().subtract(i, 'months');
                months.push(month.format('MMM YYYY'));
                const monthStart = month.startOf('month').toDate();
                const monthEnd = month.endOf('month').toDate();
                const count = allMembers.filter(m => {
                    const createdDate = new Date(m.createdAt);
                    return createdDate >= monthStart && createdDate <= monthEnd;
                }).length;
                monthlyData.push(count);
            }

            const ctx3 = document.getElementById('growthChart').getContext('2d');
            growthChart = new Chart(ctx3, {
                type: 'line',
                data: {
                    labels: months,
                    datasets: [{
                        label: 'New Members',
                        data: monthlyData,
                        borderColor: '#0d6efd',
                        backgroundColor: 'rgba(13, 110, 253, 0.1)',
                        tension: 0.4,
                        fill: true
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return `${context.raw} members`;
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: { stepSize: 1 }
                        }
                    }
                }
            });
        }

        // Helper function to escape HTML
        function escapeHtml(text) {
            if (!text) return '';
            const div = document.createElement('div');
            div.appendChild(document.createTextNode(text));
            return div.innerHTML;
        }

        // Initialize DataTables via Server-Side Processing
        function initializeDataTables() {
            $('.members-ajax-table').each(function() {
                var tableId = $(this).attr('id');
                var statusId = $(this).data('status');

                if ($.fn.DataTable.isDataTable('#' + tableId)) {
                    $('#' + tableId).DataTable().destroy();
                }

                var table = $('#' + tableId).DataTable({
                    processing: true,
                    serverSide: true,
                    ajax: {
                        url: '@Url.Action("GetMembersDataTable", "Members")',
                        type: 'POST',
                        data: function (d) {
                            d.statusId = statusId;
                        }
                    },
                    columns: [
                        { 
                            data: null,
                            render: function (data, type, row) {
                                var firstName = row.firstName || '';
                                var otherNames = row.otherNames || '';
                                var initial = firstName ? firstName.substring(0, 1).toUpperCase() : '?';
                                return `
                                <div class="d-flex align-items-center">
                                    <div class="avatar-circle me-2" style="width:35px;height:35px;background:#667eea;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:bold;">
                                        ${initial}
                                    </div>
                                    <div>
                                        <strong>${firstName} ${otherNames}</strong>
                                        <div class="small text-muted">ID: #${row.id}</div>
                                    </div>
                                </div>`;
                            }
                        },
                        { 
                            data: 'phone',
                            render: function(data) {
                                return data ? `<a href="tel:${data}" class="text-decoration-none"><i class="fa fa-phone me-1"></i>${data}</a>` : '';
                            }
                        },
                        { 
                            data: 'email',
                            render: function(data) {
                                return data ? `<a href="mailto:${data}" class="text-decoration-none"><i class="fa fa-envelope me-1"></i>${data}</a>` : '';
                            }
                        },
                        { 
                            data: 'gender',
                            render: function(data) {
                                if (data === "Male") return '<span class="badge bg-info"><i class="fa fa-mars me-1"></i>Male</span>';
                                return '<span class="badge bg-warning"><i class="fa fa-venus me-1"></i>Female</span>';
                            }
                        },
                        { data: 'assembly', render: function(data) { return data || '-'; } },
                        { 
                            data: null,
                            render: function(data, type, row) {
                                var marital = row.maritalStatus ? `<span class="badge bg-secondary">${row.maritalStatus}</span>` : '<span class="text-muted">-</span>';
                                var spouse = row.spouseName ? `<div class="small text-muted">Spouse: ${row.spouseName}</div>` : '';
                                return marital + spouse;
                            }
                        },
                        { 
                            data: 'numberOfChildren',
                            render: function(data) {
                                return data && data > 0 ? `<span class="badge bg-primary">${data}</span>` : '<span class="text-muted">-</span>';
                            }
                        },
                        { 
                            data: 'statusId',
                            render: function(data) {
                                if (data == 1) return '<span class="badge bg-success">Active</span>';
                                if (data == 2) return '<span class="badge bg-warning">Inactive</span>';
                                return '<span class="badge bg-secondary">Pending</span>';
                            }
                        },
                        { 
                            data: 'createdAt',
                            render: function(data) {
                                if (!data) return '';
                                var date = moment(data);
                                return `<div>${date.format("DD MMM YYYY")}</div><div class="small text-muted">${date.format("hh:mm A")}</div>`;
                            }
                        },
                        { 
                            data: null,
                            className: 'text-end',
                            orderable: false,
                            render: function(data, type, row) {
                                var actions = `
                                    <a href="/Members/MemberDetails?memberId=${row.id}" class="btn btn-sm btn-outline-info"><i class="fa fa-eye"></i></a>
                                    <a href="/Members/Edit/${row.id}" class="btn btn-sm btn-outline-warning"><i class="fa fa-edit"></i></a>
                                `;
                                if (row.statusId == 3) {
                                    actions += `<button class="btn btn-sm btn-outline-primary" onclick="joinMembershipClass(${row.id})"><i class="fa fa-users"></i></button>`;
                                } else if (row.statusId == 2) {
                                    actions += `<button class="btn btn-sm btn-outline-success" onclick="makeFullMember(${row.id})"><i class="fa fa-check-circle"></i></button>`;
                                }

                                if (row.statusId == 1) {
                                    actions += `<button class="btn btn-sm btn-outline-secondary" onclick="toggleMemberStatus(${row.id}, false)"><i class="fa fa-ban"></i></button>`;
                                } else if (row.statusId == 2) {
                                    actions += `<button class="btn btn-sm btn-outline-success" onclick="toggleMemberStatus(${row.id}, true)"><i class="fa fa-check"></i></button>`;
                                }
                                actions += `<button class="btn btn-sm btn-outline-danger" onclick="deleteMember(${row.id})"><i class="fa fa-trash"></i></button>`;
                                return actions;
                            }
                        }
                    ],
                    order: [[8, 'desc']] // Order by CreatedAt desc by default
                });

                // Realtime search
                $('#memberSearch').keyup(function() {
                    table.search($(this).val()).draw();
                });
            });
        }

