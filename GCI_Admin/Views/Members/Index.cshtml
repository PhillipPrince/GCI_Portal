                membersToExport = allMembers.filter(m => m.statusId === 2);
            } else {
                membersToExport = allMembers.filter(m => m.statusId === 3);
            }

            const exportData = membersToExport.map(m => ({
                'ID': m.id,
                'First Name': m.firstName,
                'Other Names': m.otherNames || '',
                'Phone': m.phone || '',
                'Email': m.email || '',
                'Gender': m.gender || '',
                'Date of Birth': m.dateOfBirth ? moment(m.dateOfBirth).format('YYYY-MM-DD') : '',
                'Marital Status': m.maritalStatus || '',
                'Spouse Name': m.spouseName || '',
                'Number of Children': m.numberOfChildren || 0,
                'Assembly': m.assembly || '',
                'Residential Address': m.residentialAddress || '',
                'Social Media': m.socialMediaName || '',
                'Status': m.statusId === 1 ? 'Active' : m.statusId === 2 ? 'Membership Class' : 'Pending',
                'Joined Date': moment(m.createdAt).format('YYYY-MM-DD HH:mm:ss')
            }));

            const wb = XLSX.utils.book_new();
            const ws = XLSX.utils.json_to_sheet(exportData);
            XLSX.utils.book_append_sheet(wb, ws, 'Members');
            XLSX.writeFile(wb, `Members_${currentTab}_${moment().format('YYYY-MM-DD')}.xlsx`);

            showToast('Members exported successfully', 'success');
        }

        // Make functions globally available
        window.deleteMember = deleteMember;
        window.editMember = editMember;
        window.viewMember = viewMember;
        window.openModal = openModal;
        window.toggleView = toggleView;
        window.exportMembers = exportMembers;
        window.clearFilters = clearFilters;
        window.applyFilters = applyFilters;
        window.showUploadModal = showUploadModal;
        window.downloadMembersTemplate = downloadMembersTemplate;
    </script>
}