        // Filter functions
        function applyFilters() {
            const search = $('#memberSearch').val();
            const statusVal = $('#statusFilter').val();
            const genderVal = $('#genderFilter').val();
            const maritalVal = $('#maritalFilter').val();

            let statusSearch = '';
            if (statusVal === '1') statusSearch = 'Active';
            else if (statusVal === '2') statusSearch = 'Inactive';
            else if (statusVal === '3') statusSearch = 'Pending';

            if (currentView === 'table') {
                $('table[id$="Table"]').each(function() {
                    const table = $(this).DataTable();
                    table.search(search);

                    // Gender is column 3
                    table.column(3).search(genderVal);

                    // Marital Status is column 5
                    table.column(5).search(maritalVal);

                    // Status is column 7
                    table.column(7).search(statusSearch);

                    table.draw();
                });
            } else if (currentView === 'grid') {
                filterCardView(search, statusVal, genderVal, maritalVal);
            }
        }

        function filterCardView(search, status, gender, marital) {
            let filteredMembers = allMembers;

            if (currentTab === 'active') {
                filteredMembers = filteredMembers.filter(m => m.statusId === 1);
            } else if (currentTab === 'membership') {
                filteredMembers = filteredMembers.filter(m => m.statusId === 2);
            } else {
                filteredMembers = filteredMembers.filter(m => m.statusId === 3);
            }

            if (search) {
                filteredMembers = filteredMembers.filter(m =>
                    `${m.firstName} ${m.otherNames || ''} ${m.email || ''} ${m.phone || ''}`
                    .toLowerCase().includes(search.toLowerCase())
                );
            }

            if (status) {
                filteredMembers = filteredMembers.filter(m => m.statusId.toString() === status);
            }

            if (gender) {
                filteredMembers = filteredMembers.filter(m => m.gender === gender);
            }

            if (marital) {
                filteredMembers = filteredMembers.filter(m => m.maritalStatus === marital);
