@model MembersListViewModel

@{
    ViewData["Title"] = "Church Members";
}

<!-- Page Header with Stats -->
<div class="row mb-4">
    <div class="col-md-8">
        <h2 class="fw-bold mb-1">Church Members</h2>
        <p class="text-muted mb-0">Manage church members, track membership status, and view member details</p>
    </div>
    <div class="col-md-4 text-end">
        <button class="btn btn-success btn-lg me-2" onclick="downloadMembersTemplate()">
            <i class="fa fa-download me-2"></i>Download Template
        </button>
        <button class="btn btn-primary btn-lg" onclick="openModal('@Url.Action("AddMemberPartial")')">
            <i class="fa fa-user-plus me-2"></i>Add New Member
        </button>
    </div>
</div>

<!-- Quick Stats Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm stat-card">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="bg-primary bg-opacity-10 p-3 rounded-circle">
                            <i class="fa fa-users text-primary fa-2x"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1">Total Members</h6>
                        <h3 class="fw-bold mb-0" id="totalMembers">@Model.TotalMembers</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

   
</div>

<!-- Filter Bar -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-center">
            <div class="col-md-3">
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-end-0">
                        <i class="fa fa-search text-muted"></i>
                    </span>
                    <input type="text" class="form-control border-start-0" id="memberSearch" placeholder="Search by name, phone or email...">
                </div>
            </div>
            <div class="col-md-2">
                <select class="form-select" id="statusFilter">
                    <option value="">All Status</option>
                    <option value="1">Active</option>
                    <option value="2">Inactive</option>
                    <option value="3">Pending</option>
                </select>
            </div>
            <div class="col-md-2">
                <select class="form-select" id="genderFilter">
                    <option value="">All Genders</option>
                    <option value="Male">Male</option>
                    <option value="Female">Female</option>
                </select>
            </div>
            <div class="col-md-2">
                <select class="form-select" id="maritalFilter">
                    <option value="">Marital Status</option>
                    <option value="Single">Single</option>
                    <option value="Married">Married</option>
                    <option value="Divorced">Divorced</option>
                    <option value="Widowed">Widowed</option>
                </select>
            </div>
            <div class="col-md-3 text-end">
                <button class="btn btn-outline-secondary me-2" onclick="clearFilters()">
                    <i class="fa fa-times me-1"></i>Clear
                </button>
                <button class="btn btn-primary" onclick="applyFilters()">
                    <i class="fa fa-filter me-1"></i>Apply
                </button>
            </div>
        </div>
    </div>
</div>


<!-- View Toggle -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="btn-group" role="group">
        <button class="btn btn-outline-primary active" onclick="toggleView('table')">
            <i class="fa fa-table me-1"></i>Table View
        </button>
        <button class="btn btn-outline-primary" onclick="toggleView('grid')">
            <i class="fa fa-th me-1"></i>Card View
        </button>
        <button class="btn btn-outline-primary" onclick="toggleView('summary')">
            <i class="fa fa-chart-pie me-1"></i>Summary
        </button>
    </div>
    <div>
        <button class="btn btn-outline-secondary me-2" onclick="exportMembers()">
            <i class="fa fa-file-excel me-1"></i>Export to Excel
        </button>
        <button class="btn btn-outline-secondary" onclick="showUploadModal()">
            <i class="fa fa-upload me-1"></i>Upload Members
        </button>
    </div>
</div>

<!-- Members Container -->
<div class="card-body">
    <!-- TABS -->
    <ul class="nav nav-tabs nav-tabs-custom mb-3" id="memberTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="all-members-tab" data-bs-toggle="tab" data-bs-target="#allMembers" type="button" role="tab">
                <i class="fa fa-users text-primary me-1"></i>All Members
                <span class="badge bg-primary ms-2">@Model.TotalMembers</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="active-tab" data-bs-toggle="tab" data-bs-target="#activeMembers" type="button" role="tab">
                <i class="fa fa-check-circle text-success me-1"></i>Active Members
                <span class="badge bg-primary ms-2">@Model.MemberStatus.ActiveMembers?.Count </span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="membership-tab" data-bs-toggle="tab" data-bs-target="#membershipClass" type="button" role="tab">
                <i class="fa fa-book text-warning me-1"></i>Membership Class
                <span class="badge bg-warning ms-2">@Model.MemberStatus.MembershipClassMembers?.Count </span>
            </button>
        </li>
            
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="awaiting-tab" data-bs-toggle="tab" data-bs-target="#awaitingConfirmation" type="button" role="tab">
                <i class="fa fa-clock me-1" style="color:#fd7e14;"></i>Awaiting Confirmation
                <span class="badge ms-2" style="background-color:#fd7e14;">@Model.MemberStatus.AwaitingConfirmationMembers?.Count</span>
            </button>
        </li>

        <li class="nav-item" role="presentation">
            <button class="nav-link" id="inactive-tab" data-bs-toggle="tab" data-bs-target="#inactiveMembers" type="button" role="tab">
                <i class="fa fa-pause-circle text-secondary me-1"></i>Inactive Members
                <span class="badge bg-secondary ms-2">@Model.MemberStatus.InactiveMembers?.Count </span>
            </button>
        </li>
        <li class="nav-item dropdown">
            <button class="nav-link dropdown-toggle" data-bs-toggle="dropdown" role="button">
                <i class="fa fa-ellipsis-h me-1"></i>More Status
            </button>
            <ul class="dropdown-menu">
                <li>
                    <button class="dropdown-item" id="transferred-tab" data-bs-toggle="tab" data-bs-target="#transferredMembers" type="button" role="tab">
                        <i class="fa fa-exchange-alt text-primary me-2"></i>Transferred
                        <span class="badge bg-primary ms-2">@Model.MemberStatus.TransferredMembers?.Count </span>
                    </button>
                </li>
                <li>
                    <button class="dropdown-item" id="glory-tab" data-bs-toggle="tab" data-bs-target="#promotedToGlory" type="button" role="tab">
                        <i class="fa fa-angel text-info me-2"></i>Promoted to Glory
                        <span class="badge bg-info ms-2">@Model.MemberStatus.PromotedToGlory?.Count </span>
                    </button>
                </li>
                    
                <li>
                    <button class="dropdown-item" id="withdrawn-tab" data-bs-toggle="tab" data-bs-target="#withdrawnMembers" type="button" role="tab">
                        <i class="fa fa-sign-out-alt text-warning me-2"></i>Withdrawn
                        <span class="badge bg-warning ms-2">@Model.MemberStatus.WithdrawnMembers?.Count </span>
                    </button>
                </li>
                    
            </ul>
        </li>
    </ul>

    <!-- TAB CONTENT -->
    <div class="tab-content" id="memberTabsContent">
        <!-- All Members Tab - Make this the active tab content -->
        <div class="tab-pane fade show active" id="allMembers" role="tabpanel">
            @{ ViewData["TableId"] = "allMembersTable"; ViewData["StatusId"] = "0"; }
            @await Html.PartialAsync("~/Views/Members/_MembersTablePartial.cshtml", (List<GCI_Admin.Models.Member>)null)
        </div>
        <!-- Active Members Tab -->
        <div class="tab-pane fade" id="activeMembers" role="tabpanel">
            @{ ViewData["TableId"] = "activeMembersTable"; ViewData["StatusId"] = "1"; }
            @await Html.PartialAsync("~/Views/Members/_MembersTablePartial.cshtml", (List<GCI_Admin.Models.Member>)null)
        </div>
            
        <!-- Membership Class Tab -->
        <div class="tab-pane fade" id="membershipClass" role="tabpanel">
            @{ ViewData["TableId"] = "membershipClassTable"; ViewData["StatusId"] = "2"; }
            @await Html.PartialAsync("~/Views/Members/_MembersTablePartial.cshtml", (List<GCI_Admin.Models.Member>)null)
        </div>
           
        <!-- Awaiting Confirmation Tab -->
        <div class="tab-pane fade" id="awaitingConfirmation" role="tabpanel">
            @{ ViewData["TableId"] = "awaitingConfirmationTable"; ViewData["StatusId"] = "4"; }
            @await Html.PartialAsync("~/Views/Members/_MembersTablePartial.cshtml", (List<GCI_Admin.Models.Member>)null)
        </div>

        <!-- Inactive Members Tab -->
        <div class="tab-pane fade" id="inactiveMembers" role="tabpanel">
            @{ ViewData["TableId"] = "inactiveMembersTable"; ViewData["StatusId"] = "3"; }
            @await Html.PartialAsync("~/Views/Members/_MembersTablePartial.cshtml", (List<GCI_Admin.Models.Member>)null)
        </div>
            
        <!-- Transferred Members Tab -->
        <div class="tab-pane fade" id="transferredMembers" role="tabpanel">
            @{ ViewData["TableId"] = "transferredMembersTable"; ViewData["StatusId"] = "7"; }
            @await Html.PartialAsync("~/Views/Members/_MembersTablePartial.cshtml", (List<GCI_Admin.Models.Member>)null)
        </div>
            
        <!-- Promoted to Glory Tab -->
        <div class="tab-pane fade" id="promotedToGlory" role="tabpanel">
            @{ ViewData["TableId"] = "promotedToGloryTable"; ViewData["StatusId"] = "5"; }
            @await Html.PartialAsync("~/Views/Members/_MembersTablePartial.cshtml", (List<GCI_Admin.Models.Member>)null)
        </div>
            
        <!-- Withdrawn Members Tab -->
        <div class="tab-pane fade" id="withdrawnMembers" role="tabpanel">
            @{ ViewData["TableId"] = "withdrawnMembersTable"; ViewData["StatusId"] = "6"; }
            @await Html.PartialAsync("~/Views/Members/_MembersTablePartial.cshtml", (List<GCI_Admin.Models.Member>)null)
        </div>
    </div>
</div>
<!-- Upload Modal -->
<div class="modal fade" id="uploadModal" tabindex="-1" aria-labelledby="uploadModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="uploadModalLabel">
                    <i class="fa fa-upload me-2"></i>Upload Members from Excel
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info">
                    <i class="fa fa-info-circle me-2"></i>
                    Please use the downloaded template format. The Excel file should match the template structure below.
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Upload Options</label>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="uploadOption" id="appendData" value="append" checked>
                        <label class="form-check-label" for="appendData">
                            Append to existing data
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="uploadOption" id="replaceData" value="replace">
                        <label class="form-check-label" for="replaceData">
                            Replace all data (clears existing)
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="uploadOption" id="updateData" value="update">
                        <label class="form-check-label" for="updateData">
                            Update existing records (based on Email/Phone)
                        </label>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Choose File</label>
                    <input type="file" class="form-control" id="excelFile" accept=".xlsx,.xls,.csv">
                </div>

                <div class="progress mb-3" style="display: none;" id="uploadProgress">
                    <div class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" style="width: 0%">0%</div>
                </div>

                <div id="uploadPreview" class="mb-3" style="display: none;">
                    <h6>Preview:</h6>
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered">
                            <thead id="previewHeader"></thead>
                            <tbody id="previewBody"></tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="uploadMembers()" id="uploadBtn">
                    <i class="fa fa-upload me-1"></i>Upload
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Global Modal for Create/Edit -->
<div class="modal fade" id="globalModal">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-scrollable">
        <div class="modal-content shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Member Details</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="modalContent"></div>
        </div>
    </div>
</div>

<!-- Success Toast Notification -->
<div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div id="successToast" class="toast align-items-center text-white bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body">
                <i class="fa fa-check-circle me-2"></i>
                <span id="toastMessage">Operation completed successfully</span>
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Chart.js for summary charts -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

    <!-- Moment.js for date handling -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.4/moment.min.js"></script>

    <!-- SheetJS for Excel handling -->
    <script src="https://cdn.sheetjs.com/xlsx-0.20.1/package/dist/xlsx.full.min.js"></script>

    <!-- SweetAlert2 for better confirmations -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>
        .stat-card {
            transition: transform 0.2s, box-shadow 0.2s;
            cursor: pointer;
        }

            .stat-card:hover {
                transform: translateY(-3px);
                box-shadow: 0 0.5rem 1.5rem rgba(0,0,0,0.1) !important;
            }

        .member-card {
            transition: all 0.3s;
            border: 1px solid rgba(0,0,0,0.05);
        }

            .member-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 10px 25px rgba(0,0,0,0.1);
            }

        .status-badge {
            position: absolute;
            top: 10px;
            right: 10px;
        }

        .btn-group .btn.active {
            background-color: #0d6efd;
            color: white;
            border-color: #0d6efd;
        }

        .action-btn {
            width: 32px;
            height: 32px;
            padding: 0;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            transition: all 0.2s;
        }

            .action-btn:hover {
                transform: translateY(-2px);
            }

            .action-btn.edit-btn:hover {
                background-color: #0d6efd;
                color: white;
            }

            .action-btn.delete-btn:hover {
                background-color: #dc3545;
                color: white;
            }

            .action-btn.view-btn:hover {
                background-color: #6c757d;
                color: white;
            }

        .member-highlight {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 15px;
            border-radius: 10px;
            margin-bottom: 15px;
        }

        .nav-tabs .nav-link {
            color: #495057;
            font-weight: 500;
        }

            .nav-tabs .nav-link.active {
                color: #0d6efd;
                font-weight: 600;
            }

        .tab-pane {
            animation: fadeIn 0.3s ease;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>

    <script>
        // Global variables
        let allMembers = [];
        let currentView = 'table';
        let currentTab = 'active';
        let statusChart, genderChart, growthChart;
        let activeTabMembers = {
            active: [],
            membership: [],
            nonmembers: []
        };

        $(document).ready(function() {
            loadAllMembers();
            initializeDataTables();

            // Handle tab changes
            $('#memberTabs button').on('click', function() {
                currentTab = $(this).attr('id').replace('-tab', '');
                if (currentView === 'grid') {
                    renderCardView();
                } else if (currentView === 'summary') {
                    renderSummaryView();
                }
            });

            // Check for success message from TempData
        @if (TempData["SuccessMessage"] != null)
        {
            <text>
                        showToast('@TempData["SuccessMessage"]', 'success');
            </text>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <text>
                        showToast('@TempData["ErrorMessage"]', 'error');
            </text>
        }
        });

        // Load all members from server
        function loadAllMembers() {
            $.get('@Url.Action("GetAllMembers", "Members")', function(data) {
                allMembers = data;
                updateStats();
                if (currentView === 'grid') {
                    renderCardView();
                } else if (currentView === 'summary') {
                    renderSummaryView();
                }
            }).fail(function() {
                console.error('Failed to load members');
            });
        }

        // Update statistics
        function updateStats() {
            const active = allMembers.filter(m => m.statusId === 1).length;
            const membership = allMembers.filter(m => m.statusId === 2).length;
            const nonMembers = allMembers.filter(m => m.statusId === 3).length;

            $('#totalMembers').text(allMembers.length);
            $('#activeMembers').text(active);
            $('#membershipClass').text(membership);
            $('#nonMembers').text(nonMembers);
        }

        // Show toast notification
        function showToast(message, type = 'success') {
            const toast = $('#successToast');
            toast.removeClass('bg-success bg-danger bg-warning');

            if (type === 'success') {
                toast.addClass('bg-success');
                toast.find('i').removeClass().addClass('fa fa-check-circle me-2');
            } else if (type === 'error') {
                toast.addClass('bg-danger');
                toast.find('i').removeClass().addClass('fa fa-exclamation-circle me-2');
            } else if (type === 'warning') {
                toast.addClass('bg-warning');
                toast.find('i').removeClass().addClass('fa fa-exclamation-triangle me-2');
            }

            $('#toastMessage').text(message);
            const bsToast = new bootstrap.Toast(toast[0], { delay: 3000 });
            bsToast.show();
        }

        // Download Excel template
        function downloadMembersTemplate() {
            const template = [
                {
                    'FirstName': 'John',
                    'OtherNames': 'Doe',
                    'Phone': '0244123456',
                    'Email': 'john.doe@email.com',
                    'Gender': 'Male',
                    'DateOfBirth': '1985-05-15',
                    'MaritalStatus': 'Married',
                    'SpouseName': 'Jane Doe',
                    'NumberOfChildren': '2',
                    'Assembly': 'Accra Central',
                    'ResidentialAddress': '123 Main Street, Accra',
                    'SocialMediaName': 'johndoe'
                }
            ];

            const wb = XLSX.utils.book_new();
            const ws = XLSX.utils.json_to_sheet(template);

            ws['!cols'] = [
                { wch: 15 }, { wch: 15 }, { wch: 15 }, { wch: 25 },
                { wch: 10 }, { wch: 15 }, { wch: 15 }, { wch: 20 },
                { wch: 15 }, { wch: 20 }, { wch: 30 }, { wch: 20 }
            ];

            const instructions = [
                { 'Field': 'FirstName', 'Required': 'Yes', 'Description': 'Member first name' },
                { 'Field': 'OtherNames', 'Required': 'No', 'Description': 'Other names' },
                { 'Field': 'Phone', 'Required': 'Yes', 'Description': 'Contact phone number' },
                { 'Field': 'Email', 'Required': 'Yes', 'Description': 'Email address' },
                { 'Field': 'Gender', 'Required': 'Yes', 'Description': 'Male / Female' },
                { 'Field': 'DateOfBirth', 'Required': 'No', 'Description': 'Format: YYYY-MM-DD' },
                { 'Field': 'MaritalStatus', 'Required': 'No', 'Description': 'Single / Married / Divorced / Widowed' },
                { 'Field': 'SpouseName', 'Required': 'No', 'Description': 'Spouse name if married' },
                { 'Field': 'NumberOfChildren', 'Required': 'No', 'Description': 'Number of children' },
                { 'Field': 'Assembly', 'Required': 'No', 'Description': 'Assembly/Location' },
                { 'Field': 'ResidentialAddress', 'Required': 'No', 'Description': 'Home address' },
                { 'Field': 'SocialMediaName', 'Required': 'No', 'Description': 'Social media handle' }
            ];

            const wsInstructions = XLSX.utils.json_to_sheet(instructions);
            wsInstructions['!cols'] = [{ wch: 20 }, { wch: 12 }, { wch: 60 }];

            XLSX.utils.book_append_sheet(wb, ws, 'Members');
            XLSX.utils.book_append_sheet(wb, wsInstructions, 'Instructions');

            XLSX.writeFile(wb, 'Members_Template.xlsx');

            Swal.fire({
                icon: 'success',
                title: 'Template Downloaded',
                text: 'Members Excel template downloaded successfully.'
            });
        }

        // Show upload modal
        function showUploadModal() {
            $('#uploadModal').modal('show');
            $('#excelFile').val('');
            $('#uploadPreview').hide();
            $('#uploadProgress').hide();
        }

        // Handle file selection
        $('#excelFile').on('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                previewExcelFile(file);
            }
        });

        // Preview Excel file
        function previewExcelFile(file) {
            const reader = new FileReader();

            reader.onload = function(e) {
                try {
                    const data = new Uint8Array(e.target.result);
                    const workbook = XLSX.read(data, { type: 'array' });
                    const firstSheetName = workbook.SheetNames[0];
                    const worksheet = workbook.Sheets[firstSheetName];
                    const jsonData = XLSX.utils.sheet_to_json(worksheet, { header: 1 });

                    if (jsonData.length > 0) {
                        const headers = jsonData[0];
                        const previewRows = jsonData.slice(1, 6);

                        let headerHtml = '<tr>';
                        headers.forEach(header => {
                            headerHtml += `<th>${header}</th>`;
                        });
                        headerHtml += '</tr>';

                        let bodyHtml = '';
                        previewRows.forEach(row => {
                            bodyHtml += '<tr>';
                            row.forEach(cell => {
                                bodyHtml += `<td>${cell || ''}</td>`;
                            });
                            bodyHtml += '</tr>';
                        });

                        $('#previewHeader').html(headerHtml);
                        $('#previewBody').html(bodyHtml);
                        $('#uploadPreview').show();
                    }
                } catch (error) {
                    showToast('Error previewing file. Please check the format.', 'error');
                }
            };

            reader.readAsArrayBuffer(file);
        }

        // Upload members
        function uploadMembers() {
    const fileInput = document.getElementById('excelFile');
    const uploadOption = document.querySelector('input[name="uploadOption"]:checked').value;
    const progressBar = document.getElementById('uploadProgress');
    const progressBarInner = progressBar.querySelector('.progress-bar');

    if (fileInput.files.length === 0) {
        Swal.fire('Warning', 'Please select an Excel file.', 'warning');
        return;
    }

    const formData = new FormData();
    formData.append('file', fileInput.files[0]);
    formData.append('uploadOption', uploadOption);

    progressBar.style.display = 'block';
    progressBarInner.style.width = '0%';
    progressBarInner.innerText = '0%';

    $.ajax({
        url: '/Members/UploadMembersExcel',
        type: 'POST',
        data: formData,
        processData: false,
        contentType: false,

        xhr: function () {
            const xhr = new window.XMLHttpRequest();

            xhr.upload.addEventListener('progress', function (evt) {
                if (evt.lengthComputable) {
                    const percentComplete = Math.round(
                        (evt.loaded / evt.total) * 100
                    );

                    progressBarInner.style.width =
                        percentComplete + '%';

                    progressBarInner.innerText =
                        percentComplete + '%';
                }
            }, false);

            return xhr;
        },

        success: function (response) {

            progressBar.style.display = 'none';

            const hasFailedFile =
                response.data &&
                response.data.failedRecords > 0 &&
                response.data.failedRecordsFileBase64;

            let html = `
                <b>Total:</b> ${response.data.totalRecords}<br/>
                <b>Successful:</b> ${response.data.successfulRecords}<br/>
                <b>Failed:</b> ${response.data.failedRecords}
            `;

            if (hasFailedFile) {
                html += `
                    <br/><br/>
                    <button id="downloadFailedRecords"
                            class="btn btn-danger">
                        <i class="fa fa-download me-1"></i>
                        Download Failed Records
                    </button>
                `;
            }

            Swal.fire({
                icon: 'success',
                title: 'Upload Completed',
                html: html,
                confirmButtonText: 'OK',

                didOpen: function () {

                    if (hasFailedFile) {

                        document
                            .getElementById('downloadFailedRecords')
                            .addEventListener('click', function () {

                                try {

                                    const byteCharacters =
                                        atob(response.data.failedRecordsFileBase64);

                                    const byteNumbers =
                                        new Array(byteCharacters.length);

                                    for (let i = 0; i < byteCharacters.length; i++) {
                                        byteNumbers[i] =
                                            byteCharacters.charCodeAt(i);
                                    }

                                    const byteArray =
                                        new Uint8Array(byteNumbers);

                                    const blob = new Blob(
                                        [byteArray],
                                        {
                                            type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
                                        });

                                    const url =
                                        window.URL.createObjectURL(blob);

                                    const link =
                                        document.createElement('a');

                                    link.href = url;

                                    link.download =
                                        response.data.failedRecordsFileName ||
                                        'FailedMembers.xlsx';

                                    document.body.appendChild(link);

                                    link.click();

                                    document.body.removeChild(link);

                                    window.URL.revokeObjectURL(url);

                                } catch (e) {
                                    console.error(e);

                                    Swal.fire(
                                        'Error',
                                        'Unable to download failed records file.',
                                        'error'
                                    );
                                }
                            });
                    }
                }
            }).then(() => {
                location.reload();
            });
        },

        error: function (xhr) {

            progressBar.style.display = 'none';

            let errorMessage = 'Upload failed.';

            if (xhr.responseJSON &&
                xhr.responseJSON.message) {

                errorMessage =
                    xhr.responseJSON.message;
            }

            Swal.fire(
                'Error',
                errorMessage,
                'error'
            );
        }
    });
}
