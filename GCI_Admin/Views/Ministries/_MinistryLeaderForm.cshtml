@* 
@model GCI_Admin.Models.MembersMinistriesViewModel

<div class="container-fluid">
    <div class="mb-3">
        <label for="MemberId" class="form-label">Member <span class="text-danger">*</span></label>
        <select class="form-select" id="MemberId" name="MemberId" required>
            <option value="">-- Select a member --</option>
            @if (ViewBag.Members != null)
            {
                foreach (var member in ViewBag.Members)
                {
                    <option value="@member.MemberId">@member.FullName (@member.Email)</option>
                }
            }
        </select>
        <small class="text-muted">Type to search for a member</small>
    </div>
    
    <div class="mb-3">
        <label for="MinistryId" class="form-label">Ministry <span class="text-danger">*</span></label>
        <select class="form-select" id="MinistryId" name="MinistryId" required>
            <option value="">-- Select a ministry --</option>
            @if (ViewBag.Ministries != null)
            {
                foreach (var ministry in ViewBag.Ministries)
                {
                    <option value="@ministry.MinistryId">@ministry.MinistryName</option>
                }
            }
        </select>
    </div>
    
    <div class="mb-3">
        <label for="PositionTitle" class="form-label">Position Title <span class="text-danger">*</span></label>
        <input type="text" class="form-control" id="PositionTitle" placeholder="e.g., Worship Director, Youth Pastor, Outreach Coordinator" required>
        <small class="text-muted">The role or title this person holds in the ministry</small>
    </div>
    
    <div class="mb-3">
        <label for="Bio" class="form-label">Bio / Description</label>
        <textarea class="form-control" id="Bio" rows="3" placeholder="Brief biography, qualifications, or role description"></textarea>
    </div>
    
    <div class="row mb-3">
        <div class="col-md-6">
            <label for="StartDate" class="form-label">Start Date <span class="text-danger">*</span></label>
            <input type="date" class="form-control" id="StartDate" required>
        </div>
        <div class="col-md-6">
            <label for="EndDate" class="form-label">End Date</label>
            <input type="date" class="form-control" id="EndDate">
            <small class="text-muted">Leave empty if currently serving</small>
        </div>
    </div>
    
    <div class="mb-3 form-check">
        <input type="checkbox" class="form-check-input" id="IsActive" checked>
        <label class="form-check-label" for="IsActive">Active Leader</label>
        <small class="text-muted d-block">Uncheck if this leader is no longer serving in this role</small>
    </div>
</div>

<script>
    // Enhance member dropdown with search functionality if Select2 is not available
    $(document).ready(function() {
        if (typeof $.fn.select2 === 'undefined') {
            var memberSelect = $('#MemberId');
            var searchWrapper = $('<div class="mb-2"></div>');
            var searchInput = $('<input type="text" class="form-control" placeholder="Search members...">');
            
            memberSelect.before(searchWrapper);
            searchWrapper.append(searchInput);
            
            searchInput.on('keyup', function() {
                var term = $(this).val().toLowerCase();
                memberSelect.find('option').each(function() {
                    var text = $(this).text().toLowerCase();
                    if (text.indexOf(term) > -1 || $(this).val() === '') {
                        $(this).show();
                    } else {
                        $(this).hide();
                    }
                });
            });
        }
    });
</script> *@
