@model GCI_Admin.Models.DTOs.MembersMinistriesViewModel

@{
    Layout = null;
    var isEdit = false;
    var formId = "createMinistryLeaderForm";
}

<div class="modal fade ministry-leader-modal" id="addMinistryLeaderModal" tabindex="-1" aria-labelledby="addMinistryLeaderModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addMinistryLeaderModalLabel">
                    <i class="fa fa-user-plus me-2"></i>Add Ministry Leader
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <div class="modal-body">
                <form id="@formId">
                    @Html.AntiForgeryToken()

                    <div class="alert alert-info">
                        <i class="fa fa-info-circle me-2"></i>
                        Assign a member as a leader to a ministry. The member will be responsible for overseeing ministry activities.
                    </div>

                    <!-- Member Selector Partial (GEC Format) -->
                    @{
                        var membersList = new List<GCI_Admin.Models.Member>();
                        if (ViewBag.Members != null)
                        {
                            foreach (var member in ViewBag.Members)
                            {
                                membersList.Add(new GCI_Admin.Models.Member
                                {
                                    Id = int.Parse(member.Value),
                                    FirstName = member.Text.Split('(')[0].Trim(),
                                    OtherNames = "",
                                    Email = member.Text.Contains('(') ? member.Text.Split('(')[1].Trim(')') : "",
                                    Phone = "",
                                    Gender = ""
                                });
                            }
                        }
                    }
                    
                    @await Html.PartialAsync("_MemberSelector", new GCI_Admin.Models.ViewModels.MemberSelectorViewModel
                    {
                        ControlId = "ministryLeaderMemberSelector",
                        LabelText = "Select Member",
                        MemberIdFieldName = "MemberId",
                        SelectedMemberId = null,
                        Members = membersList,
                        IsRequired = true,
                        IsEdit = false,
                        ShowPhoneAndGender = false
                    })

                    <div class="row mt-3">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">
                                <i class="fa fa-building-o me-1 text-primary"></i>Ministry
                                <span class="text-danger">*</span>
                            </label>
                            <select class="form-select" id="MinistryId" name="MinistryId" required>
                                <option value="">-- Select Ministry --</option>
                                @if (ViewBag.Ministries != null)
                                {
                                    foreach (var ministry in ViewBag.Ministries)
                                    {
                                        <option value="@ministry.Value">@ministry.Text</option>
                                    }
                                }
                            </select>
                            <span class="text-danger" id="ministryValidation"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">
                                <i class="fa fa-tag me-1 text-primary"></i>Position Title
                                <span class="text-danger">*</span>
                            </label>
                            <input type="text" class="form-control" id="PositionTitle" name="PositionTitle" 
                                   placeholder="e.g., Worship Director, Youth Pastor, Outreach Coordinator" required />
                            <span class="text-danger" id="positionTitleValidation"></span>
                            <small class="text-muted">The role or title this person holds in the ministry</small>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">
                            <i class="fa fa-align-left me-1 text-primary"></i>Bio / Description
                        </label>
                        <textarea class="form-control" id="Bio" name="Bio" rows="4" 
                                  placeholder="Brief biography, qualifications, or role description..."></textarea>
                        <small class="text-muted">Optional: Provide a brief description of the leader's role and responsibilities</small>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">
                                <i class="fa fa-calendar me-1 text-primary"></i>Start Date
                                <span class="text-danger">*</span>
                            </label>
                            <input type="date" class="form-control" id="StartDate" name="StartDate" 
                                   value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                            <span class="text-danger" id="startDateValidation"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">
                                <i class="fa fa-calendar-times me-1 text-primary"></i>End Date
                            </label>
                            <input type="date" class="form-control" id="EndDate" name="EndDate" />
                            <small class="text-muted">Leave empty if currently serving</small>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="IsActive" name="IsActive" checked>
                                <label class="form-check-label fw-bold" for="IsActive">
                                    <i class="fa fa-check-circle me-1 text-success"></i>Active Leader
                                </label>
                            </div>
                            <small class="text-muted">Uncheck if this leader is no longer serving in this role</small>
                        </div>
                    </div>
                </form>
            </div>
            
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fa fa-times me-1"></i>Cancel
                </button>
                <button type="button" class="btn btn-primary" id="saveMinistryLeaderBtn" onclick="confirmAndSubmit()">
                    <span id="ministryLeaderLoading" class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                    <span id="saveBtnText">Save Ministry Leader</span>
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    /* Custom dropdown styles */
    .custom-dropdown {
        position: relative;
        width: 100%;
    }
    
    .dropdown-trigger {
        position: relative;
        cursor: pointer;
        user-select: none;
    }
    
    .dropdown-trigger[disabled] {
        cursor: not-allowed;
        opacity: 0.6;
    }
    
    .dropdown-trigger input {
        cursor: pointer;
        background-color: white;
        padding-right: 30px;
    }
    
    .dropdown-trigger input:disabled {
        background-color: #e9ecef;
        cursor: not-allowed;
    }
    
    .dropdown-arrow {
        position: absolute;
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
        pointer-events: none;
        font-size: 12px;
        color: #6c757d;
    }
    
    .dropdown-list {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: white;
        border: 1px solid #ced4da;
        border-radius: 0.25rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.15);
        z-index: 1060;
        max-height: 400px;
        display: flex;
        flex-direction: column;
    }
    
    .dropdown-search {
        padding: 10px;
        border-bottom: 1px solid #e9ecef;
        background: white;
    }
    
    .dropdown-options {
        overflow-y: auto;
        max-height: 350px;
    }
    
    .option-item {
        padding: 10px 15px;
        cursor: pointer;
        border-bottom: 1px solid #f0f0f0;
        transition: background-color 0.2s;
    }
    
    .option-item:hover {
        background-color: #f8f9fa;
    }
    
    .option-item.selected {
        background-color: #e7f1ff;
    }
    
    .option-title {
        font-weight: 500;
        color: #212529;
    }
    
    .option-subtitle {
        font-size: 12px;
        color: #6c757d;
        margin-top: 2px;
    }
    
    .no-result-message {
        padding: 20px;
        text-align: center;
        color: #999;
    }
    
    .dropdown-list {
        animation: dropdownFadeIn 0.15s ease;
    }
    
    @@keyframes dropdownFadeIn {
        from {
            opacity: 0;
            transform: translateY(-5px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    // Initialize form handling
    $(document).ready(function() {
        // Prevent default form submission
        $('#@formId').on('submit', function(e) {
            e.preventDefault();
            return false;
        });
        
        // Debug: Check if modal elements exist
        console.log('Modal initialized');
        console.log('Member selector exists:', $('#ministryLeaderMemberSelector_display').length > 0);
    });

    // Function to show confirmation dialog before submission
    function confirmAndSubmit() {
        // Get all field values for the confirmation message
        const memberDisplayName = $('#ministryLeaderMemberSelector_display').val();
        const ministryName = $('#MinistryId option:selected').text();
        const positionTitle = $('#PositionTitle').val();
        const startDate = $('#StartDate').val();
        const endDate = $('#EndDate').val();
        const isActive = $('#IsActive').is(':checked');
        const bio = $('#Bio').val();
        
        // Format dates for display
        const formattedStartDate = startDate ? new Date(startDate).toLocaleDateString() : 'Not specified';
        const formattedEndDate = endDate ? new Date(endDate).toLocaleDateString() : 'Currently serving';
        
        // Build confirmation message
        const confirmationTitle = 'Confirm Ministry Leader Assignment';
        const confirmationMessage = `
            <div style="text-align: left;">
                <p>Are you sure you want to assign this member as a ministry leader?</p>
                <hr>
                <p><strong>Member:</strong> ${memberDisplayName || 'Not selected'}</p>
                <p><strong>Ministry:</strong> ${ministryName || 'Not selected'}</p>
                <p><strong>Position:</strong> ${positionTitle || 'Not specified'}</p>
                <p><strong>Start Date:</strong> ${formattedStartDate}</p>
                <p><strong>End Date:</strong> ${formattedEndDate}</p>
                <p><strong>Status:</strong> ${isActive ? 'Active' : 'Inactive'}</p>
                ${bio ? `<p><strong>Bio:</strong> ${bio.substring(0, 100)}${bio.length > 100 ? '...' : ''}</p>` : ''}
                <hr>
                <p class="text-info">Please review the information before confirming.</p>
            </div>
        `;
        
        // Show SweetAlert confirmation
        Swal.fire({
            title: confirmationTitle,
            html: confirmationMessage,
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, assign leader!',
            cancelButtonText: 'Cancel',
            showLoaderOnConfirm: true,
            preConfirm: async () => {
                try {
                    // Call the submit function
                    return await submitMinistryLeaderForm();
                } catch (error) {
                    Swal.showValidationMessage(`Request failed: ${error}`);
                }
            },
            allowOutsideClick: () => !Swal.isLoading()
        }).then((result) => {
            if (result.isConfirmed) {
                console.log('User confirmed the action');
            } else if (result.dismiss === Swal.DismissReason.cancel) {
                Swal.fire(
                    'Cancelled',
                    'Ministry leader assignment was cancelled',
                    'info'
                );
            }
        });
    }

    // Main submit function - Sending as JSON
    function submitMinistryLeaderForm() {
        return new Promise((resolve, reject) => {
            // Get all field values
            const memberId = $('#ministryLeaderMemberSelector_selectedId').val();
            const ministryId = $('#MinistryId').val();
            const positionTitle = $('#PositionTitle').val();
            const bio = $('#Bio').val();
            const startDate = $('#StartDate').val();
            const endDate = $('#EndDate').val();
            const isActive = $('#IsActive').is(':checked');
            const token = $('input[name="__RequestVerificationToken"]').val();

            // Validate member is selected
            if (!memberId || memberId === '') {
                Swal.fire('Validation Error', 'Please select a member', 'warning');
                reject('Member not selected');
                return;
            }

            // Validate ministry is selected
            if (!ministryId || ministryId === '') {
                Swal.fire('Validation Error', 'Please select a ministry', 'warning');
                reject('Ministry not selected');
                return;
            }

            // Validate position title
            if (!positionTitle || positionTitle.trim() === '') {
                Swal.fire('Validation Error', 'Please enter a position title', 'warning');
                reject('Position title not entered');
                return;
            }

            // Validate start date
            if (!startDate) {
                Swal.fire('Validation Error', 'Please select a start date', 'warning');
                reject('Start date not selected');
                return;
            }

            // Validate end date is after start date if provided
            if (endDate && new Date(endDate) < new Date(startDate)) {
                Swal.fire('Validation Error', 'End date cannot be earlier than start date', 'warning');
                reject('Invalid date range');
                return;
            }

            // Disable button and show loading
            const $saveBtn = $('#saveMinistryLeaderBtn');
            const $loadingSpinner = $('#ministryLeaderLoading');
            const $btnText = $('#saveBtnText');
            
            $saveBtn.prop('disabled', true);
            $loadingSpinner.removeClass('d-none');
            const originalText = $btnText.text();
            $btnText.text('Saving...');

            // Prepare JSON data
            const requestData = {
                MemberId: parseInt(memberId),
                MinistryId: parseInt(ministryId),
                PositionTitle: positionTitle.trim(),
                Bio: bio || '',
                StartDate: startDate,
                EndDate: endDate || null,
                IsActive: isActive
            };

            console.log("Submitting ministry leader form data as JSON:");
            console.log("URL:", '/Ministry/CreateMinistryLeader');
            console.log("Data:", requestData);

            // Make AJAX request with JSON content type
            $.ajax({
                url: '/Ministry/CreateMinistryLeader',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(requestData),
                headers: {
                    'RequestVerificationToken': token
                },
                success: function(response) {
                    console.log("Response:", response);
                    
                    // Reset button state
                    $saveBtn.prop('disabled', false);
                    $loadingSpinner.addClass('d-none');
                    $btnText.text(originalText);

                    if (response.isSuccess) {
                        // Show success message
                        Swal.fire({
                            icon: 'success',
                            title: 'Success!',
                            text: response.message || 'Ministry leader assigned successfully',
                            showConfirmButton: false,
                            timer: 1500
                        }).then(() => {
                            // Close modal and reload
                            $('#addMinistryLeaderModal').modal('hide');
                            location.reload();
                        });
                        resolve(response);
                    } else {
                        // Show error message
                        let errorMessage = response.message || 'Failed to assign ministry leader.';
                        
                        // Handle validation errors
                        if (response.errors && response.errors.length > 0) {
                            errorMessage = response.errors.join('<br>');
                        }
                        
                        Swal.fire('Error', errorMessage, 'error');
                        reject(errorMessage);
                    }
                },
                error: function(xhr, status, error) {
                    // Reset button state
                    $saveBtn.prop('disabled', false);
                    $loadingSpinner.addClass('d-none');
                    $btnText.text(originalText);
                    
                    // Handle different error scenarios
                    let errorMessage = 'An unexpected error occurred.';
                    
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMessage = xhr.responseJSON.message;
                    } else if (xhr.status === 400) {
                        errorMessage = 'Invalid data sent to server.';
                    } else if (xhr.status === 409) {
                        errorMessage = 'This member is already a leader in this ministry.';
                    } else if (xhr.status === 0) {
                        errorMessage = 'Network error. Please check your connection.';
                    } else if (xhr.status === 404) {
                        errorMessage = 'Service endpoint not found. Please contact support.';
                    } else if (xhr.status === 500) {
                        errorMessage = 'Server error. Please try again later.';
                    }
                    
                    console.error('Form submission error:', xhr, status, error);
                    Swal.fire('Error', errorMessage, 'error');
                    reject(errorMessage);
                }
            });
        });
    }

    // Handle Enter key in form inputs
    $(document).on('keypress', '#@formId input, #@formId select, #@formId textarea', function(e) {
        if (e.which === 13 && !$(this).is('textarea')) {
            e.preventDefault();
            confirmAndSubmit();
        }
    });

    // Listen for member selection to validate
    $(document).on('memberSelected', function(e, data) {
        console.log('Member selected for ministry leader:', data);
        $('#ministryLeaderMemberSelector_validation').text('');
    });

    // Reset form when modal is closed
    $('#addMinistryLeaderModal').on('hidden.bs.modal', function() {
        $('#ministryLeaderMemberSelector_display').val('');
        $('#ministryLeaderMemberSelector_selectedId').val('');
        $('#MinistryId').val('');
        $('#PositionTitle').val('');
        $('#Bio').val('');
        $('#StartDate').val(new Date().toISOString().split('T')[0]);
        $('#EndDate').val('');
        $('#IsActive').prop('checked', true);
        $('.dropdown-list').hide();
        $('#ministryLeaderMemberSelector_validation').text('');
        $('#ministryValidation').text('');
        $('#positionTitleValidation').text('');
        $('#startDateValidation').text('');
    });
</script>