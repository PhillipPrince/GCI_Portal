    <!-- Active menu fix - Enhanced click & URL matching -->
    <script>
        (function() {
            function activateSidebarMenu() {
                var currentPath = window.location.pathname.toLowerCase();
                
                // Clear active states first
                document.querySelectorAll('.sidebar .active, .sidebar .active-link').forEach(function(el) {
                    el.classList.remove('active', 'active-link');
                });

                var activeChildFound = false;

                // 1. Highlight exact matching child link in submenus
                var subLinks = document.querySelectorAll('.submenu a');
                subLinks.forEach(function(link) {
                    var href = (link.getAttribute('href') || '').toLowerCase();
                    if (!href || href === '#') return;

                    var isMatch = currentPath === href || 
                                  (href !== '/' && href !== '/home' && currentPath.startsWith(href));

                    if (isMatch && !activeChildFound) {
                        link.classList.add('active-link');
                        activeChildFound = true;

                        var parentCollapse = link.closest('.collapse');
                        if (parentCollapse) {
                            parentCollapse.classList.add('show');
                            var parentTrigger = document.querySelector('[data-bs-toggle="collapse"][href="#' + parentCollapse.id + '"]');
                            if (parentTrigger) {
                                parentTrigger.classList.add('active');
                                parentTrigger.setAttribute('aria-expanded', 'true');
                            }
                        }
                    }
                });

                // 2. Highlight standalone top-level links
                if (!activeChildFound) {
                    var topLinks = document.querySelectorAll('.sidebar > .menu-link');
                    topLinks.forEach(function(link) {
                        var href = (link.getAttribute('href') || '').toLowerCase();
                        var isParentTrigger = link.hasAttribute('data-bs-toggle');

                        if (isParentTrigger) {
                            var targetId = (link.getAttribute('href') || '').replace('#', '');
                            var targetCollapse = document.getElementById(targetId);
                            if (targetCollapse && targetCollapse.classList.contains('show')) {
                                link.classList.add('active');
                                link.setAttribute('aria-expanded', 'true');
                            }
                        } else if (href && href !== '#') {
                            if (currentPath === href || (href !== '/' && href !== '/home' && currentPath.startsWith(href)) ||
                                (currentPath === '/' && (href === '/' || href === '/home' || href === '/home/index'))) {
                                link.classList.add('active');
                            }
                        }
                    });
                }
            }

            function setupMenuClickHandlers() {
                // Handle parent menu toggles
                document.querySelectorAll('.sidebar [data-bs-toggle="collapse"]').forEach(function(trigger) {
                    trigger.addEventListener('click', function(e) {
                        var targetId = (this.getAttribute('href') || '').replace('#', '');
                        var targetCollapse = document.getElementById(targetId);

                        if (targetCollapse) {
                            var isShowing = targetCollapse.classList.contains('show');
                            // Toggle active highlight immediately on click
                            if (!isShowing) {
                                this.classList.add('active');
                                this.setAttribute('aria-expanded', 'true');
                            } else {
                                // If closing and no active-link inside, remove active
                                if (!targetCollapse.querySelector('.active-link')) {
                                    this.classList.remove('active');
                                    this.setAttribute('aria-expanded', 'false');
                                }
                            }
                        }
                    });
                });

                // Handle child & single menu link clicks
                document.querySelectorAll('.sidebar a[href]:not([data-bs-toggle="collapse"])').forEach(function(link) {
                    link.addEventListener('click', function() {
                        document.querySelectorAll('.sidebar .active-link').forEach(function(el) {
                            el.classList.remove('active-link');
                        });
                        this.classList.add('active-link');

                        var parentCollapse = this.closest('.collapse');
                        if (parentCollapse) {
                            parentCollapse.classList.add('show');
                            var parentTrigger = document.querySelector('[data-bs-toggle="collapse"][href="#' + parentCollapse.id + '"]');
                            if (parentTrigger) {
                                parentTrigger.classList.add('active');
                                parentTrigger.setAttribute('aria-expanded', 'true');
                            }
                        }
                    });
                });
            }

            // Execute on DOM load
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', function() {
                    activateSidebarMenu();
                    setupMenuClickHandlers();
                });
            } else {
                activateSidebarMenu();
                setupMenuClickHandlers();
            }

            // Retry after short delay to ensure Bootstrap collapse is fully initialized
            setTimeout(activateSidebarMenu, 150);
        })();

        // Global Unified Spinner API
        function showGlobalSpinner(message) {
            var textEl = document.getElementById('global-spinner-text');
            var overlay = document.getElementById('global-spinner-overlay');
            if (textEl) {
                textEl.innerText = message || 'Processing...';
            }
            if (overlay) {
                overlay.classList.add('show');
            }
        }

        function hideGlobalSpinner() {
            var overlay = document.getElementById('global-spinner-overlay');
            if (overlay) {
                overlay.classList.remove('show');
            }
        }

        // Attach aliases to window object for global availability
        window.showGlobalSpinner = showGlobalSpinner;
        window.hideGlobalSpinner = hideGlobalSpinner;
        window.showSpinner = showGlobalSpinner;
        window.hideSpinner = hideGlobalSpinner;
        window.AppSpinner = {
            show: showGlobalSpinner,
            hide: hideGlobalSpinner
        };

        // Intercept global AJAX events to show spinner automatically when requested
        // Using jQuery global ajax event handlers
        $(document).ajaxSend(function(event, jqXHR, ajaxOptions) {
            if (ajaxOptions.showSpinner !== false) {
                // By default we don't intercept every single AJAX call unless we want to, 
                // but let's leave it manual for now unless specified.
                // Uncomment the line below to show globally for ALL ajax
                // showGlobalSpinner();
            }
        });
        
        $(document).ajaxComplete(function(event, jqXHR, ajaxOptions) {
            // hideGlobalSpinner();
        });

        // Global AJAX Error Handler for Session Expiration (401)
        $(document).ajaxError(function(event, jqXHR, ajaxSettings, thrownError) {
            if (jqXHR.status === 401 || (jqXHR.responseJSON && jqXHR.responseJSON.redirectToLogin)) {
                window.location.href = '@Url.Action("Index", "Auth")';
            }
        });

        // Auto-logout idle timer matching the 20-minute server session timeout
        (function() {
            var timeoutMs = 20 * 60 * 1000; // 20 minutes
            var logoutTimer;

            function resetTimer() {
                clearTimeout(logoutTimer);
                logoutTimer = setTimeout(function() {
                    window.location.href = '@Url.Action("LogoutGet", "Auth")';
                }, timeoutMs);
            }

            // Reset timer on user interactions
            window.addEventListener('mousemove', resetTimer, false);
            window.addEventListener('mousedown', resetTimer, false);
            window.addEventListener('keypress', resetTimer, false);
            window.addEventListener('touchmove', resetTimer, false);
            window.addEventListener('scroll', resetTimer, false);

            resetTimer(); // Initialize timer
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>