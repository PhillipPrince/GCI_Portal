    <!-- Active menu fix - Dynamic version -->
    <script>
        (function() {
            // Dynamically build menuItems from the DOM using data-controller attributes
            function buildMenuItems() {
                var menuItems = {};
                
                // Process all elements with data-controller attribute
                document.querySelectorAll('[data-controller]').forEach(function(el) {
                    var controller = el.getAttribute('data-controller');
                    
                    // Skip if already processed
                    if (menuItems[controller]) return;
                    
                    // Check if it's a submenu link (inside .collapse)
                    var parentCollapse = el.closest('.collapse');
                    if (parentCollapse) {
                        var parentId = parentCollapse.id;
                        menuItems[controller] = {
                            parentId: parentId,
                            triggerSelector: '[data-controller="' + controller + '"]'
                        };
                    } 
                    // Check if it's a standalone menu link (no data-bs-toggle)
                    else if (el.classList.contains('menu-link') && !el.hasAttribute('data-bs-toggle')) {
                        menuItems[controller] = { 
                            parentId: null, 
                            isSingle: true 
                        };
                    }
                    // Check if it's a trigger link (has data-bs-toggle)
                    else if (el.hasAttribute('data-bs-toggle')) {
                        // This is a parent menu item
                        var targetId = el.getAttribute('href').replace('#', '');
                        if (targetId) {
                            menuItems[controller] = {
                                parentId: targetId,
                                triggerSelector: '[data-controller="' + controller + '"]',
                                isParent: true
                            };
                        }
                    }
                });
                
                // Add dashboard special case
                var dashLink = document.querySelector('.sidebar a[data-controller="home"]');
                if (dashLink) {
                    menuItems['home'] = { parentId: null, isDashboard: true };
                }
                
                return menuItems;
            }
            
            function getActiveMenuFromUrl() {
                var currentPath = window.location.pathname.toLowerCase();
                var menuItems = buildMenuItems();
                
                // Find matching menu item by checking each controller name against URL
                for (var key in menuItems) {
                    if (currentPath.includes(key)) {
                        return menuItems[key];
                    }
                }
                
                // Special handling for child items that might have different controller names
                var allLinks = document.querySelectorAll('.submenu a[data-controller]');
                for (var i = 0; i < allLinks.length; i++) {
                    var link = allLinks[i];
                    var href = link.getAttribute('href');
                    if (href && (currentPath.endsWith(href.split('/').pop()) || 
                        currentPath.toLowerCase() === href.toLowerCase())) {
                        var controller = link.getAttribute('data-controller');
                        if (menuItems[controller]) {
                            return menuItems[controller];
                        }
                    }
                }
                
                // Check for dashboard
                if (currentPath === '/' || currentPath === '/home' || currentPath === '/home/index') {
                    return { parentId: null, isDashboard: true };
                }
                
                return null;
            }
            
            function openActiveSubmenu() {
                var active = getActiveMenuFromUrl();
                
                // Handle parent menu activation
                if (active && active.parentId) {
                    var submenuDiv = document.getElementById(active.parentId);
                    var triggerLink = document.querySelector(active.triggerSelector);
                    
                    if (submenuDiv && !submenuDiv.classList.contains('show')) {
                        var bsCollapse = new bootstrap.Collapse(submenuDiv, { toggle: false });
                        bsCollapse.show();
                        if (triggerLink) {
                            triggerLink.setAttribute('aria-expanded', 'true');
                            triggerLink.classList.add('active');
                        }
                    } else if (triggerLink && !triggerLink.classList.contains('active')) {
                        triggerLink.classList.add('active');
                    }
                } else if (active && active.isDashboard) {
                    var dashLink = document.querySelector('.sidebar a[data-controller="home"]');
                    if (dashLink) dashLink.classList.add('active');
                }
                
                // Highlight the actual active link
                var allSubLinks = document.querySelectorAll('.submenu a');
                allSubLinks.forEach(function(link) {
                    var linkHref = link.getAttribute('href');
                    if (linkHref && (window.location.pathname.endsWith(linkHref.split('/').pop()) ||
                        window.location.pathname.toLowerCase() === linkHref.toLowerCase())) {
                        
                        link.classList.add('active-link');
                        
                        var parentCollapse = link.closest('.collapse');
                        if (parentCollapse && !parentCollapse.classList.contains('show')) {
                            var parentId = parentCollapse.getAttribute('id');
                            var triggerBtn = document.querySelector('[data-bs-toggle="collapse"][href="#' + parentId + '"]');
                            if (triggerBtn) {
                                var bsCollapse = new bootstrap.Collapse(parentCollapse, { toggle: false });
                                bsCollapse.show();
                                triggerBtn.setAttribute('aria-expanded', 'true');
                                triggerBtn.classList.add('active');
                            }
                        } else if (parentCollapse && parentCollapse.classList.contains('show')) {
                            var parentTrigger = document.querySelector('[data-bs-toggle="collapse"][href="#' + parentCollapse.id + '"]');
                            if (parentTrigger) parentTrigger.classList.add('active');
                        }
                    }
                });
                
                // Also check standalone links (not in submenus)
                var standaloneLinks = document.querySelectorAll('.sidebar > .menu-link:not([data-bs-toggle])');
                standaloneLinks.forEach(function(link) {
                    var linkHref = link.getAttribute('href');
                    if (linkHref && (window.location.pathname.endsWith(linkHref.split('/').pop()) ||
                        window.location.pathname.toLowerCase() === linkHref.toLowerCase())) {
                        link.classList.add('active');
                    }
                });
            }
            
            // Initialize when DOM is ready
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', openActiveSubmenu);
            } else {
                openActiveSubmenu();
            }
            
            // Small delay to ensure Bootstrap is fully initialized
            setTimeout(openActiveSubmenu, 100);
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>