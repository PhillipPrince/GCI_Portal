<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GCI_Admin</title>

    <!-- ================= CSS ================= -->
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- DataTables -->
    <link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/buttons/2.4.1/css/buttons.bootstrap5.min.css" rel="stylesheet" />

    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

    <!-- Custom CSS -->
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />

    
</head>

<body>

    <!-- ================= SIDEBAR ================= -->
    <div class="sidebar">
        <!-- Dashboard link (always visible) -->
        <a href="@Url.Action("Index", "Home")" class="menu-link" data-controller="home">
            <i class="fa fa-home me-2"></i> Dashboard
        </a>

        <!-- MEMBERS -->
        <a data-bs-toggle="collapse" href="#membersMenu" class="menu-link" data-controller="members">
            <i class="fa fa-users me-2"></i> Members
        </a>
        <div id="membersMenu" class="collapse submenu">
            <a href="@Url.Action("Index", "Members")" data-controller="members">All Members</a>
        </div>

        <!-- CHURCH STRUCTURE -->
        <a data-bs-toggle="collapse" href="#churchMenu" class="menu-link" data-controller="church">
            <i class="fa fa-church me-2"></i> Church Structure
        </a>
        <div id="churchMenu" class="collapse submenu">
            <a href="@Url.Action("Index", "Assemblies")" data-controller="assemblies">Assemblies</a>
            <a href="@Url.Action("Index", "GrowthCenters")" data-controller="growthcenters">Growth Centers</a>
        </div>

        <!-- RCP & PLEDGES MENU -->
        <a data-bs-toggle="collapse" href="#rcpsMenu" class="menu-link" data-controller="rcps">
            <i class="fa fa-seedling me-2"></i> Rapid Church Planting (RCPS)
        </a>
        <div id="rcpsMenu" class="collapse submenu">
            <a href="@Url.Action("Index", "Rcps")" data-controller="rcps">Active Rcpss</a>
            <a href="@Url.Action("RcpsPledges", "Rcps")" data-controller="rcpspledges">Pledges & Giving</a>
        </div>

        <!-- LEADERSHIP -->
        <a data-bs-toggle="collapse" href="#leadershipMenu" class="menu-link" data-controller="leadership">
            <i class="fa fa-user-tie me-2"></i> Leadership
        </a>
        <div id="leadershipMenu" class="collapse submenu">
            <a href="@Url.Action("Index", "GECMember")" data-controller="gecmember">Central Leadership</a>
            <a href="@Url.Action("Elders", "Leadership")" data-controller="elders">Elders</a>
            <a href="@Url.Action("Deacons", "Leadership")" data-controller="deacons">Deacons</a>
        </div>

        <!-- MINISTRIES -->
        <a data-bs-toggle="collapse" href="#ministriesMenu" class="menu-link" data-controller="ministries">
            <i class="fa fa-cross me-2"></i> Ministries
        </a>
        <div id="ministriesMenu" class="collapse submenu">
            <a href="@Url.Action("Index", "Ministries")" data-controller="ministries">All Ministries</a>
        </div>

        <!-- EVENTS -->
        <a data-bs-toggle="collapse" href="#eventsMenu" class="menu-link" data-controller="events">
            <i class="fa fa-calendar me-2"></i> Events
        </a>
        <div id="eventsMenu" class="collapse submenu">
            <a href="@Url.Action("Index", "Event")" data-controller="event">Annual Calendar</a>
            <a href="@Url.Action("Index", "EventRegistrations")" data-controller="eventregistrations">Event Registrations</a>
        </div>

        <!-- CONTENT -->
        <a data-bs-toggle="collapse" href="#contentMenu" class="menu-link" data-controller="content">
            <i class="fa fa-bullhorn me-2"></i> Content & Media
        </a>
        <div id="contentMenu" class="collapse submenu">
            <a href="@Url.Action("Index", "Announcements")" data-controller="announcements">Announcements</a>
        </div>

        <!-- REPORTS MENU -->
        <a data-bs-toggle="collapse" href="#reportsMenu" class="menu-link" data-controller="reports">
            <i class="fa fa-chart-bar me-2"></i> Reports
        </a>
        <div id="reportsMenu" class="collapse submenu">
            <a href="@Url.Action("Index", "Reports")" data-controller="reportsdashboard">All Reports</a>
            <a href="@Url.Action("GrowthCenters", "Reports")" data-controller="growthcenterreports">Growth Centers Report</a>
            <a href="@Url.Action("Deacons", "Reports")" data-controller="deaconsreports">Deacons Report</a>
            <a href="@Url.Action("MinistryLeaders", "Reports")" data-controller="ministryleadersreports">Ministry Leaders Report</a>
        </div>

        <!-- FINANCE -->
        <a data-bs-toggle="collapse" href="#finance" class="menu-link" data-controller="finance">
            <i class="fa fa-money-bill-wave me-2"></i> Finance
        </a>
        <div id="finance" class="collapse submenu">
            <a href="@Url.Action("Index", "Finance")" data-controller="finance">Payments</a>
        </div>

        <!-- BENEVOLENCE -->
        <a data-bs-toggle="collapse" href="#benevolence" class="menu-link" data-controller="benevolence">
            <i class="fa fa-hand-holding-heart me-2"></i> Benevolence
        </a>
        <div id="benevolence" class="collapse submenu">
            <a href="@Url.Action("Index", "Benevolence")" data-controller="benevolence">Benevolence Members</a>
        </div>

        <!-- SETTINGS -->
        <a href="@Url.Action("Index", "SystemConfig")" class="menu-link" data-controller="systemconfig">
            <i class="fa fa-cogs me-2"></i> System Settings
        </a>
    </div>

    <!-- ================= TOPBAR ================= -->
    <div class="topbar">
        <div class="church-logo">
            <img src="~/images/church-logo.png" alt="Logo" />
            <span>GCI Church Admin Console</span>
        </div>

        <div class="dropdown">
            <a class="text-white dropdown-toggle d-flex align-items-center" data-bs-toggle="dropdown">
                <i class="fa fa-user-circle fa-2x me-2"></i>
                <span>@User.Identity?.Name</span>
            </a>

            <ul class="dropdown-menu dropdown-menu-end">
                <li>
                    <a class="dropdown-item" href="@Url.Action("Profile", "Account")">
                        <i class="fa fa-user me-2"></i> View Profile
                    </a>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <a class="dropdown-item" href="@Url.Action("Logout", "Auth")">
                        <i class="fa fa-sign-out-alt me-2"></i> Logout
                    </a>
                </li>
            </ul>
        </div>
    </div>

    <!-- ================= CONTENT ================= -->
    <div class="content">
        @RenderBody()
    </div>

    <!-- ================= FOOTER ================= -->
    <footer class="text-center py-3">
        &copy; 2026 - GCI_Admin | GCI Church
    </footer>

    <!-- ================= JAVASCRIPT ================= -->
    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- Bootstrap -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Select2 -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- DataTables -->
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <!-- DataTables Buttons -->
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.print.min.js"></script>

    <!-- Export Dependencies -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>

    <!-- Global DataTables Init -->
    <script src="~/js/datatables-global.js"></script>
    <script src="~/js/global-utils.js"></script>

    <!-- Custom JS -->
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Active menu fix - Dynamic version -->
    <script>
        (function() {
            // Dynamically build menuItems from the DOM using data-controller attributes
            function buildMenuItems() {
                var menuItems = {};
                
                // Process all elements with data-controller attribute
                document.querySelectorAll('[data-controller]').forEach(function(el) {
                    var controller = el.getAttribute('data-controller');
                    
                    // Skip if already processed
                    if (menuItems[controller]) return;
                    
                    // Check if it's a submenu link (inside .collapse)
                    var parentCollapse = el.closest('.collapse');
                    if (parentCollapse) {
                        var parentId = parentCollapse.id;
                        menuItems[controller] = {
                            parentId: parentId,
                            triggerSelector: '[data-controller="' + controller + '"]'
                        };
                    } 
                    // Check if it's a standalone menu link (no data-bs-toggle)
                    else if (el.classList.contains('menu-link') && !el.hasAttribute('data-bs-toggle')) {
                        menuItems[controller] = { 
                            parentId: null, 
                            isSingle: true 
                        };
                    }
                    // Check if it's a trigger link (has data-bs-toggle)
                    else if (el.hasAttribute('data-bs-toggle')) {
                        // This is a parent menu item
                        var targetId = el.getAttribute('href').replace('#', '');
                        if (targetId) {
                            menuItems[controller] = {
                                parentId: targetId,
                                triggerSelector: '[data-controller="' + controller + '"]',
                                isParent: true
                            };
                        }
                    }
                });
                
                // Add dashboard special case
                var dashLink = document.querySelector('.sidebar a[data-controller="home"]');
                if (dashLink) {
                    menuItems['home'] = { parentId: null, isDashboard: true };
                }
                
                return menuItems;
            }
            
            function getActiveMenuFromUrl() {
                var currentPath = window.location.pathname.toLowerCase();
                var menuItems = buildMenuItems();
                
                // Find matching menu item by checking each controller name against URL
                for (var key in menuItems) {
                    if (currentPath.includes(key)) {
                        return menuItems[key];
                    }
                }
                
                // Special handling for child items that might have different controller names
                var allLinks = document.querySelectorAll('.submenu a[data-controller]');
                for (var i = 0; i < allLinks.length; i++) {
                    var link = allLinks[i];
                    var href = link.getAttribute('href');
                    if (href && (currentPath.endsWith(href.split('/').pop()) || 
                        currentPath.toLowerCase() === href.toLowerCase())) {
                        var controller = link.getAttribute('data-controller');
                        if (menuItems[controller]) {
                            return menuItems[controller];
                        }
                    }
                }
                
                // Check for dashboard
                if (currentPath === '/' || currentPath === '/home' || currentPath === '/home/index') {
                    return { parentId: null, isDashboard: true };
                }
                
                return null;
            }
            
            function openActiveSubmenu() {
                var active = getActiveMenuFromUrl();
                
                // Handle parent menu activation
                if (active && active.parentId) {
                    var submenuDiv = document.getElementById(active.parentId);
                    var triggerLink = document.querySelector(active.triggerSelector);
                    
                    if (submenuDiv && !submenuDiv.classList.contains('show')) {
                        var bsCollapse = new bootstrap.Collapse(submenuDiv, { toggle: false });
                        bsCollapse.show();
                        if (triggerLink) {
                            triggerLink.setAttribute('aria-expanded', 'true');
                            triggerLink.classList.add('active');
                        }
                    } else if (triggerLink && !triggerLink.classList.contains('active')) {
                        triggerLink.classList.add('active');
                    }
                } else if (active && active.isDashboard) {
                    var dashLink = document.querySelector('.sidebar a[data-controller="home"]');
                    if (dashLink) dashLink.classList.add('active');
                }
                
                // Highlight the actual active link
                var allSubLinks = document.querySelectorAll('.submenu a');
                allSubLinks.forEach(function(link) {
                    var linkHref = link.getAttribute('href');
                    if (linkHref && (window.location.pathname.endsWith(linkHref.split('/').pop()) ||
                        window.location.pathname.toLowerCase() === linkHref.toLowerCase())) {
                        
                        link.classList.add('active-link');
                        
                        var parentCollapse = link.closest('.collapse');
                        if (parentCollapse && !parentCollapse.classList.contains('show')) {
                            var parentId = parentCollapse.getAttribute('id');
                            var triggerBtn = document.querySelector('[data-bs-toggle="collapse"][href="#' + parentId + '"]');
                            if (triggerBtn) {
                                var bsCollapse = new bootstrap.Collapse(parentCollapse, { toggle: false });
                                bsCollapse.show();
                                triggerBtn.setAttribute('aria-expanded', 'true');
                                triggerBtn.classList.add('active');
                            }
                        } else if (parentCollapse && parentCollapse.classList.contains('show')) {
                            var parentTrigger = document.querySelector('[data-bs-toggle="collapse"][href="#' + parentCollapse.id + '"]');
                            if (parentTrigger) parentTrigger.classList.add('active');
                        }
                    }
                });
                
                // Also check standalone links (not in submenus)
                var standaloneLinks = document.querySelectorAll('.sidebar > .menu-link:not([data-bs-toggle])');
                standaloneLinks.forEach(function(link) {
                    var linkHref = link.getAttribute('href');
                    if (linkHref && (window.location.pathname.endsWith(linkHref.split('/').pop()) ||
                        window.location.pathname.toLowerCase() === linkHref.toLowerCase())) {
                        link.classList.add('active');
                    }
                });
            }
            
            // Initialize when DOM is ready
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', openActiveSubmenu);
            } else {
                openActiveSubmenu();
            }
            
            // Small delay to ensure Bootstrap is fully initialized
            setTimeout(openActiveSubmenu, 100);
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>