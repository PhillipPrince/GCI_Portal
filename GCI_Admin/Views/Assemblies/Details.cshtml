@model GCI_Admin.Models.AssembliesData

@{
    ViewData["Title"] = "Assembly Details";
    var assembly = Model.Assembly.FirstOrDefault();
    var leaders = Model.AssemblyLeader;
}

<div class="row mb-4">
    <div class="col-md-8">
        <h2 class="fw-bold mb-1">@assembly?.Name</h2>
        <p class="text-muted mb-0">Assembly Details</p>
    </div>
    <div class="col-md-4 text-end">
        <a href="@Url.Action("Index", "Assemblies")" class="btn btn-outline-secondary">
            <i class="fa fa-arrow-left me-2"></i>Back to Assemblies
        </a>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-0 py-3">
                <h5 class="fw-bold mb-0">
                    <i class="fa fa-info-circle me-2 text-primary"></i>
                    Assembly Information
                </h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="border-bottom pb-3 mb-3">
                            <h6 class="text-muted mb-2">Location</h6>
                            <p class="fs-6 fw-medium mb-0">@(assembly?.Location ?? "N/A")</p>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="border-bottom pb-3 mb-3">
                            <h6 class="text-muted mb-2">Created At</h6>
                            <p class="fs-6 fw-medium mb-0">@(assembly?.CreatedAt.ToString("dd MMM yyyy") ?? "N/A")</p>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="border-bottom pb-3 mb-3">
                            <h6 class="text-muted mb-2">Contact Phone</h6>
                            <p class="fs-6 fw-medium mb-0">@(assembly?.ContactPhone ?? "N/A")</p>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="border-bottom pb-3 mb-3">
                            <h6 class="text-muted mb-2">Contact Email</h6>
                            <p class="fs-6 fw-medium mb-0">@(assembly?.ContactEmail ?? "N/A")</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0">
                    <i class="fa fa-users me-2 text-success"></i>
                    Assembly Leaders
                </h5>
                <span class="badge bg-success">@(leaders?.Count ?? 0) Leaders</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Member Name</th>
                                <th>Role Bio</th>
                                <th>Start Date</th>
                                <th>End Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (leaders != null && leaders.Any())
                            {
                                foreach (var leader in leaders)
                                {
                                    <tr>
                                        <td class="ps-4 fw-medium">
                                            <div class="d-flex align-items-center">
                                                @if (leader.Member != null && leader.Member.ProfileImage != null && leader.Member.ProfileImage.Length > 0)
                                                {
                                                    <img src="data:image/jpeg;base64,@Convert.ToBase64String(leader.Member.ProfileImage)" alt="Profile" class="rounded-circle me-3 border shadow-sm" style="width: 45px; height: 45px; object-fit: cover;">
                                                }
                                                else
                                                {
                                                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 45px; height: 45px; font-size: 1.2rem;">
                                                        <i class="fa fa-user"></i>
                                                    </div>
                                                }
                                                <div>
                                                    <div class="fw-bold">@(leader.Member != null ? $"{leader.Member.FirstName} {leader.Member.OtherNames}" : "Unknown")</div>
                                                    @if(leader.Member != null) {
                                                        <div class="text-muted small">@leader.Member.Phone</div>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(leader.Bio) && leader.Bio.Length > 40)
                                            {
                                                <span title="@leader.Bio">@leader.Bio.Substring(0, 40)...</span>
                                            }
                                            else
                                            {
                                                <span>@(leader.Bio ?? "N/A")</span>
                                            }
                                        </td>
                                        <td>@leader.StartDate.ToString("dd MMM yyyy")</td>
                                        <td>@(leader.EndDate.HasValue ? leader.EndDate.Value.ToString("dd MMM yyyy") : "Ongoing")</td>
                                        <td>
                                            @if (leader.IsActive)
                                            {
                                                <span class="badge bg-success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Inactive</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-4">
                                        No leaders assigned to this assembly yet.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</div>
