@model GCI_Admin.Models.AssembliesData

@{
    ViewData["Title"] = "Assemblies Management";
}

<!-- Page Header -->
<div class="row mb-4">
    <div class="col-md-8">
        <h2 class="fw-bold mb-1">Church Assemblies</h2>
        <p class="text-muted mb-0">Manage church branches and assembly leadership</p>
    </div>
    <div class="col-md-4 d-flex justify-content-end">
        <button class="btn btn-primary btn-lg" id="dynamicActionBtn">
            <i class="fa fa-plus-circle me-2"></i><span id="dynamicBtnText">Create New Assembly</span>
        </button>
    </div>
</div>

<!-- Tabs Navigation -->
<ul class="nav nav-tabs mb-4" id="assemblyTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="assemblies-tab" data-bs-toggle="tab" data-bs-target="#assemblies" type="button" role="tab" aria-controls="assemblies" aria-selected="true">
            <i class="fa fa-building me-2"></i>Assemblies
            <span class="badge bg-primary ms-2" id="assembliesCount">@Model.Assembly?.Count</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="leaders-tab" data-bs-toggle="tab" data-bs-target="#leaders" type="button" role="tab" aria-controls="leaders" aria-selected="false">
            <i class="fa fa-users me-2"></i>Assembly Leaders
            <span class="badge bg-primary ms-2" id="leadersCount">@Model.AssemblyLeader?.Count</span>
        </button>
    </li>
</ul>

<!-- Tab Content -->
<div class="tab-content" id="assemblyTabsContent">

    <!-- Assemblies Tab -->
    <div class="tab-pane fade show active" id="assemblies" role="tabpanel" aria-labelledby="assemblies-tab">

        <!-- Quick Stats for Assemblies -->
        <div class="row g-3 mb-4">
            <div class="col-md-4 col-6">
                <div class="card border-0 shadow-sm stat-card">
                    <div class="card-body d-flex align-items-center">
                        <div class="bg-primary bg-opacity-10 p-3 rounded-circle">
                            <i class="fa fa-building text-primary fa-2x"></i>
                        </div>
                        <div class="ms-3">
                            <h6 class="text-muted mb-1">Total Assemblies</h6>
                            <h3 class="fw-bold mb-0" id="totalAssemblies">@Model.Assembly?.Count</h3>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4 col-6">
                <div class="card border-0 shadow-sm stat-card">
                    <div class="card-body d-flex align-items-center">
                        <div class="bg-success bg-opacity-10 p-3 rounded-circle">
                            <i class="fa fa-map-marker text-success fa-2x"></i>
                        </div>
                        <div class="ms-3">
                            <h6 class="text-muted mb-1">Locations</h6>
                            <h3 class="fw-bold mb-0" id="totalLocations">@(Model.Assembly?.Select(a => a.Location).Distinct().Count() )</h3>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4 col-6">
                <div class="card border-0 shadow-sm stat-card">
                    <div class="card-body d-flex align-items-center">
                        <div class="bg-info bg-opacity-10 p-3 rounded-circle">
                            <i class="fa fa-calendar text-info fa-2x"></i>
                        </div>
                        <div class="ms-3">
                            <h6 class="text-muted mb-1">Active Leaders</h6>
                            <h3 class="fw-bold mb-0" id="activeLeaders">@(Model.AssemblyLeader?.Count(l => l.IsActive) )</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Filter Bar for Assemblies -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <div class="row g-3 align-items-center">
                    <div class="col-md-6">
                        <div class="input-group">
                            <span class="input-group-text bg-transparent border-end-0">
                                <i class="fa fa-search text-muted"></i>
                            </span>
                            <input type="text" class="form-control border-start-0" id="assemblySearch" placeholder="Search assemblies...">
                        </div>
                    </div>
                    <div class="col-md-6 text-end">
                        <button class="btn btn-outline-secondary me-2" onclick="clearAssemblyFilters()">
                            <i class="fa fa-times me-1"></i>Clear
                        </button>
                        <button class="btn btn-primary" onclick="applyAssemblyFilters()">
                            <i class="fa fa-filter me-1"></i>Apply
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Assemblies Table -->
        <div id="assembliesTableContainer">
            @await Html.PartialAsync("_AssembliesTable", Model.Assembly)
        </div>
    </div>

    <!-- Assembly Leaders Tab -->
    <div class="tab-pane fade" id="leaders" role="tabpanel" aria-labelledby="leaders-tab">

        <!-- Quick Stats for Leaders -->
        <div class="row g-3 mb-4">
            <div class="col-md-3 col-6">
                <div class="card border-0 shadow-sm stat-card">
                    <div class="card-body">
                        <h6 class="text-muted mb-1">Total Leaders</h6>
                        <h3 class="fw-bold mb-0" id="totalLeaders">@Model.AssemblyLeader?.Count</h3>
                    </div>
                </div>
            </div>

            <div class="col-md-3 col-6">
                <div class="card border-0 shadow-sm stat-card">
                    <div class="card-body">
                        <h6 class="text-muted mb-1">Active</h6>
                        <h3 class="fw-bold mb-0 text-success" id="activeLeadersCount">@(Model.AssemblyLeader?.Count(l => l.IsActive) )</h3>
                    </div>
                </div>
            </div>

            <div class="col-md-3 col-6">
                <div class="card border-0 shadow-sm stat-card">
                    <div class="card-body">
                        <h6 class="text-muted mb-1">Inactive</h6>
                        <h3 class="fw-bold mb-0 text-secondary" id="inactiveLeadersCount">@(Model.AssemblyLeader?.Count(l => !l.IsActive) )</h3>
                    </div>
                </div>
            </div>

            <div class="col-md-3 col-6">
                <div class="card border-0 shadow-sm stat-card">
                    <div class="card-body">
                        <h6 class="text-muted mb-1">Assemblies</h6>
                        <h3 class="fw-bold mb-0" id="totalAssembliesForLeaders">@Model.Assembly?.Count</h3>
                    </div>
                </div>
            </div>
        </div>

        <!-- Leaders Table -->
        <div id="leadersTableContainer">
            @await Html.PartialAsync("_AssemblLeadersTable", Model.AssemblyLeader)
        </div>
    </div>
</div>

<!-- Assembly Modal (keep existing modal) -->
<div class="modal fade" id="assemblyModal" tabindex="-1" aria-labelledby="assemblyModalLabel" aria-hidden="true">
    <!-- Modal content remains the same -->
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="assemblyModalLabel">
                    <i class="fa fa-building me-2"></i>
                    <span id="modalTitle">Add New Assembly</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="assemblyModalBody">
                <form id="assemblyForm">
                    <input type="hidden" id="assemblyId" name="Id" value="" />
                    <div class="mb-3">
                        <label for="assemblyName" class="form-label">Assembly Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="assemblyName" name="Name" placeholder="Enter assembly name" required>
                    </div>
                    <div class="mb-3">
                        <label for="assemblyLocation" class="form-label">Location <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="assemblyLocation" name="Location" placeholder="Enter location" required>
                    </div>
                    <div class="mb-3">
                        <label for="assemblyDescription" class="form-label">Description</label>
                        <textarea class="form-control" id="assemblyDescription" name="Description" rows="3" placeholder="Optional description"></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="assemblyEmail" class="form-label">Email (Optional)</label>
                        <input type="email" class="form-control" id="assemblyEmail" name="ContactEmail" placeholder="Enter email">
                    </div>
                    <div class="mb-3">
                        <label for="assemblyPhone" class="form-label">Phone (Optional)</label>
                        <input type="text" class="form-control" id="assemblyPhone" name="ContactPhone" placeholder="Enter phone number">
                    </div>
                    <div class="mb-3">
                        @await Html.PartialAsync("_MemberSelector", new GCI_Admin.Models.ViewModels.MemberSelectorViewModel { 
                            ControlId = "assemblyLeaderSelector",
                            LabelText = "Assembly Leader (Optional)",
                            MemberIdFieldName = "LeaderMemberId",
                            IsRequired = false
                        })
                    </div>
                    <div class="mb-3">
                        @await Html.PartialAsync("_ImagePicker", new GCI_Admin.Models.ImagePickerViewModel
                        {
                            ControlId = "assemblyLeaderImage",
                            LabelText = "Leader Profile Image (Optional)",
                            IconClass = "fa fa-user-circle-o",
                            HelpText = "Upload a profile image for the assembly leader. Recommended size: 400x400 pixels. Max size: 5MB",
                            UploadButtonText = "Choose Image",
                            PreviewWidth = 150,
                            PreviewHeight = 150,
                            MaxFileSizeMB = 5,
                            IsRequired = false,
                            Rounded = true,
                            FileInputName = "ProfileImage",
                            ImageUrlFieldName = "ProfileImageUrl",
                            Base64FieldName = "ProfileImageBase64"
                        })
                    </div>
                </form>
                <div class="text-center p-4 d-none" id="assemblyLoading">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="submitAssemblyForm()" id="saveAssemblyBtn">
                    <i class="fa fa-save me-1"></i>Save Assembly
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Branch Leader Modal - Loads the separated partial view -->
<div class="modal fade" id="leaderModal" tabindex="-1" aria-labelledby="leaderModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="leaderModalLabel">
                    <i class="fa fa-user-plus me-2"></i>Assign Assembly Leader
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <!-- Content will be loaded here -->
            <div id="leaderModalContent">
                <div class="text-center p-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2">Loading form...</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        let assemblies = [];
        let leaders = [];

        $(document).ready(function () {
            // Initialize tables
            initializeDataTables();

            // Handle tab changes - update button text and functionality
            const tabElements = document.querySelectorAll('#assemblyTabs button[data-bs-toggle="tab"]');
            tabElements.forEach(tabEl => {
                tabEl.addEventListener('shown.bs.tab', function (e) {
                    const tabId = e.target.id;
                    console.log("Tab switched to: " + tabId);
                    
                    if (tabId === 'leaders-tab') {
                        // Update button for Leaders tab
                        $('#dynamicBtnText').text('Add Assembly Leader');
                        $('#dynamicActionBtn').off('click').on('click', function(ev) {
                            ev.preventDefault();
                            openLeaderModal();
                        });
                        
                        // Adjust DataTable columns if DataTable exists
                        if (typeof $.fn.DataTable !== 'undefined' && $.fn.DataTable.isDataTable('#assemblyLeadersTable')) {
                            $('#assemblyLeadersTable').DataTable().columns.adjust().draw();
                        }
                    }
                    else if (tabId === 'assemblies-tab') {
                        // Update button for Assemblies tab
                        $('#dynamicBtnText').text('Create New Assembly');
                        $('#dynamicActionBtn').off('click').on('click', function(ev) {
                            ev.preventDefault();
                            $('#assemblyModal').modal('show');
                            $('#assemblyForm')[0].reset();
                            $('#assemblyId').val('');
                            $('#assemblyLoading').addClass('d-none');
                            $('#saveAssemblyBtn').prop('disabled', false);
                            $('#modalTitle').text('Add New Assembly');
                            if (typeof window['msClearSelection_assemblyLeaderSelector'] === 'function') {
                                window['msClearSelection_assemblyLeaderSelector']();
                            } else {
                                $('input[name="LeaderMemberId"]').val('');
                            }
                            if (typeof window.resetImagePicker === 'function') {
                                window.resetImagePicker('assemblyLeaderImage');
                            } else {
                                $('#assemblyLeaderImage_preview').attr('src', '/images/default-avatar.png').removeClass('image-preview-loaded');
                                $('#assemblyLeaderImage_fileData').val('');
                                $('#assemblyLeaderImage_url').val('');
                                $('#assemblyLeaderImage_clearBtn').hide();
                                $('#assemblyLeaderImage_fileInput').val('');
                            }
                        });
                        
                        // Adjust DataTable columns if DataTable exists
                        if (typeof $.fn.DataTable !== 'undefined' && $.fn.DataTable.isDataTable('#assembliesTable')) {
                            $('#assembliesTable').DataTable().columns.adjust().draw();
                        }
                    }
                });
            });

            // Set initial button state for active tab (Assemblies)
            $('#dynamicBtnText').text('Create New Assembly');
            $('#dynamicActionBtn').off('click').on('click', function(e) {
                e.preventDefault();
                $('#assemblyModal').modal('show');
                $('#assemblyForm')[0].reset();
                $('#assemblyId').val('');
                $('#assemblyLoading').addClass('d-none');
                $('#saveAssemblyBtn').prop('disabled', false);
                $('#modalTitle').text('Add New Assembly');
                if (typeof window['msClearSelection_assemblyLeaderSelector'] === 'function') {
                    window['msClearSelection_assemblyLeaderSelector']();
                } else {
                    $('input[name="LeaderMemberId"]').val('');
                }
                if (typeof window.resetImagePicker === 'function') {
                    window.resetImagePicker('assemblyLeaderImage');
                } else {
                    $('#assemblyLeaderImage_preview').attr('src', '/images/default-avatar.png').removeClass('image-preview-loaded');
                    $('#assemblyLeaderImage_fileData').val('');
                    $('#assemblyLeaderImage_url').val('');
                    $('#assemblyLeaderImage_clearBtn').hide();
                    $('#assemblyLeaderImage_fileInput').val('');
                }
            });
        });

        function openLeaderModal() {
            $('#leaderModal').modal('show');
            $('#leaderModalContent').html(`
                <div class="text-center p-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2">Loading form...</p>
                </div>
            `);
            
            $.ajax({
                url: '@Url.Action("LoadCreateForm", "Assemblies")',
                type: 'GET',
                success: function (response) {
                    $('#leaderModalContent').html(response);
                },
                error: function (xhr, status, error) {
                    $('#leaderModalContent').html(`
                        <div class="alert alert-danger m-3">
                            <i class="fa fa-exclamation-triangle me-2"></i>
                            Error loading form. Please try again.
                            <br><small>${error}</small>
                        </div>
                    `);
                    console.error("Error loading partial view:", error);
                }
            });
        }

        function updateStats() {
            if (assemblies && assemblies.length > 0) {
                const now = new Date();
                const currentMonth = now.getMonth();
                const currentYear = now.getFullYear();

                const monthAssemblies = assemblies.filter(a => {
                    const created = new Date(a.createdAt);
                    return created.getMonth() === currentMonth &&
                           created.getFullYear() === currentYear;
                }).length;

                const uniqueLocations = [...new Set(assemblies.map(a => a.location))];

                $('#totalAssemblies').text(assemblies.length);
                $('#assembliesCount').text(assemblies.length);
                $('#totalAssembliesForLeaders').text(assemblies.length);
                $('#totalLocations').text(uniqueLocations.length);
                $('#monthAssemblies').text(monthAssemblies);
            }
        }

        function updateLeaderStats() {
            if (leaders && leaders.length > 0) {
                const activeCount = leaders.filter(l => l.isActive).length;
                const inactiveCount = leaders.length - activeCount;

                $('#leadersCount').text(leaders.length);
                $('#totalLeaders').text(leaders.length);
                $('#activeLeadersCount').text(activeCount);
                $('#activeLeaders').text(activeCount);
                $('#inactiveLeadersCount').text(inactiveCount);
            }
        }

        function initializeDataTables() {
            // Both #assembliesTable and #assemblyLeadersTable have class 'datatable'
            // and are handled by the global GCIDataTable initializer if it exists
            if (typeof GCIDataTable !== 'undefined') {
                GCIDataTable.init('#assembliesTable');
                GCIDataTable.init('#assemblyLeadersTable');
            } else if ($.fn.DataTable) {
                // Fallback if GCIDataTable is not available
                if ($.fn.DataTable.isDataTable('#assembliesTable')) {
                    $('#assembliesTable').DataTable().destroy();
                }
                $('#assembliesTable').DataTable({ pageLength: 10 });
                
                if ($.fn.DataTable.isDataTable('#assemblyLeadersTable')) {
                    $('#assemblyLeadersTable').DataTable().destroy();
                }
                $('#assemblyLeadersTable').DataTable({ pageLength: 10 });
            }
        }

        // Assembly functions
        function applyAssemblyFilters() {
            const search = $('#assemblySearch').val();
            const table = $('#assembliesTable').DataTable();
            table.search(search).draw();
        }

        function clearAssemblyFilters() {
            $('#assemblySearch').val('');
            const table = $('#assembliesTable').DataTable();
            table.search('').draw();
        }

        function reloadAssembliesTable() {
            $('#assembliesTableContainer').load('@Url.Action("AssembliesTable", "Assemblies")', function () {
                initializeDataTables();
                loadData();
            });
        }

        function reloadLeadersTable() {
            $('#leadersTableContainer').load('@Url.Action("LeadersTable", "Assemblies")', function () {
                initializeDataTables();
                loadData();
            });
        }

        function deleteAssembly(id) {
            Swal.fire({
                title: "Are you sure?",
                text: "This will permanently delete this assembly.",
                icon: "warning",
                showCancelButton: true,
                confirmButtonText: "Yes, delete it",
                confirmButtonColor: "#d33"
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '@Url.Action("Delete", "Assemblies")?assemblyId=' + id,
                        type: 'DELETE',
                        success: function (response) {
                            Swal.fire("Deleted!", "Assembly deleted successfully.", "success")
                                .then(() => reloadAssembliesTable());
                        },
                        error: function (xhr) {
                            let msg = xhr.responseJSON?.message || "Failed to delete assembly.";
                            Swal.fire("Error", msg, "error");
                        }
                    });
                }
            });
        }

        // Leader functions
        function editLeader(id) {
            $('#leaderModal').modal('show');
            $('#leaderModalContent').html(`
                <div class="text-center p-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2">Loading form...</p>
                </div>
            `);
            
            $.ajax({
                url: '@Url.Action("LoadEditForm", "Assemblies")/' + id,
                type: 'GET',
                success: function (response) {
                    $('#leaderModalContent').html(response);
                },
                error: function (xhr, status, error) {
                    $('#leaderModalContent').html(`
                        <div class="alert alert-danger m-3">
                            <i class="fa fa-exclamation-triangle me-2"></i>
                            Error loading form. Please try again.
                            <br><small>${error}</small>
                        </div>
                    `);
                    console.error("Error loading partial view:", error);
                }
            });
        }

        function viewLeader(id) {
            window.location.href = '@Url.Action("Details", "Assemblies")/' + id;
        }

        async function toggleLeaderStatus(id, setActive) {
            var action = setActive ? 'activate' : 'deactivate';
            
            Swal.fire({
                title: `Confirm Status Change`,
                text: `Are you sure you want to ${action} this assembly leader?`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: `Yes, ${action}!`,
                cancelButtonText: 'Cancel'
            }).then(async (result) => {
                if (result.isConfirmed) {
                    try {
                        const response = await fetch(`@Url.Action("ToggleLeaderStatus", "Assemblies")?id=${id}&isActive=${setActive}`, {
                            method: 'POST',
                            headers: {
                                'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                            }
                        });

                        const resData = await response.json();

                        if (resData.success) {
                            Swal.fire("Success!", `Leader ${action}d successfully.`, "success")
                                .then(() => reloadLeadersTable());
                        } else {
                            Swal.fire("Error", resData.message || `Failed to ${action} leader.`, "error");
                        }
                    } catch (err) {
                        Swal.fire("Error", "An error occurred while updating status.", "error");
                    }
                }
            });
        }

        async function deleteLeader(id) {
            Swal.fire({
                title: "Are you sure?",
                text: "Are you sure you want to delete this assembly leader? This will perform a soft-delete.",
                icon: "warning",
                showCancelButton: true,
                confirmButtonText: "Yes, delete!",
                confirmButtonColor: "#d33"
            }).then(async (result) => {
                if (result.isConfirmed) {
                    try {
                        const response = await fetch(`@Url.Action("DeleteAssemblyLeader", "Assemblies")?id=${id}`, {
                            method: 'POST',
                            headers: {
                                'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                            }
                        });

                        const resData = await response.json();

                        if (resData.success) {
                            Swal.fire("Deleted!", "Leader deleted successfully.", "success")
                                .then(() => reloadLeadersTable());
                        } else {
                            Swal.fire("Error", resData.message || "Failed to delete assembly leader.", "error");
                        }
                    } catch (err) {
                        Swal.fire("Error", "An error occurred while deleting.", "error");
                    }
                }
            });
        }

        function loadData() {
            // Placeholder for loading data
            console.log("Assemblies & Leaders data loaded");
        }

        function submitAssemblyForm(e) {
            if (e) e.preventDefault();

            const form = document.getElementById('assemblyForm');

            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }

            const id = $('#assemblyId').val();
            const isEdit = id && id !== "0" && id !== "";

            const leaderVal = $('input[name="LeaderMemberId"]').val();
            const profileImageBase64 = $('input[name="ProfileImageBase64"]').val();

            const dto = {
                Name: $('#assemblyName').val()?.trim() || "",
                Location: $('#assemblyLocation').val()?.trim() || "",
                Description: $('#assemblyDescription').val()?.trim() || "",
                ContactEmail: $('#assemblyEmail').val()?.trim() || null,
                ContactPhone: $('#assemblyPhone').val()?.trim() || null,
                LeaderMemberId: leaderVal ? parseInt(leaderVal) : null,
                ProfileImageBase64: profileImageBase64 || null
            };

            $('#saveAssemblyBtn').prop('disabled', true);
            $('#assemblyLoading').removeClass('d-none');

            const url = isEdit ? `/Assemblies/Update?assemblyId=${id}` : '/Assemblies/SubmitNewAssembly';
            const method = isEdit ? 'PUT' : 'POST';

            $.ajax({
                url: url,
                type: method,
                contentType: 'application/json; charset=utf-8',
                dataType: 'json',
                data: JSON.stringify(dto),

                success: function (response) {
                    $('#assemblyLoading').addClass('d-none');
                    $('#saveAssemblyBtn').prop('disabled', false);

                    if (response.isSuccess) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Success',
                            text: isEdit ? 'Assembly updated successfully!' : 'Assembly created successfully!'
                        }).then(() => {
                            $('#assemblyModal').modal('hide');
                            reloadAssembliesTable();
                        });
                    } else {
                        Swal.fire('Error', response.message || 'Failed to save assembly.', 'error');
                    }
                },

                error: function (xhr) {
                    $('#assemblyLoading').addClass('d-none');
                    $('#saveAssemblyBtn').prop('disabled', false);

                    let message = "An unexpected error occurred.";
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        message = xhr.responseJSON.message;
                    }

                    Swal.fire('Error', message, 'error');
                }
            });
        }

        function editAssembly(id) {
            $.ajax({
                url: '/Assemblies/GetById?assemblyId=' + id,
                type: 'GET',
                success: function (response) {
                    if (response.isSuccess && response.data) {
                        const data = response.data;
                        const assembly = data.assembly || data; // handle backward compatibility
                        
                        $('#assemblyId').val(assembly.id);
                        $('#assemblyName').val(assembly.name);
                        $('#assemblyLocation').val(assembly.location);
                        $('#assemblyDescription').val(assembly.description);
                        $('#assemblyEmail').val(assembly.contactEmail);
                        $('#assemblyPhone').val(assembly.contactPhone);
                        
                        // Set the member selector value
                        if (data.leaderMemberId) {
                            if (typeof window['msSetSelectedMember_assemblyLeaderSelector'] === 'function') {
                                window['msSetSelectedMember_assemblyLeaderSelector'](data.leaderMemberId, data.leaderName || 'Current Leader');
                            } else {
                                $('input[name="LeaderMemberId"]').val(data.leaderMemberId);
                            }
                        } else {
                            if (typeof window['msClearSelection_assemblyLeaderSelector'] === 'function') {
                                window['msClearSelection_assemblyLeaderSelector']();
                            } else {
                                $('input[name="LeaderMemberId"]').val('');
                            }
                        }
                        
                        // Reset image picker
                        if (typeof window.resetImagePicker === 'function') {
                            window.resetImagePicker('assemblyLeaderImage');
                        } else {
                            $('#assemblyLeaderImage_preview').attr('src', '/images/default-avatar.png').removeClass('image-preview-loaded');
                            $('#assemblyLeaderImage_fileData').val('');
                            $('#assemblyLeaderImage_url').val('');
                            $('#assemblyLeaderImage_clearBtn').hide();
                            $('#assemblyLeaderImage_fileInput').val('');
                        }
                        
                        // Set the profile image if available
                        if (data.leaderProfileImage) {
                            $('#assemblyLeaderImage_preview').attr('src', data.leaderProfileImage).addClass('image-preview-loaded');
                            $('#assemblyLeaderImage_url').val(data.leaderProfileImage);
                            $('#assemblyLeaderImage_clearBtn').show();
                        }
                        
                        $('#modalTitle').text('Edit Assembly');
                        $('#assemblyModal').modal('show');
                    } else {
                        Swal.fire('Error', 'Failed to load assembly details.', 'error');
                    }
                },
                error: function () {
                    Swal.fire('Error', 'An error occurred while loading details.', 'error');
                }
            });
        }

        function viewAssembly(id) {
            // Usually redirects to Details page or opens a view-only modal
            window.location.href = '/Assemblies/Details/' + id;
        }

        // Make functions globally available
        window.deleteAssembly = deleteAssembly;
        window.editAssembly = editAssembly;
        window.viewAssembly = viewAssembly;
        window.editLeader = editLeader;
        window.viewLeader = viewLeader;
        window.toggleLeaderStatus = toggleLeaderStatus;
        window.deleteLeader = deleteLeader;
        window.applyAssemblyFilters = applyAssemblyFilters;
        window.clearAssemblyFilters = clearAssemblyFilters;
    </script>

