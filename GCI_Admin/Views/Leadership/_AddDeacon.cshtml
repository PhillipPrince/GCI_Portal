@model GCI_Admin.Models.NewDeacon

@{
    Layout = null;
    var isEdit = false;
    var formId = "createDeaconForm";
}

<div class="modal fade deacon-modal" id="addDeaconModal" tabindex="-1" aria-labelledby="addDeaconModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addDeaconModalLabel">
                    <i class="fa fa-user-plus me-2"></i>Add New Deacon
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <div class="modal-body">
                <form id="@formId">
                    @Html.AntiForgeryToken()

                    <div class="alert alert-info">
                        <i class="fa fa-info-circle me-2"></i>
                        Select a church member to appoint as a deacon. Only active members who are not already deacons will appear in the list.
                    </div>

                    @await Html.PartialAsync("_MemberSelector", new GCI_Admin.Models.ViewModels.MemberSelectorViewModel
                    {
                        ControlId = "deaconMemberSelector",
                        LabelText = "Select Member",
                        MemberIdFieldName = "MemberId",
                        SelectedMemberId = null,
                        Members = Model.MembersList?.Select(m => new GCI_Admin.Models.Member 
                        { 
                            Id = int.Parse(m.Value), 
                            FirstName = m.Text.Split('-')[0].Trim(),
                            OtherNames = "",
                            Email = m.Text.Contains('-') ? m.Text.Split('-')[1].Trim() : "",
                            Phone = "",
                            Gender = ""
                        }).ToList(),
                        IsRequired = true,
                        IsEdit = false,
                        ShowPhoneAndGender = false
                    })
                    
                    <div class="row mt-3">
                        <div class="col-12">
                            @await Html.PartialAsync("_ImagePicker", new GCI_Admin.Models.ImagePickerViewModel
                            {
                                ControlId = "deaconProfileImage",
                                LabelText = "Deacon Profile Image",
                                IconClass = "fa fa-user-circle-o",
                                HelpText = "Upload a profile image for the deacon. Recommended size: 400x400 pixels. Max size: 5MB",
                                UploadButtonText = "Choose Image",
                                CurrentImageUrl = null,
                                PreviewWidth = 150,
                                PreviewHeight = 150,
                                MaxFileSizeMB = 5,
                                IsRequired = false,
                                Rounded = true,
                                FileInputName = "ProfileImage",
                                ImageUrlFieldName = "ProfileImageUrl",
                                Base64FieldName = "ProfileImageBase64"
                            })
                        </div>
                    </div>

                    <div class="row mt-3">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">
                                <i class="fa fa-building-o me-1 text-primary"></i>Ministry
                                <span class="text-danger">*</span>
                            </label>
                            <select class="form-select" id="MinistryId" name="MinistryId" required>
                                <option value="">-- Select Ministry --</option>
                                @foreach (var ministry in Model.MinistriesList)
                                {
                                    <option value="@ministry.Value">@ministry.Text</option>
                                }
                            </select>
                            <span class="text-danger" id="ministryValidation"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">
                                <i class="fa fa-calendar me-1 text-primary"></i>Start Date
                                <span class="text-danger">*</span>
                            </label>
                            <input type="date" class="form-control" id="StartDate" name="StartDate" 
                                   value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                            <span class="text-danger" id="startDateValidation"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">
                            <i class="fa fa-align-left me-1 text-primary"></i>Biography
                        </label>
                        <textarea class="form-control" id="Bio" name="Bio" rows="4" 
                                  placeholder="Enter deacon's biography, service history, and other relevant information..."></textarea>
                        <small class="text-muted">Optional: Provide a brief biography of the deacon</small>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="IsActive" name="IsActive" checked>
                                <label class="form-check-label fw-bold" for="IsActive">
                                    <i class="fa fa-check-circle me-1 text-success"></i>Active Status
                                </label>
                            </div>
                            <small class="text-muted">Deacon will be active immediately</small>
                        </div>

                        <div class="col-md-6 mb-3">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="OnDuty" name="OnDuty">
                                <label class="form-check-label fw-bold" for="OnDuty">
                                    <i class="fa fa-clock-o me-1 text-warning"></i>Mark On Duty
                                </label>
                            </div>
                            <small class="text-muted">Mark deacon as currently on duty (only one deacon can be on duty at a time)</small>
                        </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="HasSpecialDuties" name="HasSpecialDuties">
                                <label class="form-check-label fw-bold" for="HasSpecialDuties">
                                    <i class="fa fa-star me-1 text-info"></i>Special Duties
                                </label>
                            </div>
                            <small class="text-muted">Deacon has special duties assigned</small>
                        </div>

                        <div class="col-md-6 mb-3">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="IsEmeritus" name="IsEmeritus">
                                <label class="form-check-label fw-bold" for="IsEmeritus">
                                    <i class="fa fa-graduation-cap me-1 text-primary"></i>Deacon Emeritus
                                </label>
                            </div>
                            <small class="text-muted">Honorary title for retired deacons</small>
                        </div>
                    </div>
                </form>
            </div>
            
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fa fa-times me-1"></i>Cancel
                </button>
                <button type="button" class="btn btn-primary" id="saveDeaconBtn" onclick="confirmAndSubmit()">
                    <span id="deaconLoading" class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                    <span id="saveBtnText">Save Deacon</span>
                </button>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    // Initialize form handling
    $(document).ready(function() {
        // Prevent default form submission
        $('#@formId').on('submit', function(e) {
            e.preventDefault();
            return false;
        });
    });

    // Function to show confirmation dialog before submission
    function confirmAndSubmit() {
        // Get all field values for the confirmation message
        const memberDisplayName = $('#deaconMemberSelector_display').val();
        const ministryName = $('#MinistryId option:selected').text();
        const startDate = $('#StartDate').val();
        const isActive = $('#IsActive').is(':checked');
        const onDuty = $('#OnDuty').is(':checked');
        const hasSpecialDuties = $('#HasSpecialDuties').is(':checked');
        const isEmeritus = $('#IsEmeritus').is(':checked');
        const bio = $('#Bio').val();
        const hasImage = $('#deaconProfileImage_fileData').val() ? 'Yes' : 'No';
        
        // Format dates for display
        const formattedStartDate = startDate ? new Date(startDate).toLocaleDateString() : 'Not specified';
        
        // Build confirmation message
        const confirmationTitle = 'Confirm Deacon Creation';
        const confirmationMessage = `
            <div style="text-align: left;">
                <p>Are you sure you want to appoint this member as a deacon?</p>
                <hr>
                <p><strong>Member:</strong> ${memberDisplayName || 'Not selected'}</p>
                <p><strong>Ministry:</strong> ${ministryName || 'Not selected'}</p>
                <p><strong>Start Date:</strong> ${formattedStartDate}</p>
                <p><strong>Status:</strong> ${isActive ? 'Active' : 'Inactive'}</p>
                <p><strong>On Duty:</strong> ${onDuty ? 'Yes' : 'No'}</p>
                <p><strong>Special Duties:</strong> ${hasSpecialDuties ? 'Yes' : 'No'}</p>
                <p><strong>Emeritus:</strong> ${isEmeritus ? 'Yes' : 'No'}</p>
                <p><strong>Profile Image:</strong> ${hasImage}</p>
                ${bio ? `<p><strong>Bio:</strong> ${bio.substring(0, 100)}${bio.length > 100 ? '...' : ''}</p>` : ''}
                <hr>
                <p class="text-info">Please review the information before confirming.</p>
            </div>
        `;
        
        // Show SweetAlert confirmation
        Swal.fire({
            title: confirmationTitle,
            html: confirmationMessage,
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, appoint deacon!',
            cancelButtonText: 'Cancel',
            showLoaderOnConfirm: true,
            preConfirm: async () => {
                try {
                    // Call the submit function
                    return await submitDeaconForm();
                } catch (error) {
                    Swal.showValidationMessage(`Request failed: ${error}`);
                }
            },
            allowOutsideClick: () => !Swal.isLoading()
        }).then((result) => {
            if (result.isConfirmed) {
                console.log('User confirmed the action');
            } else if (result.dismiss === Swal.DismissReason.cancel) {
                Swal.fire(
                    'Cancelled',
                    'Deacon appointment was cancelled',
                    'info'
                );
            }
        });
    }

    // Main submit function - Sending as JSON with Base64 image
    function submitDeaconForm() {
        return new Promise((resolve, reject) => {
            // Get all field values
            const memberId = $('#deaconMemberSelector_selectedId').val();
            const ministryId = $('#MinistryId').val();
            const startDate = $('#StartDate').val();
            const bio = $('#Bio').val();
            const onDuty = $('#OnDuty').is(':checked');
            const hasSpecialDuties = $('#HasSpecialDuties').is(':checked');
            const isEmeritus = $('#IsEmeritus').is(':checked');
            const token = $('input[name="__RequestVerificationToken"]').val();
            
            // Get image Base64 data from the image picker
            let profileImageBase64 = $('#deaconProfileImage_fileData').val();
            
            // If no image was uploaded, set to null or empty string
            if (!profileImageBase64 || profileImageBase64 === '') {
                profileImageBase64 = null;
            }

            // Validate member is selected
            if (!memberId || memberId === '') {
                Swal.fire('Validation Error', 'Please select a member', 'warning');
                reject('Member not selected');
                return;
            }

            // Validate ministry is selected
            if (!ministryId || ministryId === '') {
                Swal.fire('Validation Error', 'Please select a ministry', 'warning');
                reject('Ministry not selected');
                return;
            }

            // Validate start date
            if (!startDate) {
                Swal.fire('Validation Error', 'Please select a start date', 'warning');
                reject('Start date not selected');
                return;
            }

            // Disable button and show loading
            const $saveBtn = $('#saveDeaconBtn');
            const $loadingSpinner = $('#deaconLoading');
            const $btnText = $('#saveBtnText');
            
            $saveBtn.prop('disabled', true);
            $loadingSpinner.removeClass('d-none');
            const originalText = $btnText.text();
            $btnText.text('Saving...');

            // Prepare JSON data using DeaconDto structure
            const requestData = {
                MemberId: parseInt(memberId),
                MinistryId: ministryId,
                Bio: bio || '',
                StartDate: startDate,
                EndDate: null,  // EndDate is null for new deacons
                OnDuty: onDuty,
                HasSpecialDuties: hasSpecialDuties,
                IsEmeritus: isEmeritus,
                ProfileImageBase64: profileImageBase64
            };

            console.log("Submitting deacon form data with Base64 image:");
            console.log("URL:", '/Leadership/CreateDeacon');
            console.log("Has Image:", !!profileImageBase64);
            if (profileImageBase64) {
                console.log("Image Base64 Length:", profileImageBase64.length);
                console.log("Image Base64 Preview:", profileImageBase64.substring(0, 100) + "...");
            }
            console.log("Request Data:", {
                ...requestData,
                ProfileImageBase64: profileImageBase64 ? '[Base64 String]' : null
            });

            // Make AJAX request with JSON content type
            $.ajax({
                url: '/Leadership/CreateDeacon',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(requestData),
                timeout: 30000, // Increased timeout for image upload (30 seconds)
                headers: {
                    'RequestVerificationToken': token
                },
                success: function(response) {
                    console.log("Response:", response);
                    
                    // Reset button state
                    $saveBtn.prop('disabled', false);
                    $loadingSpinner.addClass('d-none');
                    $btnText.text(originalText);

                    if (response.isSuccess) {
                        // Show success message
                        Swal.fire({
                            icon: 'success',
                            title: 'Success!',
                            text: response.message || 'Deacon appointed successfully',
                            showConfirmButton: false,
                            timer: 1500
                        }).then(() => {
                            // Close modal and reload
                            $('#addDeaconModal').modal('hide');
                            location.reload();
                        });
                        resolve(response);
                    } else {
                        // Show error message
                        let errorMessage = response.message || 'Failed to appoint deacon.';
                        
                        // Handle validation errors
                        if (response.errors && response.errors.length > 0) {
                            errorMessage = response.errors.join('<br>');
                        }
                        
                        Swal.fire('Error', errorMessage, 'error');
                        reject(errorMessage);
                    }
                },
                error: function(xhr, status, error) {
                    // Reset button state
                    $saveBtn.prop('disabled', false);
                    $loadingSpinner.addClass('d-none');
                    $btnText.text(originalText);
                    
                    // Handle different error scenarios
                    let errorMessage = 'An unexpected error occurred.';
                    
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMessage = xhr.responseJSON.message;
                    } else if (xhr.status === 400) {
                        errorMessage = 'Invalid data sent to server. Please check the image size and format.';
                    } else if (xhr.status === 413) {
                        errorMessage = 'Image file is too large. Please use an image under 5MB.';
                    } else if (xhr.status === 0) {
                        errorMessage = 'Network error. Please check your connection.';
                    } else if (xhr.status === 404) {
                        errorMessage = 'Service endpoint not found. Please contact support.';
                    } else if (xhr.status === 500) {
                        errorMessage = 'Server error. Please try again later.';
                    }
                    
                    console.error('Form submission error:', xhr, status, error);
                    Swal.fire('Error', errorMessage, 'error');
                    reject(errorMessage);
                }
            });
        });
    }

    // Handle Enter key in form inputs
    $(document).on('keypress', '#@formId input, #@formId select, #@formId textarea', function(e) {
        if (e.which === 13 && !$(this).is('textarea')) {
            e.preventDefault();
            confirmAndSubmit();
        }
    });

    // Listen for member selection to validate
    $(document).on('memberSelected', function(e, data) {
        console.log('Member selected for deacon:', data);
        $('#deaconMemberSelector_validation').text('');
    });

    // Listen for image selection events
    $(document).on('imageSelected', function(e, data) {
        console.log('Image selected for deacon:', data.controlId);
        // You can add additional validation or preview logic here
    });

    $(document).on('imageCleared', function(e, data) {
        console.log('Image cleared for deacon:', data.controlId);
    });

    // Reset form when modal is closed
    $('#addDeaconModal').on('hidden.bs.modal', function() {
        // Clear member selector
        $('#deaconMemberSelector_display').val('');
        $('#deaconMemberSelector_selectedId').val('');
        
        // Clear image picker
        if (typeof clearImage === 'function') {
            // Clear without confirmation
            const controlId = 'deaconProfileImage';
            const fileInput = $('#' + controlId + '_fileInput');
            if (fileInput.length) {
                fileInput.val('');
                $('#' + controlId + '_preview').attr('src', '/images/default-avatar.png');
                $('#' + controlId + '_fileData').val('');
                $('#' + controlId + '_url').val('');
                $('#' + controlId + '_clearBtn').hide();
                clearImageError(controlId);
            }
        }
        
        // Reset other fields
        $('#MinistryId').val('');
        $('#Bio').val('');
        $('#StartDate').val(new Date().toISOString().split('T')[0]);
        $('#IsActive').prop('checked', true);
        $('#OnDuty').prop('checked', false);
        
        // Hide dropdowns and clear validation
        $('.dropdown-list').hide();
        $('#deaconMemberSelector_validation').text('');
        $('#ministryValidation').text('');
        $('#startDateValidation').text('');
    });
</script>