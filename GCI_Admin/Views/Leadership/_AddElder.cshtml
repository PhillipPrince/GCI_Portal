@model GCI_Admin.Models.DTOs.NewElder

@{
    Layout = null;
    var isEdit = false;
    var formId = "createElderForm";
}

<div class="modal fade elder-modal" id="addElderModal" tabindex="-1" aria-labelledby="addElderModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addElderModalLabel">
                    <i class="fa fa-user-plus me-2"></i>Add New Elder
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <div class="modal-body">
                <form id="@formId">
                    @Html.AntiForgeryToken()

                    <div class="alert alert-info">
                        <i class="fa fa-info-circle me-2"></i>
                        Select a church member to appoint as an elder. Only active members who are not already elders will appear in the list.
                    </div>

                    <!-- Member Selector Partial (GEC Format) -->
                    @await Html.PartialAsync("_MemberSelector", new GCI_Admin.Models.ViewModels.MemberSelectorViewModel
                    {
                        ControlId = "elderMemberSelector",
                        LabelText = "Select Member",
                        MemberIdFieldName = "MemberId",
                        SelectedMemberId = null,
                        Members = Model.MembersList?.Select(m => new GCI_Admin.Models.Member 
                        { 
                            Id = int.Parse(m.Value), 
                            FirstName = m.Text.Split('-')[0].Trim(),
                            OtherNames = "",
                            Email = m.Text.Contains('-') ? m.Text.Split('-')[1].Trim() : "",
                            Phone = "",
                            Gender = ""
                        }).ToList(),
                        IsRequired = true,
                        IsEdit = false,
                        ShowPhoneAndGender = false
                    })

                    <div class="row mt-3">
                        <div class="col-md-12 mb-3">
                            <label class="form-label fw-bold">
                                <i class="fa fa-calendar me-1 text-primary"></i>Date Ordained
                                <span class="text-danger">*</span>
                            </label>
                            <input type="date" class="form-control" id="DateOrdained" name="DateOrdained" 
                                   value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                            <span class="text-danger" id="dateOrdainedValidation"></span>
                            <small class="text-muted">The date when the member was ordained as an elder</small>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">
                            <i class="fa fa-align-left me-1 text-primary"></i>Description
                        </label>
                        <textarea class="form-control" id="Description" name="Description" rows="4" 
                                  placeholder="Enter elder's description, service history, qualifications, and other relevant information..."></textarea>
                        <small class="text-muted">Optional: Provide a brief description of the elder's role and responsibilities</small>
                    </div>

                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="IsActive" name="IsActive" checked>
                                <label class="form-check-label fw-bold" for="IsActive">
                                    <i class="fa fa-check-circle me-1 text-success"></i>Active Status
                                </label>
                            </div>
                            <small class="text-muted">Elder will be active immediately</small>
                        </div>
                    </div>
                </form>
            </div>
            
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fa fa-times me-1"></i>Cancel
                </button>
                <button type="button" class="btn btn-primary" id="saveElderBtn" onclick="confirmAndSubmit()">
                    <span id="elderLoading" class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                    <span id="saveBtnText">Save Elder</span>
                </button>
            </div>
        </div>
    </div>
</div>


<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    // Initialize form handling
    $(document).ready(function() {
        // Prevent default form submission
        $('#@formId').on('submit', function(e) {
            e.preventDefault();
            return false;
        });
    });

    // Function to show confirmation dialog before submission
    function confirmAndSubmit() {
        // Get all field values for the confirmation message
        const memberDisplayName = $('#elderMemberSelector_display').val();
        const dateOrdained = $('#DateOrdained').val();
        const isActive = $('#IsActive').is(':checked');
        const description = $('#Description').val();
        
        // Format dates for display
        const formattedDateOrdained = dateOrdained ? new Date(dateOrdained).toLocaleDateString() : 'Not specified';
        
        // Build confirmation message
        const confirmationTitle = 'Confirm Elder Appointment';
        const confirmationMessage = `
            <div style="text-align: left;">
                <p>Are you sure you want to appoint this member as an elder?</p>
                <hr>
                <p><strong>Member:</strong> ${memberDisplayName || 'Not selected'}</p>
                <p><strong>Date Ordained:</strong> ${formattedDateOrdained}</p>
                <p><strong>Status:</strong> ${isActive ? 'Active' : 'Inactive'}</p>
                ${description ? `<p><strong>Description:</strong> ${description.substring(0, 100)}${description.length > 100 ? '...' : ''}</p>` : ''}
                <hr>
                <p class="text-info">Please review the information before confirming.</p>
            </div>
        `;
        
        // Show SweetAlert confirmation
        Swal.fire({
            title: confirmationTitle,
            html: confirmationMessage,
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, appoint elder!',
            cancelButtonText: 'Cancel',
            showLoaderOnConfirm: true,
            preConfirm: async () => {
                try {
                    // Call the submit function
                    return await submitElderForm();
                } catch (error) {
                    Swal.showValidationMessage(`Request failed: ${error}`);
                }
            },
            allowOutsideClick: () => !Swal.isLoading()
        }).then((result) => {
            if (result.isConfirmed) {
                console.log('User confirmed the action');
            } else if (result.dismiss === Swal.DismissReason.cancel) {
                Swal.fire(
                    'Cancelled',
                    'Elder appointment was cancelled',
                    'info'
                );
            }
        });
    }

    // Main submit function - Sending as JSON
    function submitElderForm() {
        return new Promise((resolve, reject) => {
            // Get all field values
            const memberId = $('#elderMemberSelector_selectedId').val();
            const dateOrdained = $('#DateOrdained').val();
            const description = $('#Description').val();
            const isActive = $('#IsActive').is(':checked');
            const token = $('input[name="__RequestVerificationToken"]').val();

            // Validate member is selected
            if (!memberId || memberId === '') {
                Swal.fire('Validation Error', 'Please select a member', 'warning');
                reject('Member not selected');
                return;
            }

            // Validate date ordained
            if (!dateOrdained) {
                Swal.fire('Validation Error', 'Please select the date ordained', 'warning');
                reject('Date ordained not selected');
                return;
            }

            // Disable button and show loading
            const $saveBtn = $('#saveElderBtn');
            const $loadingSpinner = $('#elderLoading');
            const $btnText = $('#saveBtnText');
            
            $saveBtn.prop('disabled', true);
            $loadingSpinner.removeClass('d-none');
            const originalText = $btnText.text();
            $btnText.text('Saving...');

            // Prepare JSON data
            const requestData = {
                MemberId: parseInt(memberId),
                DateOrdained: dateOrdained,
                Description: description || '',
                IsActive: isActive
            };

            console.log("Submitting elder form data as JSON:");
            console.log("URL:", '/Leadership/CreateElder');
            console.log("Data:", requestData);

            // Make AJAX request with JSON content type
            $.ajax({
                url: '/Leadership/CreateElder',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(requestData),
                headers: {
                    'RequestVerificationToken': token
                },
                success: function(response) {
                    console.log("Response:", response);
                    
                    // Reset button state
                    $saveBtn.prop('disabled', false);
                    $loadingSpinner.addClass('d-none');
                    $btnText.text(originalText);

                    if (response.isSuccess) {
                        // Show success message
                        Swal.fire({
                            icon: 'success',
                            title: 'Success!',
                            text: response.message || 'Elder appointed successfully',
                            showConfirmButton: false,
                            timer: 1500
                        }).then(() => {
                            // Close modal and reload
                            $('#addElderModal').modal('hide');
                            location.reload();
                        });
                        resolve(response);
                    } else {
                        // Show error message
                        let errorMessage = response.message || 'Failed to appoint elder.';
                        
                        // Handle validation errors
                        if (response.errors && response.errors.length > 0) {
                            errorMessage = response.errors.join('<br>');
                        }
                        
                        Swal.fire('Error', errorMessage, 'error');
                        reject(errorMessage);
                    }
                },
                error: function(xhr, status, error) {
                    // Reset button state
                    $saveBtn.prop('disabled', false);
                    $loadingSpinner.addClass('d-none');
                    $btnText.text(originalText);
                    
                    // Handle different error scenarios
                    let errorMessage = 'An unexpected error occurred.';
                    
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMessage = xhr.responseJSON.message;
                    } else if (xhr.status === 400) {
                        errorMessage = 'Invalid data sent to server.';
                    } else if (xhr.status === 0) {
                        errorMessage = 'Network error. Please check your connection.';
                    } else if (xhr.status === 404) {
                        errorMessage = 'Service endpoint not found. Please contact support.';
                    } else if (xhr.status === 500) {
                        errorMessage = 'Server error. Please try again later.';
                    }
                    
                    console.error('Form submission error:', xhr, status, error);
                    Swal.fire('Error', errorMessage, 'error');
                    reject(errorMessage);
                }
            });
        });
    }

    // Handle Enter key in form inputs
    $(document).on('keypress', '#@formId input, #@formId select, #@formId textarea', function(e) {
        if (e.which === 13 && !$(this).is('textarea')) {
            e.preventDefault();
            confirmAndSubmit();
        }
    });

    // Listen for member selection to validate
    $(document).on('memberSelected', function(e, data) {
        console.log('Member selected for elder:', data);
        $('#elderMemberSelector_validation').text('');
    });

    // Reset form when modal is closed
    $('#addElderModal').on('hidden.bs.modal', function() {
        $('#elderMemberSelector_display').val('');
        $('#elderMemberSelector_selectedId').val('');
        $('#DateOrdained').val(new Date().toISOString().split('T')[0]);
        $('#Description').val('');
        $('#IsActive').prop('checked', true);
        $('.dropdown-list').hide();
        $('#elderMemberSelector_validation').text('');
        $('#dateOrdainedValidation').text('');
    });
</script>