@model List<GCI_Admin.Models.MeetingAttendance>
@using System.Security.Claims

@{
    var roleIdClaim = User.FindFirst("RoleId")?.Value ??
                     User.FindFirst(ClaimTypes.Role)?.Value ??
                     "0";
    int.TryParse(roleIdClaim, out int roleId);
    bool isFinance = roleId == 6;
    bool isAdmin = roleId == 1 || roleId == 2;
}

<div class="card shadow-sm">
    <div class="table-responsive p-3">
        <table id="meetingsAttendanceTable" class="table table-striped table-hover align-middle datatable">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Meeting Type</th>
                    <th>Meeting Date</th>
                    @if (!isFinance)
                    {
                        <th>Total Attendees</th>
                        <th>Male</th>
                        <th>Female</th>
                        <th>Children</th>
                        <th>Remarks</th>
                    }
                    <th>Recorded By</th>
                    <th>Created At</th>
                    <th>Actions</th>
                </tr>
                <!-- Filter Row -->
                <tr>
                    <th></th>
                    <th>
                        <select class="form-select form-select-sm meeting-type-filter">
                            <option value="">All Types</option>
                            <option value="Sunday Service">Sunday Service</option>
                            <option value="Midweek Service">Midweek Service</option>
                            <option value="Bible Study">Bible Study</option>
                            <option value="Prayer Meeting">Prayer Meeting</option>
                            <option value="Youth Service">Youth Service</option>
                            <option value="Children's Church">Children's Church</option>
                        </select>
                    </th>
                    <th>
                        <input type="text" placeholder="Search Date" class="form-control form-control-sm date-filter" />
                    </th>
                    @if (!isFinance)
                    {
                        <th>
                            <input type="text" placeholder="Min Attendees" class="form-control form-control-sm number-filter" />
                        </th>
                        <th>
                            <input type="text" placeholder="Min Male" class="form-control form-control-sm number-filter" />
                        </th>
                        <th>
                            <input type="text" placeholder="Min Female" class="form-control form-control-sm number-filter" />
                        </th>
                        <th>
                            <input type="text" placeholder="Min Children" class="form-control form-control-sm number-filter" />
                        </th>
                        <th>
                            <input type="text" placeholder="Search Remarks" class="form-control form-control-sm" />
                        </th>
                    }
                    <th>
                        <input type="text" placeholder="Search User ID" class="form-control form-control-sm" />
                    </th>
                    <th>
                        <input type="text" placeholder="Search Created Date" class="form-control form-control-sm" />
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any(m => m.IsActive))
                {
                    int count = 1;
                    var activeMeetings = Model.Where(m => m.IsActive).OrderByDescending(m => m.MeetingDate);
                    
                    foreach (var meeting in activeMeetings)
                    {
                        <tr>
                            <td>@count</td>
                            
                            <!-- Meeting Type with Badge -->
                            <td>
                                @if (meeting.MeetingType == "Sunday Service")
                                {
                                    <span class="badge bg-primary">
                                        <i class="fa fa-church me-1"></i> Sunday Service
                                    </span>
                                }
                                else if (meeting.MeetingType == "Midweek Service")
                                {
                                    <span class="badge bg-info text-dark">
                                        <i class="fa fa-calendar-week me-1"></i> Midweek Service
                                    </span>
                                }
                                else if (meeting.MeetingType == "Bible Study")
                                {
                                    <span class="badge bg-success">
                                        <i class="fa fa-bible me-1"></i> Bible Study
                                    </span>
                                }
                                else if (meeting.MeetingType == "Prayer Meeting")
                                {
                                    <span class="badge bg-warning text-dark">
                                        <i class="fa fa-pray me-1"></i> Prayer Meeting
                                    </span>
                                }
                                else if (meeting.MeetingType == "Youth Service")
                                {
                                    <span class="badge bg-danger">
                                        <i class="fa fa-users me-1"></i> Youth Service
                                    </span>
                                }
                                else if (meeting.MeetingType == "Children's Church")
                                {
                                    <span class="badge bg-secondary">
                                        <i class="fa fa-child me-1"></i> Children's Church
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-dark">@meeting.MeetingType</span>
                                }
                            </td>
                            
                            <!-- Meeting Date -->
                            <td>
                                <strong>@meeting.MeetingDate.ToString("dd MMM yyyy")</strong>
                                <div class="small text-muted">@meeting.MeetingDate.ToString("hh:mm tt")</div>
                            </td>
                            
                            @if (!isFinance)
                            {
                                <!-- Total Attendees -->
                                <td class="text-center">
                                    <span class="badge bg-primary fs-6">@meeting.TotalAttendees.ToString("N0")</span>
                                </td>
                                
                                <!-- Male Count -->
                                <td class="text-center">
                                    @if (meeting.MaleCount.HasValue)
                                    {
                                        <span class="badge bg-info">@meeting.MaleCount.Value.ToString("N0")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                
                                <!-- Female Count -->
                                <td class="text-center">
                                    @if (meeting.FemaleCount.HasValue)
                                    {
                                        <span class="badge bg-success">@meeting.FemaleCount.Value.ToString("N0")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                
                                <!-- Children Count -->
                                <td class="text-center">
                                    @if (meeting.ChildrenCount.HasValue)
                                    {
                                        <span class="badge bg-warning text-dark">@meeting.ChildrenCount.Value.ToString("N0")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                
                                <!-- Remarks -->
                                <td>
                                    @if (!string.IsNullOrEmpty(meeting.Remarks))
                                    {
                                        <span class="text-muted" data-bs-toggle="tooltip" title="@meeting.Remarks">
                                            <i class="fa fa-comment me-1"></i>
                                            @(meeting.Remarks.Length > 50 ? meeting.Remarks.Substring(0, 50) + "..." : meeting.Remarks)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                            }
                            
                            <!-- Recorded By -->
                            <td class="text-center">
                                <span class="badge bg-secondary">ID: @meeting.RecorderName</span>
                            </td>
                            
                            <!-- Created At -->
                            <td>
                                <div class="small">
                                    <div>@meeting.CreatedAt.ToString("dd MMM yyyy")</div>
                                    <div class="text-muted">@meeting.CreatedAt.ToString("hh:mm tt")</div>
                                </div>
                            </td>
                            
                            <!-- Actions -->
                            <td class="text-center">
                                <div class="btn-group" role="group">
                                    @if (isFinance)
                                    {
                                        <a href="@Url.Action("MeetingDetails", "Meetings", new { id = meeting.MeetingAttendancesId })"
                                               class="btn btn-sm btn-primary"
                                               data-bs-toggle="tooltip"
                                               title="Verify / View Collection Details">
                                            <i class="fa fa-money-bill-wave me-1"></i> Verify / View Collections
                                        </a>
                                    }
                                    else
                                    {
                                        <a href="@Url.Action("MeetingDetails", "Meetings", new { id = meeting.MeetingAttendancesId })"
                                               class="btn btn-sm btn-outline-info"
                                               data-bs-toggle="tooltip"
                                               title="View Meeting Details">
                                            <i class="fa fa-eye me-1"></i> View
                                        </a>
                                        @if (isAdmin)
                                        {
                                            <a href="@Url.Action("EditMeeting", "Meeting", new { id = meeting.MeetingAttendancesId })"
                                                   class="btn btn-sm btn-outline-warning"
                                                   data-bs-toggle="tooltip"
                                                   title="Edit Meeting">
                                                <i class="fa fa-edit me-1"></i> Edit
                                            </a>
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger"
                                                    onclick="deleteMeeting(@meeting.MeetingAttendancesId)"
                                                    data-bs-toggle="tooltip"
                                                    title="Delete Meeting">
                                                <i class="fa fa-trash me-1"></i> Delete
                                            </button>
                                        }
                                    }
                                </div>
                            </td>
                        </tr>
                        count++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="@(isFinance ? 6 : 11)" class="text-center text-muted py-4">
                            <i class="fa fa-church fa-2x mb-2 d-block"></i>
                            No meeting records found
                        </td>
                    </tr>
                }
            </tbody>
            @if (!isFinance)
            {
                <tfoot class="table-light fw-bold">
                    <tr>
                        <td colspan="3" class="text-end">Total Meetings:</td>
                        <td class="text-center">@Model?.Count(m => m.IsActive)</td>
                        <td colspan="7"></td>
                    </tr>
                    <tr>
                        <td colspan="3" class="text-end">Total Attendees (All Meetings):</td>
                        <td class="text-center">@Model?.Where(m => m.IsActive).Sum(m => m.TotalAttendees).ToString("N0")</td>
                        <td colspan="7"></td>
                    </tr>
                </tfoot>
            }
        </table>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteMeetingModal" tabindex="-1" aria-labelledby="deleteMeetingModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white border-0">
                <h5 class="modal-title fw-bold" id="deleteMeetingModalLabel">
                    <i class="fa fa-trash-alt me-2"></i>Confirm Delete
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <p class="mb-0">Are you sure you want to delete this meeting record?</p>
                <small class="text-muted">This action cannot be undone.</small>
            </div>
            <div class="modal-footer bg-light border-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteMeetingBtn">Delete</button>
            </div>
        </div>
    </div>
</div>

<style>
    .datatable input, .datatable select {
        font-size: 0.875rem;
    }
    
    .table th {
        font-weight: 600;
        color: #4a5568;
    }
    
    .table td {
        vertical-align: middle;
    }
    
    .btn-group .btn {
        margin: 0 2px;
    }
    
    tfoot tr td {
        background-color: #f8f9fa;
    }
    
    .badge {
        font-weight: 500;
        padding: 0.35rem 0.65rem;
    }
    
    .fa, .fas, .far {
        font-size: 0.875rem;
    }
</style>

<script>
    let meetingIdToDelete = null;

    $(document).ready(function() {
        // Initialize via global handler (handles standard text/select filter row)
        GCIDataTable.init('#meetingsAttendanceTable', { order: [[2, 'desc']] });
        var table = $('#meetingsAttendanceTable').DataTable();
        
        // Special: wire up numeric "min value" filters for columns 3-6
        var api = table;
        api.columns([3, 4, 5, 6]).every(function() {
            var column = this;
            var input = $(column.header()).find('input');
            input.on('keyup change', function() {
                var minValue = parseInt(this.value);
                // Remove previous custom search for this input
                $.fn.dataTable.ext.search = $.fn.dataTable.ext.search.filter(
                    function(fn) { return fn._columnIndex !== column.index(); }
                );
                if (!isNaN(minValue) && this.value !== '') {
                    var fn = function(settings, data, dataIndex) {
                        var value = parseInt(data[column.index()]) || 0;
                        return value >= minValue;
                    };
                    fn._columnIndex = column.index();
                    $.fn.dataTable.ext.search.push(fn);
                }
                table.draw();
            });
        });
        
        // Initialize tooltips
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        tooltipTriggerList.map(function(tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl);
        });
    });
    
    // Delete meeting function
    function deleteMeeting(id) {
        meetingIdToDelete = id;
        $('#deleteMeetingModal').modal('show');
    }
    
    // Confirm delete
    $('#confirmDeleteMeetingBtn').on('click', function() {
        if (meetingIdToDelete) {
            // Get anti-forgery token if needed
            var token = $('input[name="__RequestVerificationToken"]').val();
            
            $.ajax({
                url: '/Meeting/DeleteMeeting/' + meetingIdToDelete,
                type: 'DELETE',
                headers: {
                    'RequestVerificationToken': token
                },
                success: function(response) {
                    if (response.success) {
                        $('#deleteMeetingModal').modal('hide');
                        // Show success message
                        Swal.fire({
                            icon: 'success',
                            title: 'Deleted!',
                            text: 'Meeting record has been deleted.',
                            timer: 2000,
                            showConfirmButton: false
                        }).then(() => {
                            location.reload();
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: response.message || 'Failed to delete meeting'
                        });
                    }
                },
                error: function(xhr) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'An error occurred while deleting the meeting'
                    });
                }
            });
        }
    });
</script>