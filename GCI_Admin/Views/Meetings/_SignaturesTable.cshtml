@model List<GCI_Admin.Models.ServiceCollectionSignature>

@if (Model != null && Model.Any())
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white border-0 py-3">
            <h5 class="fw-bold mb-0">
                <i class="fa fa-signature me-2 text-warning"></i>Collection Signatures
            </h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Order</th>
                            <th>Signed By</th>
                            <th>Signed</th>
                            <th>Signed At</th>
                            <th>Verified</th>
                            <th>Verified At</th>
                            <th>OTP Channel</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var signature in Model.OrderBy(x => x.SignatureOrder))
                        {
                            <tr>
                                <td>@(signature.SignatureOrder ?? 0)</td>
                                <td>@signature.Name</td>
                                <td>
                                    @if (signature.IsSigned)
                                    {
                                        <span class="badge bg-success">
                                            <i class="fa fa-check-circle"></i> Yes
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            <i class="fa fa-times-circle"></i> No
                                        </span>
                                    }
                                </td>
                                <td>@(signature.SignedAt?.ToString("dd MMM yyyy hh:mm tt") ?? "—")</td>
                                <td>
                                    @if (signature.IsVerified)
                                    {
                                        <span class="badge bg-success">
                                            <i class="fa fa-check-circle"></i> Yes
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            <i class="fa fa-clock"></i> Pending
                                        </span>
                                    }
                                </td>
                                <td>@(signature.VerifiedAt?.ToString("dd MMM yyyy hh:mm tt") ?? "—")</td>
                                <td>@(string.IsNullOrEmpty(signature.OtpChannel) ? "—" : signature.OtpChannel)</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <td colspan="7">
                                <div class="row">
                                    <div class="col-md-6">
                                        <small class="text-muted">
                                            <i class="fa fa-check-circle text-success"></i> Signed: @Model.Count(x => x.IsSigned)
                                        </small>
                                    </div>
                                    <div class="col-md-6">
                                        <small class="text-muted">
                                            <i class="fa fa-check-double text-success"></i> Verified: @Model.Count(x => x.IsVerified)
                                        </small>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body text-center text-muted py-4">
            <i class="fa fa-signature fa-2x mb-2 d-block"></i>
            No signature records found
        </div>
    </div>
}