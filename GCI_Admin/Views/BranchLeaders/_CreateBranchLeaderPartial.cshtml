@model GCI_Admin.Models.DTOs.CreateAssemblyLeaderDto

@{
    var isEdit = ViewBag.IsEdit ?? false;
    var formId = isEdit ? "editBranchLeaderForm" : "createBranchLeaderForm";
    var action = isEdit ? "Update" : "Create";
}

<!-- Modal Body -->
<div class="modal-body">
    <form asp-action="@action" asp-controller="BranchLeaders" asp-route-id="@(isEdit ? Model?.AssemblyLeader?.AssemblyLeaderId : null)" method="post" id="@formId">
        @Html.AntiForgeryToken()

        @if (isEdit)
        {
            <input type="hidden" asp-for="AssemblyLeader.AssemblyLeaderId" id="AssemblyLeaderId" />
        }

        <div class="alert alert-info">
            <i class="fa fa-info-circle me-2"></i>
            Assign a member as a leader to an assembly. The member will be responsible for overseeing branch/assembly activities.
        </div>

        <!-- Member Selector Partial -->
        @await Html.PartialAsync("_MemberSelector", new GCI_Admin.Models.ViewModels.MemberSelectorViewModel
        {
            ControlId = "branchLeaderMemberSelector",
            LabelText = "Select Member",
            MemberIdFieldName = "MemberId",
            SelectedMemberId = Model?.AssemblyLeader?.MemberId,
            Members = Model?.Members,
            IsRequired = true,
            IsEdit = isEdit,
            ShowPhoneAndGender = true
        })

        <hr />

        <div class="row mt-3">
            <div class="col-12">
                @await Html.PartialAsync("_ImagePicker", new GCI_Admin.Models.ImagePickerViewModel
                {
                    ControlId = "branchLeaderProfileImage",
                    LabelText = "Profile Image",
                    IconClass = "fa fa-user-circle-o",
                    HelpText = "Upload a profile image for the assembly leader. Recommended size: 400x400 pixels. Max size: 5MB",
                    UploadButtonText = "Choose Image",
                    CurrentImageUrl = Model?.AssemblyLeader?.MemberId != null ? $"/uploads/{Model.AssemblyLeader.MemberId}.jpg" : null,
                    PreviewWidth = 150,
                    PreviewHeight = 150,
                    MaxFileSizeMB = 5,
                    IsRequired = false,
                    Rounded = true,
                    FileInputName = "ProfileImage",
                    ImageUrlFieldName = "ProfileImageUrl",
                    Base64FieldName = "ProfileImageBase64"
                })
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label fw-bold">Branch / Assembly <span class="text-danger">*</span></label>
                <select asp-for="AssemblyLeader.AssemblyId" class="form-select" id="AssemblyId" name="AssemblyId" required>
                    <option value="">-- Select Branch --</option>
                    @if (Model?.Assemblies != null)
                    {
                        foreach (var assembly in Model.Assemblies)
                        {
                            <option value="@assembly.Id" selected="@(Model?.AssemblyLeader?.AssemblyId == assembly.Id)">@assembly.Name</option>
                        }
                    }
                </select>
                <span asp-validation-for="AssemblyLeader.AssemblyId" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label fw-bold">Start Date <span class="text-danger">*</span></label>
                <input asp-for="AssemblyLeader.StartDate" type="date" class="form-control" id="StartDate" name="StartDate" required
                       value="@(Model?.AssemblyLeader?.StartDate.ToString("yyyy-MM-dd") ?? DateTime.Today.ToString("yyyy-MM-dd"))">
                <span asp-validation-for="AssemblyLeader.StartDate" class="text-danger"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12 mb-3">
                <label class="form-label fw-bold">Bio / Description</label>
                <textarea asp-for="AssemblyLeader.Bio" class="form-control" id="Bio" name="Bio" rows="3" maxlength="500"
                          placeholder="Brief biography, qualifications, or role description..."></textarea>
                <span asp-validation-for="AssemblyLeader.Bio" class="text-danger"></span>
                <small class="text-muted">Optional: Provide a brief description of the leader's role and responsibilities</small>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label fw-bold">End Date</label>
                <input asp-for="AssemblyLeader.EndDate" type="date" class="form-control" id="EndDate" name="EndDate"
                       value="@(Model?.AssemblyLeader?.EndDate?.ToString("yyyy-MM-dd"))">
                <span asp-validation-for="AssemblyLeader.EndDate" class="text-danger"></span>
                <small class="text-muted">Leave empty if currently serving</small>
            </div>
            <div class="col-md-6 mb-3 d-flex align-items-center">
                <div class="form-check form-switch mt-4">
                    <input asp-for="AssemblyLeader.IsActive" class="form-check-input" type="checkbox" id="IsActive" name="IsActive"
                           checked="@(Model?.AssemblyLeader?.IsActive ?? true)">
                    <label class="form-check-label fw-bold" asp-for="AssemblyLeader.IsActive">Active Leader</label>
                </div>
            </div>
        </div>
    </form>
</div>

<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
    <button type="button" class="btn btn-primary" onclick="confirmAndSubmitBranchLeader()" id="saveBranchLeaderBtn">
        <span class="spinner-border spinner-border-sm d-none" id="branchLeaderLoading" role="status" aria-hidden="true"></span>
        <span id="saveBtnText">@(isEdit ? "Save Changes" : "Assign Leader")</span>
    </button>
</div>

<script>
    $(document).ready(function() {
        $('#@formId').on('submit', function(e) {
            e.preventDefault();
            return false;
        });

        if (typeof initializeCustomDropdown === 'function') {
            initializeCustomDropdown('branchLeaderMemberSelector');
        }
    });

    function confirmAndSubmitBranchLeader() {
        const isEdit = '@isEdit'.toLowerCase() === 'true';
        const memberDisplayName = $('#branchLeaderMemberSelector_display').val();
        const assemblyName = $('#AssemblyId option:selected').text();
        const startDate = $('#StartDate').val();
        const endDate = $('#EndDate').val();
        const isActive = $('#IsActive').is(':checked');
        const bio = $('#Bio').val();

        const formattedStartDate = startDate ? new Date(startDate).toLocaleDateString() : 'Not specified';
        const formattedEndDate = endDate ? new Date(endDate).toLocaleDateString() : 'Currently serving';

        let confirmationMessage = '';
        let confirmationTitle = '';

        if (isEdit) {
            confirmationTitle = 'Confirm Update';
            confirmationMessage = `
                <div style="text-align: left;">
                    <p>Are you sure you want to update this assembly leader?</p>
                    <hr>
                    <p><strong>Member:</strong> ${memberDisplayName || 'Not selected'}</p>
                    <p><strong>Assembly:</strong> ${assemblyName || 'Not selected'}</p>
                    <p><strong>Start Date:</strong> ${formattedStartDate}</p>
                    <p><strong>End Date:</strong> ${formattedEndDate}</p>
                    <p><strong>Status:</strong> ${isActive ? 'Active' : 'Inactive'}</p>
                    ${bio ? `<p><strong>Bio:</strong> ${bio.substring(0, 100)}${bio.length > 100 ? '...' : ''}</p>` : ''}
                    <hr>
                    <p class="text-warning">This action will update the leader's information in the system.</p>
                </div>
            `;
        } else {
            confirmationTitle = 'Confirm Assignment';
            confirmationMessage = `
                <div style="text-align: left;">
                    <p>Are you sure you want to assign this member as an assembly leader?</p>
                    <hr>
                    <p><strong>Member:</strong> ${memberDisplayName || 'Not selected'}</p>
                    <p><strong>Assembly:</strong> ${assemblyName || 'Not selected'}</p>
                    <p><strong>Start Date:</strong> ${formattedStartDate}</p>
                    <p><strong>End Date:</strong> ${formattedEndDate}</p>
                    <p><strong>Status:</strong> ${isActive ? 'Active' : 'Inactive'}</p>
                    ${bio ? `<p><strong>Bio:</strong> ${bio.substring(0, 100)}${bio.length > 100 ? '...' : ''}</p>` : ''}
                    <hr>
                    <p class="text-info">Please review the information before confirming.</p>
                </div>
            `;
        }

        Swal.fire({
            title: confirmationTitle,
            html: confirmationMessage,
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: isEdit ? 'Yes, update it!' : 'Yes, assign leader!',
            cancelButtonText: 'Cancel',
            showLoaderOnConfirm: true,
            preConfirm: async () => {
                try {
                    return await submitBranchLeaderForm();
                } catch (error) {
                    Swal.showValidationMessage(`Request failed: ${error}`);
                }
            },
            allowOutsideClick: () => !Swal.isLoading()
        });
    }

    function submitBranchLeaderForm() {
        return new Promise((resolve, reject) => {
            const isEdit = '@isEdit'.toLowerCase() === 'true';
            const formId = isEdit ? 'editBranchLeaderForm' : 'createBranchLeaderForm';
            const form = $('#' + formId);

            if (!form.length) {
                reject('Form not found');
                Swal.fire('Error', 'Form not found', 'error');
                return;
            }

            const leaderId = $('#AssemblyLeaderId').val() || '0';
            const memberId = $('#branchLeaderMemberSelector_selectedId').val();
            const assemblyId = $('#AssemblyId').val();
            const bio = $('#Bio').val();
            const startDate = $('#StartDate').val();
            const endDate = $('#EndDate').val();
            const isActive = $('#IsActive').is(':checked');

            if (!form[0].checkValidity()) {
                form[0].reportValidity();
                reject('Validation failed');
                Swal.fire('Validation Error', 'Please fill all required fields correctly', 'warning');
                return;
            }

            if (!memberId || memberId === '') {
                Swal.fire('Validation Error', 'Please select a member', 'warning');
                reject('Member not selected');
                return;
            }

            if (!assemblyId || assemblyId === '') {
                Swal.fire('Validation Error', 'Please select an assembly', 'warning');
                reject('Assembly not selected');
                return;
            }

            if (!startDate) {
                Swal.fire('Validation Error', 'Please select a start date', 'warning');
                reject('Start date not selected');
                return;
            }

            if (endDate && new Date(endDate) < new Date(startDate)) {
                Swal.fire('Validation Error', 'End date cannot be earlier than start date', 'warning');
                reject('Invalid date range');
                return;
            }

            const $saveBtn = $('#saveBranchLeaderBtn');
            const $loadingSpinner = $('#branchLeaderLoading');
            const $btnText = $('#saveBtnText');

            $saveBtn.prop('disabled', true);
            $loadingSpinner.removeClass('d-none');
            const originalText = $btnText.text();
            $btnText.text('Saving...');

            const token = $('input[name="__RequestVerificationToken"]', form).val();
            const url = isEdit ? `/BranchLeaders/Update/${leaderId}` : '/BranchLeaders/Create';

            const requestData = {
                AssemblyLeaderId: parseInt(leaderId) || 0,
                MemberId: parseInt(memberId),
                AssemblyId: parseInt(assemblyId),
                Bio: bio || '',
                StartDate: startDate,
                EndDate: endDate || null,
                IsActive: isActive,
                ProfileImageBase64: $('#branchLeaderProfileImage_base64').val() || null
            };

            $.ajax({
                url: url,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(requestData),
                headers: {
                    'RequestVerificationToken': token
                },
                success: function(response) {
                    $saveBtn.prop('disabled', false);
                    $loadingSpinner.addClass('d-none');
                    $btnText.text(originalText);

                    if (response.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Success!',
                            text: response.message || `Leader ${isEdit ? 'updated' : 'assigned'} successfully`,
                            showConfirmButton: false,
                            timer: 1500
                        }).then(() => {
                            $('#leaderModal').modal('hide');
                            location.reload();
                        });
                        resolve(response);
                    } else {
                        let errorMessage = response.message || 'Failed to save assembly leader.';
                        if (response.errors && response.errors.length > 0) {
                            errorMessage = response.errors.join('<br>');
                        }
                        Swal.fire('Error', errorMessage, 'error');
                        reject(errorMessage);
                    }
                },
                error: function(xhr, status, error) {
                    $saveBtn.prop('disabled', false);
                    $loadingSpinner.addClass('d-none');
                    $btnText.text(originalText);

                    let errorMessage = 'An unexpected error occurred.';
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMessage = xhr.responseJSON.message;
                    }
                    Swal.fire('Error', errorMessage, 'error');
                    reject(errorMessage);
                }
            });
        });
    }

    $(document).on('keypress', '#@formId input, #@formId select, #@formId textarea', function(e) {
        if (e.which === 13 && !$(this).is('textarea')) {
            e.preventDefault();
            confirmAndSubmitBranchLeader();
        }
    });

    $(document).on('memberSelected', function(e, data) {
        $('#branchLeaderMemberSelector_validation').text('');
    });
</script>
