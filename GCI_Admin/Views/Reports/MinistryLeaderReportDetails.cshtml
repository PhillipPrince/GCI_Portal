@model GCI_Admin.Models.MinistryLeaderReport

@{
    ViewData["Title"] = "Ministry Leader Report Details";
}

<style>
    /* Custom animations and hover effects */
    .stat-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        cursor: pointer;
    }
    
        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.1) !important;
        }
    
    .gradient-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
    }
    
    .info-row {
        transition: background-color 0.2s ease;
        border-radius: 8px;
        padding: 12px;
        margin-bottom: 8px;
    }
    
        .info-row:hover {
            background-color: #f8f9fa;
        }
    
    .badge-modern {
        padding: 8px 16px;
        font-size: 0.9rem;
        border-radius: 20px;
        font-weight: 500;
    }
    
    .icon-circle {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
    }
    
    .activity-card {
        border-left: 4px solid;
        transition: all 0.3s ease;
    }
    
        .activity-card:hover {
            transform: translateX(5px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.08);
        }
    
    .glass-effect {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(10px);
    }
    
    .timeline-item {
        position: relative;
        padding-left: 20px;
        border-left: 2px solid #e0e0e0;
        margin-bottom: 20px;
    }
    
        .timeline-item::before {
            content: '';
            position: absolute;
            left: -6px;
            top: 0;
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: #667eea;
        }
</style>

<!-- Modern Page Header with Gradient -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card border-0 shadow-lg gradient-header rounded-4 overflow-hidden">
            <div class="card-body p-4">
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <div class="d-flex align-items-center mb-2">
                            <i class="fa fa-church fa-3x me-3"></i>
                            <div>
                                <h1 class="fw-bold mb-1 text-white">Ministry Leader Report</h1>
                                <p class="text-white-50 mb-0">Detailed report information and analysis</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="d-flex gap-2 justify-content-md-end mt-3 mt-md-0">
                            <a href="@Url.Action("MinistryLeaderReports", "Reports")" class="btn btn-light btn-lg shadow-sm">
                                <i class="fa fa-arrow-left me-2"></i>Back
                            </a>
                            <button class="btn btn-warning btn-lg shadow-sm" onclick="window.print()">
                                <i class="fa fa-print me-2"></i>Print
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Statistics Summary Cards -->
<div class="row mb-4 g-3">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm stat-card rounded-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-1">Total Members</p>
                        <h2 class="fw-bold mb-0 text-primary">@Model.TotalRegisteredMembers</h2>
                    </div>
                    <div class="icon-circle bg-primary bg-opacity-10">
                        <i class="fa fa-users text-primary"></i>
                    </div>
                </div>
                <div class="mt-2">
                    <small class="text-success">
                        <i class="fa fa-check-circle"></i> Registered
                    </small>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm stat-card rounded-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-1">Calendar Activity</p>
                        <h2 class="fw-bold mb-0 text-info">
                            @(Model.HadCalendarActivity ? "Yes" : "No")
                        </h2>
                    </div>
                    <div class="icon-circle bg-info bg-opacity-10">
                        <i class="fa fa-calendar text-info"></i>
                    </div>
                </div>
                @if (Model.HadCalendarActivity && Model.CalendarActivityAttendance.HasValue)
                {
                    <div class="mt-2">
                        <small class="text-info">
                            <i class="fa fa-users"></i> @Model.CalendarActivityAttendance attended
                        </small>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm stat-card rounded-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-1">Other Meetings</p>
                        <h2 class="fw-bold mb-0 text-warning">
                            @(Model.HadOtherMeetings ? "Yes" : "No")
                        </h2>
                    </div>
                    <div class="icon-circle bg-warning bg-opacity-10">
                        <i class="fa fa-users text-warning"></i>
                    </div>
                </div>
                @if (Model.HadOtherMeetings && Model.OtherMeetingAttendance.HasValue)
                {
                    <div class="mt-2">
                        <small class="text-warning">
                            <i class="fa fa-users"></i> @Model.OtherMeetingAttendance attended
                        </small>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm stat-card rounded-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-1">Report Status</p>
                        <h2 class="fw-bold mb-0">
                            @if (Model.IsActive)
                            {
                                <span class="text-success">Active</span>
                            }
                            else
                            {
                                <span class="text-danger">Inactive</span>
                            }
                        </h2>
                    </div>
                    <div class="icon-circle bg-success bg-opacity-10">
                        <i class="fa fa-flag-checkered text-success"></i>
                    </div>
                </div>
                <div class="mt-2">
                    <small class="text-muted">
                        <i class="fa fa-calendar"></i> @Model.ReportingMonth.ToString("MMM yyyy")
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Main Information Column -->
    <div class="col-lg-7">
        <!-- Report Information Card - Modern Timeline Style -->
        <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
            <div class="card-header bg-white py-3 border-0">
                <h5 class="mb-0 fw-bold">
                    <i class="fa fa-info-circle me-2 text-primary"></i>Report Information
                </h5>
            </div>
            <div class="card-body pt-0">
                <div class="timeline-item">
                    <label class="text-muted small text-uppercase mb-1">Ministry</label>
                    <div class="fw-bold fs-5">@Model.Ministry?.MinistryName</div>
                </div>
                <div class="timeline-item">
                    <label class="text-muted small text-uppercase mb-1">Submitted By</label>
                    <div class="fw-bold">
                        @if (Model.SubmittedByMinistryLeader?.Member != null)
                        {
                            <div class="d-flex align-items-center">
                                <i class="fa fa-user-circle fa-2x me-2 text-primary"></i>
                                <div>
                                    @Model.SubmittedByMinistryLeaderName
                                    <small class="d-block text-muted">Ministry Leader</small>
                                </div>
                            </div>
                        }
                        else
                        {
                            <span class="text-muted">Not available</span>
                        }
                    </div>
                </div>
                <div class="timeline-item">
                    <label class="text-muted small text-uppercase mb-1">Reporting Period</label>
                    <div>
                        <span class="badge bg-primary badge-modern">
                            <i class="fa fa-calendar-alt me-1"></i>
                            @Model.ReportingMonth.ToString("MMMM yyyy")
                        </span>
                    </div>
                </div>
                <div class="timeline-item">
                    <label class="text-muted small text-uppercase mb-1">Leadership Support Comments</label>
                    <div class="p-3 bg-light rounded-3">
                        @if (!string.IsNullOrEmpty(Model.LeadershipSupportComments))
                        {
                            <p class="mb-0">@Model.LeadershipSupportComments</p>
                        }
                        else
                        {
                            <p class="text-muted mb-0"><em>No comments provided</em></p>
                        }
                    </div>
                </div>
            </div>
            <div class="card-footer bg-light py-3">
                <div class="row">
                    <div class="col-6">
                        <small class="text-muted">
                            <i class="fa fa-clock me-1"></i>
                            Created: @Model.CreatedAt.ToString("dd MMM yyyy")
                        </small>
                    </div>
                    <div class="col-6 text-end">
                        <small class="text-muted">
                            <i class="fa fa-pencil me-1"></i>
                            Updated: @(Model.UpdatedAt?.ToString("dd MMM yyyy") ?? "Never")
                        </small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Calendar Activity Card - Enhanced -->
        <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
            <div class="card-header bg-white py-3 border-0">
                <h5 class="mb-0 fw-bold">
                    <i class="fa fa-calendar-check-o me-2 text-success"></i>Calendar Activity
                </h5>
            </div>
            <div class="card-body">
                @if (Model.HadCalendarActivity)
                {
                    <div class="activity-card" style="border-left-color: #28a745;">
                        <div class="p-3">
                            <div class="mb-3">
                                <span class="badge bg-success badge-modern">
                                    <i class="fa fa-check-circle me-1"></i> Activity Held
                                </span>
                            </div>
                            <div class="mb-3">
                                <label class="text-muted small text-uppercase mb-2">Activity Description</label>
                                <div class="p-3 bg-light rounded-3">@Model.CalendarActivity</div>
                            </div>
                            <div>
                                <div class="row align-items-center">
                                    <div class="col-md-6">
                                        <div class="text-center p-3 bg-info bg-opacity-10 rounded-3">
                                            <i class="fa fa-users fa-2x text-info mb-2"></i>
                                            <h4 class="fw-bold mb-0">@(Model.CalendarActivityAttendance?.ToString() ?? "0")</h4>
                                            <small class="text-muted">Total Attendance</small>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="text-center p-3 bg-success bg-opacity-10 rounded-3">
                                            <i class="fa fa-church fa-2x text-success mb-2"></i>
                                            <h4 class="fw-bold mb-0">@Model.Ministry?.MinistryName</h4>
                                            <small class="text-muted">Host Ministry</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="fa fa-calendar-times-o fa-4x text-muted mb-3 opacity-50"></i>
                        <p class="text-muted mb-0">No calendar activity reported for this month</p>
                    </div>
                }
            </div>
        </div>

        <!-- Other Meetings Card - Enhanced -->
        <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
            <div class="card-header bg-white py-3 border-0">
                <h5 class="mb-0 fw-bold">
                    <i class="fa fa-users me-2 text-warning"></i>Other Meetings
                </h5>
            </div>
            <div class="card-body">
                @if (Model.HadOtherMeetings)
                {
                    <div class="activity-card" style="border-left-color: #ffc107;">
                        <div class="p-3">
                            <div class="mb-3">
                                <span class="badge bg-warning text-dark badge-modern">
                                    <i class="fa fa-check-circle me-1"></i> Meeting Held
                                </span>
                            </div>
                            <div class="mb-3">
                                <label class="text-muted small text-uppercase mb-2">Meeting Description</label>
                                <div class="p-3 bg-light rounded-3">@Model.OtherMeetingDescription</div>
                            </div>
                            <div>
                                <div class="row align-items-center">
                                    <div class="col-md-6">
                                        <div class="text-center p-3 bg-warning bg-opacity-10 rounded-3">
                                            <i class="fa fa-users fa-2x text-warning mb-2"></i>
                                            <h4 class="fw-bold mb-0">@(Model.OtherMeetingAttendance?.ToString() ?? "0")</h4>
                                            <small class="text-muted">Total Attendance</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="fa fa-users-slash fa-4x text-muted mb-3 opacity-50"></i>
                        <p class="text-muted mb-0">No other meetings reported for this month</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Sidebar Column -->
    <div class="col-lg-5">
        <!-- Pillar Support Card - Enhanced -->
        <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
            <div class="card-header bg-white py-3 border-0">
                <h5 class="mb-0 fw-bold">
                    <i class="fa fa-flag me-2 text-info"></i>Pillar Support
                </h5>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(Model.SupportedPillar))
                {
                    <div class="text-center mb-4">
                        <div class="icon-circle bg-info bg-opacity-10 mx-auto mb-3" style="width: 80px; height: 80px; font-size: 36px;">
                            <i class="fa fa-flag text-info"></i>
                        </div>
                        <h3 class="fw-bold">@Model.SupportedPillar</h3>
                        <span class="badge bg-info badge-modern">Supported Pillar</span>
                    </div>
                    
                    @if (!string.IsNullOrEmpty(Model.PillarSupportDescription))
                    {
                        <div class="mt-4">
                            <label class="text-muted small text-uppercase mb-2">Support Description</label>
                            <div class="p-3 bg-light rounded-3">
                                @Model.PillarSupportDescription
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="fa fa-flag-o fa-4x text-muted mb-3 opacity-50"></i>
                        <p class="text-muted mb-0">No pillar support reported</p>
                    </div>
                }
            </div>
        </div>

        <!-- Quick Actions Card -->
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="card-header bg-white py-3 border-0">
                <h5 class="mb-0 fw-bold">
                    <i class="fa fa-bolt me-2 text-warning"></i>Quick Actions
                </h5>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <button class="btn btn-outline-primary btn-lg rounded-3" onclick="window.print()">
                        <i class="fa fa-print me-2"></i>Print Report
                    </button>
                    <button class="btn btn-outline-success btn-lg rounded-3" onclick="exportAsPDF()">
                        <i class="fa fa-file-pdf me-2"></i>Export as PDF
                    </button>
                    <button class="btn btn-outline-info btn-lg rounded-3" onclick="shareReport()">
                        <i class="fa fa-share-alt me-2"></i>Share Report
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Initialize tooltips
            $('[data-bs-toggle="tooltip"]').tooltip();
            
            // Add animation to cards
            $('.card').each(function(index) {
                $(this).css('animation', `fadeInUp 0.5s ease ${index * 0.1}s`);
            });
        });
        
        // Print functionality
        function printReport() {
            window.print();
        }
        
        // Export to PDF
        function exportAsPDF() {
            // Add your PDF export logic here
            alert('PDF export feature coming soon!');
        }
        
        // Share report
        function shareReport() {
            // Add your share logic here
            if (navigator.share) {
                navigator.share({
                    title: 'Ministry Leader Report',
                    text: 'Check out this ministry report',
                    url: window.location.href
                });
            } else {
                alert('Share feature not supported in this browser');
            }
        }
        
        // Add animation styles
        const style = document.createElement('style');
        style.textContent = `
            @@keyframes fadeInUp {
                from {
                    opacity: 0;
                    transform: translateY(20px);
                }
                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }
            
            .card {
                animation-fill-mode: both;
            }
        `;
        document.head.appendChild(style);
    </script>
}