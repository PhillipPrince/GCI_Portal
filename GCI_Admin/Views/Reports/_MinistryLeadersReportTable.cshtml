@* @model List<GCI_Admin.Models.MinistryLeaderReport>

<div class="card shadow-sm">
    <div class="table-responsive p-3">
        <table id="ministryLeadersReportTable" class="table table-striped table-hover align-middle datatable">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Ministry Name</th>
                    <th>Leader Name</th>
                    <th>Report Date</th>
                    <th>Weekly Meetings</th>
                    <th>Total Members</th>
                    <th>New Members</th>
                    <th>Activities</th>
                    <th>Challenges</th>
                    <th>Prayer Requests</th>
                </tr>
                <!-- Filter Row -->
                <tr>
                    <th></th>
                    <th><input type="text" placeholder="Search Ministry" class="form-control form-control-sm" /></th>
                    <th><input type="text" placeholder="Search Leader" class="form-control form-control-sm" /></th>
                    <th><input type="text" placeholder="Search Date" class="form-control form-control-sm" /></th>
                    <th></th>
                    <th></th>
                    <th></th>
                    <th></th>
                    <th><input type="text" placeholder="Search Challenges" class="form-control form-control-sm" /></th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    int count = 1;
                    foreach (var report in Model.OrderByDescending(r => r.ReportDate))
                    {
                        <tr>
                            <td>@count</td>
                            <td>
                                <strong>@report.Ministry?.Name</strong>
                            </td>
                            <td>@report.LeaderName</td>
                            <td>@report.ReportDate.ToString("dd MMM yyyy")</td>
                            <td class="text-center">@report.WeeklyMeetings</td>
                            <td class="text-center">
                                <span class="badge bg-primary">@report.TotalMembers</span>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-success">@report.NewMembersThisMonth</span>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(report.KeyActivities))
                                {
                                    <span class="text-info" data-bs-toggle="tooltip" title="@report.KeyActivities">
                                        <i class="fa fa-tasks"></i> @(report.KeyActivities.Length > 40 ? report.KeyActivities.Substring(0, 40) + "..." : report.KeyActivities)
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">No activities</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(report.Challenges))
                                {
                                    <span class="text-warning" data-bs-toggle="tooltip" title="@report.Challenges">
                                        <i class="fa fa-exclamation-circle"></i> @(report.Challenges.Length > 40 ? report.Challenges.Substring(0, 40) + "..." : report.Challenges)
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">None</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(report.PrayerRequests))
                                {
                                    <i class="fa fa-pray text-success" data-bs-toggle="tooltip" title="@report.PrayerRequests"></i>
                                    <span class="text-muted ms-1">Submitted</span>
                                }
                                else
                                {
                                    <span class="text-muted">None</span>
                                }
                            </td>
                        </tr>
                        count++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="10" class="text-center text-muted py-4">
                            <i class="fa fa-church fa-2x mb-2 d-block"></i>
                            No ministry reports found
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot class="table-light fw-bold">
                <tr>
                    <td colspan="5" class="text-end">Totals/Averages:</td>
                    <td class="text-center">@Model?.Sum(m => m.TotalMembers)</td>
                    <td class="text-center">@Model?.Sum(m => m.NewMembersThisMonth)</td>
                    <td colspan="3"></td>
                </tr>
            </tfoot>
        </table>
    </div>
</div> *@