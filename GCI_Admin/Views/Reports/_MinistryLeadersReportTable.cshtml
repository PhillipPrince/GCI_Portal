@model List<GCI_Admin.Models.MinistryLeaderReport>

<div class="card shadow-sm">
    <div class="table-responsive p-3">
        <table id="ministryLeadersReportTable" class="table table-striped table-hover align-middle datatable">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Ministry Name</th>
                    <th>Leader Name</th>
                    <th>Reporting Month</th>
                    <th>Calendar Activity</th>
                    <th>Calendar Attendance</th>
                    <th>Other Meetings</th>
                    <th>Other Attendance</th>
                    <th>Total Registered Members</th>
                    <th>Supported Pillar</th>
                    <th>Actions</th>
                </tr>
                <!-- Filter Row -->
                <tr>
                    <th></th>
                    <th><input type="text" placeholder="Search Ministry" class="form-control form-control-sm" /></th>
                    <th><input type="text" placeholder="Search Leader" class="form-control form-control-sm" /></th>
                    <th><input type="text" placeholder="Search Month" class="form-control form-control-sm" /></th>
                    <th><input type="text" placeholder="Search Activity" class="form-control form-control-sm" /></th>
                    <th></th>
                    <th><input type="text" placeholder="Search Meetings" class="form-control form-control-sm" /></th>
                    <th></th>
                    <th></th>
                    <th><input type="text" placeholder="Search Pillar" class="form-control form-control-sm" /></th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    int count = 1;
                    foreach (var report in Model.OrderByDescending(r => r.ReportingMonth))
                    {
                        <tr>
                            <td>@count</td>
                            <td>
                                <strong>@report.Ministry?.MinistryName</strong>
                            </td>
                            <td>@report.SubmittedByMinistryLeaderName</td>
                            <td>@report.ReportingMonth.ToString("MMM yyyy")</td>
                            <td>
                                @if (report.HadCalendarActivity)
                                {
                                    <span class="badge bg-success">
                                        <i class="fa fa-check-circle"></i> Yes
                                    </span>
                                    <div class="small text-muted mt-1">@report.CalendarActivity</div>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        <i class="fa fa-times-circle"></i> No
                                    </span>
                                }
                            </td>
                            <td class="text-center">
                                @if (report.HadCalendarActivity && report.CalendarActivityAttendance.HasValue)
                                {
                                    <span class="badge bg-info">@report.CalendarActivityAttendance</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                @if (report.HadOtherMeetings)
                                {
                                    <span class="badge bg-success">
                                        <i class="fa fa-check-circle"></i> Yes
                                    </span>
                                    <div class="small text-muted mt-1">@report.OtherMeetingDescription</div>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">No</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (report.HadOtherMeetings && report.OtherMeetingAttendance.HasValue)
                                {
                                    <span class="badge bg-warning text-dark">@report.OtherMeetingAttendance</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-center">
                                <span class="badge bg-primary">@report.TotalRegisteredMembers</span>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(report.SupportedPillar))
                                {
                                    <span class="badge bg-dark">@report.SupportedPillar</span>
                                    @if (!string.IsNullOrEmpty(report.PillarSupportDescription))
                                    {
                                        <div class="small text-muted mt-1" data-bs-toggle="tooltip" title="@report.PillarSupportDescription">
                                            <i class="fa fa-info-circle"></i> View
                                        </div>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">None</span>
                                }
                            </td>
                            <td class="text-center">
                                <a href="@Url.Action("MinistryLeaderReportDetails", "Reports", new { id = report.MinistryLeaderReportId })"
                                       class="btn btn-sm btn-outline-info"
                                       data-bs-toggle="tooltip"
                                       title="View Report Details">
                                    <i class="fa fa-eye me-1"></i> Details
                                </a>
                            </td>
                        </tr>
                        count++;
                    }
                }
            </tbody>
            @if (Model != null && Model.Any())
            {
                <tfoot class="table-light fw-bold">
                    <tr>
                        <td colspan="8" class="text-end">Total Registered Members (All Ministries):</td>
                        <td class="text-center">@Model.Sum(m => m.TotalRegisteredMembers)</td>
                        <td colspan="2"></td>
                    </tr>
                </tfoot>
            }
        </table>
    </div>
</div>