@model GCI_Admin.Models.MinistryLeaderReport

@{
    ViewData["Title"] = "Ministry Leader Report Details";
}

<!-- Page Header -->
<div class="row mb-4">
    <div class="col-md-8">
        <h2 class="fw-bold mb-1">Ministry Leader Report Details</h2>
        <p class="text-muted mb-0">View complete ministry report information, activities, and feedback</p>
    </div>
    <div class="col-md-4 d-flex justify-content-end gap-2">
        <a href="@Url.Action("MinistryLeaderReports", "Reports")" class="btn btn-outline-secondary btn-lg">
            <i class="fa fa-arrow-left me-2"></i>Back to Reports
        </a>
        <button class="btn btn-primary btn-lg" onclick="window.print()">
            <i class="fa fa-print me-2"></i>Print Report
        </button>
    </div>
</div>

<!-- Report Information Card -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white py-3">
        <h5 class="mb-0 fw-bold">
            <i class="fa fa-info-circle me-2 text-primary"></i>Report Information
        </h5>
    </div>
    <div class="card-body">
        <div class="row g-4">
            <div class="col-md-6">
                <table class="table table-borderless">
                    <tr>
                        <td class="text-muted fw-semibold" style="width: 180px;">Ministry:</td>
                        <td class="fw-bold">@Model.Ministry?.MinistryName</td>
                    </tr>
                    <tr>
                        <td class="text-muted fw-semibold">Submitted By:</td>
                        <td class="fw-bold">
                            @if (Model.SubmittedByMinistryLeader?.Member != null)
                            {
                                @($"{Model.SubmittedByMinistryLeader.Member.FirstName} {Model.SubmittedByMinistryLeader.Member.OtherNames}")
                            }
                            else
                            {
                                <span class="text-muted">Not available</span>
                            }
                        </td>
                    </tr>
                    <tr>
                        <td class="text-muted fw-semibold">Reporting Month:</td>
                        <td>
                            <span class="badge bg-primary fs-6">@Model.ReportingMonth.ToString("MMMM yyyy")</span>
                        </td>
                    </tr>
                    <tr>
                        <td class="text-muted fw-semibold">Total Registered Members:</td>
                        <td>
                            <span class="badge bg-success fs-6">@Model.TotalRegisteredMembers</span>
                        </td>
                    </tr>
                </table>
            </div>
            <div class="col-md-6">
                <table class="table table-borderless">
                    <tr>
                        <td class="text-muted fw-semibold" style="width: 180px;">Leadership Support Comments:</td>
                        <td>
                            @if (!string.IsNullOrEmpty(Model.LeadershipSupportComments))
                            {
                                <div class="p-2 bg-light rounded">
                                    @Model.LeadershipSupportComments
                                </div>
                            }
                            else
                            {
                                <span class="text-muted">No comments provided</span>
                            }
                        </td>
                    </tr>
                </table>
            </div>
        </div>
        
        @if (Model.CreatedAt != default)
        {
            <div class="row mt-3">
                <div class="col-12">
                    <hr />
                    <small class="text-muted">
                        <i class="fa fa-clock me-1"></i>
                        Created on: @Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt") | 
                        Last Updated: @(Model.UpdatedAt?.ToString("dd MMM yyyy, hh:mm tt") ?? "Never") |
                        Status: @(Model.IsActive ? "Active" : "Inactive")
                    </small>
                </div>
            </div>
        }
    </div>
</div>

<!-- Calendar Activity Card -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white py-3">
        <h5 class="mb-0 fw-bold">
            <i class="fa fa-calendar-check-o me-2 text-success"></i>Calendar Activity
        </h5>
    </div>
    <div class="card-body">
        @if (Model.HadCalendarActivity)
        {
            <div class="row g-4">
                <div class="col-md-12 mb-3">
                    <label class="text-muted fw-semibold mb-2">Activity Description</label>
                    <div class="p-3 bg-light rounded">@Model.CalendarActivity</div>
                </div>
                <div class="col-md-6">
                    <table class="table table-borderless">
                        <tr>
                            <td class="text-muted fw-semibold" style="width: 120px;">Attendance:</td>
                            <td>
                                <span class="badge bg-info fs-6">@(Model.CalendarActivityAttendance?.ToString() ?? "Not recorded")</span>
                            </td>
                        </tr>
                        <tr>
                            <td class="text-muted fw-semibold">Status:</td>
                            <td>
                                <span class="badge bg-success">
                                    <i class="fa fa-check-circle me-1"></i> Activity Held
                                </span>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="fa fa-calendar-times-o fa-4x text-muted mb-3"></i>
                <p class="text-muted mb-0">No calendar activity reported for this month</p>
            </div>
        }
    </div>
</div>

<!-- Other Meetings Card -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white py-3">
        <h5 class="mb-0 fw-bold">
            <i class="fa fa-users me-2 text-warning"></i>Other Meetings
        </h5>
    </div>
    <div class="card-body">
        @if (Model.HadOtherMeetings)
        {
            <div class="row g-4">
                <div class="col-md-12 mb-3">
                    <label class="text-muted fw-semibold mb-2">Meeting Description</label>
                    <div class="p-3 bg-light rounded">@Model.OtherMeetingDescription</div>
                </div>
                <div class="col-md-6">
                    <table class="table table-borderless">
                        <tr>
                            <td class="text-muted fw-semibold" style="width: 120px;">Attendance:</td>
                            <td>
                                <span class="badge bg-warning text-dark fs-6">@(Model.OtherMeetingAttendance?.ToString() ?? "Not recorded")</span>
                            </td>
                        </tr>
                        <tr>
                            <td class="text-muted fw-semibold">Status:</td>
                            <td>
                                <span class="badge bg-success">
                                    <i class="fa fa-check-circle me-1"></i> Meeting Held
                                </span>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="fa fa-users-slash fa-4x text-muted mb-3"></i>
                <p class="text-muted mb-0">No other meetings reported for this month</p>
            </div>
        }
    </div>
</div>

<!-- Pillar Support Card -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white py-3">
        <h5 class="mb-0 fw-bold">
            <i class="fa fa-flag me-2 text-info"></i>Pillar Support
        </h5>
    </div>
    <div class="card-body">
        @if (!string.IsNullOrEmpty(Model.SupportedPillar))
        {
            <div class="row g-4">
                <div class="col-md-6">
                    <table class="table table-borderless">
                        <tr>
                            <td class="text-muted fw-semibold" style="width: 120px;">Pillar:</td>
                            <td>
                                <span class="badge bg-dark fs-6">@Model.SupportedPillar</span>
                            </td>
                        </tr>
                    </table>
                </div>
                @if (!string.IsNullOrEmpty(Model.PillarSupportDescription))
                {
                    <div class="col-md-12">
                        <label class="text-muted fw-semibold mb-2">Support Description</label>
                        <div class="p-3 bg-light rounded">
                            @Model.PillarSupportDescription
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="fa fa-flag-o fa-4x text-muted mb-3"></i>
                <p class="text-muted mb-0">No pillar support reported</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Initialize tooltips
            $('[data-bs-toggle="tooltip"]').tooltip();
        });
        
        // Print functionality
        function printReport() {
            window.print();
        }
    </script>
    
    <style>
        @@media print {
            .btn, .topbar, .sidebar, footer, .dropdown {
                display: none !important;
            }
            .content {
                margin-left: 0 !important;
                padding: 0 !important;
            }
            .card {
                border: 1px solid #ddd !important;
                break-inside: avoid;
            }
            .table {
                break-inside: avoid;
            }
        }
        
        .bg-light {
            background-color: #f8f9fa !important;
        }
        
        .table-borderless td {
            padding: 0.5rem 0;
        }
        
        .table-borderless td:first-child {
            font-weight: 600;
        }
        
        .card-header {
            border-bottom: 1px solid rgba(0,0,0,.125);
        }
    </style>
}