@model GCI_Admin.Models.GrowthCenterMeeting

@{
    ViewData["Title"] = "Growth Center Meeting Details";
}

<!-- Page Header -->
<div class="row mb-4">
    <div class="col-md-8">
        <h2 class="fw-bold mb-1">Growth Center Meeting Details</h2>
        <p class="text-muted mb-0">View complete meeting information, attendance, and visitors</p>
    </div>
    <div class="col-md-4 d-flex justify-content-end gap-2">
        <a href="@Url.Action("GrowthCenters", "Reports")" class="btn btn-outline-secondary btn-lg">
            <i class="fa fa-arrow-left me-2"></i>Back to Reports
        </a>
        <button class="btn btn-primary btn-lg" onclick="window.print()">
            <i class="fa fa-print me-2"></i>Print Report
        </button>
    </div>
</div>

<!-- Meeting Details Card -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white py-3">
        <h5 class="mb-0 fw-bold">
            <i class="fa fa-calendar-alt me-2 text-primary"></i>Meeting Information
        </h5>
    </div>
    <div class="card-body">
        <div class="row g-4">
            <div class="col-md-6">
                <table class="table table-borderless">
                    <tr>
                        <td class="text-muted fw-semibold" style="width: 150px;">Growth Center:</td>
                        <td class="fw-bold">@Model.GrowthCenter?.CenterName</td>
                    </tr>
                    <tr>
                        <td class="text-muted fw-semibold">Meeting Date:</td>
                        <td class="fw-bold">@Model.MeetingDate.ToString("dddd, dd MMMM yyyy")</td>
                    </tr>
                    <tr>
                        <td class="text-muted fw-semibold">Time:</td>
                        <td class="fw-bold">
                            @{
                                // Format TimeSpan to 12-hour format with AM/PM
                                var startTime = DateTime.Today.Add(Model.StartingTime);
                                var endTime = DateTime.Today.Add(Model.FinishingTime);
                            }
                            @startTime.ToString("hh:mm tt") - @endTime.ToString("hh:mm tt")
                        </td>
                    </tr>
                    <tr>
                        <td class="text-muted fw-semibold">Bible Study Topic:</td>
                        <td>
                            <span class="badge bg-info text-dark">@Model.BibleStudyTopic</span>
                        </td>
                    </tr>
                </table>
            </div>
            <div class="col-md-6">
                <table class="table table-borderless">
                    <tr>
                        <td class="text-muted fw-semibold" style="width: 150px;">Total Members:</td>
                        <td>
                            <span class="badge bg-primary fs-6">@Model.TotalMembers</span>
                        </td>
                    </tr>
                    <tr>
                        <td class="text-muted fw-semibold">Total Visitors:</td>
                        <td>
                            <span class="badge bg-success fs-6">@Model.TotalVisitors</span>
                        </td>
                    </tr>
                    <tr>
                        <td class="text-muted fw-semibold">Total Attendance:</td>
                        <td>
                            <span class="badge bg-warning text-dark fs-6">@(Model.TotalMembers + Model.TotalVisitors)</span>
                        </td>
                    </tr>
                    <tr>
                        <td class="text-muted fw-semibold">Children Present:</td>
                        <td>
                            <span class="badge bg-secondary fs-6">@Model.NumberOfChildren</span>
                        </td>
                    </tr>
                    <tr>
                        <td class="text-muted fw-semibold">Offering Collected:</td>
                        <td>
                            <span class="badge bg-success fs-6">KES @Model.OfferingCollected.ToString("N2")</span>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
        
        @if (Model.CreatedAt != default)
        {
            <div class="row mt-3">
                <div class="col-12">
                    <hr />
                    <small class="text-muted">
                        <i class="fa fa-clock me-1"></i>
                        Recorded on: @Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt") | 
                        Status: @(Model.IsActive ? "Active" : "Inactive")
                    </small>
                </div>
            </div>
        }
    </div>
</div>

<!-- Members Attendance Section -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold">
                    <i class="fa fa-users me-2 text-primary"></i>Members Attendance
                    <span class="badge bg-primary ms-2">@(Model.Attendees?.Count ?? 0)</span>
                </h5>
            </div>
            <div class="card-body">
                @await Html.PartialAsync("_MeetingAttendeesTable", Model.Attendees)
            </div>
        </div>
    </div>
</div>

<!-- Visitors Section -->
<div class="row">
    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold">
                    <i class="fa fa-user-plus me-2 text-success"></i>Visitors
                    <span class="badge bg-success ms-2">@(Model.Visitors?.Count ?? 0)</span>
                </h5>
            </div>
            <div class="card-body">
                @await Html.PartialAsync("_MeetingVisitorsTable", Model.Visitors)
            </div>
        </div>
    </div>
</div>

<!-- Quick Stats Cards -->

@section Scripts {
    <script>
        $(document).ready(function() {
            // Initialize tooltips
            $('[data-bs-toggle="tooltip"]').tooltip();
        });
        
        // Print functionality
        function printReport() {
            window.print();
        }
    </script>
    
    <style>
        @@media print {
            .btn, .topbar, .sidebar, footer, .dropdown, .stat-card {
                display: none !important;
            }
            .content {
                margin-left: 0 !important;
                padding: 0 !important;
            }
            .card {
                border: 1px solid #ddd !important;
                break-inside: avoid;
            }
            .table {
                break-inside: avoid;
            }
        }
        
        .stat-card {
            transition: transform 0.2s;
            cursor: default;
        }
        
        .stat-card:hover {
            transform: translateY(-5px);
        }
    </style>
}