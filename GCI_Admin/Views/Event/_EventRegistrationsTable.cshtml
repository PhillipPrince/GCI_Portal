@model List<GCI_Admin.Models.EventRegistration>

@{
    ViewData["Title"] = "Event Registrations";
}

@Html.AntiForgeryToken()

@if (Model != null && Model.Any())
{
    <div class="table-responsive p-3">
        <table id="eventRegistrationsTable" class="table table-striped table-hover align-middle datatable">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Member</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Assembly</th>
                    <th>Amount Paid</th>
                    <th>Payment Status</th>
                    <th>Attended</th>
                    <th>Registered Date</th>
                    <th class="text-end">Actions</th>
                </tr>
                <tr>
                    <th></th>
                    <th>
                        <input type="text" placeholder="Search Member" class="form-control form-control-sm" />
                    </th>
                    <th>
                        <input type="text" placeholder="Search Email" class="form-control form-control-sm" />
                    </th>
                    <th></th>
                    <th>
                        <select class="form-select form-select-sm">
                            <option value="">All Assemblies</option>
                        </select>
                    </th>
                    <th></th>
                    <th>
                        <select class="form-select form-select-sm">
                            <option value="">All</option>
                            <option value="Paid">Paid</option>
                            <option value="Pending">Pending</option>
                            <option value="Failed">Failed</option>
                        </select>
                    </th>
                    <th>
                        <select class="form-select form-select-sm">
                            <option value="">All</option>
                            <option value="true">Attended</option>
                            <option value="false">Not Attended</option>
                        </select>
                    </th>
                    <th>
                        <input type="date" class="form-control form-control-sm" />
                    </th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                @{
                    int count = 1;
                    foreach (var r in Model.OrderByDescending(r => r.RegistrationDate))
                    {
                        <tr>
                            <td>@count</td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="avatar-sm me-2">
                                        <div class="avatar-title @(r.MemberId != 0 ? "bg-primary" : "bg-secondary") bg-opacity-10 rounded-circle">
                                            <i class="fa fa-user @(r.MemberId != 0 ? "text-primary" : "text-secondary")"></i>
                                        </div>
                                    </div>
                                    <div>
                                        <strong>
                                            @if (r.MemberId != 0)
                                            {
                                                @($"{r.Member?.FirstName} {r.Member?.OtherNames}")
                                            }
                                            else
                                            {
                                                @($"{r.GuestName} ")
                                            }
                                        </strong>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <small class="text-muted">@(r.MemberId != 0 ? r.Member?.Email ?? "N/A" : r.GuestEmail ?? "N/A")</small>
                            </td>
                            <td>
                                <small class="text-muted">@(r.MemberId != 0 ? r.Member?.Phone ?? "N/A" : r.GuestPhone ?? "N/A")</small>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    <i class="fa fa-map-marker-alt me-1 text-muted"></i>
                                    @(r.MemberId != 0 ? r.Member?.Assembly ?? "N/A" : r.GuestAssembly ?? "N/A")
                                </span>
                            </td>
                            <td class="fw-medium">KES @r.AmountPaid.ToString("N2")</td>

                            <!-- Payment Badge -->
                            <td>
                                @if (r.PaymentStatusId == 4)
                                {
                                    <span class="badge bg-success">
                                        <i class="fa fa-check-circle me-1"></i>Paid
                                    </span>
                                }
                                else if (r.PaymentStatusId == 2)
                                {
                                    <span class="badge bg-warning text-dark">
                                        <i class="fa fa-clock me-1"></i>Pending
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        <i class="fa fa-times-circle me-5"></i>Failed
                                    </span>
                                }
                            </td>

                            <!-- Attendance Badge -->
                            <td>
                                @if (r.HasAttended == true)
                                {
                                    <span class="badge bg-success">
                                        <i class="fa fa-check-circle me-1"></i>Yes
                                    </span>
                                }
                                else if (r.HasAttended == false)
                                {
                                    <span class="badge bg-secondary">
                                        <i class="fa fa-circle me-1"></i>No
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        <i class="fa fa-question-circle me-1"></i>Unknown
                                    </span>
                                }
                            </td>

                            <td>
                                <small>@r.RegistrationDate.ToString("dd MMM yyyy hh:mm tt")</small>
                            </td>

                            <!-- Actions -->
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <!-- View Details -->
                                    <button class="btn btn-outline-info"
                                            title="View Details"
                                            onclick="viewRegistration(@r.RegistrationId)">
                                        <i class="fa fa-eye"></i>
                                    </button>

                                    <!-- Mark Attendance -->
                                    @if (r.HasAttended != true)
                                    {
                                        <button class="btn btn-outline-success"
                                                title="Mark as Attended"
                                                onclick="markAttended(@r.RegistrationId)">
                                            <i class="fa fa-check"></i>
                                        </button>
                                    }

                                    <!-- Send Reminder -->
                                    <button class="btn btn-outline-warning"
                                            title="Send Reminder"
                                            onclick="sendRegistrationReminder(@r.RegistrationId, '@(r.Member?.Email)')">
                                        <i class="fa fa-envelope"></i>
                                    </button>

                                    <!-- Delete -->
                                    <button class="btn btn-outline-danger"
                                            title="Delete Registration"
                                            onclick="deleteRegistration(@r.RegistrationId)">
                                        <i class="fa fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                        count++;
                    }
                }
            </tbody>
        </table>
    </div>
    
    <!-- Summary Footer -->
    <div class="card-footer bg-white border-top-0 py-3">
        <div class="row text-center">
            <div class="col-md-3">
                <div class="border-end">
                    <h6 class="text-muted mb-1">Total Registrations</h6>
                    <h4 class="mb-0">@Model.Count</h4>
                </div>
            </div>
            <div class="col-md-3">
                <div class="border-end">
                    <h6 class="text-muted mb-1">Paid</h6>
                    <h4 class="mb-0 text-success">@Model.Count(r => r.PaymentStatusId == 1)</h4>
                </div>
            </div>
            <div class="col-md-3">
                <div class="border-end">
                    <h6 class="text-muted mb-1">Pending</h6>
                    <h4 class="mb-0 text-warning">@Model.Count(r => r.PaymentStatusId == 2)</h4>
                </div>
            </div>
            <div class="col-md-3">
                <h6 class="text-muted mb-1">Attended</h6>
                <h4 class="mb-0 text-primary">@Model.Count(r => r.HasAttended == true)</h4>
            </div>
        </div>
    </div>
}
else
{
    <div class="text-center py-5">
        <i class="fa fa-users fa-3x text-muted mb-3"></i>
        <h5 class="text-muted">No Registrations Yet</h5>
        <p class="text-muted">When members register for this event, they will appear here.</p>
    </div>
}

<style>
    .avatar-sm {
        width: 32px;
        height: 32px;
    }
    
    .avatar-title {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    
    .table > :not(caption) > * > * {
        padding: 12px 8px;
    }
</style>

<script>
    // MARK ATTENDANCE
    async function markAttended(id) {
        const result = await Swal.fire({
            title: 'Mark Attendance',
            text: 'Mark this member as attended?',
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'Yes, mark attended',
            cancelButtonText: 'Cancel'
        });

        if (!result.isConfirmed) return;

        try {
            const response = await fetch('@Url.Action("MarkAttended", "EventRegistration")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                body: JSON.stringify({ id: id })
            });

            const data = await response.json();

            if (data.success) {
                Swal.fire('Success', 'Attendance marked successfully!', 'success');
                if (typeof refreshRegistrations === 'function') {
                    refreshRegistrations();
                } else {
                    location.reload();
                }
            } else {
                Swal.fire('Error', data.message || 'Failed to update attendance.', 'error');
            }
        } catch (error) {
            Swal.fire('Error', 'An error occurred. Please try again.', 'error');
        }
    }

    // VIEW REGISTRATION DETAILS
    async function viewRegistration(id) {
        Swal.fire({
            title: 'Loading...',
            allowOutsideClick: false,
            didOpen: () => {
                Swal.showLoading();
            }
        });

        try {
            const response = await fetch(`/EventRegistration/Details/${id}`, {
                method: 'GET'
            });
            
            const html = await response.text();
            
            Swal.fire({
                title: 'Registration Details',
                html: html,
                width: '800px',
                showConfirmButton: true,
                confirmButtonText: 'Close'
            });
        } catch (error) {
            Swal.fire('Error', 'Failed to load registration details.', 'error');
        }
    }

    // SEND REGISTRATION REMINDER
    async function sendRegistrationReminder(registrationId, email) {
        const result = await Swal.fire({
            title: 'Send Reminder',
            text: `Send reminder to ${email}?`,
            icon: 'info',
            showCancelButton: true,
            confirmButtonText: 'Send',
            cancelButtonText: 'Cancel'
        });

        if (!result.isConfirmed) return;

        try {
            const response = await fetch('@Url.Action("SendReminder", "EventRegistration")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                body: JSON.stringify({ id: registrationId })
            });

            const data = await response.json();

            if (data.success) {
                Swal.fire('Success', 'Reminder sent successfully!', 'success');
            } else {
                Swal.fire('Error', data.message || 'Failed to send reminder.', 'error');
            }
        } catch (error) {
            Swal.fire('Error', 'An error occurred. Please try again.', 'error');
        }
    }

    // DELETE REGISTRATION
    async function deleteRegistration(id) {
        const result = await Swal.fire({
            title: 'Delete Registration?',
            text: 'This action cannot be undone!',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            confirmButtonText: 'Yes, delete it',
            cancelButtonText: 'Cancel'
        });

        if (!result.isConfirmed) return;

        try {
            const response = await fetch('@Url.Action("Delete", "EventRegistration")/' + id, {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                }
            });

            if (response.ok) {
                Swal.fire('Deleted!', 'Registration has been deleted.', 'success');
                if (typeof refreshRegistrations === 'function') {
                    refreshRegistrations();
                } else {
                    location.reload();
                }
            } else {
                const data = await response.json();
                Swal.fire('Error', data.message || 'Failed to delete registration.', 'error');
            }
        } catch (error) {
            Swal.fire('Error', 'An error occurred. Please try again.', 'error');
        }
    }

    // Initialize DataTable for search/filter
    $(document).ready(function () {
        // Global DataTable initializer handles #eventRegistrationsTable (has datatable class + filter row)
    });
</script>