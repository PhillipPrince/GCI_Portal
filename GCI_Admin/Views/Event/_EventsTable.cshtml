@model List<GCI_Admin.Models.Event>

<div class="card shadow-sm">
    <div class="table-responsive p-3">
        <table id="eventsTable" class="table table-striped table-hover align-middle datatable">
            <thead class="table-light">
                <tr>
                    <th>Title</th>
                    <th>Description</th>
                    <th>Date</th>
                    <th>Location</th>
                    <th>Paid</th>
                    <th>Price</th>
                    <th>Status</th>
                    <th>Created At</th>
                    <th class="text-end">Actions</th>
                </tr>
                <tr>
                    <th>
                        <input type="text" placeholder="Search Title" class="form-control form-control-sm" />
                    </th>
                    <th></th>
                    <th>
                        <input type="date" class="form-control form-control-sm" />
                    </th>
                    <th>
                        <input type="text" placeholder="Search Location" class="form-control form-control-sm" />
                    </th>
                    <th>
                        <select class="form-select form-select-sm">
                            <option value="">All</option>
                            <option value="True">Yes</option>
                            <option value="False">No</option>
                        </select>
                    </th>
                    <th></th>
                    <th>
                        <select class="form-select form-select-sm">
                            <option value="">All</option>
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                        </select>
                    </th>
                    <th></th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                @foreach (var e in Model)
                {
                    <tr>
                        <td>@e.Title</td>
                        <td>@e.Description</td>
                        <td>@e.EventDate.ToString("dd MMM yyyy")</td>
                        <td>@e.Location</td>

                        <!-- Paid -->
                        <td>
                            @if (e.IsPaid)
                            {
                                <span class="badge bg-success">Yes</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">No</span>
                            }
                        </td>

                        <!-- Price -->
                        <td>
                            @(e.Price.HasValue? e.Price.Value.ToString("N2") : "-")
                        </td>

                        <!-- Active Status -->
                        <td>
                            @if (e.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactive</span>
                            }
                        </td>

                        <!-- Created -->
                        <td>@e.CreatedAt?.ToString("dd MMM yyyy")</td>
                        
                        <!-- Actions -->
                        <td class="text-end">
                            <!-- View - Using anchor tag like MemberDetails -->
                            <a href="@Url.Action("EventDetails", "Event", new { id = e.EventId })"
                                   class="btn btn-sm btn-outline-info"
                                   title="View Event Details">
                                <i class="fa fa-eye"></i>
                            </a>

                            <!-- Edit -->
                            <a href="@Url.Action("Edit", "Event", new { id = e.EventId })"
                                   class="btn btn-sm btn-outline-warning"
                                   title="Edit Event">
                                <i class="fa fa-edit"></i>
                            </a>

                            <!-- Activate / Deactivate -->
                            @if (e.IsActive)
                            {
                                <button class="btn btn-sm btn-outline-secondary"
                                        onclick="toggleEventStatus(@e.EventId, false)"
                                        title="Deactivate Event">
                                    <i class="fa fa-ban"></i>
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-success"
                                        onclick="toggleEventStatus(@e.EventId, true)"
                                        title="Activate Event">
                                    <i class="fa fa-check"></i>
                                </button>
                            }

                            <!-- Delete -->
                            <button class="btn btn-sm btn-outline-danger"
                                    onclick="deleteEvent(@e.EventId)"
                                    title="Delete Event">
                                <i class="fa fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    // Initialize DataTable with custom filtering
    $(document).ready(function() {
        var table = $('#eventsTable').DataTable({
            pageLength: 10,
            language: {
                search: "Search:",
                lengthMenu: "Show _MENU_ entries",
                info: "Showing _START_ to _END_ of _TOTAL_ entries",
                emptyTable: "No events found",
                zeroRecords: "No matching events found"
            },
            order: [[2, 'desc']], // Sort by date descending
            columnDefs: [
                { orderable: false, targets: [8] } // Disable sorting on actions column
            ]
        });
        
        // Setup column search
        $('#eventsTable thead tr:eq(1) th').each(function(index) {
            var input = $(this).find('input, select');
            if (input.length) {
                input.on('keyup change', function() {
                    table.column(index).search(this.value).draw();
                });
            }
        });
    });

    function toggleEventStatus(eventId, isActive) {
        const action = isActive ? 'activate' : 'deactivate';
        
        Swal.fire({
            title: 'Are you sure?',
            text: `You are about to ${action} this event.`,
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: `Yes, ${action} it`
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '/Event/ToggleStatus',
                    type: 'POST',
                    data: { id: eventId, isActive: isActive },
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(response) {
                        if (response.isSuccess) {
                            Swal.fire('Success', response.message, 'success')
                                .then(() => {
                                    window.location.reload();
                                });
                        } else {
                            Swal.fire('Error', response.message, 'error');
                        }
                    },
                    error: function() {
                        Swal.fire('Error', 'Operation failed. Please try again.', 'error');
                    }
                });
            }
        });
    }

    function deleteEvent(eventId) {
        Swal.fire({
            title: 'Delete Event?',
            text: 'This action cannot be undone!',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            confirmButtonText: 'Yes, delete it'
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '/Event/Delete',
                    type: 'POST',
                    data: { id: eventId },
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(response) {
                        if (response.isSuccess) {
                            Swal.fire('Deleted!', response.message, 'success')
                                .then(() => {
                                    window.location.reload();
                                });
                        } else {
                            Swal.fire('Error', response.message, 'error');
                        }
                    },
                    error: function() {
                        Swal.fire('Error', 'Delete failed. Please try again.', 'error');
                    }
                });
            }
        });
    }
</script>