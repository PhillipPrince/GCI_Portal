@model GCI_Admin.Models.EventViewModel

@{
    ViewData["Title"] = "Event Details - " + Model.Event.Title;
}

@Html.AntiForgeryToken()

<div class="row mb-4">
    <div class="col-md-8">
        <h2 class="fw-bold mb-1">@Model.Event.Title</h2>
        <p class="text-muted mb-0">Event Details</p>
    </div>
    <div class="col-md-4 text-end">
        <div class="btn-group me-2">
            <button type="button" class="btn btn-outline-primary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="fa fa-share-alt me-2"></i>Share Links
            </button>
            <ul class="dropdown-menu">
                <li><a class="dropdown-item" href="javascript:void(0)" onclick="copyGuestRegistrationLink(@Model.Event.EventId)"><i class="fa fa-user me-2"></i>Guest Registration</a></li>
                <li><a class="dropdown-item" href="javascript:void(0)" onclick="copyUsherRegistrationLink(@Model.Event.EventId)"><i class="fa fa-users-cog me-2"></i>Usher Registration</a></li>
            </ul>
        </div>
        <a href="@Url.Action("Index", "Event")" class="btn btn-outline-secondary">
            <i class="fa fa-arrow-left me-2"></i>Back to Events
        </a>
    </div>
</div>

<div class="row">
    @if (Model.Event.EventImage != null && Model.Event.EventImage.Length > 0)
    {
        <div class="col-12 mb-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-3 text-center">
                    <img src="data:image/jpeg;base64,@Convert.ToBase64String(Model.Event.EventImage)" class="img-fluid rounded-3" style="max-height: 400px; width: 100%; object-fit: cover;" alt="Event Cover Image" />
                </div>
            </div>
        </div>
    }

    <div class="col-lg-8">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-0 py-3">
                <h5 class="fw-bold mb-0">
                    <i class="fa fa-info-circle me-2 text-primary"></i>
                    Event Information
                </h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-12">
                        <div class="border-bottom pb-3 mb-3">
                            <h6 class="text-muted mb-2">Title</h6>
                            <p class="fs-5 fw-medium mb-0">@Model.Event.Title</p>
                        </div>
                    </div>

                    <div class="col-md-12">
                        <div class="border-bottom pb-3 mb-3">
                            <h6 class="text-muted mb-2">Description</h6>
                            <p class="mb-0">@Model.Event.Description</p>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="border-bottom pb-3 mb-3">
                            <h6 class="text-muted mb-2">
                                <i class="fa fa-calendar me-1"></i> Event Date
                            </h6>
                            <p class="mb-0 fw-medium">
                                @Model.Event.EventDate.ToString("dddd, MMMM dd, yyyy hh:mm tt")
                            </p>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="border-bottom pb-3 mb-3">
                            <h6 class="text-muted mb-2">
                                <i class="fa fa-map-marker me-1"></i> Location
                            </h6>
                            <p class="mb-0 fw-medium">@Model.Event.Location</p>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="border-bottom pb-3 mb-3">
                            <h6 class="text-muted mb-2">
                                <i class="fa fa-tag me-1"></i> Payment
                            </h6>
                            @if (Model.Event.IsPaid && Model.Event.Price.HasValue)
                            {
                                <p class="mb-0 fw-medium text-primary">
                                    KES @Model.Event.Price.Value.ToString("N2")
                                </p>
                            }
                            else
                            {
                                <p class="mb-0 fw-medium text-success">
                                    <i class="fa fa-check-circle"></i> Free Event
                                </p>
                            }
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="border-bottom pb-3 mb-3">
                            <h6 class="text-muted mb-2">
                                <i class="fa fa-toggle-on me-1"></i> Status
                            </h6>
                            @if (Model.Event.IsActive)
                            {
                                <span class="badge bg-success fs-6 px-3 py-2">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger fs-6 px-3 py-2">Inactive</span>
                            }
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="border-bottom pb-3 mb-3">
                            <h6 class="text-muted mb-2">
                                <i class="fa fa-clipboard-list me-1"></i> Registration
                            </h6>
                            @if (Model.Event.RequireRegistration)
                            {
                                <p class="mb-0 fw-medium text-primary">
                                    <i class="fa fa-check-circle"></i> Registration Required
                                </p>
                                <small class="text-muted">
                                    Total Registrations: <strong id="totalRegistrations">@(Model.Registrations?.Count ?? 0)</strong>
                                </small>
                            }
                            else
                            {
                                <p class="mb-0 fw-medium text-muted">
                                    <i class="fa fa-times-circle"></i> No Registration Required
                                </p>
                            }
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="border-bottom pb-3 mb-3">
                            <h6 class="text-muted mb-2">
                                <i class="fa fa-door-open me-1"></i> Walk-ins
                            </h6>
                            @if (Model.Event.AllowWalkIns)
                            {
                                <p class="mb-0 fw-medium text-success">Allowed</p>
                            }
                            else
                            {
                                <p class="mb-0 fw-medium text-danger">Not Allowed</p>
                            }
                        </div>
                    </div>

                    @if (Model.Event.StartDateTime.HasValue || Model.Event.EndDateTime.HasValue)
                    {
                        <div class="col-md-6">
                            <div class="border-bottom pb-3 mb-3">
                                <h6 class="text-muted mb-2">
                                    <i class="fa fa-hourglass-half me-1"></i> Duration
                                </h6>
                                @if (Model.Event.StartDateTime.HasValue)
                                {
                                    <p class="mb-1">
                                        <strong>Start:</strong> @Model.Event.StartDateTime.Value.ToString("dd MMM yyyy hh:mm tt")
                                    </p>
                                }
                                @if (Model.Event.EndDateTime.HasValue)
                                {
                                    <p class="mb-0">
                                        <strong>End:</strong> @Model.Event.EndDateTime.Value.ToString("dd MMM yyyy hh:mm tt")
                                    </p>
                                }
                            </div>
                        </div>
                    }

                    <div class="col-md-12">
                        <div class="border-bottom pb-3 mb-3">
                            <h6 class="text-muted mb-2">
                                <i class="fa fa-clock me-1"></i> Created
                            </h6>
                            <p class="mb-0">@Model.Event.CreatedAt?.ToString("dd MMM yyyy hh:mm tt")</p>
                        </div>
                    </div>

                    @if (Model.Event.UpdatedAt.HasValue)
                    {
                        <div class="col-md-12">
                            <div class="border-bottom pb-3 mb-3">
                                <h6 class="text-muted mb-2">
                                    <i class="fa fa-edit me-1"></i> Last Updated
                                </h6>
                                <p class="mb-0">@Model.Event.UpdatedAt.Value.ToString("dd MMM yyyy hh:mm tt")</p>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-0 py-3">
                <h5 class="fw-bold mb-0">
                    <i class="fa fa-users-cog me-2 text-primary"></i>
                    Registration Age Groups
                </h5>
            </div>
            <div class="card-body">
                <div class="alert alert-info border-0 bg-info bg-opacity-10 d-flex align-items-center">
                    <i class="fa fa-info-circle fa-lg text-info me-3"></i>
                    <div>
                        Configure the age group options presented to guests during registration. Add them one by one below.
                    </div>
                </div>
                
                <div class="mb-3">
                    <label class="form-label fw-medium">Add Age Group</label>
                    <div class="input-group mb-2">
                        <input type="text" id="newAgeGroupInput" class="form-control" placeholder="e.g. Youths (12-20)" />
                        <button class="btn btn-outline-secondary" type="button" onclick="addAgeGroup()">Add</button>
                    </div>
                    <div id="ageGroupsListContainer" class="d-flex flex-wrap gap-2 mt-3">
                        <!-- Chips will be rendered here -->
                    </div>
                </div>
                <button type="button" class="btn btn-primary mt-2" onclick="saveAgeGroups()">
                    <i class="fa fa-save me-2"></i>Save Age Groups
                </button>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-0 py-3">
                <h5 class="fw-bold mb-0">
                    <i class="fa fa-cog me-2 text-secondary"></i>
                    Actions
                </h5>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a href="@Url.Action("Edit", "Event", new { id = Model.Event.EventId })"
                           class="btn btn-warning">
                        <i class="fa fa-edit me-2"></i> Edit Event
                    </a>
                    
                    @if (Model.Event.IsActive)
                    {
                        <button class="btn btn-outline-secondary"
                                onclick="toggleEventStatus(@Model.Event.EventId, false)">
                            <i class="fa fa-ban me-2"></i> Deactivate Event
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-outline-success"
                                onclick="toggleEventStatus(@Model.Event.EventId, true)">
                            <i class="fa fa-check me-2"></i> Activate Event
                        </button>
                    }
                    
                    <button class="btn btn-outline-danger"
                            onclick="deleteEvent(@Model.Event.EventId)">
                        <i class="fa fa-trash me-2"></i> Delete Event
                    </button>
                    
                    @if (Model.Event.RequireRegistration)
                    {
                        <hr>
                        <button class="btn btn-outline-primary"
                                onclick="exportRegistrations(@Model.Event.EventId)">
                            <i class="fa fa-download me-2"></i> Export Registrations
                        </button>
                        <button class="btn btn-outline-secondary"
                                onclick="sendReminders(@Model.Event.EventId)">
                            <i class="fa fa-envelope me-2"></i> Send Reminders
                        </button>
                    }
                    
                    <hr>

                    <button class="btn btn-primary"
                            onclick="openNotificationModal(@Model.Event.EventId)">
                        <i class="fa fa-bell me-2"></i> Send Notification
                    </button>

                    <button class="btn btn-outline-info"
                            onclick="window.print()">
                        <i class="fa fa-print me-2"></i> Print Details
                    </button>
                </div>
            </div>
        </div>

        <!-- QR Code Card -->
        <div class="card border-0 shadow-sm mb-4 text-center">
            <div class="card-header bg-white border-0 py-3">
                <h5 class="fw-bold mb-0">
                    <i class="fa fa-qrcode me-2 text-primary"></i>
                    Event QR Code
                </h5>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(Model.Event.QrCode))
                {
                    <img src="https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=@Model.Event.QrCode" class="img-fluid mb-2" alt="Event QR Code" style="max-height: 200px;" />
                    <p class="small text-muted mb-0">Scan this QR Code to mark attendance for this event.</p>
                }
                else
                {
                    <p class="text-danger small mb-0">No QR Code generated for this event.</p>
                }
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 py-3">
                <h5 class="fw-bold mb-0">
                    <i class="fa fa-chart-bar me-2 text-info"></i>
                    Quick Stats
                </h5>
            </div>
            <div class="card-body">
                <div class="text-center mb-3">
                    <div class="display-4 text-primary fw-bold" id="attendeeCount">-</div>
                    <div class="text-muted">Registered Attendees</div>
                </div>
                <div class="text-center mb-3">
                    <div class="display-4 text-success fw-bold" id="attendedCount">-</div>
                    <div class="text-muted">Marked Attended</div>
                </div>
                <div class="text-center">
                    <div class="display-4 text-warning fw-bold" id="pendingCount">-</div>
                    <div class="text-muted">Pending Payments</div>
                </div>
                @if (Model.Event.IsPaid)
                {
                    <div class="text-center mt-3 pt-3 border-top">
                        <div class="display-4 text-info fw-bold" id="revenue">-</div>
                        <div class="text-muted">Revenue Generated</div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Registration & Financial Summaries -->
@if (Model.Event.RequireRegistration && Model.Registrations != null)
{
    var assemblySummary = Model.Registrations
        .GroupBy(r => !string.IsNullOrWhiteSpace(r.GuestAssembly) ? r.GuestAssembly : (r.Member != null ? (r.Member.Assembly ?? "Unknown") : "Unknown"))
        .Select(g => new { Assembly = g.Key, Count = g.Count() })
        .OrderByDescending(x => x.Count)
        .ToList();

    int totalSuccessfulPayments = Model.Registrations.Where(r => r.PaymentStatusId == 4).Count();
    int totalFailedPayments = Model.Registrations.Where(r => r.PaymentStatusId != 4 && r.PaymentStatusId != 2).Count();
    int totalPendingPayments = Model.Registrations.Where(r => r.PaymentStatusId == 2).Count();
    
    decimal successfulRevenue = Model.Registrations.Where(r => r.PaymentStatusId == 4).Sum(r => r.AmountPaid);
    decimal expectedFromPending = totalPendingPayments * (Model.Event.Price ?? 0);
    decimal expectedFromFailed = totalFailedPayments * (Model.Event.Price ?? 0);

    <div class="row mt-4">
        <!-- Assembly Summary Card -->
        <div class="col-md-6 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="fw-bold mb-0">
                        <i class="fa fa-church me-2 text-primary"></i>
                        Assembly Summary
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive" style="max-height: 250px; overflow-y: auto;">
                        <table class="table table-hover mb-0">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th>Assembly</th>
                                    <th class="text-end">Registrations</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach(var item in assemblySummary)
                                {
                                    <tr>
                                        <td>@item.Assembly</td>
                                        <td class="text-end fw-bold text-primary">@item.Count</td>
                                    </tr>
                                }
                                @if(!assemblySummary.Any())
                                {
                                    <tr><td colspan="2" class="text-center text-muted">No registrations found.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Financial Summary Card (if paid) -->
        @if(Model.Event.IsPaid)
        {
            <div class="col-md-6 mb-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white border-0 py-3">
                        <h5 class="fw-bold mb-0">
                            <i class="fa fa-money-bill-wave me-2 text-success"></i>
                            Financial Summary
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-3 border-bottom pb-2">
                            <span class="text-success fw-bold"><i class="fa fa-check-circle me-1"></i> Successful Payments</span>
                            <span class="fw-bold">KES @successfulRevenue.ToString("N2") <span class="text-muted small">(@totalSuccessfulPayments)</span></span>
                        </div>
                        <div class="d-flex justify-content-between mb-3 border-bottom pb-2">
                            <span class="text-warning fw-bold"><i class="fa fa-clock me-1"></i> Pending Payments</span>
                            <span class="fw-bold">KES @expectedFromPending.ToString("N2") <span class="text-muted small">(@totalPendingPayments)</span></span>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-danger fw-bold"><i class="fa fa-times-circle me-1"></i> Failed Payments</span>
                            <span class="fw-bold">KES @expectedFromFailed.ToString("N2") <span class="text-muted small">(@totalFailedPayments)</span></span>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- Registrations Section - Only shown if registration is required -->
@if (Model.Event.RequireRegistration)
{
    <div class="row mt-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0">
                        <i class="fa fa-users me-2 text-primary"></i>
                        Event Registrations
                        <span class="badge bg-primary ms-2" id="registrationBadge">@(Model.Registrations?.Count ?? 0)</span>
                    </h5>
                    <div>
                        @if (Model.Event.IsPaid)
                        {
                            <button class="btn btn-sm btn-outline-warning me-2" onclick="sendBulkPaymentReminders(@Model.Event.EventId)">
                                <i class="fa fa-bell me-1"></i> Remind Unpaid
                            </button>
                        }
                        <button class="btn btn-sm btn-outline-info me-2" onclick="sendBulkAttendanceReminders(@Model.Event.EventId)">
                            <i class="fa fa-calendar-check me-1"></i> Remind Attendance
                        </button>
                        <button class="btn btn-sm btn-outline-primary me-2" onclick="refreshRegistrations()">
                            <i class="fa fa-refresh me-1"></i> Refresh
                        </button>
                        <button class="btn btn-sm btn-outline-success" onclick="exportRegistrations(@Model.Event.EventId)">
                            <i class="fa fa-file-excel me-1"></i> Export
                        </button>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div id="registrationsTableContainer">
                        @await Html.PartialAsync("_EventRegistrationsTable", Model.Registrations, new ViewDataDictionary(ViewData) { { "AllowedAgeGroups", Model.Event.AllowedAgeGroups } })
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Feedback Section -->
<div class="row mt-4 mb-4">
    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 py-3">
                <h5 class="fw-bold mb-0">
                    <i class="fa fa-comments me-2 text-info"></i>
                    Event Feedback & Reviews
                    <span class="badge bg-info ms-2">@(Model.Feedbacks?.Count ?? 0)</span>
                </h5>
            </div>
            <div class="card-body">
                @if (Model.Feedbacks == null || !Model.Feedbacks.Any())
                {
                    <div class="text-center py-4">
                        <i class="fa fa-comment-slash fa-2x text-muted mb-2"></i>
                        <p class="text-muted mb-0">No feedback submitted for this event yet.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle" id="eventFeedbackTable">
                            <thead class="table-light">
                                <tr>
                                    <th>Member</th>
                                    <th>Attendance</th>
                                    <th>Ratings</th>
                                    <th>What they liked</th>
                                    <th>Improvements</th>
                                    <th>Insights / Reason for Absence</th>
                                    <th>Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var f in Model.Feedbacks)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-bold">@(f.Member != null ? $"{f.Member.FirstName} {f.Member.OtherNames}" : "Unknown Member")</div>
                                            <small class="text-muted">Member ID: @f.MemberId</small>
                                        </td>
                                        <td>
                                            @if (f.AttendanceType == "Attended")
                                            {
                                                <span class="badge bg-success">In Person</span>
                                            }
                                            else if (f.AttendanceType == "AttendedOnline")
                                            {
                                                <span class="badge bg-primary">Online</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Did Not Attend</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="small">
                                                @if (f.SpeakerRating.HasValue) { <span>Speaker: @f.SpeakerRating/5</span><br /> }
                                                @if (f.ProgramRating.HasValue) { <span>Program: @f.ProgramRating/5</span><br /> }
                                                @if (f.FacilitiesRating.HasValue) { <span>Facilities: @f.FacilitiesRating/5</span><br /> }
                                                @if (f.MessageRating.HasValue) { <span>Message: @f.MessageRating/5</span><br /> }
                                                @if (f.MealsRating.HasValue) { <span>Meals: @f.MealsRating/5</span><br /> }
                                                @if (f.ScheduleRating.HasValue) { <span>Schedule: @f.ScheduleRating/5</span> }
                                            </div>
                                        </td>
                                        <td>
                                            <div class="text-wrap" style="max-width: 250px;">@f.LikedMost</div>
                                        </td>
                                        <td>
                                            <div class="text-wrap" style="max-width: 250px;">@f.Improvements</div>
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(f.NonAttendanceReason))
                                            {
                                                <div class="text-wrap small text-danger" style="max-width: 250px;">
                                                    <strong>Absence Reason:</strong> @f.NonAttendanceReason
                                                </div>
                                            }
                                            @if (!string.IsNullOrEmpty(f.Insights))
                                            {
                                                <div class="text-wrap small text-muted mt-1" style="max-width: 250px;">
                                                    <strong>Insights:</strong> @f.Insights
                                                </div>
                                            }
                                        </td>
                                        <td class="small">@f.CreatedAt.ToString("yyyy-MM-dd")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Send Notification Modal -->
<div class="modal fade" id="sendNotificationModal" tabindex="-1" aria-labelledby="sendNotificationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold" id="sendNotificationModalLabel">
                    <i class="fa fa-bell me-2"></i> Send Event Notification
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info d-flex align-items-center mb-3">
                    <i class="fa fa-info-circle me-2"></i>
                    <div>
                        <strong>Target Group:</strong>
                        @if (Model.Event.GroupId.HasValue)
                        {
                            <span class="badge bg-primary ms-1">Group ID: @Model.Event.GroupId</span>
                            <small class="text-muted ms-2">This notification will be sent to the event's target group.</small>
                        }
                        else
                        {
                            <span class="badge bg-success ms-1">Church-Wide</span>
                            <small class="text-muted ms-2">This notification will be sent to all members.</small>
                        }
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label fw-medium">Notification Title <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="fa fa-heading text-muted"></i></span>
                            <input type="text" id="notifTitle" class="form-control"
                                   placeholder="e.g., Reminder: @Model.Event.Title"
                                   value="Reminder: @Model.Event.Title" />
                        </div>
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-medium">Message <span class="text-danger">*</span></label>
                        <textarea id="notifMessage" class="form-control" rows="4"
                                  placeholder="Write your notification message...">Don't miss our upcoming event: @Model.Event.Title on @Model.Event.EventDate.ToString("dddd, MMMM dd yyyy") at @Model.Event.Location. We look forward to seeing you!</textarea>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-medium">Schedule Date &amp; Time <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="fa fa-clock text-muted"></i></span>
                            <input type="datetime-local" id="notifTime" class="form-control"
                                   value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                        </div>
                        <div class="form-text">Set when this notification should be sent.</div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-medium d-block">Delivery Channels</label>
                        <div class="border rounded-3 p-3 bg-light">
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" id="notifSendSMS" checked>
                                <label class="form-check-label" for="notifSendSMS">
                                    <i class="fa fa-sms text-success me-1"></i> Send SMS
                                </label>
                            </div>
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" id="notifSendPush">
                                <label class="form-check-label" for="notifSendPush">
                                    <i class="fa fa-mobile-alt text-primary me-1"></i> Push Notification
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="notifSendEmail">
                                <label class="form-check-label" for="notifSendEmail">
                                    <i class="fa fa-envelope text-warning me-1"></i> Send Email
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    <i class="fa fa-times me-1"></i> Cancel
                </button>
                <button type="button" class="btn btn-primary" id="submitNotifBtn" onclick="submitEventNotification()">
                    <i class="fa fa-paper-plane me-2"></i> Schedule Notification
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- SheetJS for Excel handling -->
    <script src="https://cdn.sheetjs.com/xlsx-0.20.1/package/dist/xlsx.full.min.js"></script>

    <script>
        // Global variables
        let autoRefreshInterval = null;
        const eventId = @Model.Event.EventId;
        const requireRegistration = @Json.Serialize(Model.Event.RequireRegistration);

        function toggleEventStatus(eventId, isActive) {
            const action = isActive ? 'activate' : 'deactivate';
            
            Swal.fire({
                title: 'Are you sure?',
                text: `You are about to ${action} this event.`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: `Yes, ${action} it`
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/Event/ToggleStatus',
                        type: 'POST',
                        data: { id: eventId, isActive: isActive },
                        headers: {
                            'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function(response) {
                            if (response.isSuccess) {
                                Swal.fire('Success', response.message, 'success')
                                    .then(() => {
                                        window.location.reload();
                                    });
                            } else {
                                Swal.fire('Error', response.message, 'error');
                            }
                        },
                        error: function() {
                            Swal.fire('Error', 'Operation failed. Please try again.', 'error');
                        }
                    });
                }
            });
        }

        function deleteEvent(eventId) {
            Swal.fire({
                title: 'Delete Event?',
                text: 'This action cannot be undone!',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                confirmButtonText: 'Yes, delete it'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/Event/Delete',
                        type: 'POST',
                        data: { id: eventId },
                        headers: {
                            'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function(response) {
                            if (response.isSuccess) {
                                Swal.fire('Deleted!', response.message, 'success')
                                    .then(() => {
                                        window.location.href = '/Event/Index';
                                    });
                            } else {
                                Swal.fire('Error', response.message, 'error');
                            }
                        },
                        error: function() {
                            Swal.fire('Error', 'Delete failed. Please try again.', 'error');
                        }
                    });
                }
            });
        }

        const rawRegistrations = @Html.Raw(Model.Registrations != null ? System.Text.Json.JsonSerializer.Serialize(Model.Registrations.Select(r => new {
            Name = !string.IsNullOrWhiteSpace(r.GuestName) ? r.GuestName : (r.Member != null ? r.Member.FirstName + " " + r.Member.OtherNames : "Unknown"),
            Email = !string.IsNullOrWhiteSpace(r.GuestEmail) ? r.GuestEmail : (r.Member != null ? r.Member.Email : ""),
            Phone = !string.IsNullOrWhiteSpace(r.GuestPhone) ? r.GuestPhone : (r.Member != null ? r.Member.Phone : ""),
            Assembly = !string.IsNullOrWhiteSpace(r.GuestAssembly) ? r.GuestAssembly : (r.Member != null ? (r.Member.Assembly ?? "Unknown") : "Unknown"),
            AmountPaid = r.AmountPaid,
            PaymentStatus = r.PaymentStatusId == 4 ? "Paid" : (r.PaymentStatusId == 2 ? "Pending" : "Failed"),
            Attended = r.HasAttended == true ? "Yes" : "No",
            RegistrationDate = r.RegistrationDate.ToString("yyyy-MM-dd HH:mm")
        })) : "[]");

        function exportRegistrations(eventId) {
            if (!rawRegistrations || rawRegistrations.length === 0) {
                Swal.fire('Info', 'No registrations to export.', 'info');
                return;
            }

            // Create an empty worksheet
            const ws = XLSX.utils.aoa_to_sheet([]);
            let currentRow = 0;

            // --- 1. Assembly Summary ---
            XLSX.utils.sheet_add_aoa(ws, [["ASSEMBLY SUMMARY"]], { origin: { r: currentRow, c: 0 } });
            currentRow++;
            
            const assemblyCounts = {};
            rawRegistrations.forEach(r => {
                const asm = r.Assembly || "Unknown";
                assemblyCounts[asm] = (assemblyCounts[asm] || 0) + 1;
            });
            const assemblySummaryArray = Object.keys(assemblyCounts).map(asm => ({ Assembly: asm, Registrations: assemblyCounts[asm] }));
            assemblySummaryArray.sort((a, b) => b.Registrations - a.Registrations);
            
            XLSX.utils.sheet_add_json(ws, assemblySummaryArray, { origin: { r: currentRow, c: 0 }, skipHeader: false });
            currentRow += assemblySummaryArray.length + 2; // +1 for header, +1 for empty spacing row

            // --- 2. Financial Summary (if paid) ---
            const isPaidEvent = '@Model.Event.IsPaid.ToString().ToLower()' === 'true';
            if (isPaidEvent) {
                XLSX.utils.sheet_add_aoa(ws, [["FINANCIAL SUMMARY"]], { origin: { r: currentRow, c: 0 } });
                currentRow++;
                
                let successCount = 0;
                let successAmount = 0;
                let pendingCount = 0;
                let failedCount = 0;

                rawRegistrations.forEach(r => {
                    if (r.PaymentStatus === 'Paid') {
                        successCount++;
                        successAmount += r.AmountPaid;
                    } else if (r.PaymentStatus === 'Pending') {
                        pendingCount++;
                    } else {
                        failedCount++;
                    }
                });

                const eventPrice = @(Model.Event.Price ?? 0);
                const financialSummaryArray = [
                    { Category: 'Successful Payments', Count: successCount, Amount: successAmount },
                    { Category: 'Pending Payments', Count: pendingCount, Amount: pendingCount * eventPrice },
                    { Category: 'Failed Payments', Count: failedCount, Amount: failedCount * eventPrice }
                ];
                
                XLSX.utils.sheet_add_json(ws, financialSummaryArray, { origin: { r: currentRow, c: 0 }, skipHeader: false });
                currentRow += financialSummaryArray.length + 2; // +1 for header, +1 for empty spacing row
            }

            // --- 3. Full Registrations ---
            XLSX.utils.sheet_add_aoa(ws, [["FULL REGISTRATIONS"]], { origin: { r: currentRow, c: 0 } });
            currentRow++;
            
            XLSX.utils.sheet_add_json(ws, rawRegistrations, { origin: { r: currentRow, c: 0 }, skipHeader: false });

            // Create Workbook and append the single sheet
            const wb = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(wb, ws, "Event Summary");

            const fileName = "Event_Registrations_@Html.Raw(Model.Event.Title.Replace(" ", "_").Replace("\"", ""))" + ".xlsx";
            XLSX.writeFile(wb, fileName);
        }

        function sendReminders(eventId) {
            Swal.fire({
                title: 'Send Reminders?',
                text: 'This will send email reminders to all registered participants.',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Yes, send reminders'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/Event/SendReminders',
                        type: 'POST',
                        data: { id: eventId },
                        headers: {
                            'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function(response) {
                            if (response.isSuccess) {
                                Swal.fire('Success', response.message, 'success');
                            } else {
                                Swal.fire('Error', response.message, 'error');
                            }
                        },
                        error: function() {
                            Swal.fire('Error', 'Failed to send reminders.', 'error');
                        }
                    });
                }
            });
        }

        function sendBulkPaymentReminders(eventId) {
            Swal.fire({
                title: 'Send Bulk Payment Reminders?',
                text: 'This will send SMS/Email payment reminders to ALL registrants who have not paid. Are you sure?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, Send Reminders'
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire({
                        title: 'Sending...',
                        allowOutsideClick: false,
                        didOpen: () => {
                            Swal.showLoading();
                        }
                    });

                    $.ajax({
                        url: '/Event/SendBulkPaymentReminders',
                        type: 'POST',
                        data: { eventId: eventId },
                        headers: {
                            'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function(response) {
                            if (response.isSuccess) {
                                Swal.fire('Success', response.message, 'success');
                            } else {
                                Swal.fire('Error', response.message || 'No unpaid registrations found.', 'info');
                            }
                        },
                        error: function() {
                            Swal.fire('Error', 'Failed to send bulk payment reminders.', 'error');
                        }
                    });
                }
            });
        }

        function sendBulkAttendanceReminders(eventId) {
            Swal.fire({
                title: 'Send Bulk Attendance Reminders?',
                text: 'This will send SMS/Email attendance reminders to ALL registrants who have not yet been marked as attended. Are you sure?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Yes, Send Reminders'
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire({
                        title: 'Sending...',
                        allowOutsideClick: false,
                        didOpen: () => {
                            Swal.showLoading();
                        }
                    });

                    $.ajax({
                        url: '/Event/SendBulkAttendanceReminders',
                        type: 'POST',
                        data: { eventId: eventId },
                        headers: {
                            'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function(response) {
                            if (response.isSuccess) {
                                Swal.fire('Success', response.message, 'success');
                            } else {
                                Swal.fire('Error', response.message || 'No pending attendance registrations found.', 'info');
                            }
                        },
                        error: function() {
                            Swal.fire('Error', 'Failed to send bulk attendance reminders.', 'error');
                        }
                    });
                }
            });
        }

        function refreshRegistrations() {
            if (!requireRegistration) return;
            
            $('#registrationsTableContainer').html('<div class="text-center p-5"><i class="fa fa-spinner fa-spin fa-2x"></i><p class="mt-2">Loading registrations...</p></div>');
            
            $.ajax({
                url: `/Event/GetRegistrations/${eventId}`,
                type: 'GET',
                success: function(response) {
                    if ($.fn.DataTable.isDataTable('#eventRegistrationsTable')) {
                        $('#eventRegistrationsTable').DataTable().destroy();
                    }
                    $('#registrationsTableContainer').html(response);
                    $('#registrationBadge').text($('#eventRegistrationsTable tbody tr').length);
                    GCIDataTable.init('#eventRegistrationsTable');
                    fetchStats(); // Refresh stats after loading registrations
                },
                error: function() {
                    $('#registrationsTableContainer').html('<div class="alert alert-danger m-3">Failed to load registrations.</div>');
                }
            });
        }

        function fetchStats() {
            $.ajax({
                url: '/Event/GetStats/' + eventId,
                type: 'GET',
                success: function(response) {
                    if (response.isSuccess) {
                        $('#attendeeCount').text(response.attendeeCount || 0);
                        $('#attendedCount').text(response.attendedCount || 0);
                        $('#pendingCount').text(response.pendingCount || 0);
                        if (response.revenue) {
                            $('#revenue').text(`KES ${response.revenue.toLocaleString()}`);
                        }
                    }
                }
            });
        }

        function openNotificationModal(eventId) {
            $('#sendNotificationModal').modal('show');
        }

        function submitEventNotification() {
            const title = $('#notifTitle').val().trim();
            const message = $('#notifMessage').val().trim();
            const notifTime = $('#notifTime').val();

            if (!title || !message || !notifTime) {
                Swal.fire('Validation Error', 'Please fill in the notification title, message and schedule time.', 'warning');
                return;
            }

            const sendSMS = $('#notifSendSMS').is(':checked');
            const sendPush = $('#notifSendPush').is(':checked');
            const sendEmail = $('#notifSendEmail').is(':checked');

            if (!sendSMS && !sendPush && !sendEmail) {
                Swal.fire('No Channel Selected', 'Please select at least one delivery channel (SMS, Push, or Email).', 'warning');
                return;
            }

            const payload = {
                Title: title,
                Message: message,
                SendSMS: sendSMS,
                SendPushNotification: sendPush,
                SendEmail: sendEmail,
                NotificationTime: notifTime
            };

            $('#submitNotifBtn').prop('disabled', true).html('<i class="fa fa-spinner fa-spin me-2"></i>Scheduling...');

            $.ajax({
                url: `/Event/SendEventNotification?eventId=${eventId}`,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    $('#sendNotificationModal').modal('hide');
                    if (response.isSuccess) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Notification Scheduled!',
                            html: `Your notification has been saved and will be sent at the scheduled time.`,
                            confirmButtonText: 'OK'
                        });
                    } else {
                        Swal.fire('Error', response.message || 'Failed to schedule notification.', 'error');
                    }
                },
                error: function(xhr) {
                    const msg = xhr.responseJSON?.message || 'Failed to schedule notification.';
                    Swal.fire('Error', msg, 'error');
                },
                complete: function() {
                    $('#submitNotifBtn').prop('disabled', false).html('<i class="fa fa-paper-plane me-2"></i>Schedule Notification');
                }
            });
        }

        // Initialize on page load
        $(document).ready(function() {
            fetchStats();
            
            if ($('#eventFeedbackTable').length) {
                GCIDataTable.init('#eventFeedbackTable');
            }

            if (requireRegistration) {
                
                // Stop auto-refresh when page is hidden, restart when visible
               
            }
        });

        // Cleanup on page unload
        $(window).on('beforeunload', function() {
            stopAutoRefresh();
        });

        function copyGuestRegistrationLink(eventId) {
            const url = window.location.origin + '/Register/Event/' + eventId;
            
            if (navigator.clipboard) {
                navigator.clipboard.writeText(url).then(function() {
                    if (typeof Swal !== 'undefined') {
                        Swal.fire({
                            title: 'Copied!',
                            text: 'Guest registration link copied to clipboard.',
                            icon: 'success',
                            timer: 2000,
                            showConfirmButton: false
                        });
                    } else {
                        alert('Guest registration link copied to clipboard: ' + url);
                    }
                }, function(err) {
                    console.error('Could not copy text: ', err);
                    alert('Failed to copy link. Please manually copy: ' + url);
                });
            } else {
                alert('Guest registration link: ' + url);
            }
        }

        function copyUsherRegistrationLink(eventId) {
            const url = window.location.origin + '/Register/Usher/' + eventId;
            
            if (navigator.clipboard) {
                navigator.clipboard.writeText(url).then(function() {
                    if (typeof Swal !== 'undefined') {
                        Swal.fire({
                            title: 'Copied!',
                            text: 'Usher registration link copied to clipboard.',
                            icon: 'success',
                            timer: 2000,
                            showConfirmButton: false
                        });
                    } else {
                        alert('Usher registration link copied to clipboard: ' + url);
                    }
                }, function(err) {
                    console.error('Could not copy text: ', err);
                    alert('Failed to copy link. Please manually copy: ' + url);
                });
            } else {
                alert('Usher registration link: ' + url);
            }
        }


        let ageGroupsArray = [];
        const initialGroupsRaw = `@Html.Raw(Model.Event.AllowedAgeGroups ?? "")`;
        if (initialGroupsRaw) {
            try {
                if (initialGroupsRaw.startsWith('[')) {
                    ageGroupsArray = JSON.parse(initialGroupsRaw);
                } else {
                    ageGroupsArray = initialGroupsRaw.split(',').map(s => s.trim()).filter(s => s.length > 0);
                }
            } catch (e) {
                console.error("Could not parse age groups", e);
            }
        }

        function renderAgeGroups() {
            const container = document.getElementById('ageGroupsListContainer');
            if(container) {
                container.innerHTML = '';
                ageGroupsArray.forEach((group, index) => {
                    const chip = document.createElement('span');
                    chip.className = 'badge bg-secondary d-flex align-items-center p-2 fs-6 fw-normal';
                    chip.innerHTML = `${group} <i class="fa fa-times ms-2 text-light" style="cursor:pointer;" onclick="removeAgeGroup(${index})"></i>`;
                    container.appendChild(chip);
                });
            }
        }

        function addAgeGroup() {
            const input = document.getElementById('newAgeGroupInput');
            const val = input.value.trim();
            if (val) {
                if (!ageGroupsArray.includes(val)) {
                    ageGroupsArray.push(val);
                    input.value = '';
                    renderAgeGroups();
                } else {
                    Swal.fire('Info', 'This age group is already added.', 'info');
                }
            }
        }

        function removeAgeGroup(index) {
            ageGroupsArray.splice(index, 1);
            renderAgeGroups();
        }

        document.addEventListener('DOMContentLoaded', function() {
            renderAgeGroups();
            
            const inputEl = document.getElementById('newAgeGroupInput');
            if (inputEl) {
                inputEl.addEventListener('keypress', function(e) {
                    if (e.key === 'Enter' || e.keyCode === 13) {
                        e.preventDefault();
                        addAgeGroup();
                    }
                });
            }
        });

        function saveAgeGroups() {
            var val = JSON.stringify(ageGroupsArray);
            var eventId = @Model.Event.EventId;

            $.ajax({
                url: '@Url.Action("UpdateAgeGroups", "Event")',
                type: 'POST',
                data: {
                    eventId: eventId,
                    ageGroups: val
                },
                success: function(response) {
                    if (response.isSuccess) {
                        Swal.fire('Saved!', 'Age groups have been updated successfully.', 'success');
                    } else {
                        Swal.fire('Error', response.message || 'Failed to save age groups.', 'error');
                    }
                },
                error: function() {
                    Swal.fire('Error', 'An error occurred while saving age groups.', 'error');
                }
            });
        }
    </script>
}