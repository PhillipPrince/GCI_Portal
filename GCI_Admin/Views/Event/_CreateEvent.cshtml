            }

        .card {
            border-radius: 15px;
            overflow: hidden;
        }

        .bg-opacity-10 {
            opacity: 0.1;
        }

        .btn {
            border-radius: 10px;
            padding: 10px 20px;
            transition: all 0.3s;
        }

            .btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(0,0,0,0.1);
