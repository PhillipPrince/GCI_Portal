@model GCI_Admin.Models.DashboardViewModel

<div class="row g-4 mb-4">
    <div class="col-12">
        <h5 class="fw-bold mb-3"><i class="fa fa-church me-2 text-primary"></i>Church Attendance Overview</h5>
    </div>
    
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <div class="flex-shrink-0">
                        <div class="bg-primary bg-opacity-10 p-3 rounded-circle">
                            <i class="fa fa-calendar-alt fa-2x text-primary"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1">Total Meetings</h6>
                        <h3 class="fw-bold mb-0">@Model.TotalMeetings.ToString("N0")</h3>
                        <small class="text-muted"><i class="fa fa-clock me-1"></i>@Model.MeetingTypesCount meeting types</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <div class="flex-shrink-0">
                        <div class="bg-success bg-opacity-10 p-3 rounded-circle">
                            <i class="fa fa-users fa-2x text-success"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1">Total Attendance</h6>
                        <h3 class="fw-bold mb-0">@Model.TotalAttendees.ToString("N0")</h3>
                        @if (Model.AttendanceGrowthPercentage > 0)
                        {
                            <small class="text-success"><i class="fa fa-arrow-up me-1"></i>+@Model.AttendanceGrowthPercentage% from last month</small>
                        }
                        else if (Model.AttendanceGrowthPercentage < 0)
                        {
                            <small class="text-danger"><i class="fa fa-arrow-down me-1"></i>@Model.AttendanceGrowthPercentage% from last month</small>
                        }
                        else
                        {
                            <small class="text-muted"><i class="fa fa-minus me-1"></i>No change</small>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <div class="flex-shrink-0">
                        <div class="bg-info bg-opacity-10 p-3 rounded-circle">
                            <i class="fa fa-chart-line fa-2x text-info"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1">Avg. Attendance/Meeting</h6>
                        <h3 class="fw-bold mb-0">@Model.AverageAttendance.ToString("N0")</h3>
                        <small class="text-muted"><i class="fa fa-calendar me-1"></i>Per service</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <div class="flex-shrink-0">
                        <div class="bg-warning bg-opacity-10 p-3 rounded-circle">
                            <i class="fa fa-chart-bar fa-2x text-warning"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1">Last 30 Days</h6>
                        <h3 class="fw-bold mb-0">@Model.AttendeesLast30Days.ToString("N0")</h3>
                        <small class="text-muted"><i class="fa fa-calendar me-1"></i>@Model.MeetingsLast30Days meetings</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
