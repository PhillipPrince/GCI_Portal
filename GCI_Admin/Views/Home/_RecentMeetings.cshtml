@model List<GCI_Admin.Models.RecentMeetingStats>

@if (Model != null && Model.Any())
{
    <div class="row g-4 mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h6 class="fw-bold mb-0"><i class="fa fa-history me-2 text-primary"></i>Recent Meetings</h6>
                        <a href="@Url.Action("Index", "Meetings")" class="btn btn-link btn-sm p-0">View All →</a>
                    </div>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle" id="recentMeetingsTable">
                            <thead class="table-light">
                                <tr>
                                    <th>Date</th>
                                    <th>Meeting Type</th>
                                    <th>Total</th>
                                    <th>Male</th>
                                    <th>Female</th>
                                    <th>Children</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var meeting in Model)
                                {
                                    <tr>
                                        <td>@meeting.MeetingDate.ToString("MMM dd, yyyy")</td>
                                        <td><span class="badge bg-primary bg-opacity-10 text-primary">@meeting.MeetingType</span></td>
                                        <td><strong>@meeting.TotalAttendees</strong></td>
                                        <td>@meeting.MaleCount</td>
                                        <td>@meeting.FemaleCount</td>
                                        <td>@meeting.ChildrenCount</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
