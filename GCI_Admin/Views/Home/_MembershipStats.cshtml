@model GCI_Admin.Models.DashboardViewModel

<!-- KPI CARDS - Enhanced with gradients and real percentages -->
<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <div class="flex-shrink-0">
                        <div class="bg-primary bg-opacity-10 p-3 rounded-circle">
                            <i class="fa fa-users fa-2x text-primary"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1">Total Members</h6>
                        <h3 class="fw-bold mb-0">@Model.TotalMembers.ToString("N0")</h3>
                        @if (Model.MemberGrowthPercentage > 0)
                        {
                            <small class="text-success"><i class="fa fa-arrow-up me-1"></i>+@Model.MemberGrowthPercentage% from last month</small>
                        }
                        else if (Model.MemberGrowthPercentage < 0)
                        {
                            <small class="text-danger"><i class="fa fa-arrow-down me-1"></i>@Model.MemberGrowthPercentage% from last month</small>
                        }
                        else
                        {
                            <small class="text-muted"><i class="fa fa-minus me-1"></i>No change from last month</small>
                        }
                    </div>
                </div>
                <div class="progress" style="height: 4px;">
                    <div class="progress-bar bg-primary" style="width: @Model.TotalMembersPercentage%"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <div class="flex-shrink-0">
                        <div class="bg-success bg-opacity-10 p-3 rounded-circle">
                            <i class="fa fa-user-check fa-2x text-success"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1">Active Members</h6>
                        <h3 class="fw-bold mb-0">@Model.TotalActiveMembers.ToString("N0")</h3>
                        @if (Model.ActiveMemberGrowthPercentage > 0)
                        {
                            <small class="text-success"><i class="fa fa-arrow-up me-1"></i>+@Model.ActiveMemberGrowthPercentage% from last month</small>
                        }
                        else if (Model.ActiveMemberGrowthPercentage < 0)
                        {
                            <small class="text-danger"><i class="fa fa-arrow-down me-1"></i>@Model.ActiveMemberGrowthPercentage% from last month</small>
                        }
                        else
                        {
                            <small class="text-muted"><i class="fa fa-minus me-1"></i>No change from last month</small>
                        }
                    </div>
                </div>
                <div class="progress" style="height: 4px;">
                    <div class="progress-bar bg-success" style="width: @Model.ActiveMembersPercentage%"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <div class="flex-shrink-0">
                        <div class="bg-info bg-opacity-10 p-3 rounded-circle">
                            <i class="fa fa-church fa-2x text-info"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1">Membership Class</h6>
                        <h3 class="fw-bold mb-0">@Model.MemberStatus?.MembershipClassMembers?.Count</h3>
                        <small class="text-info"><i class="fa fa-clock me-1"></i>Awaiting confirmation</small>
                    </div>
                </div>
                <div class="progress" style="height: 4px;">
                    <div class="progress-bar bg-info" style="width: @(Model.TotalActiveMembers > 0 ? Math.Round((decimal)(Model.MemberStatus?.MembershipClassMembers?.Count ) / Model.TotalActiveMembers * 100, 2) : 0)%"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- CHARTS SECTION - Two charts side by side -->
<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0">ðŸ“ˆ Member Growth</h6>
                    <div class="btn-group btn-group-sm">
                        <button class="btn btn-outline-secondary active" data-chart="member-growth" data-period="weekly">Weekly</button>
                        <button class="btn btn-outline-secondary" data-chart="member-growth" data-period="monthly">Monthly</button>
                        <button class="btn btn-outline-secondary" data-chart="member-growth" data-period="yearly">Yearly</button>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <canvas id="membersChart" height="120"></canvas>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0">ðŸ‘‘ Full Membership Attainment</h6>
                    <div class="btn-group btn-group-sm">
                        <button class="btn btn-outline-secondary active" data-chart="full-membership" data-period="weekly">Weekly</button>
                        <button class="btn btn-outline-secondary" data-chart="full-membership" data-period="monthly">Monthly</button>
                        <button class="btn btn-outline-secondary" data-chart="full-membership" data-period="yearly">Yearly</button>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <canvas id="fullMembersChart" height="120"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- MEMBERS TAB SECTION - ENHANCED WITH ALL STATUSES -->
<div class="card border-0 shadow-sm" id="members-list-section">
    <div class="card-header bg-white border-0 py-3">
        <div class="d-flex justify-content-between align-items-center">
            <h6 class="fw-bold mb-0">
                <i class="fa fa-users me-2 text-primary"></i>ðŸ‘¥ Member Management
            </h6>
         
        </div>
    </div>
    <div class="card-body">
        <!-- TABS -->
        <ul class="nav nav-tabs nav-tabs-custom mb-3" id="memberTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="active-tab" data-bs-toggle="tab" data-bs-target="#activeMembers" type="button" role="tab">
                    <i class="fa fa-check-circle text-success me-1"></i>Active Members 
                    <span class="badge bg-primary ms-2">@Model.MemberStatus.ActiveMembers?.Count </span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="membership-tab" data-bs-toggle="tab" data-bs-target="#membershipClass" type="button" role="tab">
                    <i class="fa fa-book text-warning me-1"></i>Membership Class 
                    <span class="badge bg-warning ms-2">@Model.MemberStatus.MembershipClassMembers?.Count </span>
                </button>
            </li>
            
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="awaiting-tab" data-bs-toggle="tab" data-bs-target="#awaitingConfirmation" type="button" role="tab">
                    <i class="fa fa-clock text-orange me-1" style="color:#fd7e14;"></i>Awaiting Confirmation
                    <span class="badge ms-2" style="background-color:#fd7e14;">@Model.MemberStatus.AwaitingConfirmationMembers?.Count</span>
                </button>
            </li>
            
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="inactive-tab" data-bs-toggle="tab" data-bs-target="#inactiveMembers" type="button" role="tab">
                    <i class="fa fa-pause-circle text-secondary me-1"></i>Inactive Members 
                    <span class="badge bg-secondary ms-2">@Model.MemberStatus.InactiveMembers?.Count </span>
                </button>
            </li>
            <li class="nav-item dropdown">
                <button class="nav-link dropdown-toggle" data-bs-toggle="dropdown" role="button">
                    <i class="fa fa-ellipsis-h me-1"></i>More Status
                </button>
                <ul class="dropdown-menu">
                    <li>
                        <button class="dropdown-item" id="transferred-tab" data-bs-toggle="tab" data-bs-target="#transferredMembers" type="button" role="tab">
                            <i class="fa fa-exchange-alt text-primary me-2"></i>Transferred
                            <span class="badge bg-primary ms-2">@Model.MemberStatus.TransferredMembers?.Count </span>
                        </button>
                    </li>
                    <li>
                        <button class="dropdown-item" id="glory-tab" data-bs-toggle="tab" data-bs-target="#promotedToGlory" type="button" role="tab">
                            <i class="fa fa-angel text-info me-2"></i>Promoted to Glory
                            <span class="badge bg-info ms-2">@Model.MemberStatus.PromotedToGlory?.Count </span>
                        </button>
                    </li>
                    
                    <li>
                        <button class="dropdown-item" id="withdrawn-tab" data-bs-toggle="tab" data-bs-target="#withdrawnMembers" type="button" role="tab">
                            <i class="fa fa-sign-out-alt text-warning me-2"></i>Withdrawn
                            <span class="badge bg-warning ms-2">@Model.MemberStatus.WithdrawnMembers?.Count </span>
                        </button>
                    </li>
                    
                </ul>
            </li>
        </ul>

        <!-- TAB CONTENT -->
        <div class="tab-content" id="memberTabsContent">
            <!-- Active Members Tab -->
            <div class="tab-pane fade show active" id="activeMembers" role="tabpanel">
                @{ ViewData["TableId"] = "activeMembersTable"; ViewData["StatusId"] = "1"; }
                @await Html.PartialAsync("~/Views/Members/_MembersTablePartial.cshtml", (List<GCI_Admin.Models.Member>)null)
            </div>
            
            <!-- Membership Class Tab -->
            <div class="tab-pane fade" id="membershipClass" role="tabpanel">
                @{ ViewData["TableId"] = "membershipClassTable"; ViewData["StatusId"] = "2"; }
                @await Html.PartialAsync("~/Views/Members/_MembersTablePartial.cshtml", (List<GCI_Admin.Models.Member>)null)
            </div>      
           
            <!-- Awaiting Confirmation Tab -->
            <div class="tab-pane fade" id="awaitingConfirmation" role="tabpanel">
                @{ ViewData["TableId"] = "awaitingConfirmationTable"; ViewData["StatusId"] = "4"; }
                @await Html.PartialAsync("~/Views/Members/_MembersTablePartial.cshtml", (List<GCI_Admin.Models.Member>)null)
            </div>

            <!-- Inactive Members Tab -->
            <div class="tab-pane fade" id="inactiveMembers" role="tabpanel">
                @{ ViewData["TableId"] = "inactiveMembersTable"; ViewData["StatusId"] = "3"; }
                @await Html.PartialAsync("~/Views/Members/_MembersTablePartial.cshtml", (List<GCI_Admin.Models.Member>)null)
            </div>
            
            <!-- Transferred Members Tab -->
            <div class="tab-pane fade" id="transferredMembers" role="tabpanel">
                @{ ViewData["TableId"] = "transferredMembersTable"; ViewData["StatusId"] = "7"; }
                @await Html.PartialAsync("~/Views/Members/_MembersTablePartial.cshtml", (List<GCI_Admin.Models.Member>)null)
            </div>
            
            <!-- Promoted to Glory Tab -->
            <div class="tab-pane fade" id="promotedToGlory" role="tabpanel">
                @{ ViewData["TableId"] = "promotedToGloryTable"; ViewData["StatusId"] = "5"; }
                @await Html.PartialAsync("~/Views/Members/_MembersTablePartial.cshtml", (List<GCI_Admin.Models.Member>)null)
            </div>
            
            <!-- Withdrawn Members Tab -->
            <div class="tab-pane fade" id="withdrawnMembers" role="tabpanel">
                @{ ViewData["TableId"] = "withdrawnMembersTable"; ViewData["StatusId"] = "6"; }
                @await Html.PartialAsync("~/Views/Members/_MembersTablePartial.cshtml", (List<GCI_Admin.Models.Member>)null)
            </div>
        </div>
    </div>
</div>
