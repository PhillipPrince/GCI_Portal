@model GCI_Admin.Models.DashboardViewModel

<!-- CHARTS SECTION - All four charts grouped together -->
<div class="row g-4 mb-4">
    <!-- Member Growth Chart -->
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0">📈 Member Growth</h6>
                    <div class="btn-group btn-group-sm">
                        <button class="btn btn-outline-secondary active" data-chart="member-growth" data-period="weekly">Weekly</button>
                        <button class="btn btn-outline-secondary" data-chart="member-growth" data-period="monthly">Monthly</button>
                        <button class="btn btn-outline-secondary" data-chart="member-growth" data-period="yearly">Yearly</button>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <canvas id="membersChart" height="120"></canvas>
            </div>
        </div>
    </div>

    <!-- Full Membership Attainment Chart -->
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0">👑 Full Membership Attainment</h6>
                    <div class="btn-group btn-group-sm">
                        <button class="btn btn-outline-secondary active" data-chart="full-membership" data-period="weekly">Weekly</button>
                        <button class="btn btn-outline-secondary" data-chart="full-membership" data-period="monthly">Monthly</button>
                        <button class="btn btn-outline-secondary" data-chart="full-membership" data-period="yearly">Yearly</button>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <canvas id="fullMembersChart" height="120"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Gender Distribution Chart -->
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 py-3">
                <h6 class="fw-bold mb-0"><i class="fa fa-venus-mars me-2 text-primary"></i>Gender Distribution</h6>
            </div>
            <div class="card-body">
                <div id="genderData" data-male="@Model.TotalMale" data-female="@Model.TotalFemale" data-children="@Model.TotalChildren" style="display:none;"></div>
                <canvas id="genderChart" height="200"></canvas>
                <div class="row mt-3 text-center">
                    <div class="col-4">
                        <div class="border rounded p-2">
                            <small class="text-muted">Male</small>
                            <h5 class="mb-0 text-primary">@Model.TotalMale.ToString("N0")</h5>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="border rounded p-2">
                            <small class="text-muted">Female</small>
                            <h5 class="mb-0 text-success">@Model.TotalFemale.ToString("N0")</h5>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="border rounded p-2">
                            <small class="text-muted">Children</small>
                            <h5 class="mb-0 text-warning">@Model.TotalChildren.ToString("N0")</h5>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Monthly Attendance Trend Chart -->
    <div class="col-md-8">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0"><i class="fa fa-line-chart me-2 text-primary"></i>Monthly Attendance Trend</h6>
                </div>
            </div>
            <div class="card-body">
                <div data-attendance='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyAttendanceTrend ?? new List<GCI_Admin.Models.MonthlyTrendStats>()))' style="display:none;"></div>
                <canvas id="attendanceTrendChart" height="180"></canvas>
            </div>
        </div>
    </div>
</div>
