@model GCI_Admin.Models.DashboardViewModel

<!-- TODAY'S OVERVIEW -->
<div class="row g-4 mb-4">
    <div class="col-md-12">
        <div class="card border-0 shadow-sm bg-primary text-white" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
            <div class="card-body p-4 d-flex justify-content-between align-items-center flex-wrap">
                <div>
                    <h4 class="fw-bold mb-2"><i class="fa fa-calendar-day me-2"></i>@Model.TodayDayOfWeek, @Model.TodayDate</h4>
                    @if (Model.TodayActivities != null && Model.TodayActivities.Any())
                    {
                        <div class="d-flex align-items-center mt-2 flex-wrap gap-2">
                            <span class="badge bg-white text-primary px-3 py-2">Today's Activities</span>
                            <span class="fs-6 opacity-85">
                                @string.Join(" • ", Model.TodayActivities.Select(a => $"{a.ActivityName} ({(a.StartTime.HasValue ? new DateTime(a.StartTime.Value.Ticks).ToString("h:mm tt") : "")})"))
                            </span>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex align-items-center mt-2">
                            <span class="badge bg-white text-primary px-3 py-2">No Activities Today</span>
                        </div>
                    }
                </div>
                <div class="text-end mt-3 mt-md-0">
                    <h1 class="fw-bold mb-0 display-5 opacity-75"><i class="fa fa-clock me-2"></i>@DateTime.Now.ToString("h:mm tt")</h1>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- UPCOMING EVENTS KPI -->
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <div class="flex-shrink-0">
                        <div class="bg-warning bg-opacity-10 p-3 rounded-circle">
                            <i class="fa fa-calendar fa-2x text-warning"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1">Upcoming Events</h6>
                        <h3 class="fw-bold mb-0">@Model.UpcomingEvents.ToString("N0")</h3>
                        @if (Model.EventChangePercentage > 0)
                        {
                            <small class="text-danger"><i class="fa fa-arrow-up me-1"></i>+@Model.EventChangePercentage% from last month</small>
                        }
                        else if (Model.EventChangePercentage < 0)
                        {
                            <small class="text-success"><i class="fa fa-arrow-down me-1"></i>@Model.EventChangePercentage% from last month</small>
                        }
                        else
                        {
                            <small class="text-muted"><i class="fa fa-minus me-1"></i>Same as last month</small>
                        }
                    </div>
                </div>
                <div class="progress" style="height: 4px;">
                    <div class="progress-bar bg-warning" style="width: @Model.EventCompletionPercentage%"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- UPCOMING EVENTS LIST -->
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0">📅 Upcoming Events</h6>
                    <a href="@Url.Action("Index", "Event")" class="btn btn-link btn-sm p-0">View All →</a>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="list-group list-group-flush">
                    @if (Model.UpcomingEvent != null && Model.UpcomingEvent.Any())
                    {
                        foreach (var evt in Model.UpcomingEvent.Take(3))
                        {
                            <a href="@Url.Action("EventDetails", "Event", new { id = evt.EventId })" class="list-group-item list-group-item-action border-0 d-flex align-items-center py-3 text-decoration-none text-dark">
                                <div class="bg-primary bg-opacity-10 p-2 rounded-circle me-3">
                                    <i class="fa fa-church text-primary"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <h6 class="mb-1 text-truncate" style="max-width: 150px;">@evt.Title</h6>
                                    <small class="text-muted">
                                        <i class="fa fa-clock me-1"></i>
                                        @evt.EventDate.ToString("MMM dd, h:mm tt")
                                    </small>
                                </div>
                                <span class="badge @(evt.EventDate.Date == DateTime.Today ? "bg-primary" : "bg-secondary") ms-2">
                                    @(evt.EventDate.Date == DateTime.Today ? "Today" : "Soon")
                                </span>
                            </a>
                        }
                    }
                    else
                    {
                        <div class="text-center text-muted py-4">
                            <i class="fa fa-calendar-alt fa-2x mb-2"></i>
                            <p class="mb-0">No upcoming events</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- THEMES SECTION -->
    <div class="col-md-6">
        <div class="row g-3 h-100">
            <!-- Annual Theme -->
            <div class="col-6">
                <div class="card border-0 shadow-sm h-100 overflow-hidden position-relative" onclick="$('#themeModal').modal('show')" style="cursor: pointer; min-height: 180px;">
                    <img id="yearThemeImage" class="position-absolute w-100 h-100" style="object-fit: cover; opacity: 0.15; z-index: 0;" />
                    <div class="card-body d-flex flex-column justify-content-center align-items-center text-center position-relative z-1 h-100 px-2 py-4">
                        <div class="bg-primary bg-opacity-10 p-2 rounded-circle mb-2">
                            <i class="fa fa-star text-primary"></i>
                        </div>
                        <h6 class="fw-bold text-primary mb-1 text-uppercase" style="font-size: 0.75rem; letter-spacing: 1px;" id="themeYearTitle">
                            Theme of the Year
                        </h6>
                        <h5 class="fw-bold mb-2 text-dark" id="themeTitle" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                            Loading...
                        </h5>
                        <p class="text-muted small fst-italic mb-0" id="themeVerse" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;"></p>
                    </div>
                </div>
            </div>
            
            <!-- Monthly Theme -->
            <div class="col-6">
                <div class="card border-0 shadow-sm h-100 overflow-hidden position-relative" onclick="$('#monthlyThemeModal').modal('show')" style="cursor: pointer; min-height: 180px;">
                    <img id="monthlyThemeImage" class="position-absolute w-100 h-100" style="object-fit: cover; opacity: 0.15; z-index: 0;" />
                    <div class="card-body d-flex flex-column justify-content-center align-items-center text-center position-relative z-1 h-100 px-2 py-4">
                        <div class="bg-success bg-opacity-10 p-2 rounded-circle mb-2">
                            <i class="fa fa-calendar-check text-success"></i>
                        </div>
                        <h6 class="fw-bold text-success mb-1 text-uppercase" style="font-size: 0.75rem; letter-spacing: 1px;" id="monthlyThemeMonthTitle">
                            Theme of the Month
                        </h6>
                        <h5 class="fw-bold mb-2 text-dark" id="monthlyThemeTitle" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                            Loading...
                        </h5>
                        <p class="text-muted small mb-0" id="monthlyThemeActivity" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;"></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Quick Actions -->
    <div class="col-md-12">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <div class="row align-items-center">
                    <div class="col-md-3 border-end">
                        <h5 class="fw-bold mb-0">⚡ Quick Actions</h5>
                        <p class="text-muted small mb-0">Fast access to common tasks</p>
                    </div>
                    <div class="col-md-9">
                        <div class="d-flex gap-3 overflow-auto" style="white-space: nowrap;">
                            <a href="javascript:void(0);" onclick="$('#addMemberModal').modal('show')" class="btn btn-outline-primary px-4 py-2 rounded-pill flex-shrink-0">
                                <i class="fa fa-user-plus me-2"></i> Add New Member
                            </a>
                            <a href="@Url.Action("CreateEvent", "Event")" class="btn btn-outline-success px-4 py-2 rounded-pill flex-shrink-0">
                                <i class="fa fa-calendar-plus me-2"></i> Create Event
                            </a>
                            <a href="@Url.Action("CreateAnnouncement", "Announcements")" class="btn btn-outline-warning px-4 py-2 rounded-pill flex-shrink-0">
                                <i class="fa fa-bullhorn me-2"></i> New Announcement
                            </a>
                            
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
