@model GCI_Admin.Models.DashboardViewModel

<!-- KPI CARDS - Enhanced with gradients and real percentages -->
<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <div class="flex-shrink-0">
                        <div class="bg-primary bg-opacity-10 p-3 rounded-circle">
                            <i class="fa fa-users fa-2x text-primary"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1">Total Members</h6>
                        <h3 class="fw-bold mb-0">@Model.TotalMembers.ToString("N0")</h3>
                        @if (Model.MemberGrowthPercentage > 0)
                        {
                            <small class="text-success"><i class="fa fa-arrow-up me-1"></i>+@Model.MemberGrowthPercentage% from last month</small>
                        }
                        else if (Model.MemberGrowthPercentage < 0)
                        {
                            <small class="text-danger"><i class="fa fa-arrow-down me-1"></i>@Model.MemberGrowthPercentage% from last month</small>
                        }
                        else
                        {
                            <small class="text-muted"><i class="fa fa-minus me-1"></i>No change from last month</small>
                        }
                    </div>
                </div>
                <div class="progress" style="height: 4px;">
                    <div class="progress-bar bg-primary" style="width: @Model.TotalMembersPercentage%"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <div class="flex-shrink-0">
                        <div class="bg-success bg-opacity-10 p-3 rounded-circle">
                            <i class="fa fa-user-check fa-2x text-success"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1">Active Members</h6>
                        <h3 class="fw-bold mb-0">@Model.TotalActiveMembers.ToString("N0")</h3>
                        @if (Model.ActiveMemberGrowthPercentage > 0)
                        {
                            <small class="text-success"><i class="fa fa-arrow-up me-1"></i>+@Model.ActiveMemberGrowthPercentage% from last month</small>
                        }
                        else if (Model.ActiveMemberGrowthPercentage < 0)
                        {
                            <small class="text-danger"><i class="fa fa-arrow-down me-1"></i>@Model.ActiveMemberGrowthPercentage% from last month</small>
                        }
                        else
                        {
                            <small class="text-muted"><i class="fa fa-minus me-1"></i>No change from last month</small>
                        }
                    </div>
                </div>
                <div class="progress" style="height: 4px;">
                    <div class="progress-bar bg-success" style="width: @Model.ActiveMembersPercentage%"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <div class="flex-shrink-0">
                        <div class="bg-info bg-opacity-10 p-3 rounded-circle">
                            <i class="fa fa-church fa-2x text-info"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1">Membership Class</h6>
                        <h3 class="fw-bold mb-0">@Model.MemberStatus?.MembershipClassMembers?.Count</h3>
                        <small class="text-info"><i class="fa fa-clock me-1"></i>Awaiting confirmation</small>
                    </div>
                </div>
                <div class="progress" style="height: 4px;">
                    <div class="progress-bar bg-info" style="width: @(Model.TotalActiveMembers > 0 ? Math.Round((decimal)(Model.MemberStatus?.MembershipClassMembers?.Count ) / Model.TotalActiveMembers * 100, 2) : 0)%"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <div class="flex-shrink-0">
                        <div class="bg-warning bg-opacity-10 p-3 rounded-circle">
                            <i class="fa fa-calendar fa-2x text-warning"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1">Upcoming Events</h6>
                        <h3 class="fw-bold mb-0">@Model.UpcomingEvents.ToString("N0")</h3>
                        @if (Model.EventChangePercentage > 0)
                        {
                            <small class="text-danger"><i class="fa fa-arrow-up me-1"></i>+@Model.EventChangePercentage% from last month</small>
                        }
                        else if (Model.EventChangePercentage < 0)
                        {
                            <small class="text-success"><i class="fa fa-arrow-down me-1"></i>@Model.EventChangePercentage% from last month</small>
                        }
                        else
                        {
                            <small class="text-muted"><i class="fa fa-minus me-1"></i>Same as last month</small>
                        }
                    </div>
                </div>
                <div class="progress" style="height: 4px;">
                    <div class="progress-bar bg-warning" style="width: @Model.EventCompletionPercentage%"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- DATA PANELS -->
<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0">ðŸ“… Upcoming Events</h6>
                    <a href="@Url.Action("Index", "Event")" class="btn btn-link btn-sm p-0">View All â†’</a>
                </div>
            </div>
            <div class="card-body">
                <div class="list-group list-group-flush">
                    @if (Model.UpcomingEvent != null && Model.UpcomingEvent.Any())
                    {
                        foreach (var evt in Model.UpcomingEvent.Take(3))
                        {
                            <a href="@Url.Action("EventDetails", "Event", new { id = evt.EventId })" class="list-group-item list-group-item-action px-0 border-0 d-flex align-items-center text-decoration-none text-dark">
                                <div class="bg-primary bg-opacity-10 p-2 rounded-circle me-3">
                                    <i class="fa fa-church text-primary"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <h6 class="mb-1">@evt.Title</h6>
                                    <small class="text-muted">
                                        <i class="fa fa-clock me-1"></i>
                                        @evt.EventDate.ToString("MMM dd, h:mm tt")
                                    </small>
                                </div>
                                <span class="badge @(evt.EventDate.Date == DateTime.Today ? "bg-primary" : "bg-secondary")">
                                    @(evt.EventDate.Date == DateTime.Today ? "Today" : "")
                                </span>
                            </a>
                        }
                    }
                    else
                    {
                        <div class="text-center text-muted py-4">
                            <i class="fa fa-calendar-alt fa-2x mb-2"></i>
                            <p class="mb-0">No upcoming events</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Theme Card with onclick -->
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100 overflow-hidden" onclick="openThemeModal()" style="cursor: pointer;">
            <div class="row g-0 h-100">
                <!-- Left Image Section -->
                <div class="col-md-5">
                    <div class="h-100">
                        <img id="yearThemeImage"
                             alt="Theme of the Year"
                             class="img-fluid h-100 w-100"
                             style="object-fit: cover;">
                    </div>
                </div>
                <!-- Right Content Section -->
                <div class="col-md-7">
                    <div class="card-body d-flex flex-column justify-content-center align-items-center text-center h-100">
                        <h6 class="fw-bold text-primary mb-2" id="themeYearTitle">
                            Theme of the Year
                        </h6>
                        <h5 class="fw-bold mb-3" id="themeTitle">
                            Loading...
                        </h5>
                        <p class="text-muted mb-1 fw-semibold" id="themeVerse"></p>
                        <p class="text-muted mb-0" id="themeDescription"></p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 py-3">
                <h6 class="fw-bold mb-0">âš¡ Quick Actions</h6>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a href="javascript:void(0);"
                           onclick="openAddMemberModal()"
                           class="btn btn-primary text-start d-flex align-items-center">
                        <i class="fa fa-user-plus me-3"></i>
                        <div>
                            <strong>Add New Member</strong><br>
                            <small class="opacity-75">Register a new church member</small>
                        </div>
                    </a>
                    <a href="@Url.Action("CreateEvent", "Event")" class="btn btn-success text-start d-flex align-items-center">
                        <i class="fa fa-calendar-plus me-3"></i>
                        <div>
                            <strong>Create Event</strong><br>
                            <small class="opacity-75">Schedule a church event</small>
                        </div>
                    </a>
                    <a href="@Url.Action("CreateAnnouncement", "Announcements")" class="btn btn-warning text-start d-flex align-items-center">
                        <i class="fa fa-bullhorn me-3"></i>
                        <div>
                            <strong>New Announcement</strong><br>
                            <small class="opacity-75">Share with congregation</small>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ðŸ†• ATTENDANCE KPI CARDS - New Section -->
<div class="row g-4 mb-4">
    <div class="col-12">
        <h5 class="fw-bold mb-3"><i class="fa fa-church me-2 text-primary"></i>Church Attendance Overview</h5>
    </div>
    
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <div class="flex-shrink-0">
                        <div class="bg-primary bg-opacity-10 p-3 rounded-circle">
                            <i class="fa fa-calendar-alt fa-2x text-primary"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1">Total Meetings</h6>
                        <h3 class="fw-bold mb-0">@Model.TotalMeetings.ToString("N0")</h3>
                        <small class="text-muted"><i class="fa fa-clock me-1"></i>@Model.MeetingTypesCount meeting types</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <div class="flex-shrink-0">
                        <div class="bg-success bg-opacity-10 p-3 rounded-circle">
                            <i class="fa fa-users fa-2x text-success"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1">Total Attendance</h6>
                        <h3 class="fw-bold mb-0">@Model.TotalAttendees.ToString("N0")</h3>
                        @if (Model.AttendanceGrowthPercentage > 0)
                        {
                            <small class="text-success"><i class="fa fa-arrow-up me-1"></i>+@Model.AttendanceGrowthPercentage% from last month</small>
                        }
                        else if (Model.AttendanceGrowthPercentage < 0)
                        {
                            <small class="text-danger"><i class="fa fa-arrow-down me-1"></i>@Model.AttendanceGrowthPercentage% from last month</small>
                        }
                        else
                        {
                            <small class="text-muted"><i class="fa fa-minus me-1"></i>No change</small>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <div class="flex-shrink-0">
                        <div class="bg-info bg-opacity-10 p-3 rounded-circle">
                            <i class="fa fa-chart-line fa-2x text-info"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1">Avg. Attendance/Meeting</h6>
                        <h3 class="fw-bold mb-0">@Model.AverageAttendance.ToString("N0")</h3>
                        <small class="text-muted"><i class="fa fa-calendar me-1"></i>Per service</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <div class="flex-shrink-0">
                        <div class="bg-warning bg-opacity-10 p-3 rounded-circle">
                            <i class="fa fa-chart-bar fa-2x text-warning"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1">Last 30 Days</h6>
                        <h3 class="fw-bold mb-0">@Model.AttendeesLast30Days.ToString("N0")</h3>
                        <small class="text-muted"><i class="fa fa-calendar me-1"></i>@Model.MeetingsLast30Days meetings</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ðŸ†• GENDER BREAKDOWN SECTION -->
<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 py-3">
                <h6 class="fw-bold mb-0"><i class="fa fa-venus-mars me-2 text-primary"></i>Gender Distribution</h6>
            </div>
            <div class="card-body">
                <div id="genderData" data-male="@Model.TotalMale" data-female="@Model.TotalFemale" data-children="0" style="display:none;"></div>
                <canvas id="genderChart" height="200"></canvas>
                <div class="row mt-3 text-center">
                    <div class="col-4">
                        <div class="border rounded p-2">
                            <small class="text-muted">Male</small>
                            <h5 class="mb-0 text-primary">@Model.TotalMale.ToString("N0")</h5>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="border rounded p-2">
                            <small class="text-muted">Female</small>
                            <h5 class="mb-0 text-success">@Model.TotalFemale.ToString("N0")</h5>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="border rounded p-2">
                            <small class="text-muted">Children</small>
                            <h5 class="mb-0 text-warning">@Model.TotalChildren.ToString("N0")</h5>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0"><i class="fa fa-line-chart me-2 text-primary"></i>Monthly Attendance Trend</h6>
                </div>
            </div>
            <div class="card-body">
                <div data-attendance='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyAttendanceTrend ?? new List<GCI_Admin.Models.MonthlyTrendStats>()))' style="display:none;"></div>
                <canvas id="attendanceTrendChart" height="180"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- ðŸ†• RECENT MEETINGS SECTION -->
@if (Model.RecentMeetings != null && Model.RecentMeetings.Any())
{
    <div class="row g-4 mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h6 class="fw-bold mb-0"><i class="fa fa-history me-2 text-primary"></i>Recent Meetings</h6>
                        <a href="@Url.Action("Index", "Meetings")" class="btn btn-link btn-sm p-0">View All</a>
                    </div>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle" id="recentMeetingsTable">
                            <thead class="table-light">
                                <tr>
                                    <th>Date</th>
                                    <th>Meeting Type</th>
                                    <th>Total</th>
                                    <th>Male</th>
                                    <th>Female</th>
                                    <th>Children</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var meeting in Model.RecentMeetings)
                                {
                                    <tr>
                                        <td>@meeting.MeetingDate.ToString("MMM dd, yyyy")</td>
                                        <td><span class="badge bg-primary bg-opacity-10 text-primary">@meeting.MeetingType</span></td>
                                        <td><strong>@meeting.TotalAttendees</strong></td>
                                        <td>@meeting.MaleCount</td>
                                        <td>@meeting.FemaleCount</td>
                                        <td>@meeting.ChildrenCount</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- CHARTS SECTION - Two charts side by side -->
<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0">ðŸ“ˆ Member Growth</h6>
                    <div class="btn-group btn-group-sm">
                        <button class="btn btn-outline-secondary active" data-chart="member-growth" data-period="weekly">Weekly</button>
                        <button class="btn btn-outline-secondary" data-chart="member-growth" data-period="monthly">Monthly</button>
                        <button class="btn btn-outline-secondary" data-chart="member-growth" data-period="yearly">Yearly</button>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <canvas id="membersChart" height="120"></canvas>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0">ðŸ‘‘ Full Membership Attainment</h6>
                    <div class="btn-group btn-group-sm">
                        <button class="btn btn-outline-secondary active" data-chart="full-membership" data-period="weekly">Weekly</button>
                        <button class="btn btn-outline-secondary" data-chart="full-membership" data-period="monthly">Monthly</button>
                        <button class="btn btn-outline-secondary" data-chart="full-membership" data-period="yearly">Yearly</button>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <canvas id="fullMembersChart" height="120"></canvas>
            </div>
        </div>
    </div>
</div>


<!-- MEMBERS TAB SECTION - ENHANCED WITH ALL STATUSES -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white border-0 py-3">
        <div class="d-flex justify-content-between align-items-center">
            <h6 class="fw-bold mb-0">
                <i class="fa fa-users me-2 text-primary"></i>ðŸ‘¥ Member Management
            </h6>
         
        </div>
    </div>
    <div class="card-body">
        <!-- TABS -->
        <ul class="nav nav-tabs nav-tabs-custom mb-3" id="memberTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="active-tab" data-bs-toggle="tab" data-bs-target="#activeMembers" type="button" role="tab">
                    <i class="fa fa-check-circle text-success me-1"></i>Active Members 
                    <span class="badge bg-primary ms-2">@Model.MemberStatus.ActiveMembers?.Count </span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="membership-tab" data-bs-toggle="tab" data-bs-target="#membershipClass" type="button" role="tab">
                    <i class="fa fa-book text-warning me-1"></i>Membership Class 
                    <span class="badge bg-warning ms-2">@Model.MemberStatus.MembershipClassMembers?.Count </span>
                </button>
            </li>
            
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="awaiting-tab" data-bs-toggle="tab" data-bs-target="#awaitingConfirmation" type="button" role="tab">
                    <i class="fa fa-clock text-orange me-1" style="color:#fd7e14;"></i>Awaiting Confirmation
                    <span class="badge ms-2" style="background-color:#fd7e14;">@Model.MemberStatus.AwaitingConfirmationMembers?.Count</span>
                </button>
            </li>
            
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="inactive-tab" data-bs-toggle="tab" data-bs-target="#inactiveMembers" type="button" role="tab">
                    <i class="fa fa-pause-circle text-secondary me-1"></i>Inactive Members 
                    <span class="badge bg-secondary ms-2">@Model.MemberStatus.InactiveMembers?.Count </span>
                </button>
            </li>
            <li class="nav-item dropdown">
                <button class="nav-link dropdown-toggle" data-bs-toggle="dropdown" role="button">
                    <i class="fa fa-ellipsis-h me-1"></i>More Status
                </button>
                <ul class="dropdown-menu">
                    <li>
                        <button class="dropdown-item" id="transferred-tab" data-bs-toggle="tab" data-bs-target="#transferredMembers" type="button" role="tab">
                            <i class="fa fa-exchange-alt text-primary me-2"></i>Transferred
                            <span class="badge bg-primary ms-2">@Model.MemberStatus.TransferredMembers?.Count </span>
                        </button>
                    </li>
                    <li>
                        <button class="dropdown-item" id="glory-tab" data-bs-toggle="tab" data-bs-target="#promotedToGlory" type="button" role="tab">
                            <i class="fa fa-angel text-info me-2"></i>Promoted to Glory
                            <span class="badge bg-info ms-2">@Model.MemberStatus.PromotedToGlory?.Count </span>
                        </button>
                    </li>
                    
                    <li>
                        <button class="dropdown-item" id="withdrawn-tab" data-bs-toggle="tab" data-bs-target="#withdrawnMembers" type="button" role="tab">
                            <i class="fa fa-sign-out-alt text-warning me-2"></i>Withdrawn
                            <span class="badge bg-warning ms-2">@Model.MemberStatus.WithdrawnMembers?.Count </span>
                        </button>
                    </li>
                    
                </ul>
            </li>
        </ul>

        <!-- TAB CONTENT -->
        <div class="tab-content" id="memberTabsContent">
            <!-- Active Members Tab -->
            <div class="tab-pane fade show active" id="activeMembers" role="tabpanel">
                @{ ViewData["TableId"] = "activeMembersTable"; ViewData["StatusId"] = "1"; }
                @await Html.PartialAsync("~/Views/Members/_MembersTablePartial.cshtml", (List<GCI_Admin.Models.Member>)null)
            </div>
            
            <!-- Membership Class Tab -->
            <div class="tab-pane fade" id="membershipClass" role="tabpanel">
                @{ ViewData["TableId"] = "membershipClassTable"; ViewData["StatusId"] = "2"; }
                @await Html.PartialAsync("~/Views/Members/_MembersTablePartial.cshtml", (List<GCI_Admin.Models.Member>)null)
            </div>      
           
            <!-- Awaiting Confirmation Tab -->
            <div class="tab-pane fade" id="awaitingConfirmation" role="tabpanel">
                @{ ViewData["TableId"] = "awaitingConfirmationTable"; ViewData["StatusId"] = "4"; }
                @await Html.PartialAsync("~/Views/Members/_MembersTablePartial.cshtml", (List<GCI_Admin.Models.Member>)null)
            </div>

            <!-- Inactive Members Tab -->
            <div class="tab-pane fade" id="inactiveMembers" role="tabpanel">
                @{ ViewData["TableId"] = "inactiveMembersTable"; ViewData["StatusId"] = "3"; }
                @await Html.PartialAsync("~/Views/Members/_MembersTablePartial.cshtml", (List<GCI_Admin.Models.Member>)null)
            </div>
            
            <!-- Transferred Members Tab -->
