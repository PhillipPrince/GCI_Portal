@model GCI_Admin.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<!-- Page Title & Actions -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Dashboard</h2>
        <p class="text-muted mb-0">Welcome back, Admin! Here's what's happening with your church.</p>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#reportModal">
            <i class="fa fa-download me-2"></i>Export Report
        </button>
        <button class="btn btn-primary" onclick="location.reload()">
            <i class="fa fa-sync-alt me-2"></i>Refresh Data
        </button>
    </div>
</div>

<!-- DASHBOARD CONTAINER -->
<div id="dashboard-container">
    <div id="membership-stats-container">
        <div class="text-center py-4">
            <div class="spinner-border text-primary" role="status"></div>
            <h6 class="mt-2 text-muted">Loading Membership Data...</h6>
        </div>
    </div>
    
    <div id="event-stats-container">
        <div class="text-center py-4">
            <div class="spinner-border text-warning" role="status"></div>
            <h6 class="mt-2 text-muted">Loading Event Data...</h6>
        </div>
    </div>
    
    <div id="meeting-stats-container">
        <div class="text-center py-4">
            <div class="spinner-border text-success" role="status"></div>
            <h6 class="mt-2 text-muted">Loading Meeting Data...</h6>
        </div>
    </div>
    
    <div id="members-list-container"></div>
</div>

<!-- Theme Modal -->
<div class="modal fade" id="themeModal" tabindex="-1" aria-labelledby="themeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-gradient-primary text-white border-0">
                <h5 class="modal-title fw-bold" id="themeModalLabel">
                    <i class="fa fa-star me-2"></i>Theme of the Year
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <!-- Display Mode -->
                <div id="displayMode">
                    <div class="text-center mb-4">
                        <img id="modalImage" src="" alt="Theme Image" class="img-fluid rounded shadow-sm" style="max-height: 300px; width: auto;">
                    </div>
                    <h4 id="modalTitle" class="text-center fw-bold mb-3"></h4>
                    <p id="modalVerse" class="text-center text-muted fst-italic mb-3"></p>
                    <p id="modalDescription" class="text-center text-muted"></p>
                </div>

                <!-- Edit Mode (hidden by default) -->
                <div id="editMode" style="display: none;">
                    <div class="mb-3">
                        <label for="editImageFile" class="form-label fw-bold">Theme Image</label>
                        <input type="file" class="form-control" id="editImageFile" accept="image/*" onchange="previewImage(this)">
                        <small class="text-muted">Upload a new image (will be converted to base64)</small>
                        <div class="mt-2 text-center">
                            <img id="imagePreview" src="" alt="Preview" style="max-height: 150px; display: none;" class="img-fluid rounded">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="editYear" class="form-label fw-bold">Year</label>
                        <input type="text" class="form-control" id="editYear" placeholder="Enter year (e.g., 2024)">
                    </div>
                    <div class="mb-3">
                        <label for="editTitle" class="form-label fw-bold">Theme Title</label>
                        <input type="text" class="form-control" id="editTitle" placeholder="Enter theme title">
                    </div>
                    <div class="mb-3">
                        <label for="editVerse" class="form-label fw-bold">Key Verse</label>
                        <input type="text" class="form-control" id="editVerse" placeholder="Enter key verse">
                    </div>
                    <div class="mb-3">
                        <label for="editDescription" class="form-label fw-bold">Description</label>
                        <textarea class="form-control" id="editDescription" rows="3" placeholder="Enter description"></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light border-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="editThemeButton" onclick="toggleEditMode()">
                    <i class="fa fa-edit me-2"></i>Edit
                </button>
                <button type="button" class="btn btn-success" id="saveThemeButton" style="display: none;" onclick="saveThemeChanges()">
                    <i class="fa fa-save me-2"></i>Save Changes
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Monthly Theme Modal -->
<div class="modal fade" id="monthlyThemeModal" tabindex="-1" aria-labelledby="monthlyThemeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-gradient-primary text-white border-0">
                <h5 class="modal-title fw-bold" id="monthlyThemeModalLabel">
                    <i class="fa fa-star me-2"></i>Theme of the Month
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <!-- Display Mode -->
                <div id="monthlyDisplayMode">
                    <div class="text-center mb-4">
                        <img id="monthlyModalImage" src="" alt="Theme Image" class="img-fluid rounded shadow-sm" style="max-height: 300px; width: auto;">
                    </div>
                    <h4 id="monthlyModalTitle" class="text-center fw-bold mb-3"></h4>
                    <p id="monthlyModalDescription" class="text-center text-muted fst-italic mb-3"></p>
                </div>

                <!-- Edit Mode (hidden by default) -->
                <div id="monthlyEditMode" style="display: none;">
                    <div class="mb-3">
                        <label for="monthlyEditImageFile" class="form-label fw-bold">Theme Image</label>
                        <input type="file" class="form-control" id="monthlyEditImageFile" accept="image/*" onchange="previewMonthlyImage(this)">
                        <small class="text-muted">Upload a new image (will be converted to base64)</small>
                        <div class="mt-2 text-center">
                            <img id="monthlyImagePreview" src="" alt="Preview" style="max-height: 150px; display: none;" class="img-fluid rounded">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="monthlyEditMonth" class="form-label fw-bold">Month</label>
                            <input type="number" min="1" max="12" class="form-control" id="monthlyEditMonth" placeholder="e.g., 7">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="monthlyEditYear" class="form-label fw-bold">Year</label>
                            <input type="number" class="form-control" id="monthlyEditYear" placeholder="e.g., 2026">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="monthlyEditTitle" class="form-label fw-bold">Theme Title</label>
                        <input type="text" class="form-control" id="monthlyEditTitle" placeholder="Enter theme title">
                    </div>
                    <div class="mb-3">
                        <label for="monthlyEditDescription" class="form-label fw-bold">Description</label>
                        <input type="text" class="form-control" id="monthlyEditDescription" placeholder="Enter description">
                    </div>
                    <div class="mb-3">
                        <label for="monthlyEditAssembly" class="form-label fw-bold">Assembly</label>
                        <input type="text" class="form-control" id="monthlyEditAssembly" placeholder="Enter assembly">
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light border-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="editMonthlyThemeButton" onclick="toggleMonthlyEditMode()">
                    <i class="fa fa-edit me-2"></i>Edit
                </button>
                <button type="button" class="btn btn-success" id="saveMonthlyThemeButton" style="display: none;" onclick="saveMonthlyThemeChanges()">
                    <i class="fa fa-save me-2"></i>Save Changes
                </button>
            </div>
        </div>
    </div>
</div>


<!-- Add Member Modal -->
<div class="modal fade" id="addMemberModal" tabindex="-1" aria-labelledby="addMemberModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-gradient-primary text-white border-0 py-3">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-white bg-opacity-20 p-2 me-3">
                        <i class="bi bi-person-plus-fill text-white fs-4"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold" id="addMemberModalLabel">Add New Member</h5>
                        <p class="text-white-50 small mb-0">Fill in the details to create a new member account</p>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" id="addMemberModalBody">
                <div class="text-center py-5 d-none" id="loadingSpinner">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-3 text-muted">Loading form...</p>
                </div>
                <div id="modalContent">
                    <!-- Partial view will load here -->
                </div>
            </div>
            <div class="modal-footer bg-light border-top-0 px-4 py-3">
                <div class="d-flex gap-2 w-100">
                    <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">
                        <i class="bi bi-x-lg me-2"></i>Cancel
                    </button>
                    <button type="button" class="btn btn-primary px-5 flex-grow-1" id="saveMemberBtn">
                        <i class="bi bi-check-lg me-2"></i>Save Member
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Dynamic Modal -->
<div class="modal fade" id="membershipClassModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Membership Class Registration</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="membershipClassModalBody">
                <!-- Partial loads here -->
            </div>
        </div>
    </div>
</div>

<!-- Report Modal -->
<div class="modal fade" id="reportModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Export Report</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Select report type:</p>
                <div class="list-group">
                    <button class="list-group-item list-group-item-action d-flex align-items-center">
                        <i class="fa fa-file-pdf text-danger me-3 fs-4"></i>
                        <div>
                            <strong>Membership Report</strong><br>
                            <small>Complete member directory with details</small>
                        </div>
                    </button>
                    <button class="list-group-item list-group-item-action d-flex align-items-center">
                        <i class="fa fa-file-excel text-success me-3 fs-4"></i>
                        <div>
                            <strong>Financial Summary</strong><br>
                            <small>Giving and contribution report</small>
                        </div>
                    </button>
                    <button class="list-group-item list-group-item-action d-flex align-items-center">
                        <i class="fa fa-file-word text-primary me-3 fs-4"></i>
                        <div>
                            <strong>Events Calendar</strong><br>
                            <small>Upcoming events and activities</small>
                        </div>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Required CSS -->
<style>
    .bg-gradient-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }

    .bg-opacity-20 {
        background-color: rgba(255, 255, 255, 0.2);
    }

    .modal.fade .modal-dialog {
        transform: scale(0.95);
        transition: transform 0.2s ease-in-out;
    }

    .modal.show .modal-dialog {
        transform: scale(1);
    }

    .modal-body::-webkit-scrollbar {
        width: 6px;
    }

    .modal-body::-webkit-scrollbar-track {
        background: #f1f1f1;
        border-radius: 10px;
    }

    .modal-body::-webkit-scrollbar-thumb {
        background: #c1c1c1;
        border-radius: 10px;
    }

        .modal-body::-webkit-scrollbar-thumb:hover {
            background: #a8a8a8;
        }

    .modal-content {
        border-radius: 16px;
        overflow: hidden;
    }

    .btn-outline-secondary:hover {
        background-color: #f8f9fa;
        border-color: #ced4da;
        color: #1e293b;
    }

    .btn-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .btn-primary:hover:not(:disabled) {
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
        }

        .btn-primary:active {
            transform: translateY(0);
        }

        .btn-primary.btn-success {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        }

    .nav-tabs-custom .nav-link {
        color: #6c757d;
        border: none;
        padding: 0.75rem 1.5rem;
        font-weight: 500;
        transition: all 0.3s ease;
    }

    .nav-tabs-custom .nav-link:hover {
        color: #667eea;
        background-color: rgba(102, 126, 234, 0.05);
        border-radius: 8px;
    }

    .nav-tabs-custom .nav-link.active {
        color: #0d6efd;
        background: none;
        border-bottom: 3px solid #0d6efd;
    }

    .nav-tabs-custom .nav-link .badge {
        font-weight: normal;
    }
    
    .dropdown-menu .dropdown-item {
        padding: 0.5rem 1rem;
        transition: all 0.2s ease;
    }
    
    .dropdown-menu .dropdown-item:hover {
        background-color: rgba(102, 126, 234, 0.1);
        transform: translateX(5px);
    }

    .card {
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .card:hover {
            transform: translateY(-2px);
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.15) !important;
        }

    .progress {
        border-radius: 10px;
    }
    
    .nav-tabs-custom .dropdown-toggle::after {
        margin-left: 0.5rem;
    }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        let currentThemeData = {};
        let membersChart = null;
        let fullMembersChart = null;
        let genderChart = null;
        let attendanceTrendChart;
        let attendanceData = [];
        let chartsInitialized = false;

        $(document).ready(function () {
            // Load dashboard content via AJAX
            loadDashboard();

            // Setup chart tab handlers
            setupChartTabHandlers();
        });

        function loadDashboard() {
            // Load sections independently and initialize their respective scripts once loaded
            $('#membership-stats-container').load('@Url.Action("GetMembershipStats", "Home")', function() {
                // Move the member list section to the bottom container
                $('#members-list-container').append($('#members-list-section'));
                
                setTimeout(initializeDataTables, 200);
                setTimeout(function() {
                    if (typeof loadMemberGrowthData === 'function') loadMemberGrowthData('weekly');
                    if (typeof loadFullMembershipData === 'function') loadFullMembershipData('weekly');
                }, 300);
            });
            
            $('#event-stats-container').load('@Url.Action("GetEventStats", "Home")', function() {
                if (typeof loadCurrentYearTheme === 'function') loadCurrentYearTheme();
                if (typeof loadCurrentMonthlyTheme === 'function') loadCurrentMonthlyTheme();
            });
            
            $('#meeting-stats-container').load('@Url.Action("GetMeetingStats", "Home")', function() {
                setTimeout(function() {
                    if (typeof initGenderChart === 'function') initGenderChart();
                    if (typeof initAttendanceTrendChart === 'function') initAttendanceTrendChart();
                }, 200);
            });
        }

        function initializeDashboard() {
            // Deprecated: logic moved to individual callbacks in loadDashboard
        }

        function initializeDataTables() {
            $('.members-ajax-table').each(function() {
                var tableId = $(this).attr('id');
                var statusId = $(this).data('status');

                if ($.fn.DataTable.isDataTable('#' + tableId)) {
                    $('#' + tableId).DataTable().destroy();
                }

                var table = $('#' + tableId).DataTable({
                    processing: true,
                    serverSide: true,
                    ajax: {
                        url: '@Url.Action("GetMembersDataTable", "Members")',
                        type: 'POST',
                        data: function (d) {
                            d.statusId = statusId;
                        }
                    },
                    columns: [
                        { 
                            data: null,
                            render: function (data, type, row) {
                                var firstName = row.firstName || '';
                                var otherNames = row.otherNames || '';
                                var initial = firstName ? firstName.substring(0, 1).toUpperCase() : '?';
                                return `
                                <div class="d-flex align-items-center">
                                    <div class="avatar-circle me-2" style="width:35px;height:35px;background:#667eea;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:bold;">
                                        ${initial}
                                    </div>
                                    <div>
                                        <strong>${firstName} ${otherNames}</strong>
                                        <div class="small text-muted">ID: #${row.id}</div>
                                    </div>
                                </div>`;
                            }
                        },
                        { 
                            data: 'phone',
                            render: function(data) {
                                return data ? `<a href="tel:${data}" class="text-decoration-none"><i class="fa fa-phone me-1"></i>${data}</a>` : '';
                            }
                        },
                        { 
                            data: 'email',
                            render: function(data) {
                                return data ? `<a href="mailto:${data}" class="text-decoration-none"><i class="fa fa-envelope me-1"></i>${data}</a>` : '';
                            }
                        },
                        { 
                            data: 'gender',
                            render: function(data) {
                                if (data === "Male") return '<span class="badge bg-info"><i class="fa fa-mars me-1"></i>Male</span>';
                                return '<span class="badge bg-warning"><i class="fa fa-venus me-1"></i>Female</span>';
                            }
                        },
                        { data: 'assembly', render: function(data) { return data || '-'; } },
                        { 
                            data: null,
                            render: function(data, type, row) {
                                var marital = row.maritalStatus ? `<span class="badge bg-secondary">${row.maritalStatus}</span>` : '<span class="text-muted">-</span>';
                                var spouse = row.spouseName ? `<div class="small text-muted">Spouse: ${row.spouseName}</div>` : '';
                                return marital + spouse;
                            }
                        },
                        { 
                            data: 'numberOfChildren',
                            render: function(data) {
                                return data && data > 0 ? `<span class="badge bg-primary">${data}</span>` : '<span class="text-muted">-</span>';
                            }
                        },
                        { 
                            data: 'statusId',
                            render: function(data) {
                                if (data == 1) return '<span class="badge bg-success">Active</span>';
                                if (data == 2) return '<span class="badge bg-warning">Inactive</span>';
                                return '<span class="badge bg-secondary">Pending</span>';
                            }
                        },
                        { 
                            data: 'createdAt',
                            render: function(data) {
                                if (!data) return '';
                                var date = new Date(data);
                                var formattedDate = date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
                                var formattedTime = date.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: true });
                                return `<div>${formattedDate}</div><div class="small text-muted">${formattedTime}</div>`;
                            }
                        },
                        { 
                            data: null,
                            className: 'text-end',
                            orderable: false,
                            render: function(data, type, row) {
                                var actions = `
                                    <a href="/Members/MemberDetails?memberId=${row.id}" class="btn btn-sm btn-outline-info"><i class="fa fa-eye"></i></a>
                                    <a href="/Members/Edit/${row.id}" class="btn btn-sm btn-outline-warning"><i class="fa fa-edit"></i></a>
                                `;
                                if (row.statusId == 3) {
                                    actions += `<button class="btn btn-sm btn-outline-primary" onclick="joinMembershipClass(${row.id})"><i class="fa fa-users"></i></button>`;
                                } else if (row.statusId == 2) {
                                    actions += `<button class="btn btn-sm btn-outline-success" onclick="makeFullMember(${row.id})"><i class="fa fa-check-circle"></i></button>`;
                                }

                                if (row.statusId == 1) {
                                    actions += `<button class="btn btn-sm btn-outline-secondary" onclick="toggleMemberStatus(${row.id}, false)"><i class="fa fa-ban"></i></button>`;
                                } else if (row.statusId == 2) {
                                    actions += `<button class="btn btn-sm btn-outline-success" onclick="toggleMemberStatus(${row.id}, true)"><i class="fa fa-check"></i></button>`;
                                }
                                actions += `<button class="btn btn-sm btn-outline-danger" onclick="deleteMember(${row.id})"><i class="fa fa-trash"></i></button>`;
                                return actions;
                            }
                        }
                    ],
                    order: [[8, 'desc']] // Order by CreatedAt desc by default
                });
            });
        }

        function setupChartTabHandlers() {
            // Handle period toggle for charts
            $(document).on('click', '.btn-group .btn[data-chart="member-growth"]', function() {
                $('.btn-group .btn[data-chart="member-growth"]').removeClass('active');
                $(this).addClass('active');
                const period = $(this).data('period');
                loadMemberGrowthData(period);
            });

            $(document).on('click', '.btn-group .btn[data-chart="full-membership"]', function() {
                $('.btn-group .btn[data-chart="full-membership"]').removeClass('active');
                $(this).addClass('active');
                const period = $(this).data('period');
                loadFullMembershipData(period);
            });
        }

        function initCharts() {
            loadMemberGrowthData('weekly');
            loadFullMembershipData('weekly');
            initGenderChart();
            initAttendanceTrendChart();
            
            // Parse attendance data embedded in partial
            try {
                var rawData = $('#dashboard-container').find('[data-attendance]').data('attendance');
                if (rawData) {
                    attendanceData = rawData;
                }
            } catch(e) {}
        }

        // Initialize Gender Chart
        function initGenderChart() {
            const canvas = document.getElementById('genderChart');
            if (!canvas) return;
            
            const ctx = canvas.getContext('2d');
            const dataElement = document.getElementById('genderData');
            if (!dataElement) return;

            const maleCount = parseInt(dataElement.dataset.male);
            const femaleCount = parseInt(dataElement.dataset.female);
            const childrenCount = parseInt(dataElement.dataset.children);
            
            if (genderChart) genderChart.destroy();
            
            genderChart = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['Male', 'Female', 'Children'],
                    datasets: [{
                        data: [maleCount, femaleCount, childrenCount],
                        backgroundColor: ['#0d6efd', '#198754', '#ffc107']
                    }]
                }
            });
        }

        // Initialize Attendance Trend Chart
        function initAttendanceTrendChart() {
            const canvas = document.getElementById('attendanceTrendChart');
            if (!canvas) return;
            
            const ctx = canvas.getContext('2d');
            
            if (attendanceTrendChart) attendanceTrendChart.destroy();
            
            if (!attendanceData || attendanceData.length === 0) {
                ctx.fillStyle = '#6c757d';
                ctx.font = '14px Arial';
                ctx.textAlign = 'center';
                ctx.fillText('No trend data available', canvas.width / 2, canvas.height / 2);
                return;
            }
            
            const labels = attendanceData.map(m => `${m.monthName} ${m.year}`);
            const attendees = attendanceData.map(m => m.totalAttendees);
            const meetings = attendanceData.map(m => m.totalMeetings);
            
            attendanceTrendChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
