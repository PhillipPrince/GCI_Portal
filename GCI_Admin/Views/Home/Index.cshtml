        // Function to convert image file to base64
        function convertImageToBase64(file) {
            return new Promise((resolve, reject) => {
                const reader = new FileReader();
                reader.onload = () => {
                    const base64String = reader.result;
                    resolve(base64String);
                };
                reader.onerror = (error) => {
                    reject(error);
                };
                reader.readAsDataURL(file);
            });
        }

        // Preview image before upload
        function previewImage(input) {
            const preview = document.getElementById('imagePreview');
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    preview.src = e.target.result;
                    preview.style.display = 'block';
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        // Load current year theme from server
        function loadCurrentYearTheme() {
            $.ajax({
                url: '/Event/GetCurrentYearTheme',
                type: 'GET',
                success: function (response) {
                    if (!response.isSuccess) {
                        console.error(response.message);
                        return;
                    }
                    var theme = response.data;
                    currentThemeData = theme;

                    $("#themeYearTitle").text("Theme of the Year " + theme.year);
                    $("#themeTitle").text(theme.theme);
                    $("#themeVerse").text(theme.verse);
                    $("#themeDescription").text(theme.description);

                    if (theme.yearThemeImage) {
                        $("#yearThemeImage").attr('src', theme.yearThemeImage);
                    }
                },
                error: function (err) {
                    console.error("Error loading theme:", err);
                }
            });
        }

        // Open theme modal
        function openThemeModal() {
            // Populate modal with current data
            document.getElementById('modalImage').src = document.getElementById('yearThemeImage').src;
            document.getElementById('modalTitle').innerText = document.getElementById('themeTitle').innerText;
            document.getElementById('modalVerse').innerText = document.getElementById('themeVerse').innerText;
            document.getElementById('modalDescription').innerText = document.getElementById('themeDescription').innerText;

            // Reset to display mode
            document.getElementById('displayMode').style.display = 'block';
            document.getElementById('editMode').style.display = 'none';
            document.getElementById('editThemeButton').style.display = 'inline-block';
            document.getElementById('saveThemeButton').style.display = 'none';

            // Show modal
            const modal = new bootstrap.Modal(document.getElementById('themeModal'));
            modal.show();
