        }

    .progress {
        border-radius: 10px;
    }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">

    <script>
        let currentThemeData = {};
        let membersChart;
        let fullMembersChart;

        $(document).ready(function () {
            loadCurrentYearTheme();

            // Load initial chart data
            loadMemberGrowthData('weekly');
            loadFullMembershipData('weekly');

            // Initialize DataTable
            var table = $('#membersTable').DataTable({
                responsive: true,
                pageLength: 10,
                order: [[1, "asc"]],
                language: {
                    search: "Search members:",
                    lengthMenu: "Show _MENU_ entries",
                    info: "Showing _START_ to _END_ of _TOTAL_ members",
                    paginate: {
                        first: '<i class="fa fa-angle-double-left"></i>',
                        previous: '<i class="fa fa-angle-left"></i>',
                        next: '<i class="fa fa-angle-right"></i>',
                        last: '<i class="fa fa-angle-double-right"></i>'
                    }
                }
            });

            // Add event listeners for member growth chart buttons
            $('.btn-group .btn[data-chart="member-growth"]').on('click', function() {
                // Update active state for this chart group
                $('.btn-group .btn[data-chart="member-growth"]').removeClass('active');
                $(this).addClass('active');

                // Get selected period
                const period = $(this).text().toLowerCase();

                // Reload chart with new period
                loadMemberGrowthData(period);
            });

            // Add event listeners for full membership chart buttons
            $('.btn-group .btn[data-chart="full-membership"]').on('click', function() {
                // Update active state for this chart group
                $('.btn-group .btn[data-chart="full-membership"]').removeClass('active');
                $(this).addClass('active');

                // Get selected period
                const period = $(this).text().toLowerCase();

                // Reload chart with new period
                loadFullMembershipData(period);
            });
        });

        // Function to load member growth chart data
        function loadMemberGrowthData(period = 'weekly') {
            $.ajax({
                url: '/Home/GetMemberGrowthData',
                type: 'GET',
                data: { period: period },
                success: function(response) {
                    if (response.success) {
                        const ctx = document.getElementById('membersChart').getContext('2d');

                        // Destroy existing chart if it exists
                        if (membersChart) {
                            membersChart.destroy();
                        }

                        // Create new chart with dynamic data
                        membersChart = new Chart(ctx, {
                            type: 'line',
                            data: {
                                labels: response.labels,
                                datasets: [{
                                    label: 'New Members',
                                    data: response.data,
                                    borderColor: '#0d6efd',
                                    backgroundColor: 'rgba(13, 110, 253, 0.1)',
                                    borderWidth: 3,
                                    tension: 0.4,
                                    fill: true,
                                    pointBackgroundColor: '#0d6efd',
                                    pointBorderColor: '#fff',
                                    pointBorderWidth: 2,
                                    pointRadius: 4,
                                    pointHoverRadius: 6
                                }]
                            },
                            options: {
                                responsive: true,
                                maintainAspectRatio: false,
                                plugins: {
