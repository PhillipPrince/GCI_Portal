        // SweetAlert2 functions
        function joinMembershipClass(memberId) {
            Swal.fire({
                title: 'Confirm Action',
                text: 'Register this member for membership class?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#0b5394',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, continue',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire({
                        title: 'Loading...',
                        text: 'Preparing form',
                        allowOutsideClick: false,
                        didOpen: () => Swal.showLoading()
                    });
                    $.get('/Members/AddMembershipClassPartial', { memberId: memberId }, function (data) {
                        Swal.close();
                        $('#membershipClassModalBody').html(data);
                        const modal = new bootstrap.Modal(document.getElementById('membershipClassModal'));
                        modal.show();
                    }).fail(function () {
                        Swal.fire({ icon: 'error', title: 'Error', text: 'Failed to load membership form.' });
                    });
                }
            });
        }

        function makeFullMember(memberId) {
            Swal.fire({
                title: 'Confirm Upgrade',
                text: 'Make this member a full member?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#198754',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, upgrade member',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('/Members/MakeFullMember', { id: memberId }, function() {
                        Swal.fire({ title: 'Success!', text: 'Member upgraded successfully', icon: 'success', timer: 2000, showConfirmButton: false })
                            .then(() => location.reload());
                    });
                }
            });
        }

