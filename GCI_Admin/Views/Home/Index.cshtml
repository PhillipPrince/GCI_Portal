@model GCI_Admin.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<!-- Page Title & Actions -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Dashboard</h2>
        <p class="text-muted mb-0">Welcome back, Admin! Here's what's happening with your church.</p>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#reportModal">
            <i class="fa fa-download me-2"></i>Export Report
        </button>
        <button class="btn btn-primary">
            <i class="fa fa-sync-alt me-2"></i>Refresh Data
        </button>
    </div>
</div>

<!-- KPI CARDS - Enhanced with gradients and icons -->
<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <div class="flex-shrink-0">
                        <div class="bg-primary bg-opacity-10 p-3 rounded-circle">
                            <i class="fa fa-users fa-2x text-primary"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1">Total Members</h6>
                        <h3 class="fw-bold mb-0">@Model.TotalMembers.ToString("N0")</h3>
                        <small class="text-success"><i class="fa fa-arrow-up me-1"></i>+12% from last month</small>
                    </div>
                </div>
                <div class="progress" style="height: 4px;">
                    <div class="progress-bar bg-primary" style="width: 75%"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <div class="flex-shrink-0">
                        <div class="bg-success bg-opacity-10 p-3 rounded-circle">
                            <i class="fa fa-user-check fa-2x text-success"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1">Active Members</h6>
                        <h3 class="fw-bold mb-0">@Model.TotalActiveMembers.ToString("N0")</h3>
                        <small class="text-success"><i class="fa fa-arrow-up me-1"></i>+8% from last month</small>
                    </div>
                </div>
                <div class="progress" style="height: 4px;">
                    <div class="progress-bar bg-success" style="width: 82%"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <div class="flex-shrink-0">
                        <div class="bg-warning bg-opacity-10 p-3 rounded-circle">
                            <i class="fa fa-calendar fa-2x text-warning"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1">Upcoming Events</h6>
                        <h3 class="fw-bold mb-0">@Model.UpcomingEvents.ToString("N0")</h3>
                        <small class="text-danger"><i class="fa fa-arrow-down me-1"></i>2 this week</small>
                    </div>
                </div>
                <div class="progress" style="height: 4px;">
                    <div class="progress-bar bg-warning" style="width: 45%"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- CHARTS SECTION - Two charts side by side -->
<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0">📈 Member Growth</h6>
                    <div class="btn-group btn-group-sm">
                        <button class="btn btn-outline-secondary active" data-chart="member-growth">Weekly</button>
                        <button class="btn btn-outline-secondary" data-chart="member-growth">Monthly</button>
                        <button class="btn btn-outline-secondary" data-chart="member-growth">Yearly</button>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <canvas id="membersChart" height="120"></canvas>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0">👑 Full Membership Attainment</h6>
                    <div class="btn-group btn-group-sm">
                        <button class="btn btn-outline-secondary active" data-chart="full-membership">Weekly</button>
                        <button class="btn btn-outline-secondary" data-chart="full-membership">Monthly</button>
                        <button class="btn btn-outline-secondary" data-chart="full-membership">Yearly</button>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <canvas id="fullMembersChart" height="120"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- DATA PANELS -->
<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0">📅 Upcoming Events</h6>
                    <a href="@Url.Action("Index", "Event")" class="btn btn-link btn-sm p-0">View All →</a>
                </div>
            </div>
            <div class="card-body">
                <div class="list-group list-group-flush">
                    @if (Model.UpcomingEvent != null && Model.UpcomingEvent.Any())
                    {
                        foreach (var evt in Model.UpcomingEvent.Take(3))
                        {
                            <div class="list-group-item px-0 border-0 d-flex align-items-center">
                                <div class="bg-primary bg-opacity-10 p-2 rounded-circle me-3">
                                    <i class="fa fa-church text-primary"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <h6 class="mb-1">@evt.Title</h6>
                                    <small class="text-muted">
                                        <i class="fa fa-clock me-1"></i>
                                        @evt.EventDate.ToString("MMM dd, h:mm tt")
                                    </small>
                                </div>
                                <span class="badge @(evt.EventDate.Date == DateTime.Today ? "bg-primary" : "bg-secondary")">
                                    @(evt.EventDate.Date == DateTime.Today ? "Today" : "")
                                </span>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center text-muted py-4">
                            <i class="fa fa-calendar-alt fa-2x mb-2"></i>
                            <p class="mb-0">No upcoming events</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Theme Card with onclick -->
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100 overflow-hidden" onclick="openThemeModal()" style="cursor: pointer;">
            <div class="row g-0 h-100">
                <!-- Left Image Section -->
                <div class="col-md-5">
                    <div class="h-100">
                        <img id="yearThemeImage"
                             alt="Theme of the Year"
                             class="img-fluid h-100 w-100"
                             style="object-fit: cover;">
                    </div>
                </div>
                <!-- Right Content Section -->
                <div class="col-md-7">
                    <div class="card-body d-flex flex-column justify-content-center align-items-center text-center h-100">
                        <h6 class="fw-bold text-primary mb-2" id="themeYearTitle">
                            Theme of the Year
                        </h6>
                        <h5 class="fw-bold mb-3" id="themeTitle">
                            Loading...
                        </h5>
                        <p class="text-muted mb-1 fw-semibold" id="themeVerse"></p>
                        <p class="text-muted mb-0" id="themeDescription"></p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 py-3">
                <h6 class="fw-bold mb-0">⚡ Quick Actions</h6>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a href="javascript:void(0);"
                       onclick="openAddMemberModal()"
                       class="btn btn-primary text-start d-flex align-items-center">
                        <i class="fa fa-user-plus me-3"></i>
                        <div>
                            <strong>Add New Member</strong><br>
                            <small class="opacity-75">Register a new church member</small>
                        </div>
                    </a>
                    <a href="@Url.Action("CreateEvent", "Event")" class="btn btn-success text-start d-flex align-items-center">
                        <i class="fa fa-calendar-plus me-3"></i>
                        <div>
                            <strong>Create Event</strong><br>
                            <small class="opacity-75">Schedule a church event</small>
                        </div>
                    </a>
                    <a href="@Url.Action("CreateAnnouncement", "Announcements")" class="btn btn-warning text-start d-flex align-items-center">
                        <i class="fa fa-bullhorn me-3"></i>
                        <div>
                            <strong>New Announcement</strong><br>
                            <small class="opacity-75">Share with congregation</small>
                        </div>
                    </a>
                    @* <a href="@Url.Action("Giving", "Reports")" class="btn btn-info text-start d-flex align-items-center"> *@
                    @*     <i class="fa fa-chart-pie me-3"></i> *@
                    @*     <div> *@
                    @*         <strong>Financial Report</strong><br> *@
                    @*         <small class="opacity-75">View giving summary</small> *@
                    @*     </div> *@
                    @* </a> *@
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MEMBERS TAB SECTION -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white border-0 py-3">
        <h6 class="fw-bold mb-0">👥 Member Management</h6>
    </div>
    <div class="card-body">
        <!-- TABS -->
        <ul class="nav nav-tabs nav-tabs-custom mb-3" id="memberTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="active-tab" data-bs-toggle="tab" data-bs-target="#activeMembers" type="button" role="tab">
                    Active Members <span class="badge bg-primary ms-2">@Model.ActiveMembers.Count</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="membership-tab" data-bs-toggle="tab" data-bs-target="#membershipClass" type="button" role="tab">
                    Membership Class <span class="badge bg-warning ms-2">@Model.MembershipClassMembers.Count</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="nonmembers-tab" data-bs-toggle="tab" data-bs-target="#nonMembers" type="button" role="tab">
                    Non-Members <span class="badge bg-secondary ms-2">@Model.NonMembers.Count</span>
                </button>
            </li>
        </ul>

        <!-- TAB CONTENT -->
        <div class="tab-content" id="memberTabsContent">
            <div class="tab-pane fade show active" id="activeMembers" role="tabpanel">
                @await Html.PartialAsync("~/Views/Members/_MembersTablePartial.cshtml", Model.ActiveMembers)
            </div>
            <div class="tab-pane fade" id="membershipClass" role="tabpanel">
                @await Html.PartialAsync("~/Views/Members/_MembersTablePartial.cshtml", Model.MembershipClassMembers)
            </div>
            <div class="tab-pane fade" id="nonMembers" role="tabpanel">
                @await Html.PartialAsync("~/Views/Members/_MembersTablePartial.cshtml", Model.NonMembers)
            </div>
        </div>
    </div>
</div>

<!-- Theme Modal -->
<div class="modal fade" id="themeModal" tabindex="-1" aria-labelledby="themeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-gradient-primary text-white border-0">
                <h5 class="modal-title fw-bold" id="themeModalLabel">
                    <i class="fa fa-star me-2"></i>Theme of the Year
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <!-- Display Mode -->
                <div id="displayMode">
                    <div class="text-center mb-4">
                        <img id="modalImage" src="" alt="Theme Image" class="img-fluid rounded shadow-sm" style="max-height: 300px; width: auto;">
                    </div>
                    <h4 id="modalTitle" class="text-center fw-bold mb-3"></h4>
                    <p id="modalVerse" class="text-center text-muted fst-italic mb-3"></p>
                    <p id="modalDescription" class="text-center text-muted"></p>
                </div>

                <!-- Edit Mode (hidden by default) -->
                <div id="editMode" style="display: none;">
                    <div class="mb-3">
                        <label for="editImageFile" class="form-label fw-bold">Theme Image</label>
                        <input type="file" class="form-control" id="editImageFile" accept="image/*" onchange="previewImage(this)">
                        <small class="text-muted">Upload a new image (will be converted to base64)</small>
                        <div class="mt-2 text-center">
                            <img id="imagePreview" src="" alt="Preview" style="max-height: 150px; display: none;" class="img-fluid rounded">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="editYear" class="form-label fw-bold">Year</label>
                        <input type="text" class="form-control" id="editYear" placeholder="Enter year (e.g., 2024)">
                    </div>
                    <div class="mb-3">
                        <label for="editTitle" class="form-label fw-bold">Theme Title</label>
                        <input type="text" class="form-control" id="editTitle" placeholder="Enter theme title">
                    </div>
                    <div class="mb-3">
                        <label for="editVerse" class="form-label fw-bold">Key Verse</label>
                        <input type="text" class="form-control" id="editVerse" placeholder="Enter key verse">
                    </div>
                    <div class="mb-3">
                        <label for="editDescription" class="form-label fw-bold">Description</label>
                        <textarea class="form-control" id="editDescription" rows="3" placeholder="Enter description"></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light border-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="editThemeButton" onclick="toggleEditMode()">
                    <i class="fa fa-edit me-2"></i>Edit
                </button>
                <button type="button" class="btn btn-success" id="saveThemeButton" style="display: none;" onclick="saveThemeChanges()">
                    <i class="fa fa-save me-2"></i>Save Changes
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Add Member Modal -->
<div class="modal fade" id="addMemberModal" tabindex="-1" aria-labelledby="addMemberModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-gradient-primary text-white border-0 py-3">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-white bg-opacity-20 p-2 me-3">
                        <i class="bi bi-person-plus-fill text-white fs-4"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold" id="addMemberModalLabel">Add New Member</h5>
                        <p class="text-white-50 small mb-0">Fill in the details to create a new member account</p>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" id="addMemberModalBody">
                <div class="text-center py-5 d-none" id="loadingSpinner">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-3 text-muted">Loading form...</p>
                </div>
                <div id="modalContent">
                    <!-- Partial view will load here -->
                </div>
            </div>
            <div class="modal-footer bg-light border-top-0 px-4 py-3">
                <div class="d-flex gap-2 w-100">
                    <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">
                        <i class="bi bi-x-lg me-2"></i>Cancel
                    </button>
                    <button type="button" class="btn btn-primary px-5 flex-grow-1" id="saveMemberBtn">
                        <i class="bi bi-check-lg me-2"></i>Save Member
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Dynamic Modal -->
<div class="modal fade" id="membershipClassModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Membership Class Registration</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="membershipClassModalBody">
                <!-- Partial loads here -->
            </div>
        </div>
    </div>
</div>

<!-- Report Modal -->
<div class="modal fade" id="reportModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Export Report</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Select report type:</p>
                <div class="list-group">
                    <button class="list-group-item list-group-item-action d-flex align-items-center">
                        <i class="fa fa-file-pdf text-danger me-3 fs-4"></i>
                        <div>
                            <strong>Membership Report</strong><br>
                            <small>Complete member directory with details</small>
                        </div>
                    </button>
                    <button class="list-group-item list-group-item-action d-flex align-items-center">
                        <i class="fa fa-file-excel text-success me-3 fs-4"></i>
                        <div>
                            <strong>Financial Summary</strong><br>
                            <small>Giving and contribution report</small>
                        </div>
                    </button>
                    <button class="list-group-item list-group-item-action d-flex align-items-center">
                        <i class="fa fa-file-word text-primary me-3 fs-4"></i>
                        <div>
                            <strong>Events Calendar</strong><br>
                            <small>Upcoming events and activities</small>
                        </div>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Required CSS -->
