    }

    .modal-body::-webkit-scrollbar-track {
        background: #f1f1f1;
        border-radius: 10px;
    }

    .modal-body::-webkit-scrollbar-thumb {
        background: #c1c1c1;
        border-radius: 10px;
    }

        .modal-body::-webkit-scrollbar-thumb:hover {
            background: #a8a8a8;
        }

    .modal-content {
        border-radius: 16px;
        overflow: hidden;
    }

    .btn-outline-secondary:hover {
        background-color: #f8f9fa;
        border-color: #ced4da;
