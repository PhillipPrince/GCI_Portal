@model List<GCI_Admin.Models.Payment>

<div class="card shadow-sm">
    <div class="table-responsive p-3">
        <table id="paymentsTable" class="table table-striped table-hover align-middle datatable">

            <thead class="table-light">
                <tr>
                    <th>Payment ID</th>
                    <th>Phone Number</th>
                    <th>Amount</th>
                    <th>Receipt No</th>
                    <th>Status</th>
                    <th>Transaction Date</th>
                    <th>Created At</th>
                    <th class="text-end">Actions</th>
                </tr>

                <!-- Search Row -->
                <tr>
                    <th>
                        <input type="text" placeholder="Search Payment ID" class="form-control form-control-sm" />
                    </th>
                    <th>
                        <input type="text" placeholder="Search Phone" class="form-control form-control-sm" />
                    </th>
                    <th>
                        <input type="text" placeholder="Search Amount" class="form-control form-control-sm" />
                    </th>
                    <th>
                        <input type="text" placeholder="Search Receipt" class="form-control form-control-sm" />
                    </th>
                    <th>
                        <select class="form-control form-control-sm">
                            <option value="">All</option>
                            <option value="1">Pending</option>
                            <option value="2">Success</option>
                            <option value="3">Failed</option>
                        </select>
                    </th>
                    <th>
                        <input type="date" class="form-control form-control-sm" />
                    </th>
                    <th>
                        <input type="date" class="form-control form-control-sm" />
                    </th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                @foreach (var payment in Model)
                {
                    <tr>
                        <td>
                            <strong>#@payment.Id</strong>
                        </td>
                        <td>@payment.PhoneNumber</td>
                        <td>KES @payment.Amount.ToString("N2")</td>
                        <td>@payment.MpesaReceiptNumber</td>

                        <td>
                            @if (payment.PaymentStatusId == 1)
                            {
                                <span class="badge bg-warning">Pending</span>
                            }
                            else if (payment.PaymentStatusId == 2)
                            {
                                <span class="badge bg-success">Success</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Failed</span>
                            }
                    </td>

                    <td>
                        @(payment.TransactionDate.HasValue
                                                ? payment.TransactionDate.Value.ToString("dd MMM yyyy HH:mm")
                                                : "-")
                    </td>

                        <td>@payment.CreatedAt.ToString("dd MMM yyyy")</td>

                        <td class="text-end">

                            <!-- View -->
                            <button class="btn btn-sm btn-outline-info"
                                    onclick="openPaymentModal('@Url.Action("Details", "Payments", new { id = payment.Id })')">
                                <i class="fa fa-eye"></i>
                            </button>

                            <!-- Optional: Retry (for failed payments) -->
                        @if (payment.PaymentStatusId == 3)
                            {
                                <button class="btn btn-sm btn-outline-warning"
                                        onclick="retryPayment(@payment.Id)">
                                    <i class="fa fa-refresh"></i>
                                </button>
                            }

                        </td>
                    </tr>
                }
            </tbody>

        </table>
    </div>
</div>