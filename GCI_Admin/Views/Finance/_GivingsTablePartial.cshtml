@model List<GCI_Admin.Models.Collection>

<div class="card shadow-sm">
    <div class="table-responsive p-3">
        <table id="CollectionsTable" class="table table-striped table-hover align-middle datatable">

            <thead class="table-light">
                <tr>
                    <th>Collection ID</th>
                    <th>Phone Number</th>
                    <th>Amount</th>
                    <th>Receipt No</th>
                    <th>Status</th>
                    <th>Transaction Date</th>
                    <th>Created At</th>
                    <th class="text-end">Actions</th>
                </tr>

                <!-- Search Row -->
                <tr>
                    <th>
                        <input type="text" placeholder="Search Collection ID" class="form-control form-control-sm" />
                    </th>
                    <th>
                        <input type="text" placeholder="Search Phone" class="form-control form-control-sm" />
                    </th>
                    <th>
                        <input type="text" placeholder="Search Amount" class="form-control form-control-sm" />
                    </th>
                    <th>
                        <input type="text" placeholder="Search Receipt" class="form-control form-control-sm" />
                    </th>
                    <th>
                        <select class="form-control form-control-sm">
                            <option value="">All</option>
                            <option value="1">Pending</option>
                            <option value="2">Success</option>
                            <option value="3">Failed</option>
                        </select>
                    </th>
                    <th>
                        <input type="date" class="form-control form-control-sm" />
                    </th>
                    <th>
                        <input type="date" class="form-control form-control-sm" />
                    </th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                @foreach (var Collection in Model)
                {
                    <tr data-amount="@Collection.Amount" data-date="@((Collection.TransactionDate ?? Collection.CreatedAt).ToString("yyyy-MM-ddTHH:mm:ss"))">
                        <td>
                            <strong>#@Collection.Id</strong>
                        </td>
                        <td>@Collection.PhoneNumber</td>
                        <td>KES @Collection.Amount.ToString("N2")</td>
                        <td>@Collection.MpesaReceiptNumber</td>

                        <td>
                            @if (Collection.PaymentStatusId == 1)
                            {
                                <span class="badge bg-warning">Pending</span>
                            }
                            else if (Collection.PaymentStatusId == 2)
                            {
                                <span class="badge bg-success">Success</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Failed</span>
                            }
                    </td>

                    <td>
                        @(Collection.TransactionDate.HasValue
                                                ? Collection.TransactionDate.Value.ToString("dd MMM yyyy HH:mm")
                                                : "-")
                    </td>

                        <td>@Collection.CreatedAt.ToString("dd MMM yyyy")</td>

                        <td class="text-end">

                            <!-- View -->
                            <button class="btn btn-sm btn-outline-info"
                                    onclick="openCollectionModal('@Url.Action("Details", "Collections", new { id = Collection.Id })')">
                                <i class="fa fa-eye"></i>
                            </button>

                            <!-- Optional: Retry (for failed Collections) -->
                            @if (Collection.PaymentStatusId == 3)
                            {
                                <button class="btn btn-sm btn-outline-warning"
                                        onclick="retryCollection(@Collection.Id)">
                                    <i class="fa fa-refresh"></i>
                                </button>
                            }

                        </td>
                    </tr>
                }
            </tbody>

        </table>
    </div>
</div>