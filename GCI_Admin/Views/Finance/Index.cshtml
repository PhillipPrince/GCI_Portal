@model GCI_Admin.Models.Finance

@{
    ViewData["Title"] = "Church Collections Dashboard";

    var initCollections = Model?.Collections ?? new List<GCI_Admin.Models.Collection>();
    var initNow = DateTime.Now;
    var initTodayStart = initNow.Date;
    var initWeekStart = initNow.AddDays(-(int)initNow.DayOfWeek).Date;
    var initMonthStart = new DateTime(initNow.Year, initNow.Month, 1);
    var initYearStart = new DateTime(initNow.Year, 1, 1);

    var initTodayColls = initCollections.Where(c => c.PaymentStatusId == 2 && (c.TransactionDate ?? c.CreatedAt).Date == initTodayStart).ToList();
    var initWeekColls = initCollections.Where(c => c.PaymentStatusId == 2 && (c.TransactionDate ?? c.CreatedAt).Date >= initWeekStart).ToList();
    var initMonthColls = initCollections.Where(c => c.PaymentStatusId == 2 && (c.TransactionDate ?? c.CreatedAt).Date >= initMonthStart).ToList();
    var initYearColls = initCollections.Where(c => c.PaymentStatusId == 2 && (c.TransactionDate ?? c.CreatedAt).Date >= initYearStart).ToList();

    var initTodayTotal = initTodayColls.Sum(c => c.Amount);
    var initWeekTotal = initWeekColls.Sum(c => c.Amount);
    var initMonthTotal = initMonthColls.Sum(c => c.Amount);
    var initYearTotal = initYearColls.Sum(c => c.Amount);
}

<!-- Page Header with Stats -->
<div class="row mb-4">
    <div class="col-md-8">
        <h2 class="fw-bold mb-1">Church Collections Dashboard</h2>
        <p class="text-muted mb-0">Track and manage main church giving and contributions</p>
    </div>
    <div class="col-md-4 text-end">
        <button class="btn btn-success btn-lg me-2" onclick="exportGivings()">
            <i class="fa fa-download me-2"></i>Export Report
        </button>
        <button class="btn btn-primary btn-lg" onclick="showCollectionModal()">
            <i class="fa fa-plus-circle me-2"></i>Record Collection
        </button>
    </div>
</div>



<!-- Financial Stats Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm stat-card" onclick="filterByDate('today')">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="bg-primary bg-opacity-10 p-3 rounded-circle">
                            <i class="fa fa-calendar-day text-primary fa-2x"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1">Today's Giving</h6>
                        <h3 class="fw-bold mb-0" id="todayTotal">KES @initTodayTotal.ToString("N2")</h3>
                        <small class="text-muted" id="todayCount">@initTodayColls.Count transactions</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm stat-card" onclick="filterByDate('week')">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="bg-success bg-opacity-10 p-3 rounded-circle">
                            <i class="fa fa-calendar-week text-success fa-2x"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1">This Week</h6>
                        <h3 class="fw-bold mb-0" id="weekTotal">KES @initWeekTotal.ToString("N2")</h3>
                        <small class="text-muted" id="weekCount">@initWeekColls.Count transactions</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm stat-card" onclick="filterByDate('month')">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="bg-warning bg-opacity-10 p-3 rounded-circle">
                            <i class="fa fa-calendar-alt text-warning fa-2x"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1">This Month</h6>
                        <h3 class="fw-bold mb-0" id="monthTotal">KES @initMonthTotal.ToString("N2")</h3>
                        <small class="text-muted" id="monthCount">@initMonthColls.Count transactions</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm stat-card" onclick="filterByDate('year')">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="bg-info bg-opacity-10 p-3 rounded-circle">
                            <i class="fa fa-calendar text-info fa-2x"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1">This Year</h6>
                        <h3 class="fw-bold mb-0" id="yearTotal">KES @initYearTotal.ToString("N2")</h3>
                        <small class="text-muted" id="yearCount">@initYearColls.Count transactions</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Filter Bar -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-center">
            <div class="col-md-2">
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-end-0">
                        <i class="fa fa-search text-muted"></i>
                    </span>
                    <input type="text" class="form-control border-start-0" id="givingSearch" placeholder="Search...">
                </div>
            </div>
            <div class="col-md-2">
                <select class="form-select" id="accountReference">
                    <option value="">All Accounts</option>
                    @if (Model.AccountReferenceSummaries != null)
                    {
                        foreach (var summary in Model.AccountReferenceSummaries)
                        {
                            <option value="@summary.AccountReference">@summary.AccountReference</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-1">
                <select class="form-select" id="filterYear">
                    <option value="">Year</option>
                    @for (int y = DateTime.Now.Year; y >= DateTime.Now.Year - 5; y--)
                    {
                        <option value="@y">@y</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select class="form-select" id="filterMonth">
                    <option value="">All Months</option>
                    <option value="1">January</option>
                    <option value="2">February</option>
                    <option value="3">March</option>
                    <option value="4">April</option>
                    <option value="5">May</option>
                    <option value="6">June</option>
                    <option value="7">July</option>
                    <option value="8">August</option>
                    <option value="9">September</option>
                    <option value="10">October</option>
                    <option value="11">November</option>
                    <option value="12">December</option>
                </select>
            </div>
            <div class="col-md-2">
                <select class="form-select" id="dateRange">
                    <option value="all">All Time</option>
                    <option value="today">Today</option>
                    <option value="yesterday">Yesterday</option>
                    <option value="thisweek">This Week</option>
                    <option value="thismonth">This Month</option>
                    <option value="lastmonth">Last Month</option>
                    <option value="thisyear">This Year</option>
                    <option value="custom">Custom Range</option>
                </select>
            </div>
            <div class="col-md-1">
                <select class="form-select" id="Collectionstatus">
                    <option value="">Status</option>
                    <option value="1">Pending</option>
                    <option value="2">Success</option>
                    <option value="3">Failed</option>
                </select>
            </div>
            <div class="col-md-2 text-end">
                <button class="btn btn-outline-secondary btn-sm me-1" onclick="clearFilters()" title="Clear Filters">
                    <i class="fa fa-times"></i>
                </button>
                <button class="btn btn-primary btn-sm" onclick="applyFilters()">
                    <i class="fa fa-filter me-1"></i>Apply
                </button>
            </div>
        </div>

        <!-- Custom Date Range (Hidden by default) -->
        <div class="row mt-3" id="customDateRange" style="display: none;">
            <div class="col-md-5">
                <label class="form-label">From Date</label>
                <input type="date" class="form-control" id="fromDate">
            </div>
            <div class="col-md-5">
                <label class="form-label">To Date</label>
                <input type="date" class="form-control" id="toDate">
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button class="btn btn-primary w-100" onclick="applyCustomDate()">Apply</button>
            </div>
        </div>
    </div>
</div>

<ul class="nav nav-tabs mb-3" id="CollectionTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="tab-all" data-bs-toggle="tab" data-bs-target="#content-all" type="button" role="tab" onclick="filterByPaybill('')">All Church Collections</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="tab-844632" data-bs-toggle="tab" data-bs-target="#content-all" type="button" role="tab" onclick="filterByPaybill('844632')">Paybill 844632</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="tab-cash" data-bs-toggle="tab" data-bs-target="#content-all" type="button" role="tab" onclick="filterByPaybill('CASH')">Manual (Cash)</button>
    </li>
</ul>

<div class="tab-content" id="CollectionTabsContent">
    <div class="tab-pane fade show active" id="content-all" role="tabpanel">
        <input type="hidden" id="activePaybillFilter" value="" />
        <div id="givingsTableContainer">
            @await Html.PartialAsync("_GivingsTablePartial", Model.Collections)
        </div>
    </div>
</div>

<!-- Record Collection Modal -->
<div class="modal fade" id="CollectionModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Record Manual Collection</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="CollectionForm">
                    <div class="form-check mb-3">
                        <input type="checkbox" class="form-check-input" id="isAnonymousCollection" onchange="toggleAnonymousCollection()">
                        <label class="form-check-label fw-semibold" for="isAnonymousCollection">Record as Anonymous Collection (Member ID = 0)</label>
                    </div>

                    <div class="mb-3" id="CollectionMemberSelector_container">
                        @await Html.PartialAsync("_MemberSelector", new GCI_Admin.Models.ViewModels.MemberSelectorViewModel
                        {
                            ControlId = "CollectionMemberSelector",
                            LabelText = "Select Member",
                            MemberIdFieldName = "MemberId",
                            SelectedMemberId = null,
                            Members = ViewBag.Members as List<GCI_Admin.Models.Member>,
                            IsRequired = false,
                            IsEdit = false,
                            ShowPhoneAndGender = true
                        })
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Link to Meeting (Optional)</label>
                        <select class="form-select" id="meetingSelect">
                            <option value="">-- No Meeting Link (Standalone Collection) --</option>
                            @if (ViewBag.Meetings != null)
                            {
                                var meetingsList = ViewBag.Meetings as List<GCI_Admin.Models.MeetingAttendance>;
                                if (meetingsList != null)
                                {
                                    foreach (var m in meetingsList)
                                    {
                                        <option value="@m.MeetingAttendancesId">@m.MeetingType - @m.MeetingDate.ToString("dd MMM yyyy") (@m.TotalAttendees Attendees)</option>
                                    }
                                }
                            }
                        </select>
                        <small class="text-muted d-block mt-1">If linked to a verified meeting, individual amount will be reconciled against the meeting's bulk collection.</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Account Reference</label>
                        <select class="form-select" id="accountRef" required>
                            <option value="">-- Select Account --</option>
                            <option value="Tithes">Tithes</option>
                            <option value="Offerings">Offerings</option>
                            <option value="Sunday School">Sunday School</option>
                            <option value="Thanksgiving">Thanksgiving</option>
                            <option value="Missions">Missions</option>
                            <option value="Projects">Projects</option>
                            <option value="Youth">Youth</option>
                            <option value="Widows & Orphans">Widows & Orphans</option>
                            <option value="Others">Others</option>
                            @if (Model.AccountReferenceSummaries != null)
                            {
                                var standardAccounts = new[] { "Tithes", "Offerings", "Sunday School", "Thanksgiving", "Missions", "Projects", "Youth", "Widows & Orphans", "Others" };
                                foreach (var summary in Model.AccountReferenceSummaries)
                                {
                                    if (!standardAccounts.Contains(summary.AccountReference))
                                    {
                                        <option value="@summary.AccountReference">@summary.AccountReference</option>
                                    }
                                }
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Amount (KES)</label>
                        <input type="number" class="form-control" id="amount" min="1" step="0.01" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Transaction Date</label>
                        <input type="datetime-local" class="form-control" id="transactionDate" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Receipt Number</label>
                        <input type="text" class="form-control" id="receiptNumber" placeholder="Enter receipt number">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Collection Status</label>
                        <select class="form-select" id="CollectionstatusId" required>
                            <option value="2">Success</option>
                            <option value="1">Pending</option>
                            <option value="3">Failed</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveManualCollection()">Save Collection</button>
            </div>
        </div>
    </div>
</div>

<!-- Success Toast Notification -->
<div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div id="successToast" class="toast align-items-center text-white bg-success border-0" role="alert">
        <div class="d-flex">
            <div class="toast-body">
                <i class="fa fa-check-circle me-2"></i>
                <span id="toastMessage">Operation completed successfully</span>
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

@section Scripts {
    <!-- SheetJS for Excel export -->
    <script src="https://cdn.sheetjs.com/xlsx-0.20.1/package/dist/xlsx.full.min.js"></script>

    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Moment.js -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.4/moment.min.js"></script>

    <!-- DataTables loaded globally in _Layout.cshtml -->

    <style>
        .stat-card {
            transition: transform 0.2s, box-shadow 0.2s;
            cursor: pointer;
        }

            .stat-card:hover {
                transform: translateY(-3px);
                box-shadow: 0 0.5rem 1.5rem rgba(0,0,0,0.1) !important;
            }

        .account-widget {
            border-radius: 10px;
            padding: 0;
            overflow: hidden;
            cursor: pointer;
            transition: transform 0.2s;
        }

            .account-widget:hover {
                transform: translateY(-5px);
            }

            .account-widget .card-body {
                padding: 1.5rem;
            }

            .account-widget .amount {
                font-size: 1.5rem;
                font-weight: bold;
            }

        .btn-group .btn.active {
            background-color: #0d6efd;
            color: white;
            border-color: #0d6efd;
        }
    </style>

    <script>
        // Global variables
        let Collections = @Html.Raw(Json.Serialize(Model.Collections));
        let currentFilters = {};

        $(document).ready(function() {
            initializeDataTable();
            updateStats();
            initializeEventListeners();

            // Clear member selector when Collection modal is closed
            $('#CollectionModal').on('hidden.bs.modal', function() {
                $('#CollectionMemberSelector_display').val('');
                $('#CollectionMemberSelector_selectedId').val('');
                $('#CollectionMemberSelector_fullName').val('');
                $('#CollectionMemberSelector_email').val('');
                $('#CollectionMemberSelector_phone').val('');
                $('#CollectionMemberSelector_gender').val('');
                $('.dropdown-list').hide();
                $('#CollectionMemberSelector_validation').text('');
            });

            // Check for success message from TempData
            @if (TempData["SuccessMessage"] != null)
            {
                    <text>
                    showToast('@TempData["SuccessMessage"]', 'success');
                    </text>
            }
        });

        function initializeEventListeners() {
            $('#dateRange').on('change', function() {
                if ($(this).val() === 'custom') {
                    $('#customDateRange').slideDown();
                } else {
                    $('#customDateRange').slideUp();
                    applyFilters();
                }
            });

            $('#accountReference, #filterYear, #filterMonth, #Collectionstatus').on('change', function() {
                applyFilters();
            });

            // Individual column search
            $('#CollectionsTable thead tr:eq(1) th').each(function(i) {
                $('input', this).on('keyup change', function() {
                    if (window.CollectionsTable) {
                        window.CollectionsTable.column(i).search(this.value).draw();
                    }
                });

                $('select', this).on('change', function() {
                    if (window.CollectionsTable) {
                        window.CollectionsTable.column(i).search(this.value).draw();
                    }
                });
            });
        }

        function initializeDataTable() {
            // Delegate to global GCIDataTable initializer
            GCIDataTable.init('#CollectionsTable');
            // Grab a reference to the instance for column-search operations
            window.CollectionsTable = $('#CollectionsTable').DataTable();
        }

        function reloadCollectionsTable() {
            const filters = getFilterParams();

            $.get('@Url.Action("GetFilteredCollections", "Finance")', filters, function(data) {
                $('#givingsTableContainer').html(data);
                initializeDataTable();
                updateStats();
            }).fail(function() {
                showToast('Failed to reload Collections', 'error');
            });
        }

        function getFilterParams() {
            return {
                search: $('#givingSearch').val(),
                accountReference: $('#accountReference').val(),
                dateRange: $('#dateRange').val(),
                Collectionstatus: $('#Collectionstatus').val(),
                fromDate: $('#fromDate').val(),
                toDate: $('#toDate').val(),
                filterYear: $('#filterYear').val(),
                filterMonth: $('#filterMonth').val(),
                paybill: $('#activePaybillFilter').val()
            };
        }

        function filterByPaybill(paybill) {
            $('#activePaybillFilter').val(paybill);
            applyFilters();
        }

        function updateStats() {
            const now = moment();
            const todayStr = now.format('YYYY-MM-DD');
            const weekStart = now.clone().startOf('week');
            const monthStart = now.clone().startOf('month');
            const yearStart = now.clone().startOf('year');

            let todayTotal = 0, todayCount = 0;
            let weekTotal = 0, weekCount = 0;
            let monthTotal = 0, monthCount = 0;
            let yearTotal = 0, yearCount = 0;

            $('#CollectionsTable tbody tr').each(function() {
                const row = $(this);
                if (row.find('td').length <= 1) return;

                const amount = parseFloat(row.attr('data-amount')) || 0;
                const dateStr = row.attr('data-date');
                if (!dateStr) return;
                const txDate = moment(dateStr);

                if (txDate.isValid()) {
                    if (txDate.format('YYYY-MM-DD') === todayStr) {
                        todayTotal += amount;
                        todayCount++;
                    }
                    if (txDate.isSameOrAfter(weekStart)) {
                        weekTotal += amount;
                        weekCount++;
                    }
                    if (txDate.isSameOrAfter(monthStart)) {
                        monthTotal += amount;
                        monthCount++;
                    }
                    if (txDate.isSameOrAfter(yearStart)) {
                        yearTotal += amount;
                        yearCount++;
                    }
                }
            });

            $('#todayTotal').text('KES ' + formatNumber(todayTotal));
            $('#todayCount').text(todayCount + ' transactions');
            $('#weekTotal').text('KES ' + formatNumber(weekTotal));
            $('#weekCount').text(weekCount + ' transactions');
            $('#monthTotal').text('KES ' + formatNumber(monthTotal));
            $('#monthCount').text(monthCount + ' transactions');
            $('#yearTotal').text('KES ' + formatNumber(yearTotal));
            $('#yearCount').text(yearCount + ' transactions');
        }

        // Apply filters
        function applyFilters() {
            reloadCollectionsTable();
        }

        // Clear filters
        function clearFilters() {
            $('#givingSearch').val('');
            $('#accountReference').val('');
            $('#filterYear').val('');
            $('#filterMonth').val('');
            $('#dateRange').val('all');
            $('#Collectionstatus').val('');
            $('#customDateRange').hide();

            // Clear DataTable column searches
            if (window.CollectionsTable) {
                window.CollectionsTable.search('').columns().search('').draw();
            }

            reloadCollectionsTable();
        }

        function applyCustomDate() {
            const fromDate = $('#fromDate').val();
            const toDate = $('#toDate').val();

            if (!fromDate || !toDate) {
                showToast('Please select both from and to dates', 'warning');
                return;
            }

            applyFilters();
        }

        function filterByDate(period) {
            $('#dateRange').val(period);
            applyFilters();
        }

        function filterByAccount(account) {
            $('#accountReference').val(account);
            applyFilters();
        }

        function toggleAnonymousCollection() {
            const isAnonymous = $('#isAnonymousCollection').is(':checked');
            if (isAnonymous) {
                $('#CollectionMemberSelector_container').hide();
                $('#CollectionMemberSelector_selectedId').val('0');
            } else {
                $('#CollectionMemberSelector_container').show();
                $('#CollectionMemberSelector_selectedId').val('');
            }
        }

        function showCollectionModal() {
            $('#isAnonymousCollection').prop('checked', false);
            toggleAnonymousCollection();
            $('#meetingSelect').val('');
            $('#accountRef').val('');
            $('#amount').val('');
            $('#receiptNumber').val('');
            $('#transactionDate').val(moment().format('YYYY-MM-DDTHH:mm'));
            $('#CollectionModal').modal('show');
        }

        function saveManualCollection() {
            const isAnonymous = $('#isAnonymousCollection').is(':checked');
            let memberIdVal = $('#CollectionMemberSelector_selectedId').val();

            if (isAnonymous) {
                memberIdVal = '0';
            } else if (!memberIdVal || memberIdVal === '') {
                Swal.fire('Validation Error', 'Please select a member or check Anonymous Collection.', 'warning');
                return;
            }

            // Validate form
            if (!$('#CollectionForm')[0].checkValidity()) {
                $('#CollectionForm')[0].reportValidity();
                return;
            }

            const meetingIdVal = $('#meetingSelect').val();

            const CollectionData = {
                memberId: parseInt(memberIdVal, 10),
                meetingId: meetingIdVal ? parseInt(meetingIdVal, 10) : null,
                phoneNumber: isAnonymous ? 'N/A' : $('#CollectionMemberSelector_phone').val(),
                accountReference: $('#accountRef').val(),
                amount: parseFloat($('#amount').val()),
                transactionDate: $('#transactionDate').val(),
                mpesaReceiptNumber: $('#receiptNumber').val() ? 'CASH-' + $('#receiptNumber').val() : 'CASH-' + Date.now().toString(),
                paymentStatusId: parseInt($('#CollectionstatusId').val(), 10),
                createdAt: new Date().toISOString()
            };

            Swal.fire({
                title: 'Processing...',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            $.ajax({
                url: '@Url.Action("SaveManualCollection", "Finance")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(CollectionData),
                success: function(response) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Success',
                        text: 'Collection recorded successfully'
                    }).then(() => {
                        $('#CollectionModal').modal('hide');
                        $('#CollectionForm')[0].reset();
                        reloadCollectionsTable();
                    });
                },
                error: function(xhr) {
                    let message = 'Failed to save Collection';
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        message = xhr.responseJSON.message;
                    }
                    Swal.fire('Error', message, 'error');
                }
            });
        }

        function openCollectionModal(url) {
            window.location.href = url;
        }

        function retryCollection(id) {
            Swal.fire({
                title: 'Retry Collection',
                text: 'Are you sure you want to retry this Collection?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Yes, retry'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('@Url.Action("RetryCollection", "Finance")/' + id, function() {
                        showToast('Collection retry initiated');
                        reloadCollectionsTable();
                    }).fail(function() {
                        showToast('Failed to retry Collection', 'error');
                    });
                }
            });
        }

        $(document).ready(function() {
            // Pre-fetch active members asynchronously in background without blocking page load
            setTimeout(function() {
                $.get('/Finance/GetActiveMembers');
            }, 100);
        });

        function exportGivings() {
            const filters = getFilterParams();

            Swal.fire({
                title: 'Exporting...',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            $.get('@Url.Action("ExportGivings", "Finance")', filters, function(data) {
                const wb = XLSX.utils.book_new();

                // Format data for export
                const exportData = data.map(p => ({
                    'Collection ID': p.id,
                    'Phone Number': p.phoneNumber,
                    'Amount (KES)': p.amount,
                    'Receipt Number': p.mpesaReceiptNumber || '-',
                    'Account Reference': p.accountReference,
                    'Status': p.CollectionstatusId === 1 ? 'Pending' : p.CollectionstatusId === 2 ? 'Success' : 'Failed',
                    'Transaction Date': p.transactionDate ? moment(p.transactionDate).format('DD/MM/YYYY HH:mm') : '-',
                    'Created At': moment(p.createdAt).format('DD/MM/YYYY HH:mm')
                }));

                const ws = XLSX.utils.json_to_sheet(exportData);

                // Set column widths
                ws['!cols'] = [
                    { wch: 10 }, // Collection ID
                    { wch: 15 }, // Phone
                    { wch: 15 }, // Amount
                    { wch: 20 }, // Receipt
                    { wch: 20 }, // Account
                    { wch: 10 }, // Status
                    { wch: 20 }, // Transaction Date
                    { wch: 20 }  // Created At
                ];

                XLSX.utils.book_append_sheet(wb, ws, 'Givings');
                XLSX.writeFile(wb, `Givings_Export_${moment().format('YYYY-MM-DD')}.xlsx`);

                Swal.close();
                showToast('Export completed successfully');
            }).fail(() => {
                Swal.fire('Error', 'Failed to export data', 'error');
            });
        }

        function showToast(message, type = 'success') {
            const toast = $('#successToast');
            toast.removeClass('bg-success bg-danger bg-warning');

            if (type === 'success') {
                toast.addClass('bg-success');
                toast.find('i').removeClass().addClass('fa fa-check-circle me-2');
            } else if (type === 'error') {
                toast.addClass('bg-danger');
                toast.find('i').removeClass().addClass('fa fa-exclamation-circle me-2');
            } else if (type === 'warning') {
                toast.addClass('bg-warning');
                toast.find('i').removeClass().addClass('fa fa-exclamation-triangle me-2');
            }

            $('#toastMessage').text(message);
            const bsToast = new bootstrap.Toast(toast[0], { delay: 3000 });
            bsToast.show();
        }

        function formatNumber(num) {
            return (num || 0).toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2});
        }
    </script>
}