@model GCI_Admin.Models.Finance

@{
    ViewData["Title"] = "GBI Collections (Paybill 4099245)";

    var gbiCollections = Model?.Collections ?? new List<GCI_Admin.Models.Collection>();
    var gbiNow = DateTime.Now;
    var gbiTodayStart = gbiNow.Date;
    var gbiWeekStart = gbiNow.AddDays(-(int)gbiNow.DayOfWeek).Date;
    var gbiMonthStart = new DateTime(gbiNow.Year, gbiNow.Month, 1);

    var gbiTodayColls = gbiCollections.Where(c => c.PaymentStatusId == 2 && (c.TransactionDate ?? c.CreatedAt).Date == gbiTodayStart).ToList();
    var gbiWeekColls = gbiCollections.Where(c => c.PaymentStatusId == 2 && (c.TransactionDate ?? c.CreatedAt).Date >= gbiWeekStart).ToList();
    var gbiMonthColls = gbiCollections.Where(c => c.PaymentStatusId == 2 && (c.TransactionDate ?? c.CreatedAt).Date >= gbiMonthStart).ToList();
    var gbiAllColls = gbiCollections.Where(c => c.PaymentStatusId == 2).ToList();

    var gbiTodayTotal = gbiTodayColls.Sum(c => c.Amount);
    var gbiWeekTotal = gbiWeekColls.Sum(c => c.Amount);
    var gbiMonthTotal = gbiMonthColls.Sum(c => c.Amount);
    var gbiGrandTotal = gbiAllColls.Sum(c => c.Amount);
}

<!-- Page Header with Stats -->
<div class="row mb-4">
    <div class="col-md-8">
        <h2 class="fw-bold mb-1">
            <i class="fa fa-graduation-cap me-2 text-primary"></i>GBI Collections Dashboard
        </h2>
        <p class="text-muted mb-0">Track and manage Gospel Bible Institute giving and contributions (Paybill: 4099245)</p>
    </div>
    <div class="col-md-4 text-end">
        <button class="btn btn-success btn-lg me-2" onclick="exportGivings()">
            <i class="fa fa-download me-2"></i>Export Report
        </button>
        <button class="btn btn-primary btn-lg" onclick="showCollectionModal()">
            <i class="fa fa-plus-circle me-2"></i>Record GBI Collection
        </button>
    </div>
</div>

<!-- Financial Stats Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm stat-card" onclick="filterByDate('today')">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="bg-primary bg-opacity-10 p-3 rounded-circle">
                            <i class="fa fa-calendar-day text-primary fa-2x"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1">Today's GBI Giving</h6>
                        <h3 class="fw-bold mb-0" id="todayTotal">KES @gbiTodayTotal.ToString("N2")</h3>
                        <small class="text-muted" id="todayCount">@gbiTodayColls.Count transactions</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm stat-card" onclick="filterByDate('week')">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="bg-success bg-opacity-10 p-3 rounded-circle">
                            <i class="fa fa-calendar-week text-success fa-2x"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1">This Week</h6>
                        <h3 class="fw-bold mb-0" id="weekTotal">KES @gbiWeekTotal.ToString("N2")</h3>
                        <small class="text-muted" id="weekCount">@gbiWeekColls.Count transactions</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm stat-card" onclick="filterByDate('month')">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="bg-info bg-opacity-10 p-3 rounded-circle">
                            <i class="fa fa-calendar-alt text-info fa-2x"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1">This Month</h6>
                        <h3 class="fw-bold mb-0" id="monthTotal">KES @gbiMonthTotal.ToString("N2")</h3>
                        <small class="text-muted" id="monthCount">@gbiMonthColls.Count transactions</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm stat-card" onclick="filterByDate('')">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="bg-warning bg-opacity-10 p-3 rounded-circle">
                            <i class="fa fa-wallet text-warning fa-2x"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1">Total GBI Collections</h6>
                        <h3 class="fw-bold mb-0" id="grandTotal">KES @gbiGrandTotal.ToString("N2")</h3>
                        <small class="text-muted" id="totalCount">@gbiAllColls.Count transactions</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Account Summaries Row -->
<div class="row g-3 mb-4">
    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h5 class="fw-bold mb-0">
                    <i class="fa fa-layer-group text-primary me-2"></i>GBI Account Reference Breakdown
                </h5>
            </div>
            <div class="card-body">
                <div class="row g-3" id="accountsContainer">
                    @if (Model.AccountReferenceSummaries != null && Model.AccountReferenceSummaries.Any())
                    {
                        foreach (var summary in Model.AccountReferenceSummaries)
                        {
                            <div class="col-md-3 col-6">
                                <div class="p-3 border rounded bg-light cursor-pointer hover-shadow" onclick="filterByAccount('@summary.AccountReference')">
                                    <div class="text-muted small text-uppercase fw-semibold">@summary.AccountReference</div>
                                    <div class="fs-4 fw-bold text-primary my-1">KES @summary.TotalAmount.ToString("N2")</div>
                                    <div class="small text-muted">@summary.TransactionCount transactions</div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="col-12 text-center text-muted py-3">
                            No GBI account summaries available.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Filters and Actions -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-3">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0">
                        <i class="fa fa-search text-muted"></i>
                    </span>
                    <input type="text" class="form-control border-start-0 ps-0" id="searchInput" placeholder="Search receipt, phone...">
                </div>
            </div>
            <div class="col-md-2">
                <select class="form-select" id="accountFilter" onchange="applyFilters()">
                    <option value="">All Accounts</option>
                    @if (Model.AccountReferenceSummaries != null)
                    {
                        foreach (var summary in Model.AccountReferenceSummaries)
                        {
                            <option value="@summary.AccountReference">@summary.AccountReference</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select class="form-select" id="dateRangeFilter" onchange="handleDateRangeChange()">
                    <option value="">All Time</option>
                    <option value="today">Today</option>
                    <option value="yesterday">Yesterday</option>
                    <option value="thisweek">This Week</option>
                    <option value="thismonth">This Month</option>
                    <option value="lastmonth">Last Month</option>
                    <option value="thisyear">This Year</option>
                    <option value="custom">Custom Range</option>
                </select>
            </div>
            <div class="col-md-2">
                <select class="form-select" id="statusFilter" onchange="applyFilters()">
                    <option value="">All Statuses</option>
                    <option value="2" selected>Completed</option>
                    <option value="1">Pending</option>
                    <option value="3">Failed</option>
                </select>
            </div>
            <div class="col-md-3 text-end">
                <button class="btn btn-outline-secondary" onclick="resetFilters()">
                    <i class="fa fa-undo me-1"></i>Reset
                </button>
            </div>
        </div>

        <!-- Custom Date Range Row -->
        <div class="row g-3 mt-2 d-none" id="customDateRow">
            <div class="col-md-4 offset-md-4">
                <div class="input-group">
                    <input type="date" class="form-control" id="fromDate">
                    <span class="input-group-text">to</span>
                    <input type="date" class="form-control" id="toDate">
                </div>
            </div>
            <div class="col-md-2">
                <button class="btn btn-primary w-100" onclick="applyCustomDate()">Apply</button>
            </div>
        </div>
    </div>
</div>

<input type="hidden" id="activePaybillFilter" value="4099245" />
<div id="givingsTableContainer">
    @await Html.PartialAsync("_GivingsTablePartial", Model.Collections)
</div>

<!-- Record GBI Collection Modal -->
<div class="modal fade" id="CollectionModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">
                    <i class="fa fa-graduation-cap me-2"></i>Record GBI Collection (Paybill 4099245)
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="CollectionForm">
                    <div class="form-check mb-3">
                        <input type="checkbox" class="form-check-input" id="isAnonymousCollection" onchange="toggleAnonymousCollection()">
                        <label class="form-check-label fw-semibold" for="isAnonymousCollection">Record as Anonymous Collection (Member ID = 0)</label>
                    </div>

                    <div class="mb-3" id="CollectionMemberSelector_container">
                        @await Html.PartialAsync("_MemberSelector", new GCI_Admin.Models.ViewModels.MemberSelectorViewModel
                        {
                            ControlId = "CollectionMemberSelector",
                            LabelText = "Select Member",
                            MemberIdFieldName = "MemberId",
                            SelectedMemberId = null,
                            Members = ViewBag.Members as List<GCI_Admin.Models.Member>,
                            IsRequired = false,
                            IsEdit = false,
                            ShowPhoneAndGender = true
                        })
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Link to Meeting (Optional)</label>
                        <select class="form-select" id="meetingSelect">
                            <option value="">-- No Meeting Link (Standalone Collection) --</option>
                            @if (ViewBag.Meetings != null)
                            {
                                var meetingsList = ViewBag.Meetings as List<GCI_Admin.Models.MeetingAttendance>;
                                if (meetingsList != null)
                                {
                                    foreach (var m in meetingsList)
                                    {
                                        <option value="@m.MeetingAttendancesId">@m.MeetingType - @m.MeetingDate.ToString("dd MMM yyyy") (@m.TotalAttendees Attendees)</option>
                                    }
                                }
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Account Reference</label>
                        <select class="form-select" id="accountRef" required>
                            <option value="">-- Select Account --</option>
                            <option value="GBI Tuition">GBI Tuition</option>
                            <option value="GBI Registration">GBI Registration</option>
                            <option value="GBI Offering">GBI Offering</option>
                            <option value="GBI Graduation">GBI Graduation</option>
                            <option value="GBI Others">GBI Others</option>
                            @if (Model.AccountReferenceSummaries != null)
                            {
                                var standardAccounts = new[] { "GBI Tuition", "GBI Registration", "GBI Offering", "GBI Graduation", "GBI Others" };
                                foreach (var summary in Model.AccountReferenceSummaries)
                                {
                                    if (!standardAccounts.Contains(summary.AccountReference))
                                    {
                                        <option value="@summary.AccountReference">@summary.AccountReference</option>
                                    }
                                }
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Amount (KES)</label>
                        <input type="number" step="0.01" class="form-control" id="CollectionAmount" required min="1">
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Phone Number</label>
                        <input type="text" class="form-control" id="CollectionPhone" placeholder="2547XXXXXXXX">
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Transaction Date</label>
                        <input type="datetime-local" class="form-control" id="transactionDate">
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveManualCollection()">Save GBI Collection</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let searchTimeout;

        $(document).ready(function() {
            calculateStats();
            $('#searchInput').on('input', function() {
                clearTimeout(searchTimeout);
                searchTimeout = setTimeout(applyFilters, 500);
            });

            // Pre-fetch active members in background
            setTimeout(function() {
                $.get('/Finance/GetActiveMembers');
            }, 100);
        });

        function toggleAnonymousCollection() {
            var isAnon = $('#isAnonymousCollection').is(':checked');
            if (isAnon) {
                $('#CollectionMemberSelector_container').hide();
                if (typeof window.CollectionMemberSelector_reset === 'function') {
                    window.CollectionMemberSelector_reset();
                }
            } else {
                $('#CollectionMemberSelector_container').show();
            }
        }

        function calculateStats() {
            let todaySum = 0, todayCount = 0;
            let weekSum = 0, weekCount = 0;
            let monthSum = 0, monthCount = 0;
            let grandSum = 0, grandCount = 0;

            const now = moment();
            const todayStr = now.format('YYYY-MM-DD');
            const startOfWeek = now.clone().startOf('week');
            const startOfMonth = now.clone().startOf('month');

            $('#CollectionsTable tbody tr').each(function() {
                const row = $(this);
                if (row.find('td').length <= 1) return;

                const amount = parseFloat(row.attr('data-amount')) || 0;
                const dateStr = row.attr('data-date');
                if (!dateStr) return;
                const txDate = moment(dateStr);

                grandSum += amount;
                grandCount++;

                if (txDate.isValid()) {
                    if (txDate.format('YYYY-MM-DD') === todayStr) {
                        todaySum += amount;
                        todayCount++;
                    }
                    if (txDate.isSameOrAfter(startOfWeek)) {
                        weekSum += amount;
                        weekCount++;
                    }
                    if (txDate.isSameOrAfter(startOfMonth)) {
                        monthSum += amount;
                        monthCount++;
                    }
                }
            });

            $('#todayTotal').text('KES ' + formatNumber(todaySum));
            $('#todayCount').text(todayCount + ' transactions');
            $('#weekTotal').text('KES ' + formatNumber(weekSum));
            $('#weekCount').text(weekCount + ' transactions');
            $('#monthTotal').text('KES ' + formatNumber(monthSum));
            $('#monthCount').text(monthCount + ' transactions');
            $('#grandTotal').text('KES ' + formatNumber(grandSum));
            $('#totalCount').text(grandCount + ' transactions');
        }

        function getFilterParams() {
            return {
                search: $('#searchInput').val(),
                accountReference: $('#accountFilter').val(),
                dateRange: $('#dateRangeFilter').val(),
                PaymentStatus: $('#statusFilter').val(),
                fromDate: $('#fromDate').val(),
                toDate: $('#toDate').val(),
                paybill: '4099245'
            };
        }

        function applyFilters() {
            const params = getFilterParams();

            $('#givingsTableContainer').html(`
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2 text-muted">Filtering GBI collections...</p>
                </div>
            `);

            $.get('@Url.Action("GetFilteredCollections", "Finance")', params, function(data) {
                $('#givingsTableContainer').html(data);
                calculateStats();
            }).fail(function() {
                showToast('Failed to load filtered GBI collections', 'error');
            });
        }

        function handleDateRangeChange() {
            const val = $('#dateRangeFilter').val();
            if (val === 'custom') {
                $('#customDateRow').removeClass('d-none');
            } else {
                $('#customDateRow').addClass('d-none');
                applyFilters();
            }
        }

        function applyCustomDate() {
            const from = $('#fromDate').val();
            const to = $('#toDate').val();

            if (!from || !to) {
                showToast('Please select both From and To dates', 'warning');
                return;
            }

            applyFilters();
        }

        function filterByDate(range) {
            $('#dateRangeFilter').val(range);
            handleDateRangeChange();
        }

        function filterByAccount(account) {
            $('#accountFilter').val(account);
            applyFilters();
        }

        function resetFilters() {
            $('#searchInput').val('');
            $('#accountFilter').val('');
            $('#dateRangeFilter').val('');
            $('#statusFilter').val('2');
            $('#fromDate').val('');
            $('#toDate').val('');
            $('#customDateRow').addClass('d-none');
            applyFilters();
        }

        function showCollectionModal() {
            $('#CollectionForm')[0].reset();
            $('#isAnonymousCollection').prop('checked', false);
            toggleAnonymousCollection();
            $('#CollectionModal').modal('show');
        }

        function saveManualCollection() {
            const isAnon = $('#isAnonymousCollection').is(':checked');
            let memberId = 0;
            if (!isAnon) {
                memberId = parseInt($('#CollectionMemberSelector_val').val()) || 0;
                if (!memberId) {
                    showToast('Please select a member or check Anonymous Collection', 'warning');
                    return;
                }
            }

            const meetingIdVal = $('#meetingSelect').val();
            const meetingId = meetingIdVal ? parseInt(meetingIdVal) : null;
            const accountRef = $('#accountRef').val();
            const amount = parseFloat($('#CollectionAmount').val());
            const phone = $('#CollectionPhone').val();
            const txDate = $('#transactionDate').val();

            if (!accountRef || !amount || amount <= 0) {
                showToast('Please fill in Account Reference and a valid Amount', 'warning');
                return;
            }

            const payload = {
                MemberId: memberId,
                MeetingId: meetingId,
                AccountReference: accountRef,
                Amount: amount,
                PhoneNumber: phone || 'CASH',
                Paybill: '4099245',
                MpesaReceiptNumber: 'CASH_' + Date.now(),
                PaymentStatusId: 2,
                TransactionDate: txDate ? new Date(txDate).toISOString() : new Date().toISOString()
            };

            $.ajax({
                url: '@Url.Action("SaveManualCollection", "Finance")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function(res) {
                    if (res.success) {
                        $('#CollectionModal').modal('hide');
                        showToast('GBI Collection saved successfully');
                        applyFilters();
                    } else {
                        showToast(res.message || 'Error saving collection', 'error');
                    }
                },
                error: function() {
                    showToast('Failed to save GBI collection', 'error');
                }
            });
        }

        function showToast(message, type = 'success') {
            const toast = $('#successToast');
            toast.removeClass('bg-success bg-danger bg-warning');

            if (type === 'success') {
                toast.addClass('bg-success');
                toast.find('i').removeClass().addClass('fa fa-check-circle me-2');
            } else if (type === 'error') {
                toast.addClass('bg-danger');
                toast.find('i').removeClass().addClass('fa fa-exclamation-circle me-2');
            } else if (type === 'warning') {
                toast.addClass('bg-warning');
                toast.find('i').removeClass().addClass('fa fa-exclamation-triangle me-2');
            }

            $('#toastMessage').text(message);
            const bsToast = new bootstrap.Toast(toast[0], { delay: 3000 });
            bsToast.show();
        }

        function formatNumber(num) {
            return (num || 0).toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2});
        }
    </script>
}
