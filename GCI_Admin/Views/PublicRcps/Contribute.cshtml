@model GCI_Admin.Models.RcpsInvite
@{
    ViewData["Title"] = Model.CustomName;
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>@Model.CustomName | Gospel Centres International</title>
    <link rel="shortcut icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true" />
    <link rel="icon" type="image/png" href="~/favicon.png" asp-append-version="true" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: #f8fafc;
            font-family: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif;
            line-height: 1.5;
            color: #1e293b;
            padding: 24px 16px;
        }

        .policy-container {
            max-width: 600px;
            margin: 0 auto;
            background: #ffffff;
            border-radius: 28px;
            box-shadow: 0 20px 35px -12px rgba(0, 0, 0, 0.08), 0 1px 2px rgba(0, 0, 0, 0.02);
            overflow: hidden;
            transition: all 0.2s ease;
        }

        .policy-header {
            background: #1e4a6b;
            background: linear-gradient(135deg, #1e4a6b 0%, #0f2c3f 100%);
            padding: 28px 24px;
            text-align: center;
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }

        .policy-header h1 {
            font-size: 1.85rem;
            font-weight: 700;
            letter-spacing: -0.3px;
            color: white;
            margin-bottom: 8px;
        }

        .policy-header .church-name {
            font-size: 1rem;
            color: #94a3b8;
            font-weight: 500;
        }

        .policy-content {
            padding: 24px;
        }

        .info-box {
            background: #f1f5f9;
            border-left: 4px solid #1e4a6b;
            padding: 16px;
            border-radius: 0 12px 12px 0;
            margin-bottom: 24px;
        }

        .info-box p {
            font-size: 0.95rem;
            color: #475569;
            margin-bottom: 8px;
        }

        .info-box strong {
            color: #1e293b;
        }

        .form-group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            color: #334155;
            font-size: 0.95rem;
        }

        input[type="text"],
        input[type="tel"],
        input[type="number"],
        input[type="email"],
        select {
            width: 100%;
            padding: 14px 16px;
            border: 1px solid #cbd5e1;
            border-radius: 12px;
            font-size: 1rem;
            color: #1e293b;
            background-color: #f8fafc;
            transition: all 0.2s ease;
        }

        input:focus,
        select:focus {
            outline: none;
            border-color: #1e4a6b;
            background-color: #ffffff;
            box-shadow: 0 0 0 4px rgba(30, 74, 107, 0.1);
        }

        .checkbox-group {
            display: flex;
            align-items: center;
            margin-top: 10px;
        }

        .checkbox-group input[type="checkbox"] {
            width: 20px;
            height: 20px;
            margin-right: 12px;
            border-radius: 4px;
            cursor: pointer;
        }

        .checkbox-group label {
            margin-bottom: 0;
            cursor: pointer;
            font-weight: 500;
        }

        .btn-submit {
            background: #1e4a6b;
            color: white;
            border: none;
            padding: 16px;
            width: 100%;
            border-radius: 12px;
            font-size: 1.1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
            margin-top: 12px;
        }

        .btn-submit:hover {
            background: #153650;
            transform: translateY(-1px);
        }

        .footer {
            text-align: center;
            padding: 20px;
            color: #64748b;
            font-size: 0.85rem;
        }
    </style>
</head>
<body>

<div class="policy-container">
    <div class="policy-header">
        <h1>@Model.CustomName</h1>
        <div class="church-name">Gospel Centres International</div>
    </div>
    
    <div class="policy-content">
        <div class="info-box">
            <p><strong>Goal:</strong> Help raise funds for @Model.RcpsPlan.Name (@Model.RcpsPlan.Rcps.Name)</p>
            <p><strong>Invited By:</strong> @Model.Member.FirstName @Model.Member.OtherNames</p>
        </div>

        <form id="contributionForm">
            <input type="hidden" id="uniqueLinkCode" value="@Model.UniqueLinkCode" />

            <div class="form-group">
                <label for="friendName">Your Name</label>
                <input type="text" id="friendName" placeholder="Enter your full name" required />
            </div>

            <div class="form-group">
                <label for="friendPhone">M-PESA Phone Number</label>
                <input type="tel" id="friendPhone" placeholder="e.g. 0712345678" required />
            </div>

            <div class="form-group">
                <label for="amount">Amount to Contribute (KES)</label>
                <input type="number" id="amount" placeholder="Enter amount" min="10" required />
            </div>

            <div class="form-group checkbox-group">
                <input type="checkbox" id="isAnonymous" />
                <label for="isAnonymous">Make this an anonymous contribution</label>
            </div>

            <button type="submit" class="btn-submit" id="submitBtn">Contribute Now</button>
        </form>
    </div>
</div>

<div class="footer">
    &copy; @DateTime.Now.Year Gospel Centres International. All rights reserved.
</div>

<script>
    document.getElementById('contributionForm').addEventListener('submit', async function(e) {
        e.preventDefault();

        const btn = document.getElementById('submitBtn');
        const uniqueLinkCode = document.getElementById('uniqueLinkCode').value;
        const friendName = document.getElementById('friendName').value;
        const friendPhone = document.getElementById('friendPhone').value;
        const amount = document.getElementById('amount').value;
        const isAnonymous = document.getElementById('isAnonymous').checked;

        if (!friendName || !friendPhone || !amount) {
            Swal.fire('Required', 'Please fill in all the required fields.', 'warning');
            return;
        }

        btn.disabled = true;
        btn.textContent = 'Processing...';

        try {
            // Call the GCI-APIs endpoint
            const apiUrl = 'https://api.gospelcentresinternational.com/api/RcpsInvite/SubmitContribution'; 

            const payload = {
                uniqueLinkCode: uniqueLinkCode,
                friendName: friendName,
                friendPhone: friendPhone,
                amount: parseFloat(amount),
                isAnonymous: isAnonymous
            };

            const response = await fetch(apiUrl, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                },
                body: JSON.stringify(payload)
            });

            const data = await response.json();

            if (response.ok && data.isSuccess !== false) {
                Swal.fire({
                    title: 'Success!',
                    text: 'STK Push has been sent to your phone. Please enter your M-PESA PIN to complete the contribution.',
                    icon: 'success',
                    confirmButtonColor: '#1e4a6b'
                }).then(() => {
                    window.location.reload();
                });
            } else {
                throw new Error(data.message || 'Contribution failed. Please try again.');
            }
        } catch (error) {
            Swal.fire('Error', error.message || 'An error occurred. Please try again later.', 'error');
            btn.disabled = false;
            btn.textContent = 'Contribute Now';
        }
    });
</script>

</body>
</html>
