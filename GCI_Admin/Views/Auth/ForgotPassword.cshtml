@model GCI_Admin.Models.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GCI Admin</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, var(--primary-blue) 0%, var(--primary-dark-blue) 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .reset-container {
            width: 100%;
            max-width: 450px;
            margin: 20px;
            animation: slideUp 0.6s ease-out;
        }

        @@keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .reset-card {
            background: var(--bg-white);
            border-radius: 24px;
            box-shadow: var(--shadow-lg);
            overflow: hidden;
        }

        .reset-header {
            background: linear-gradient(135deg, var(--primary-blue) 0%, var(--primary-dark-blue) 100%);
            padding: 2rem;
            text-align: center;
            color: var(--text-light);
        }

        .reset-body {
            padding: 2rem;
        }

        .form-control {
            border: 2px solid var(--secondary-border);
            border-radius: 12px;
            padding: 0.75rem 1rem;
            transition: all 0.3s ease;
        }

            .form-control:focus {
                border-color: var(--primary-blue);
                box-shadow: 0 0 0 3px var(--accent-blue-light);
            }

        .btn-primary {
            background: linear-gradient(135deg, var(--primary-blue) 0%, var(--primary-dark-blue) 100%);
            border: none;
            padding: 0.875rem;
            border-radius: 12px;
            font-weight: 600;
            transition: all 0.3s ease;
            color: var(--text-light);
        }

            .btn-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 10px 20px rgba(37, 139, 251, 0.3);
            }

        .otp-input-group {
            display: flex;
            gap: 12px;
            justify-content: center;
            margin: 2rem 0;
        }

        .otp-input {
            width: 55px;
            height: 55px;
            text-align: center;
            font-size: 24px;
            font-weight: 600;
            border: 2px solid var(--secondary-border);
            border-radius: 12px;
        }

            .otp-input:focus {
                border-color: var(--primary-blue);
                box-shadow: 0 0 0 3px var(--accent-blue-light);
                outline: none;
            }

        .timer-text {
            font-size: 14px;
            color: var(--text-muted);
            text-align: center;
            margin: 1rem 0;
        }

        .resend-btn {
            background: none;
            border: none;
            color: var(--primary-blue);
            font-weight: 600;
            cursor: pointer;
        }

            .resend-btn:disabled {
                color: var(--secondary-gray);
                cursor: not-allowed;
            }

        .password-strength {
            height: 4px;
            background: var(--secondary-border);
            border-radius: 2px;
            margin-top: 8px;
            transition: all 0.3s ease;
        }

        .password-strength-bar {
            height: 100%;
            border-radius: 2px;
            transition: width 0.3s ease;
        }

        /* Import CSS variables */
        :root {
            --primary-blue: #258cfb;
            --primary-dark-blue: #074074;
            --primary-light-blue: #9EC8EA;
            --secondary-gray: #6c757d;
            --secondary-border: #e9ecef;
            --secondary-dark-gray: #495057;
            --accent-blue-light: rgba(13, 110, 253, 0.15);
            --bg-white: #ffffff;
            --text-light: #fff;
            --text-muted: #6c757d;
            --success-green: #28a745;
            --danger-red: #dc3545;
            --warning-yellow: #ffc107;
            --info-blue: #0dcaf0;
            --shadow-lg: 0 1rem 3rem rgba(0, 0, 0, 0.175);
        }
    </style>
</head>
<body>
    <div class="reset-container">
        <div class="reset-card">
            <div class="reset-header">
                <i class="fas fa-key fa-3x mb-3"></i>
                <h3 class="fw-bold mb-1">Forgot Password</h3>
                <p class="mb-0">We'll help you reset your password</p>
            </div>

            <div class="reset-body">
                <!-- Step 1: Enter Phone/Email -->
                <div id="step1">
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle me-2"></i>
                        Enter your registered phone number or email to receive a verification code.
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            <i class="fas fa-phone me-2"></i>Phone Number or Email
                        </label>
                        <input type="text" class="form-control" id="identifier" placeholder="+254712345678 or email@example.com">
                    </div>

                    <button class="btn btn-primary w-100" onclick="sendResetOtp()">
                        <i class="fas fa-paper-plane me-2"></i>Send Verification Code
                    </button>

                    <div class="text-center mt-3">
                        <a href="@Url.Action("Login", "Auth")" class="text-decoration-none">
                            <i class="fas fa-arrow-left me-1"></i>Back to Login
                        </a>
                    </div>
                </div>

                <!-- Step 2: OTP Verification -->
                <div id="step2" style="display: none;">
                    <div class="text-center">
                        <i class="fas fa-envelope-open-text fa-3x text-primary mb-3"></i>
                        <p>We've sent a verification code to:</p>
                        <p class="fw-bold text-primary" id="resetDestination"></p>
                    </div>

                    <div class="otp-input-group">
                        <input type="text" class="otp-input" maxlength="1" onkeyup="moveToNextReset(this, 'resetOtp2')" id="resetOtp1">
                        <input type="text" class="otp-input" maxlength="1" onkeyup="moveToNextReset(this, 'resetOtp3')" id="resetOtp2">
                        <input type="text" class="otp-input" maxlength="1" onkeyup="moveToNextReset(this, 'resetOtp4')" id="resetOtp3">
                        <input type="text" class="otp-input" maxlength="1" onkeyup="moveToNextReset(this, 'resetOtp5')" id="resetOtp4">
                        <input type="text" class="otp-input" maxlength="1" onkeyup="moveToNextReset(this, 'resetOtp6')" id="resetOtp5">
                        <input type="text" class="otp-input" maxlength="1" onkeyup="moveToPrevReset(this, 'resetOtp5')" id="resetOtp6">
                    </div>

                    <div class="timer-text">
                        <span id="resetTimerDisplay">02:00</span>
                    </div>

                    <div class="text-center mb-3">
                        <button class="btn btn-link resend-btn" id="resetResendBtn" onclick="resendResetOtp()" disabled>
                            <i class="fas fa-redo-alt me-1"></i>Resend Code
                        </button>
                    </div>

                    <button class="btn btn-primary w-100" onclick="verifyResetOtp()">
                        <i class="fas fa-check me-2"></i>Verify Code
                    </button>
                </div>

                <!-- Step 3: Reset Password -->
                <div id="step3" style="display: none;">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            <i class="fas fa-lock me-2"></i>New Password
                        </label>
                        <input type="password" class="form-control" id="newPassword" placeholder="Enter new password">
                        <div class="password-strength mt-2">
                            <div class="password-strength-bar" id="passwordStrengthBar" style="width: 0%"></div>
                        </div>
                        <small class="text-muted" id="passwordStrengthText"></small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            <i class="fas fa-check-circle me-2"></i>Confirm Password
                        </label>
                        <input type="password" class="form-control" id="confirmPassword" placeholder="Confirm new password">
                    </div>

                    <button class="btn btn-primary w-100" onclick="resetPassword()">
                        <i class="fas fa-save me-2"></i>Reset Password
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        let resetIdentifier = '';
        let resetToken = '';
        let resetTimer;
        let resetTimeLeft = 120;

        function sendResetOtp() {
            const identifier = $('#identifier').val();
            if (!identifier) {
                Swal.fire('Error', 'Please enter your phone number or email', 'error');
                return;
            }

            // Determine if it's email or phone (basic validation)
            const isEmail = identifier.includes('@@') && identifier.includes('.');
            const isPhone = /^(\+?254|0)[17]\d{8}$/.test(identifier);

            if (!isEmail && !isPhone) {
                Swal.fire('Error', 'Please enter a valid email address or phone number (e.g., +254712345678)', 'error');
                return;
            }

            resetIdentifier = identifier;

            Swal.fire({
                title: 'Sending...',
                allowOutsideClick: false,
                didOpen: () => Swal.showLoading()
            });

            $.ajax({
                url: '/Auth/RequestPasswordReset',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    emailOrPhone: identifier
                }),
                success: function(response) {
                    if (response.isSuccess) {
                        Swal.close();
                        $('#resetDestination').text(identifier);
                        $('#step1').hide();
                        $('#step2').show();
                        startResetTimer();
                    } else {
                        Swal.fire('Error', response.message || 'Failed to send verification code', 'error');
                    }
                },
                error: function(xhr) {
                    const errorMsg = xhr.responseJSON?.message || 'Failed to send verification code';
                    Swal.fire('Error', errorMsg, 'error');
                }
            });
        }

        function verifyResetOtp() {
            const otp = $('#resetOtp1').val() + $('#resetOtp2').val() + $('#resetOtp3').val() +
                        $('#resetOtp4').val() + $('#resetOtp5').val() + $('#resetOtp6').val();

            if (otp.length !== 6) {
                Swal.fire('Error', 'Please enter the complete 6-digit code', 'error');
                return;
            }

            Swal.fire({
                title: 'Verifying...',
                allowOutsideClick: false,
                didOpen: () => Swal.showLoading()
            });

            $.ajax({
                url: '/Auth/ConfirmOtp',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    emailOrPhone: resetIdentifier,
                    otpCode: otp
                }),
                success: function(response) {
                    if (response.isSuccess) {
                        resetToken = response.data?.token || 'verified';
                        Swal.close();
                        $('#step2').hide();
                        $('#step3').show();
                    } else {
                        Swal.fire('Error', response.message || 'Invalid OTP', 'error');
                    }
                },
                error: function(xhr) {
                    const errorMsg = xhr.responseJSON?.message || 'Failed to verify OTP';
                    Swal.fire('Error', errorMsg, 'error');
                }
            });
        }

        function resetPassword() {
            const newPassword = $('#newPassword').val();
            const confirmPassword = $('#confirmPassword').val();

            if (!newPassword || !confirmPassword) {
                Swal.fire('Error', 'Please fill in all fields', 'error');
                return;
            }

            if (newPassword.length < 6) {
                Swal.fire('Error', 'Password must be at least 6 characters', 'error');
                return;
            }

            if (newPassword !== confirmPassword) {
                Swal.fire('Error', 'Passwords do not match', 'error');
                return;
            }

            const otp = $('#resetOtp1').val() + $('#resetOtp2').val() + $('#resetOtp3').val() +
                        $('#resetOtp4').val() + $('#resetOtp5').val() + $('#resetOtp6').val();

            Swal.fire({
                title: 'Resetting Password...',
                allowOutsideClick: false,
                didOpen: () => Swal.showLoading()
            });

            $.ajax({
                url: '/Auth/ResetPassword',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    emailOrPhone: resetIdentifier,
                    otpCode: otp,
                    newPassword: newPassword
                }),
                success: function(response) {
                    if (response.isSuccess) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Success!',
                            text: 'Password has been reset successfully',
                            timer: 2000,
                            showConfirmButton: false
                        }).then(() => {
                            window.location.href = '/Auth/Login';
                        });
                    } else {
                        Swal.fire('Error', response.message || 'Failed to reset password', 'error');
                    }
                },
                error: function(xhr) {
                    const errorMsg = xhr.responseJSON?.message || 'Failed to reset password';
                    Swal.fire('Error', errorMsg, 'error');
                }
            });
        }

        function resendResetOtp() {
            $.ajax({
                url: '/Auth/RequestPasswordReset',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    emailOrPhone: resetIdentifier
                }),
                success: function(response) {
                    if (response.isSuccess) {
                        startResetTimer();
                        Swal.fire('Success', 'A new verification code has been sent', 'success');
                    } else {
                        Swal.fire('Error', response.message || 'Failed to resend code', 'error');
                    }
                },
                error: function() {
                    Swal.fire('Error', 'Failed to resend code', 'error');
                }
            });
        }

        function startResetTimer() {
            if (resetTimer) clearInterval(resetTimer);
            resetTimeLeft = 120;
            updateResetTimerDisplay();

            resetTimer = setInterval(function() {
                if (resetTimeLeft <= 0) {
                    clearInterval(resetTimer);
                    $('#resetResendBtn').prop('disabled', false);
                    $('#resetTimerDisplay').text('00:00');
                } else {
                    resetTimeLeft--;
                    updateResetTimerDisplay();
                }
            }, 1000);
        }

        function updateResetTimerDisplay() {
            const minutes = Math.floor(resetTimeLeft / 60);
            const seconds = resetTimeLeft % 60;
            $('#resetTimerDisplay').text(`${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`);
            $('#resetResendBtn').prop('disabled', resetTimeLeft > 0);
        }

        function moveToNextReset(current, nextId) {
            if (current.value.length === 1) {
                document.getElementById(nextId).focus();
            }
        }

        function moveToPrevReset(current, prevId) {
            if (current.value.length === 0 && current.previousElementSibling) {
                document.getElementById(prevId).focus();
            }
        }

        // Password strength checker
        $('#newPassword').on('input', function() {
            const password = $(this).val();
            const strength = calculatePasswordStrength(password);
            const bar = $('#passwordStrengthBar');
            const text = $('#passwordStrengthText');

            if (strength.score === 0) {
                bar.css({ width: '0%', backgroundColor: 'var(--danger-red)' });
                text.html('');
            } else if (strength.score === 1) {
                bar.css({ width: '25%', backgroundColor: 'var(--danger-red)' });
                text.html('<span class="text-danger">Weak</span>');
            } else if (strength.score === 2) {
                bar.css({ width: '50%', backgroundColor: 'var(--warning-yellow)' });
                text.html('<span class="text-warning">Fair</span>');
            } else if (strength.score === 3) {
                bar.css({ width: '75%', backgroundColor: 'var(--info-blue)' });
                text.html('<span class="text-info">Good</span>');
            } else {
                bar.css({ width: '100%', backgroundColor: 'var(--success-green)' });
                text.html('<span class="text-success">Strong</span>');
            }
        });

        function calculatePasswordStrength(password) {
            let score = 0;
            if (password.length >= 8) score++;
            if (password.match(/[a-z]/) && password.match(/[A-Z]/)) score++;
            if (password.match(/\d/)) score++;
            if (password.match(/[^a-zA-Z\d]/)) score++;
            return { score: score, maxScore: 4 };
        }
    </script>
</body>
</html>