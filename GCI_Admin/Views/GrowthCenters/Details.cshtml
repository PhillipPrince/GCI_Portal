@model GCI_Admin.Models.GrowthCenterDetailsData
@using Microsoft.AspNetCore.Http
@using System.Text.Json
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Growth Center Details";
    var center = Model.GrowthCenter;
    var leaders = Model.Leaders;
    var members = Model.Members;

    var cachedMembersJson = HttpContextAccessor.HttpContext?.Session?.GetString("ActiveMembers");
    List<Member> activeMembersList = new List<Member>();
    if (!string.IsNullOrEmpty(cachedMembersJson))
    {
        try 
        {
            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            activeMembersList = JsonSerializer.Deserialize<List<Member>>(cachedMembersJson, options) ?? new List<Member>();
        } 
        catch { }
    }
}

<div class="row mb-4">
    <div class="col-md-8">
        <h2 class="fw-bold mb-1">@center?.CenterName</h2>
        <p class="text-muted mb-0">Growth Center Details</p>
    </div>
    <div class="col-md-4 text-end">
        <a href="@Url.Action("Index", "GrowthCenters")" class="btn btn-outline-secondary">
            <i class="fa fa-arrow-left me-2"></i>Back to Growth Centers
        </a>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-0 py-3">
                <h5 class="fw-bold mb-0">
                    <i class="fa fa-info-circle me-2 text-primary"></i>
                    Growth Center Information
                </h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="border-bottom pb-3 mb-3">
                            <h6 class="text-muted mb-2">Location</h6>
                            <p class="fs-6 fw-medium mb-0">@(center?.Location ?? "N/A")</p>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="border-bottom pb-3 mb-3">
                            <h6 class="text-muted mb-2">Created At</h6>
                            <p class="fs-6 fw-medium mb-0">@(center?.CreatedAt.ToString("dd MMM yyyy") ?? "N/A")</p>
                        </div>
                    </div>

                    <div class="col-md-12">
                        <div class="border-bottom pb-3 mb-3">
                            <h6 class="text-muted mb-2">Description</h6>
                            <p class="fs-6 fw-medium mb-0">@(center?.Description ?? "N/A")</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0">
                    <i class="fa fa-user-circle-o me-2 text-success"></i>
                    Growth Center Leaders
                </h5>
                <span class="badge bg-success">@(leaders?.Count ?? 0) Leaders</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Member Name</th>
                                <th>Bio</th>
                                <th>Start Date</th>
                                <th>End Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (leaders != null && leaders.Any())
                            {
                                foreach (var leader in leaders)
                                {
                                    <tr>
                                        <td class="ps-4 fw-medium">
                                            <div class="d-flex align-items-center">
                                                @if (leader.Member != null && leader.Member.ProfileImage != null && leader.Member.ProfileImage.Length > 0)
                                                {
                                                    <img src="data:image/jpeg;base64,@Convert.ToBase64String(leader.Member.ProfileImage)" alt="Profile" class="rounded-circle me-3 border shadow-sm" style="width: 45px; height: 45px; object-fit: cover;">
                                                }
                                                else
                                                {
                                                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 45px; height: 45px; font-size: 1.2rem;">
                                                        <i class="fa fa-user"></i>
                                                    </div>
                                                }
                                                <div>
                                                    <div class="fw-bold">@(leader.Member != null ? $"{leader.Member.FirstName} {leader.Member.OtherNames}" : "Unknown")</div>
                                                    @if(leader.Member != null) {
                                                        <div class="text-muted small">@leader.Member.Phone</div>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(leader.Bio) && leader.Bio.Length > 40)
                                            {
                                                <span title="@leader.Bio">@leader.Bio.Substring(0, 40)...</span>
                                            }
                                            else
                                            {
                                                <span>@(leader.Bio ?? "N/A")</span>
                                            }
                                        </td>
                                        <td>@leader.StartDate.ToString("dd MMM yyyy")</td>
                                        <td>@(leader.EndDate.HasValue ? leader.EndDate.Value.ToString("dd MMM yyyy") : "Ongoing")</td>
                                        <td>
                                            @if (leader.IsActive)
                                            {
                                                <span class="badge bg-success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Inactive</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-4">
                                        No leaders assigned to this growth center yet.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0">
                    <i class="fa fa-users me-2 text-info"></i>
                    Growth Center Members
                </h5>
                <div>
                    <span class="badge bg-info text-white me-2">@(members?.Count ?? 0) Members</span>
                    <button class="btn btn-sm btn-primary" onclick="$('#addMemberModal').modal('show')">
                        <i class="fa fa-plus me-1"></i> Add Member
                    </button>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 datatable">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Member Name</th>
                                <th>Contact</th>
                                <th>Added Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (members != null && members.Any())
                            {
                                foreach (var mem in members)
                                {
                                    <tr>
                                        <td class="ps-4 fw-medium">
                                            <div class="d-flex align-items-center">
                                                @if (mem.Member != null && mem.Member.ProfileImage != null && mem.Member.ProfileImage.Length > 0)
                                                {
                                                    <img src="data:image/jpeg;base64,@Convert.ToBase64String(mem.Member.ProfileImage)" alt="Profile" class="rounded-circle me-3 border shadow-sm" style="width: 40px; height: 40px; object-fit: cover;">
                                                }
                                                else
                                                {
                                                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 40px; height: 40px; font-size: 1rem;">
                                                        <i class="fa fa-user"></i>
                                                    </div>
                                                }
                                                <div class="fw-bold">@(mem.Member != null ? $"{mem.Member.FirstName} {mem.Member.OtherNames}" : "Unknown")</div>
                                            </div>
                                        </td>
                                        <td>
                                            @if(mem.Member != null) {
                                                <div><i class="fa fa-envelope text-muted me-1"></i> @mem.Member.Email</div>
                                                <div><i class="fa fa-phone text-muted me-1"></i> @mem.Member.Phone</div>
                                            }
                                        </td>
                                        <td>@(mem.CreatedAt?.ToString("dd MMM yyyy") ?? "N/A")</td>
                                        <td>
                                            @if (mem.IsActive)
                                            {
                                                <span class="badge bg-success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Inactive</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- Add Member Modal -->
<div class="modal fade" id="addMemberModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Add Member to Growth Center</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="addMemberForm">
                    <input type="hidden" id="growthCenterId" value="@center?.GrowthCenterId" />
                    <div class="mb-3">
                        @await Html.PartialAsync("_MemberSelector", new GCI_Admin.Models.ViewModels.MemberSelectorViewModel { 
                            ControlId = "newMemberSelector",
                            LabelText = "Select Member",
                            MemberIdFieldName = "NewMemberId",
                            Members = activeMembersList,
                            IsRequired = true,
                            ShowPhoneAndGender = true,
                            DataUrl = "/Finance/GetActiveMembers"
                        })
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="saveMemberBtn">Add Member</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            if ($.fn.DataTable) {
                $('.datatable').DataTable({
                    pageLength: 10,
                    language: {
                        search: "Search members:"
                    },
                    destroy: true
                });
            }

            $('#saveMemberBtn').click(function () {
                var centerId = $('#growthCenterId').val();
                var memberId = $('input[name="NewMemberId"]').val();

                if (!memberId) {
                    Swal.fire('Error', 'Please select a member.', 'warning');
                    return;
                }

                $('#saveMemberBtn').prop('disabled', true).html('<i class="fa fa-spinner fa-spin me-1"></i> Saving...');

                $.ajax({
                    url: '@Url.Action("AddMember", "GrowthCenters")',
                    type: 'POST',
                    data: { growthCenterId: centerId, memberId: memberId },
                    success: function (res) {
                        if (res.success) {
                            Swal.fire('Success', res.message, 'success').then(() => {
                                location.reload();
                            });
                        } else {
                            Swal.fire('Error', res.message, 'error');
                            $('#saveMemberBtn').prop('disabled', false).html('Add Member');
                        }
                    },
                    error: function () {
                        Swal.fire('Error', 'An unexpected error occurred.', 'error');
                        $('#saveMemberBtn').prop('disabled', false).html('Add Member');
                    }
                });
            });
        });
    </script>
}
