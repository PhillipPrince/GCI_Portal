@model GCI_Admin.Models.GrowthCentersData

@{
    ViewData["Title"] = "Growth Centers Management";
}

<!-- Page Header -->
<div class="row mb-4">
    <div class="col-md-8">
        <h2 class="fw-bold mb-1">Growth Centers</h2>
        <p class="text-muted mb-0">Manage growth centers and their leadership</p>
    </div>
    <div class="col-md-4 d-flex justify-content-end">
        <button class="btn btn-primary btn-lg" id="dynamicActionBtn">
            <i class="fa fa-plus-circle me-2"></i><span id="dynamicBtnText">Create New Center</span>
        </button>
    </div>
</div>

<!-- Tabs Navigation -->
<ul class="nav nav-tabs mb-4" id="growthCenterTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="centers-tab" data-bs-toggle="tab" data-bs-target="#centers" type="button" role="tab" aria-controls="centers" aria-selected="true">
            <i class="fa fa-building me-2"></i>Growth Centers
            <span class="badge bg-primary ms-2" id="centersCount">@Model.GrowthCenters?.Count</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="centerLeaders-tab" data-bs-toggle="tab" data-bs-target="#centerLeaders" type="button" role="tab" aria-controls="centerLeaders" aria-selected="false">
            <i class="fa fa-users me-2"></i>Center Leaders
            <span class="badge bg-primary ms-2" id="centerLeadersCount">@Model.GrowthCenterLeaders?.Count</span>
        </button>
    </li>
</ul>

<!-- Tab Content -->
<div class="tab-content" id="growthCenterTabsContent">

    <!-- Growth Centers Tab -->
    <div class="tab-pane fade show active" id="centers" role="tabpanel" aria-labelledby="centers-tab">

        <!-- Quick Stats for Centers -->
        <div class="row g-3 mb-4">
            <div class="col-md-4 col-6">
                <div class="card border-0 shadow-sm stat-card">
                    <div class="card-body d-flex align-items-center">
                        <div class="bg-primary bg-opacity-10 p-3 rounded-circle">
                            <i class="fa fa-building text-primary fa-2x"></i>
                        </div>
                        <div class="ms-3">
                            <h6 class="text-muted mb-1">Total Centers</h6>
                            <h3 class="fw-bold mb-0" id="totalCenters">@Model.GrowthCenters?.Count</h3>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4 col-6">
                <div class="card border-0 shadow-sm stat-card">
                    <div class="card-body d-flex align-items-center">
                        <div class="bg-success bg-opacity-10 p-3 rounded-circle">
                            <i class="fa fa-users text-success fa-2x"></i>
                        </div>
                        <div class="ms-3">
                            <h6 class="text-muted mb-1">Active Leaders</h6>
                            <h3 class="fw-bold mb-0" id="activeCenterLeaders">@Model.GrowthCenterLeaders?.Count(l => l.IsActive) </h3>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4 col-6">
                <div class="card border-0 shadow-sm stat-card">
                    <div class="card-body d-flex align-items-center">
                        <div class="bg-info bg-opacity-10 p-3 rounded-circle">
                            <i class="fa fa-calendar text-info fa-2x"></i>
                        </div>
                        <div class="ms-3">
                            <h6 class="text-muted mb-1">Recently Added</h6>
                            <h3 class="fw-bold mb-0" id="recentCenters">@(Model.GrowthCenters?.OrderByDescending(c => c.CreatedAt).Take(5).Count() )</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Filter Bar for Centers -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <div class="row g-3 align-items-center">
                    <div class="col-md-6">
                        <div class="input-group">
                            <span class="input-group-text bg-transparent border-end-0">
                                <i class="fa fa-search text-muted"></i>
                            </span>
                            <input type="text" class="form-control border-start-0" id="centerSearch" placeholder="Search centers...">
                        </div>
                    </div>
                    <div class="col-md-6 text-end">
                        <button class="btn btn-outline-secondary me-2" onclick="clearCenterFilters()">
                            <i class="fa fa-times me-1"></i>Clear
                        </button>
                        <button class="btn btn-primary" onclick="applyCenterFilters()">
                            <i class="fa fa-filter me-1"></i>Apply
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Growth Centers Table -->
        <div id="centersTableContainer">
            @await Html.PartialAsync("_GrowthCentersTable", Model.GrowthCenters)
        </div>
    </div>

    <!-- Growth Center Leaders Tab -->
    <div class="tab-pane fade" id="centerLeaders" role="tabpanel" aria-labelledby="centerLeaders-tab">

        <!-- Leaders Table -->
        <div id="centerLeadersTableContainer">
            @await Html.PartialAsync("_GrowthCenterLeadersTable", Model.GrowthCenterLeaders)
        </div>
    </div>
</div>

<!-- Growth Center Modal (for Add/Edit Center) -->
<div class="modal fade" id="centerModal" tabindex="-1" aria-labelledby="centerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="centerModalLabel">
                    <i class="fa fa-building me-2"></i>
                    <span id="modalTitleCenter">Add New Center</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="centerModalBody">
                <form id="centerForm">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label for="centerName" class="form-label">Center Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="centerName" name="CenterName" placeholder="Enter center name" required>
                    </div>
                    <div class="mb-3">
                        <label for="centerLocation" class="form-label">Location</label>
                        <input type="text" class="form-control" id="centerLocation" name="Location" placeholder="Optional location">
                    </div>
                    <div class="mb-3">
                        <label for="centerDescription" class="form-label">Description</label>
                        <textarea class="form-control" id="centerDescription" name="Description" rows="3" placeholder="Optional description"></textarea>
                    </div>
                </form>
                <div class="text-center p-4 d-none" id="centerLoading">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="confirmAndSubmitCenter()" id="saveCenterBtn">
                    <i class="fa fa-save me-1"></i>Save Center
                </button>
            </div>
        </div>
    </div>
</div>

<!-- GC Leader Modal - Loads the separated partial view -->
<div class="modal fade gc-leader-modal" id="addGCLeaderModal" tabindex="-1" aria-labelledby="addGCLeaderModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addGCLeaderModalLabel">
                    <i class="fa fa-user-plus me-2"></i>Add GC Leader
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <!-- Content will be loaded here -->
            <div id="gcLeaderModalContent">
                <div class="text-center p-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2">Loading form...</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <script>
        let centers = [];
        let centerLeaders = [];

        $(document).ready(function () {
            // Load data and initialize tables
            loadCenterData();
            initializeCenterTables();

            // Handle tab changes - update button text and functionality
            $('#growthCenterTabs button').on('shown.bs.tab', function (e) {
                const tabId = $(e.target).attr('id');
                
                if (tabId === 'centerLeaders-tab') {
                    // Update button for Leaders tab
                    $('#dynamicBtnText').text('New GC Leader');
                    $('#dynamicActionBtn').off('click').on('click', function(e) {
                        e.preventDefault();
                        openGCLeaderModal();
                    });
                    
                    // Adjust DataTable columns
                    if ($.fn.DataTable.isDataTable('#centerLeadersTable')) {
                        $('#centerLeadersTable').DataTable().columns.adjust().draw();
                    }
                }
                else if (tabId === 'centers-tab') {
                    // Update button for Centers tab
                    $('#dynamicBtnText').text('Create New Center');
                    $('#dynamicActionBtn').off('click').on('click', function(e) {
                        e.preventDefault();
                        openCenterModal();
                    });
                    
                    // Adjust DataTable columns
                    if ($.fn.DataTable.isDataTable('#centersTable')) {
                        $('#centersTable').DataTable().columns.adjust().draw();
                    }
                }
            });

            // Set initial button state for active tab (Centers)
            $('#dynamicBtnText').text('Create New Center');
            $('#dynamicActionBtn').off('click').on('click', function(e) {
                e.preventDefault();
                openCenterModal();
            });
        });

        function openCenterModal() {
            $('#centerModal').modal('show');
            $('#centerForm')[0].reset();
            $('#centerLoading').addClass('d-none');
            $('#saveCenterBtn').prop('disabled', false);
            $('#modalTitleCenter').text('Add New Center');
        }

        function openGCLeaderModal() {
            // Show modal with loading spinner
            $('#addGCLeaderModal').modal('show');
            $('#gcLeaderModalContent').html(`
                <div class="text-center p-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2">Loading form...</p>
                </div>
            `);
            
            // Load the partial view
            $.ajax({
                url: '@Url.Action("LoadCreateForm", "GrowthCenters")',
                type: 'GET',
                success: function (response) {
                    $('#gcLeaderModalContent').html(response);
                },
                error: function (xhr, status, error) {
                    $('#gcLeaderModalContent').html(`
                        <div class="alert alert-danger m-3">
                            <i class="fa fa-exclamation-triangle me-2"></i>
                            Error loading form. Please try again.
                            <br><small>${error}</small>
                        </div>
                    `);
                    console.error("Error loading partial view:", error);
                }
            });
        }

        function confirmAndSubmitCenter() {
            const form = document.getElementById('centerForm');
            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }

            const dto = {
                CenterName: $('#centerName').val()?.trim() || "",
                Location: $('#centerLocation').val()?.trim() || null,
                Description: $('#centerDescription').val()?.trim() || null
            };

            $('#saveCenterBtn').prop('disabled', true);
            $('#centerLoading').removeClass('d-none');

            $.ajax({
                url: '@Url.Action("SubmitNewCenter", "GrowthCenters")',
                type: 'POST',
                contentType: 'application/json; charset=utf-8',
                dataType: 'json',
                data: JSON.stringify(dto),
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (response) {
                    $('#centerLoading').addClass('d-none');
                    $('#saveCenterBtn').prop('disabled', false);

                    if (response.isSuccess) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Success!',
                            text: response.message || 'Center created successfully!',
                            showConfirmButton: false,
                            timer: 1500
                        }).then(() => location.reload());
                    } else {
                        Swal.fire('Error', response.message || 'Failed to create center.', 'error');
                    }
                },
                error: function (xhr) {
                    $('#centerLoading').addClass('d-none');
                    $('#saveCenterBtn').prop('disabled', false);
                    let message = "An unexpected error occurred.";
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        message = xhr.responseJSON.message;
                    }
                    Swal.fire('Error', message, 'error');
                }
            });
        }

        function initializeCenterTables() {
            if ($.fn.DataTable.isDataTable('#centersTable')) {
                $('#centersTable').DataTable().destroy();
            }

            $('#centersTable').DataTable({
                pageLength: 10,
                language: {
                    search: "Search centers:",
                    lengthMenu: "Show _MENU_ centers",
                    info: "Showing _START_ to _END_ of _TOTAL_ centers",
                    emptyTable: "No centers available"
                },
                columnDefs: [
                    { targets: -1, orderable: false, searchable: false }
                ]
            });

            if ($.fn.DataTable.isDataTable('#centerLeadersTable')) {
                $('#centerLeadersTable').DataTable().destroy();
            }

            $('#centerLeadersTable').DataTable({
                pageLength: 10,
                language: {
                    search: "Search leaders:",
                    lengthMenu: "Show _MENU_ leaders",
                    info: "Showing _START_ to _END_ of _TOTAL_ leaders",
                    emptyTable: "No center leaders found"
                },
                columnDefs: [
                    { targets: -1, orderable: false, searchable: false }
                ]
            });
        }

        function applyCenterFilters() {
            const search = $('#centerSearch').val();
            const table = $('#centersTable').DataTable();
            table.search(search).draw();
        }

        function clearCenterFilters() {
            $('#centerSearch').val('');
            const table = $('#centersTable').DataTable();
            table.search('').draw();
        }

        function loadCenterData() {
            // Placeholder for any data loading needs
            console.log("Center data loaded");
        }

        function editLeader(id) {
            $('#addGCLeaderModal').modal('show');
            $('#gcLeaderModalContent').html(`
                <div class="text-center p-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2">Loading form...</p>
                </div>
            `);
            
            $.ajax({
                url: '@Url.Action("LoadEditForm", "GrowthCenters")/' + id,
                type: 'GET',
                success: function (response) {
                    $('#gcLeaderModalContent').html(response);
                },
                error: function (xhr, status, error) {
                    $('#gcLeaderModalContent').html(`
                        <div class="alert alert-danger m-3">
                            <i class="fa fa-exclamation-triangle me-2"></i>
                            Error loading form. Please try again.
                        </div>
                    `);
                    console.error("Error loading partial view:", error);
                }
            });
        }

        function toggleGCLeaderStatus(id, setActive) {
            const action = setActive ? 'activate' : 'deactivate';
            
            Swal.fire({
                title: 'Confirm Status Change',
                text: `Are you sure you want to ${action} this growth center leader?`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: `Yes, ${action}!`
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '@Url.Action("ToggleStatus", "GrowthCenters")?id=' + id + '&isActive=' + setActive,
                        type: 'POST',
                        success: function (response) {
                            if (response.success) {
                                Swal.fire('Success!', response.message || `Leader ${action}d successfully.`, 'success')
                                    .then(() => location.reload());
                            } else {
                                Swal.fire('Error', response.message || `Failed to ${action} leader.`, 'error');
                            }
                        },
                        error: function (xhr) {
                            Swal.fire('Error', xhr.responseJSON?.message || 'An unexpected error occurred.', 'error');
                        }
                    });
                }
            });
        }

        function deleteLeader(id) {
            Swal.fire({
                title: 'Are you sure?',
                text: "Are you sure you want to delete this growth center leader? This will perform a soft-delete.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Yes, delete!'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '@Url.Action("DeleteGCLeader", "GrowthCenters")/' + id,
                        type: 'POST',
                        success: function (response) {
                            if (response.success) {
                                Swal.fire('Deleted!', response.message || 'Leader deleted successfully.', 'success')
                                    .then(() => location.reload());
                            } else {
                                Swal.fire('Error', response.message || 'Failed to delete leader.', 'error');
                            }
                        },
                        error: function (xhr) {
                            Swal.fire('Error', xhr.responseJSON?.message || 'An unexpected error occurred.', 'error');
                        }
                    });
                }
            });
        }

        // Make functions globally available
        window.editLeader = editLeader;
        window.toggleGCLeaderStatus = toggleGCLeaderStatus;
        window.deleteLeader = deleteLeader;
        window.applyCenterFilters = applyCenterFilters;
        window.clearCenterFilters = clearCenterFilters;

    </script>

    <style>
        .stat-card {
            transition: transform 0.2s, box-shadow 0.2s;
            cursor: pointer;
        }

            .stat-card:hover {
                transform: translateY(-3px);
                box-shadow: 0 0.5rem 1.5rem rgba(0,0,0,0.1) !important;
            }

        .nav-tabs .nav-link {
            font-weight: 500;
            padding: 0.75rem 1.5rem;
        }

            .nav-tabs .nav-link.active {
                border-bottom: 3px solid #0d6efd;
            }

        .badge {
            font-size: 0.75rem;
        }
    </style>
}