@model GCI_Admin.Models.DTOs.CreateGCLeaderDto

@{
    var isEdit = ViewBag.IsEdit ?? false;
    var formId = isEdit ? "editGCLeaderForm" : "createGCLeaderForm";
    var action = isEdit ? "UpdateGCLeader" : "CreateGCLeader";
}

<!-- Modal Body -->
<div class="modal-body">
    <form asp-action="@action" asp-controller="GrowthCenters" method="post" id="@formId">
        @Html.AntiForgeryToken()

        @if (isEdit)
        {
            <input type="hidden" asp-for="GCLeader.GCLeaderId" id="GCLeaderId" />
        }

        <div class="alert alert-info">
            <i class="fa fa-info-circle me-2"></i>
            Assign a member as a leader to a growth center. The member will be responsible for overseeing growth center activities.
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label fw-bold">Growth Center <span class="text-danger">*</span></label>
                <select asp-for="GCLeader.GrowthCenterId" class="form-select" id="GrowthCenterId" name="GrowthCenterId" required>
                    <option value="">-- Select Growth Center --</option>
                    @if (Model?.GrowthCenters != null)
                    {
                        foreach (var center in Model.GrowthCenters)
                        {
                            <option value="@center.Value" selected="@(Model?.GCLeader?.GrowthCenterId.ToString() == center.Value)">@center.Text</option>
                        }
                    }
                </select>
                <span asp-validation-for="GCLeader.GrowthCenterId" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label fw-bold">Position Title <span class="text-danger">*</span></label>
                <input asp-for="GCLeader.PositionTitle" class="form-control" id="PositionTitle" name="PositionTitle"
                       placeholder="e.g., Center Director, Assistant Director, Coordinator" required />
                <span asp-validation-for="GCLeader.PositionTitle" class="text-danger"></span>
                <small class="text-muted">The role or title this person holds in the growth center</small>
            </div>
        </div>

        <!-- Member Selector Partial -->
        @await Html.PartialAsync("_MemberSelector", new GCI_Admin.Models.ViewModels.MemberSelectorViewModel
        {
            ControlId = "gcLeaderMemberSelector",
            LabelText = "Select Member",
            MemberIdFieldName = "MemberId",
            SelectedMemberId = Model?.GCLeader?.MemberId,
            Members = Model?.Members?.Select(m => new GCI_Admin.Models.Member
            {
                Id = int.Parse(m.Value),
                FirstName = m.Text.Split('(')[0].Trim(),
                Email = m.Text.Contains('(') ? m.Text.Split('(')[1].Trim(')') : ""
            }).ToList(),
            IsRequired = true,
            IsEdit = isEdit,
            ShowPhoneAndGender = true,
            DataUrl = Model?.GCLeader?.GrowthCenterId > 0 ? $"/GrowthCenters/GetMembersByGrowthCenter?growthCenterId={Model.GCLeader.GrowthCenterId}" : "/Finance/GetActiveMembers"
        })

        <hr />

        <div class="row mt-3">
            <div class="col-12">
                @await Html.PartialAsync("_ImagePicker", new GCI_Admin.Models.ImagePickerViewModel
                {
                    ControlId = "gcLeaderProfileImage",
                    LabelText = "Profile Image",
                    IconClass = "fa fa-user-circle-o",
                    HelpText = "Upload a profile image for the growth center leader. Recommended size: 400x400 pixels. Max size: 5MB",
                    UploadButtonText = "Choose Image",
                    CurrentImageUrl = Model?.GCLeader?.MemberId != null ? $"/uploads/{Model.GCLeader.MemberId}.jpg" : null,
                    PreviewWidth = 150,
                    PreviewHeight = 150,
                    MaxFileSizeMB = 5,
                    IsRequired = false,
                    Rounded = true,
                    FileInputName = "ProfileImage",
                    ImageUrlFieldName = "ProfileImageUrl",
                    Base64FieldName = "ProfileImageBase64"
                })
            </div>
        </div>

        <div class="row">
            <div class="col-md-12 mb-3">
                <label class="form-label fw-bold">Bio / Description</label>
                <textarea asp-for="GCLeader.Bio" class="form-control" id="Bio" name="Bio" rows="3" maxlength="500"
                          placeholder="Brief biography, qualifications, or role description..."></textarea>
                <span asp-validation-for="GCLeader.Bio" class="text-danger"></span>
                <small class="text-muted">Optional: Provide a brief description of the leader's role and responsibilities</small>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label fw-bold">Start Date <span class="text-danger">*</span></label>
                <input asp-for="GCLeader.StartDate" type="date" class="form-control" id="StartDate" name="StartDate" required
                       value="@(Model?.GCLeader?.StartDate.ToString("yyyy-MM-dd") ?? DateTime.Today.ToString("yyyy-MM-dd"))">
                    <span asp-validation-for="GCLeader.StartDate" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">End Date</label>
                    <input asp-for="GCLeader.EndDate" type="date" class="form-control" id="EndDate" name="EndDate"
                           value="@(Model?.GCLeader?.EndDate?.ToString("yyyy-MM-dd"))">
                        <span asp-validation-for="GCLeader.EndDate" class="text-danger"></span>
                        <small class="text-muted">Leave empty if currently serving</small>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12 mb-3">
                        <div class="form-check form-switch">
                            <input asp-for="GCLeader.IsActive" class="form-check-input" type="checkbox" id="IsActive" name="IsActive"
                                   checked="@(Model?.GCLeader?.IsActive ?? true)">
                                <label class="form-check-label fw-bold" asp-for="GCLeader.IsActive">Active Leader</label>
                            </div>
                            <small class="text-muted">Uncheck if this leader is no longer serving in this role</small>
                        </div>
                    </div>
                </form>
            </div>

            <script>
                // Initialize modal and form handling
                $(document).ready(function() {
                    // Ensure form validation
                    $('#@formId').on('submit', function(e) {
                        e.preventDefault();
                        return false;
                    });
        
                    // Initialize member selector if needed
                    if (typeof initializeCustomDropdown === 'function') {
                        initializeCustomDropdown('gcLeaderMemberSelector');
                    }

                    $('#GrowthCenterId').on('change', function() {
                        var growthCenterId = $(this).val();
                        var memberSelectorId = 'gcLeaderMemberSelector';
                        if (growthCenterId) {
                            var url = '/GrowthCenters/GetMembersByGrowthCenter?growthCenterId=' + growthCenterId;
                            if (window['reloadMemberSelector_' + memberSelectorId]) {
                                window['reloadMemberSelector_' + memberSelectorId](url);
                            }
                        } else {
                            if (window['reloadMemberSelector_' + memberSelectorId]) {
                                window['reloadMemberSelector_' + memberSelectorId]('/Finance/GetActiveMembers');
                            }
                        }
                    });
                });

                // Function to show confirmation dialog before submission
                function confirmAndSubmitGCLeader() {
                    const isEdit = '@isEdit'.toLowerCase() === 'true';
        
                    // Get all field values for the confirmation message
                    const memberDisplayName = $('#gcLeaderMemberSelector_fullName').val();
                    const centerName = $('#GrowthCenterId option:selected').text();
                    const positionTitle = $('#PositionTitle').val();
                    const startDate = $('#StartDate').val();
                    const endDate = $('#EndDate').val();
                    const isActive = $('#IsActive').is(':checked');
                    const bio = $('#Bio').val();
        
                    // Format dates for display
                    const formattedStartDate = startDate ? new Date(startDate).toLocaleDateString() : 'Not specified';
                    const formattedEndDate = endDate ? new Date(endDate).toLocaleDateString() : 'Currently serving';
        
                    // Build confirmation message
                    let confirmationMessage = '';
                    let confirmationTitle = '';
        
                    if (isEdit) {
                        confirmationTitle = 'Confirm Update';
                        confirmationMessage = `
                            <div style="text-align: left;">
                                <p>Are you sure you want to update this GC leader?</p>
                                <hr>
                                <p><strong>Member:</strong> ${memberDisplayName || 'Not selected'}</p>
                                <p><strong>Growth Center:</strong> ${centerName || 'Not selected'}</p>
                                <p><strong>Position:</strong> ${positionTitle || 'Not specified'}</p>
                                <p><strong>Start Date:</strong> ${formattedStartDate}</p>
                                <p><strong>End Date:</strong> ${formattedEndDate}</p>
                                <p><strong>Status:</strong> ${isActive ? 'Active' : 'Inactive'}</p>
                                ${bio ? `<p><strong>Bio:</strong> ${bio.substring(0, 100)}${bio.length > 100 ? '...' : ''}</p>` : ''}
                                <hr>
                                <p class="text-warning">This action will update the leader's information in the system.</p>
                            </div>
                        `;
                    } else {
                        confirmationTitle = 'Confirm Creation';
                        confirmationMessage = `
                            <div style="text-align: left;">
                                <p>Are you sure you want to assign this member as a growth center leader?</p>
                                <hr>
                                <p><strong>Member:</strong> ${memberDisplayName || 'Not selected'}</p>
                                <p><strong>Growth Center:</strong> ${centerName || 'Not selected'}</p>
                                <p><strong>Position:</strong> ${positionTitle || 'Not specified'}</p>
                                <p><strong>Start Date:</strong> ${formattedStartDate}</p>
                                <p><strong>End Date:</strong> ${formattedEndDate}</p>
                                <p><strong>Status:</strong> ${isActive ? 'Active' : 'Inactive'}</p>
                                ${bio ? `<p><strong>Bio:</strong> ${bio.substring(0, 100)}${bio.length > 100 ? '...' : ''}</p>` : ''}
                                <hr>
                                <p class="text-info">Please review the information before confirming.</p>
                            </div>
                        `;
                    }
        
                    // Show SweetAlert confirmation
                    Swal.fire({
                        title: confirmationTitle,
                        html: confirmationMessage,
                        icon: 'question',
                        showCancelButton: true,
                        confirmButtonColor: '#3085d6',
                        cancelButtonColor: '#d33',
                        confirmButtonText: isEdit ? 'Yes, update it!' : 'Yes, assign leader!',
                        cancelButtonText: 'Cancel',
                        showLoaderOnConfirm: true,
                        preConfirm: async () => {
                            try {
                                // Call the submit function
                                return await submitGCLeaderForm();
                            } catch (error) {
                                Swal.showValidationMessage(`Request failed: ${error}`);
                            }
                        },
                        allowOutsideClick: () => !Swal.isLoading()
                    }).then((result) => {
                        if (result.isConfirmed) {
                            console.log('User confirmed the action');
                        } else if (result.dismiss === Swal.DismissReason.cancel) {
                            Swal.fire(
                                'Cancelled',
                                isEdit ? 'Leader update was cancelled' : 'Leader assignment was cancelled',
                                'info'
                            );
                        }
                    });
                }

                // Main submit function
                function submitGCLeaderForm() {
                    return new Promise((resolve, reject) => {
                        // Get the correct form based on edit mode
                        const isEdit = '@isEdit'.toLowerCase() === 'true';
                        const formId = isEdit ? 'editGCLeaderForm' : 'createGCLeaderForm';
                        const form = $('#' + formId);
            
                        if (!form.length) {
                            console.error('Form not found:', formId);
                            reject('Form not found');
                            Swal.fire('Error', 'Form not found', 'error');
                            return;
                        }

                        // Get all field values
                        const gcLeaderId = $('#GCLeaderId').val() || '0';
                        const memberId = $('#gcLeaderMemberSelector_selectedId').val();
                        const growthCenterId = $('#GrowthCenterId').val();
                        const positionTitle = $('#PositionTitle').val();
                        const bio = $('#Bio').val();
                        const startDate = $('#StartDate').val();
                        const endDate = $('#EndDate').val();
                        const isActive = $('#IsActive').is(':checked');

                        // Validate form
                        if (!form[0].checkValidity()) {
                            form[0].reportValidity();
                            reject('Validation failed');
                            Swal.fire('Validation Error', 'Please fill all required fields correctly', 'warning');
                            return;
                        }

                        // Validate member is selected
                        if (!memberId || memberId === '') {
                            Swal.fire('Validation Error', 'Please select a member', 'warning');
                            reject('Member not selected');
                            return;
                        }

                        // Validate center is selected
                        if (!growthCenterId || growthCenterId === '') {
                            Swal.fire('Validation Error', 'Please select a growth center', 'warning');
                            reject('Center not selected');
                            return;
                        }

                        // Validate position title
                        if (!positionTitle || positionTitle.trim() === '') {
                            Swal.fire('Validation Error', 'Please enter a position title', 'warning');
                            reject('Position title not entered');
                            return;
                        }

                        // Validate start date
                        if (!startDate) {
                            Swal.fire('Validation Error', 'Please select a start date', 'warning');
                            reject('Start date not selected');
                            return;
                        }

                        // Validate end date is after start date if provided
                        if (endDate && new Date(endDate) < new Date(startDate)) {
                            Swal.fire('Validation Error', 'End date cannot be earlier than start date', 'warning');
                            reject('Invalid date range');
                            return;
                        }

                        // Disable button and show loading
                        const $saveBtn = $('#saveGCLeaderBtn');
                        const $loadingSpinner = $('#gcLeaderLoading');
                        const $btnText = $('#saveBtnText');
            
                        $saveBtn.prop('disabled', true);
                        $loadingSpinner.removeClass('d-none');
                        const originalText = $btnText.text();
                        $btnText.text('Saving...');

                        // Get anti-forgery token
                        const token = $('input[name="__RequestVerificationToken"]', form).val();

                        // Prepare JSON data
                        const requestData = {
                            GCLeaderId: parseInt(gcLeaderId) || 0,
                            MemberId: parseInt(memberId),
                            GrowthCenterId: parseInt(growthCenterId),
                            PositionTitle: positionTitle.trim(),
                            Bio: bio || '',
                            StartDate: startDate,
                            EndDate: endDate || null,
                            IsActive: isActive,
                            ProfileImageBase64: $('#gcLeaderProfileImage_base64').val() || null
                        };

                        console.log("Submitting GC Leader form data as JSON:", requestData);

                        // Make AJAX request
                        $.ajax({
                            url: form.attr('action'),
                            type: 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify(requestData),
                            headers: {
                                'RequestVerificationToken': token
                            },
                            success: function(response) {
                                console.log("Response:", response);
                    
                                // Reset button state
                                $saveBtn.prop('disabled', false);
                                $loadingSpinner.addClass('d-none');
                                $btnText.text(originalText);

                                if (response.success) {
                                    // Show success message
                                    Swal.fire({
                                        icon: 'success',
                                        title: 'Success!',
                                        text: response.message || `GC Leader ${isEdit ? 'updated' : 'assigned'} successfully`,
                                        showConfirmButton: false,
                                        timer: 1500
                                    }).then(() => {
                                        // Close modal and reload
                                        $('#addGCLeaderModal').modal('hide');
                                        location.reload();
                                    });
                                    resolve(response);
                                } else {
                                    // Show error message
                                    let errorMessage = response.message || 'Failed to save GC leader.';
                        
                                    // Handle validation errors
                                    if (response.errors && response.errors.length > 0) {
                                        errorMessage = response.errors.join('<br>');
                                    }
                        
                                    Swal.fire('Error', errorMessage, 'error');
                                    reject(errorMessage);
                                }
                            },
                            error: function(xhr, status, error) {
                                // Reset button state
                                $saveBtn.prop('disabled', false);
                                $loadingSpinner.addClass('d-none');
                                $btnText.text(originalText);
                    
                                // Handle different error scenarios
                                let errorMessage = 'An unexpected error occurred.';
                    
                                if (xhr.responseJSON && xhr.responseJSON.message) {
                                    errorMessage = xhr.responseJSON.message;
                                } else if (xhr.status === 400) {
                                    errorMessage = 'Invalid data sent to server.';
                                } else if (xhr.status === 409) {
                                    errorMessage = 'This member is already a leader in this growth center.';
                                } else if (xhr.status === 0) {
                                    errorMessage = 'Network error. Please check your connection.';
                                } else if (xhr.status === 404) {
                                    errorMessage = 'Service endpoint not found. Please contact support.';
                                } else if (xhr.status === 500) {
                                    errorMessage = 'Server error. Please try again later.';
                                }
                    
                                console.error('Form submission error:', xhr, status, error);
                                Swal.fire('Error', errorMessage, 'error');
                                reject(errorMessage);
                            }
                        });
                    });
                }

                // Handle Enter key in form inputs
                $(document).on('keypress', '#@formId input, #@formId select, #@formId textarea', function(e) {
                    if (e.which === 13 && !$(this).is('textarea')) {
                        e.preventDefault();
                        confirmAndSubmitGCLeader();
                    }
                });

                // Listen for member selection to validate
                $(document).on('memberSelected', function(e, data) {
                    console.log('Member selected for GC leader:', data);
                    // Clear any previous member validation errors
                    $('#gcLeaderMemberSelector_validation').text('');
                });

                // Reset form when modal is closed
                $('#addGCLeaderModal').on('hidden.bs.modal', function() {
                    $('#gcLeaderMemberSelector_fullName').val('');
                    $('#gcLeaderMemberSelector_selectedId').val('');
                    $('#GrowthCenterId').val('');
                    $('#PositionTitle').val('');
                    $('#Bio').val('');
                    $('#StartDate').val(new Date().toISOString().split('T')[0]);
                    $('#EndDate').val('');
                    $('#IsActive').prop('checked', true);
                    $('.dropdown-list').hide();
                });
            </script>